# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

load_dotenv()

DATA_SAVE_PATH = os.getenv("DATA_SAVE_PATH")
MODEL_PATH = os.getenv("MODEL_PATH")

# Cache for loaded models to avoid reloading
_model_cache = {}

@contextmanager
def safe_file_operation(file_path: Union[str, Path], mode: str = 'r'):
    """Context manager for safe file operations with proper error handling."""
    file_handle = None
    try:
        file_handle = open(file_path, mode)
        yield file_handle
    except (IOError, OSError) as e:
        logger.error(f"File operation failed for {file_path}: {e}")
        raise
    finally:
        if file_handle:
            file_handle.close()


def save_log_to_file(log_history: List[Dict[str, Any]], file_path: Union[str, Path], 
                    append_latest_only: bool = False) -> None:
    """
    Saves log history to a JSON file with improved error handling and performance.
    
    Optimizations:
    1. Type hints for better code clarity and IDE support
    2. Pathlib for better path handling
    3. Reduced file I/O operations
    4. More efficient JSON handling
    5. Better error handling with specific exceptions
    
    Args:
        log_history: List of log entries (each entry is a dictionary)
        file_path: Path to the file where logs will be saved
        append_latest_only: If True, only append the latest log entry
    """
    if not log_history:
        logger.warning("Empty log history provided")
        return
    
    file_path = Path(file_path)
    current_logs = []

    # Load existing logs if file exists
    if file_path.exists() and file_path.stat().st_size > 0:
        try:
            with safe_file_operation(file_path, 'r') as f:
                current_logs = json.load(f)
        except json.JSONDecodeError:
            logger.warning(f"{file_path} contains invalid JSON. Creating new file.")
            current_logs = []

    # Append logs efficiently
    if append_latest_only:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    # Write updated logs
    try:
        # Ensure parent directory exists
        file_path.parent.mkdir(parents=True, exist_ok=True)
        with safe_file_operation(file_path, 'w') as f:
            json.dump(current_logs, f, indent=2, separators=(',', ': '))
    except Exception as e:
        logger.error(f"Failed to write logs to {file_path}: {e}")
        raise


def clear_directory(directory: Union[str, Path], delete_directory: bool = False) -> None:
    """
    Clears all files and subdirectories within a given directory with improved performance.
    
    Optimizations:
    1. Use pathlib for better path operations
    2. Batch operations for better performance
    3. More specific error handling
    4. Early return for non-existent directories
    
    Args:
        directory: Path to the directory to clear
        delete_directory: If True, delete the directory after clearing its content
    """
    directory = Path(directory)
    
    if not directory.exists():
        if not delete_directory:
            directory.mkdir(parents=True, exist_ok=True)
            logger.info(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True.")
        return

    # Collect all items first for batch processing
    items_to_remove = list(directory.iterdir())
    
    for item_path in items_to_remove:
        try:
            if item_path.is_dir():
                shutil.rmtree(item_path)
                logger.debug(f"Removed directory: {item_path}")
            else:
                item_path.unlink()
                logger.debug(f"Removed file: {item_path}")
        except OSError as e:
            logger.error(f"Failed to delete '{item_path}': {e}")
            raise

    if delete_directory:
        try:
            directory.rmdir()
            logger.info(f"Removed directory: {directory}")
        except OSError as e:
            logger.error(f"Failed to delete '{directory}': {e}")
            raise


def merge_lora_model(
    model_name: str = "pythia-31M",
    base_model_repo_name: str = "EleutherAI/",
    model_load_path: Union[str, Path] = MODEL_PATH,
    model_save_path: Union[str, Path] = MODEL_PATH,
) -> None:
    """
    Merges LoRA model with base model with improved path handling and caching.
    
    Optimizations:
    1. Type hints for better code clarity
    2. Pathlib for path operations
    3. Input validation
    4. Better variable naming
    5. Model caching to avoid reloading
    """
    if not model_name or not base_model_repo_name:
        raise ValueError("model_name and base_model_repo_name cannot be empty")
    
    model_load_path = Path(model_load_path)
    model_save_path = Path(model_save_path)
    
    my_model_path = model_load_path / model_name
    
    # Extract parameter count more robustly
    try:
        param_count = model_name.lower().split("m")[0].split("-")[1]
        base_model_name = f"pythia-{param_count}M"
        base_model_full_name = f"{base_model_repo_name.rstrip('/')}/{base_model_name}"
    except (IndexError, ValueError) as e:
        raise ValueError(f"Invalid model name format: {model_name}") from e

    # Use caching for base model
    cache_key = f"base_{base_model_full_name}"
    if cache_key not in _model_cache:
        _model_cache[cache_key] = AutoModelForCausalLM.from_pretrained(base_model_full_name)
    
    base_model = _model_cache[cache_key]
    
    # Load and merge model
    model = PeftModel.from_pretrained(base_model, str(my_model_path))
    merged_model = model.merge_and_unload()
    
    # Save merged model
    save_path = model_save_path / f"{model_name}_merged"
    save_path.mkdir(parents=True, exist_ok=True)
    merged_model.save_pretrained(str(save_path))
    
    logger.info(f"Model merged and saved to {save_path}")


def remove_repetition(question: str, answer: str) -> str:
    """
    Removes question repetition from answer with improved string handling.
    
    Optimizations:
    1. Type hints
    2. Input validation
    3. More efficient string operations
    """
    if not question or not answer:
        return answer
    
    # Use more efficient string replacement
    if question in answer:
        return answer.replace(question, "", 1).strip()
    return answer


def load_model(
    model_type: str,
    model_path: Optional[Union[str, Path]] = None,
    blocks_str: Optional[str] = None,
    vanilla_model_name: Optional[str] = None,
    host_model_name: Optional[str] = None,
) -> Any:
    """
    Loads different types of models with improved caching and error handling.
    
    Optimizations:
    1. Model caching to avoid reloading
    2. Better type hints
    3. Enum-like validation for model types
    4. Pathlib usage
    5. Reduced code duplication
    """
    valid_model_types = {
        "Tuned Model", "Vanilla Model", "Transformed Model", 
        "Final Model", "Host Model"
    }
    
    if model_type not in valid_model_types:
        raise ValueError(f"Unknown model type: {model_type}. Valid types: {valid_model_types}")
    
    # Create cache key
    cache_key = f"{model_type}_{model_path}_{blocks_str}_{vanilla_model_name}_{host_model_name}"
    
    if cache_key in _model_cache:
        logger.info(f"Loading {model_type} from cache")
        return _model_cache[cache_key]
    
    model_path = Path(model_path) if model_path else None
    
    try:
        if model_type == "Tuned Model":
            if not vanilla_model_name or not blocks_str or not model_path:
                raise ValueError("vanilla_model_name, blocks_str, and model_path required for Tuned Model")
            
            model_name = vanilla_model_name.split("/")[-1]
            tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
            model = AutoModelForCausalLM.from_pretrained(str(model_path / tuned_model_name))
            
        elif model_type == "Vanilla Model":
            if not vanilla_model_name:
                raise ValueError("vanilla_model_name required for Vanilla Model")
            model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)
            
        elif model_type in ["Transformed Model", "Final Model"]:
            if not host_model_name or not blocks_str or not model_path:
                raise ValueError(f"host_model_name, blocks_str, and model_path required for {model_type}")
            
            name = host_model_name.split("/")[-1]
            suffix = "preGRAFTED" if model_type == "Transformed Model" else "GRAFTED"
            file_name = f"{name}_{suffix}_{blocks_str}.pkl"
            file_path = model_path / file_name
            
            with safe_file_operation(file_path, 'rb') as f:
                model = pickle.load(f)
                
        elif model_type == "Host Model":
            if not host_model_name:
                raise ValueError("host_model_name required for Host Model")
            model = AutoModelForCausalLM.from_pretrained(host_model_name)
        
        # Cache the loaded model
        _model_cache[cache_key] = model
        logger.info(f"Loaded and cached {model_type}")
        return model
        
    except Exception as e:
        logger.error(f"Failed to load {model_type}: {e}")
        raise


def load_batch_losses(file_path: Union[str, Path]) -> Optional[List[float]]:
    """
    Loads batch losses from a checkpoint file with improved error handling.
    
    Optimizations:
    1. Type hints
    2. Pathlib usage
    3. More specific error handling
    4. Better logging
    """
    file_path = Path(file_path)
    
    if not file_path.exists():
        logger.error(f"Checkpoint file not found: {file_path}")
        return None
    
    try:
        # Use map_location for CPU to avoid GPU memory issues
        checkpoint = torch.load(file_path, map_location='cpu')
        batch_losses = checkpoint.get("batch_losses")
        
        if batch_losses is not None:
            logger.info(f"Batch losses loaded from {file_path}")
            return batch_losses
        else:
            logger.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
            return None
            
    except Exception as e:
        logger.error(f"Error loading checkpoint from {file_path}: {e}")
        return None


def clear_model_cache() -> None:
    """
    Clears the model cache to free up memory.
    
    This function should be called when memory usage becomes a concern.
    """
    global _model_cache
    _model_cache.clear()
    logger.info("Model cache cleared")


def get_cache_info() -> Dict[str, int]:
    """
    Returns information about the current model cache.
    
    Returns:
        Dictionary with cache statistics
    """
    return {
        "cached_models": len(_model_cache),
        "cache_keys": list(_model_cache.keys())
    }