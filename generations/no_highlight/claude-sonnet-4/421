import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image
import numpy as np

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                              std=[0.229, 0.224, 0.225])
        ])
    
    def create_unrelated_pairs(self, image_text_pairs):
        """Tworzy niepowiązane pary obraz-tekst poprzez przetasowanie opisów tekstowych"""
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """Tworzy semantycznie podobne pary tekstowe używając zbiorów danych z parafrazami"""
        try:
            dataset = load_dataset(dataset_name, split=f'train[:{self.sample_size}]')
            textual_pairs = []
            for item in dataset:
                if item['is_duplicate'] == 1:
                    pair = (item['question1'], item['question2'])
                    textual_pairs.append(pair)
            return textual_pairs[:self.sample_size]
        except Exception as e:
            print(f"Error loading {dataset_name} dataset: {e}")
            # Fallback to synthetic textual pairs
            return self.create_synthetic_textual_pairs()
    
    def create_synthetic_textual_pairs(self):
        """Tworzy syntetyczne pary tekstowe jako fallback"""
        synthetic_pairs = [
            ("A cat sitting on a chair", "A feline resting on furniture"),
            ("Dog running in the park", "Canine exercising in green space"),
            ("Beautiful sunset over mountains", "Gorgeous evening sky above peaks"),
            ("Children playing soccer", "Kids enjoying football game"),
            ("Red car parked outside", "Crimson vehicle stationed outdoors"),
        ]
        return synthetic_pairs * (self.sample_size // len(synthetic_pairs) + 1)[:self.sample_size]

    def create_visual_pairs(self, image_text_pairs):
        """Tworzy zaugmentowane pary obrazów, zachowując znaczenie semantyczne"""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                augmented = augmentation_transforms(image)
                visual_pairs.append((image, augmented))
        return visual_pairs

    def load_mscoco_dataset(self):
        """Ładuje i przetwarza zbiór danych MSCOCO z ulepszonym filtrowaniem i obsługą błędów"""
        try:
            # Try the original MSCOCO dataset first
            dataset = load_dataset(
                "shunk031/MSCOCO",
                year=2014,
                coco_task="captions",
                split='train',
                streaming=True
            )
            dataset = dataset.take(self.sample_size)

            image_text_pairs = []
            processed_count = 0
            
            for item in dataset:
                try:
                    # Wybierz najbardziej opisowy podpis na podstawie długości
                    best_caption = max(item["captions"], key=len)
                    if len(best_caption.split()) >= 5:  # Odfiltruj zbyt krótkie podpisy
                        image_text_pairs.append((item["image"], best_caption))
                        processed_count += 1
                        
                    if processed_count >= self.sample_size:
                        break
                        
                except Exception as e:
                    print(f"Error processing item: {e}")
                    continue
                    
            if len(image_text_pairs) > 0:
                return image_text_pairs
            else:
                raise Exception("No valid image-text pairs found")
                
        except Exception as e:
            print(f"Error loading MSCOCO dataset: {e}")
            print("Falling back to alternative dataset...")
            return self.load_alternative_dataset()

    def load_alternative_dataset(self):
        """Ładuje alternatywny zbiór danych jako fallback"""
        try:
            # Try Conceptual Captions as alternative
            dataset = load_dataset("conceptual_captions", split=f'train[:{self.sample_size}]', streaming=True)
            
            image_text_pairs = []
            processed_count = 0
            
            for item in dataset:
                try:
                    if len(item["caption"].split()) >= 5:
                        image_text_pairs.append((item["image"], item["caption"]))
                        processed_count += 1
                        
                    if processed_count >= self.sample_size:
                        break
                        
                except Exception as e:
                    print(f"Error processing alternative dataset item: {e}")
                    continue
                    
            if len(image_text_pairs) > 0:
                return image_text_pairs
            else:
                raise Exception("Alternative dataset also failed")
                
        except Exception as e:
            print(f"Error loading alternative dataset: {e}")
            print("Creating synthetic dataset...")
            return self.create_synthetic_dataset()

    def create_synthetic_dataset(self):
        """Tworzy syntetyczny zbiór danych jako ostateczny fallback"""
        # Create simple colored images with corresponding captions
        synthetic_pairs = []
        colors = ['red', 'blue', 'green', 'yellow', 'purple']
        shapes = ['circle', 'square', 'triangle']
        
        for i in range(min(self.sample_size, 50)):
            color = random.choice(colors)
            shape = random.choice(shapes)
            
            # Create a simple colored image
            img = Image.new('RGB', (224, 224), color=color)
            caption = f"A {color} {shape} on white background"
            
            synthetic_pairs.append((img, caption))
            
        return synthetic_pairs

def main():
    # Zainicjuj tworzenie zbioru danych
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # Załaduj i utwórz zestawy danych
    print("Loading image-text dataset...")
    image_text_pairs = creator.load_mscoco_dataset()
    print(f"Loaded {len(image_text_pairs)} image-text pairs")
    
    print("Creating unrelated pairs...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Creating textual pairs...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Creating visual pairs...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # Wydrukuj próbkę z każdego zbioru danych
    print("\nDataset Samples:")
    if image_text_pairs:
        print(f"Image-Text Pair: Image type: {type(image_text_pairs[0][0])}, Caption: {image_text_pairs[0][1]}")
    if unrelated_pairs:
        print(f"Unrelated Pair: Image type: {type(unrelated_pairs[0][0])}, Caption: {unrelated_pairs[0][1]}")
    if textual_pairs:
        print(f"Textual Pair: {textual_pairs[0]}")
    if visual_pairs:
        print(f"Visual Pair: Original type: {type(visual_pairs[0][0])}, Augmented type: {type(visual_pairs[0][1])}")

if __name__ == "__main__":
    main()