import numpy as np
from pathlib import Path
from typing import List, Tuple

INPUT_FILE_PATH = './input.txt'
# INPUT_FILE_PATH = './example_in.txt'  # Commented out for clarity

def main():
    """Main function to calculate the sum of distances between sorted pairs."""
    try:
        list_1, list_2 = parse_and_process_input()
        total_distance = calculate_total_distance(list_1, list_2)
        print(f"Total distance: {total_distance}")
    except FileNotFoundError:
        print(f"Error: File '{INPUT_FILE_PATH}' not found.")
    except ValueError as e:
        print(f"Error processing data: {e}")
    except Exception as e:
        print(f"Unexpected error: {e}")

def parse_and_process_input() -> Tuple[np.ndarray, np.ndarray]:
    """
    Parse input file and return two sorted arrays.
    
    Returns:
        Tuple of two sorted numpy arrays
        
    Raises:
        FileNotFoundError: If input file doesn't exist
        ValueError: If data format is invalid
    """
    lines = parse_input_file()
    
    if not lines or all(not line.strip() for line in lines):
        raise ValueError("Input file is empty or contains no valid data")
    
    # Filter out empty lines
    lines = [line for line in lines if line.strip()]
    
    try:
        # Split lines and convert to numpy array
        cols = [line.split() for line in lines]
        
        # Validate that each line has exactly 2 columns
        if not all(len(col) == 2 for col in cols):
            raise ValueError("Each line must contain exactly 2 numbers")
        
        cols_array = np.array(cols, dtype=int).T
        
        # Sort both arrays for efficient pairing
        list_1 = np.sort(cols_array[0])
        list_2 = np.sort(cols_array[1])
        
        return list_1, list_2
        
    except ValueError as e:
        raise ValueError(f"Invalid data format in input file: {e}")

def calculate_total_distance(list_1: np.ndarray, list_2: np.ndarray) -> int:
    """
    Calculate total distance between corresponding elements of sorted arrays.
    
    Args:
        list_1: First sorted array
        list_2: Second sorted array
        
    Returns:
        Sum of absolute differences between corresponding elements
    """
    if len(list_1) != len(list_2):
        raise ValueError("Input lists must have the same length")
    
    # Vectorized calculation - much more efficient
    distances = np.abs(list_1 - list_2)
    return int(np.sum(distances))

def parse_input_file() -> List[str]:
    """
    Read and parse the input file.
    
    Returns:
        List of lines from the file
        
    Raises:
        FileNotFoundError: If the file doesn't exist
    """
    file_path = Path(INPUT_FILE_PATH)
    
    if not file_path.exists():
        raise FileNotFoundError(f"Input file '{INPUT_FILE_PATH}' does not exist")
    
    with open(file_path, 'r', encoding='utf-8') as f:
        lines = f.read().strip().split('\n')
    
    return lines

if __name__ == "__main__":
    main()