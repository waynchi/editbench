def is_sum_of_four_squares(n):
    """
    检查一个数字是否可以表示为四个非零平方数的和
    """
    if n <= 0:
        return False
    
    # 遍历所有可能的四个平方数组合
    for a in range(1, int(n**0.5) + 1):
        a_squared = a * a
        if a_squared >= n:
            break
            
        for b in range(1, int((n - a_squared)**0.5) + 1):
            b_squared = b * b
            if a_squared + b_squared >= n:
                break
                
            for c in range(1, int((n - a_squared - b_squared)**0.5) + 1):
                c_squared = c * c
                if a_squared + b_squared + c_squared >= n:
                    break
                    
                remainder = n - a_squared - b_squared - c_squared
                d = int(remainder**0.5)
                
                # 检查余数是否是完全平方数且d不为0
                if d > 0 and d * d == remainder:
                    return True, (a, b, c, d)
    
    return False, None

def find_numbers_as_four_squares(start, end):
    """
    找到指定范围内可以表示为四个非零平方数和的所有数字
    """
    results = []
    
    for num in range(start, end + 1):
        can_represent, squares = is_sum_of_four_squares(num)
        if can_represent:
            results.append((num, squares))
    
    return results

def print_four_squares_representation(n):
    """
    打印数字n的四个非零平方数表示
    """
    can_represent, squares = is_sum_of_four_squares(n)
    
    if can_represent:
        a, b, c, d = squares
        print(f"{n} = {a}² + {b}² + {c}² + {d}² = {a*a} + {b*b} + {c*c} + {d*d}")
        return True
    else:
        print(f"{n} 不能表示为四个非零平方数的和")
        return False

# 示例使用
if __name__ == "__main__":
    # 测试单个数字
    test_numbers = [30, 50, 100, 130, 200]
    
    print("测试单个数字:")
    for num in test_numbers:
        print_four_squares_representation(num)
    
    print("\n" + "="*50 + "\n")
    
    # 找到1到100范围内的所有可以表示为四个非零平方数和的数字
    print("1到100范围内可以表示为四个非零平方数和的数字:")
    results = find_numbers_as_four_squares(1, 100)
    
    for num, squares in results:
        a, b, c, d = squares
        print(f"{num} = {a}² + {b}² + {c}² + {d}²")
    
    print(f"\n总共找到 {len(results)} 个数字可以表示为四个非零平方数的和")