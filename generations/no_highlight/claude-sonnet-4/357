import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=1000):
    """
    Metoda sprzężonych gradientów do rozwiązywania układu równań Ax = b
    
    Parametry:
    A : array_like, shape (n, n)
        Macierz współczynników (musi być symetryczna i dodatnio określona)
    b : array_like, shape (n,)
        Wektor prawej strony
    x0 : array_like, shape (n,), opcjonalny
        Przybliżenie początkowe (domyślnie wektor zerowy)
    tol : float, opcjonalny
        Tolerancja dla kryterium zbieżności (domyślnie 1e-6)
    max_iter : int, opcjonalny
        Maksymalna liczba iteracji (domyślnie 1000)
    
    Zwraca:
    x : ndarray, shape (n,)
        Rozwiązanie układu równań
    residuals : list
        Lista norm residuów w każdej iteracji
    iterations : int
        Liczba wykonanych iteracji
    """
    
    # Konwersja do numpy arrays
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float)
    n = len(b)
    
    # Przybliżenie początkowe
    if x0 is None:
        x = np.zeros(n)
    else:
        x = np.array(x0, dtype=float)
    
    # Obliczenie początkowego residuum
    r = b - A @ x
    p = r.copy()
    
    # Lista do przechowywania norm residuów
    residuals = []
    
    for k in range(max_iter):
        # Norma residuum
        r_norm = np.linalg.norm(r)
        residuals.append(r_norm)
        
        # Sprawdzenie kryterium zbieżności
        if r_norm < tol:
            return x, residuals, k
        
        # Obliczenie kroku alpha
        Ap = A @ p
        alpha = (r @ r) / (p @ Ap)
        
        # Aktualizacja rozwiązania
        x = x + alpha * p
        
        # Nowe residuum
        r_new = r - alpha * Ap
        
        # Obliczenie współczynnika beta
        beta = (r_new @ r_new) / (r @ r)
        
        # Nowy kierunek sprzężony
        p = r_new + beta * p
        
        # Aktualizacja residuum
        r = r_new
    
    # Jeśli nie osiągnięto zbieżności
    print(f"Ostrzeżenie: Nie osiągnięto zbieżności po {max_iter} iteracjach")
    return x, residuals, max_iter


def conjugate_gradient_preconditioned(A, b, M=None, x0=None, tol=1e-6, max_iter=1000):
    """
    Metoda sprzężonych gradientów z prekondycjonowaniem
    
    Parametry:
    A : array_like, shape (n, n)
        Macierz współczynników
    b : array_like, shape (n,)
        Wektor prawej strony
    M : array_like, shape (n, n), opcjonalny
        Macierz prekondycjonująca (domyślnie macierz jednostkowa)
    x0 : array_like, shape (n,), opcjonalny
        Przybliżenie początkowe
    tol : float, opcjonalny
        Tolerancja zbieżności
    max_iter : int, opcjonalny
        Maksymalna liczba iteracji
    
    Zwraca:
    x : ndarray
        Rozwiązanie
    residuals : list
        Lista norm residuów
    iterations : int
        Liczba iteracji
    """
    
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float)
    n = len(b)
    
    if x0 is None:
        x = np.zeros(n)
    else:
        x = np.array(x0, dtype=float)
    
    if M is None:
        M = np.eye(n)
    else:
        M = np.array(M, dtype=float)
    
    # Początkowe residuum
    r = b - A @ x
    
    # Rozwiązanie M * z = r
    z = np.linalg.solve(M, r)
    p = z.copy()
    
    residuals = []
    
    for k in range(max_iter):
        r_norm = np.linalg.norm(r)
        residuals.append(r_norm)
        
        if r_norm < tol:
            return x, residuals, k
        
        Ap = A @ p
        alpha = (r @ z) / (p @ Ap)
        
        x = x + alpha * p
        r_new = r - alpha * Ap
        
        z_new = np.linalg.solve(M, r_new)
        beta = (r_new @ z_new) / (r @ z)
        
        p = z_new + beta * p
        r = r_new
        z = z_new
    
    print(f"Ostrzeżenie: Nie osiągnięto zbieżności po {max_iter} iteracjach")
    return x, residuals, max_iter


# Przykład użycia
if __name__ == "__main__":
    # Przykład 1: Podstawowa metoda CG
    print("Przykład 1: Podstawowa metoda sprzężonych gradientów")
    
    # Definicja macierzy A (symetryczna i dodatnio określona)
    A = np.array([[4, 1, 0],
                  [1, 3, 1],
                  [0, 1, 2]], dtype=float)
    
    b = np.array([1, 2, 3], dtype=float)
    
    # Rozwiązanie metodą CG
    x_cg, residuals, iterations = conjugate_gradient(A, b, tol=1e-8)
    
    print(f"Rozwiązanie CG: {x_cg}")
    print(f"Liczba iteracji: {iterations}")
    print(f"Końcowa norma residuum: {residuals[-1]:.2e}")
    
    # Weryfikacja z numpy
    x_exact = np.linalg.solve(A, b)
    print(f"Rozwiązanie dokładne: {x_exact}")
    print(f"Błąd: {np.linalg.norm(x_cg - x_exact):.2e}")
    
    print("\n" + "="*50 + "\n")
    
    # Przykład 2: Większy układ równań
    print("Przykład 2: Większy układ równań")
    
    n = 100
    # Generowanie macierzy dodatnio określonej
    np.random.seed(42)
    A_large = np.random.randn(n, n)
    A_large = A_large.T @ A_large + np.eye(n)  # Zapewnienie dodatniej określoności
    b_large = np.random.randn(n)
    
    x_cg_large, residuals_large, iter_large = conjugate_gradient(A_large, b_large, tol=1e-10)
    
    print(f"Rozmiar problemu: {n}x{n}")
    print(f"Liczba iteracji: {iter_large}")
    print(f"Końcowa norma residuum: {residuals_large[-1]:.2e}")
    
    # Weryfikacja
    residuum_check = np.linalg.norm(A_large @ x_cg_large - b_large)
    print(f"Weryfikacja residuum: {residuum_check:.2e}")