import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image
import numpy as np

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                              std=[0.229, 0.224, 0.225])
        ])
    
    def create_unrelated_pairs(self, image_text_pairs):
        """通过打乱文本描述来创建不相关的图像-文本对"""
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """使用释义数据集创建语义相似的文本对"""
        try:
            dataset = load_dataset(dataset_name, split=f'train[:{self.sample_size}]')
            textual_pairs = []
            for item in dataset:
                if item['is_duplicate'] == 1:
                    pair = (item['question1'], item['question2'])
                    textual_pairs.append(pair)
            return textual_pairs[:self.sample_size]
        except Exception as e:
            print(f"Error loading {dataset_name} dataset: {e}")
            # 返回一些示例文本对作为备用
            return [
                ("What is machine learning?", "Can you explain machine learning?"),
                ("How does AI work?", "What is the working principle of artificial intelligence?"),
                ("What is deep learning?", "Can you describe deep learning?")
            ]
    
    def create_visual_pairs(self, image_text_pairs):
        """创建增强的图像对，同时保持语义意义"""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                try:
                    augmented = augmentation_transforms(image)
                    visual_pairs.append((image, augmented))
                except Exception as e:
                    print(f"Error augmenting image: {e}")
                    continue
        return visual_pairs

    def load_conceptual_captions_dataset(self):
        """加载 Conceptual Captions 数据集作为替代方案"""
        try:
            dataset = load_dataset("conceptual_captions", split=f'train[:{self.sample_size}]')
            image_text_pairs = []
            
            for item in dataset:
                try:
                    if item["image"] is not None and item["caption"] is not None:
                        # 过滤掉过短的标题
                        if len(item["caption"].split()) >= 5:
                            image_text_pairs.append((item["image"], item["caption"]))
                except Exception as e:
                    print(f"Error processing item: {e}")
                    continue
                    
            return image_text_pairs[:self.sample_size]
        except Exception as e:
            print(f"Error loading Conceptual Captions dataset: {e}")
            return self.create_dummy_dataset()

    def load_flickr30k_dataset(self):
        """加载 Flickr30k 数据集作为另一个替代方案"""
        try:
            dataset = load_dataset("nlphuji/flickr30k", split=f'test[:{self.sample_size}]')
            image_text_pairs = []
            
            for item in dataset:
                try:
                    if item["image"] is not None and item["caption"] is not None:
                        # 过滤掉过短的标题
                        if len(item["caption"][0].split()) >= 5:  # 取第一个caption
                            image_text_pairs.append((item["image"], item["caption"][0]))
                except Exception as e:
                    print(f"Error processing item: {e}")
                    continue
                    
            return image_text_pairs[:self.sample_size]
        except Exception as e:
            print(f"Error loading Flickr30k dataset: {e}")
            return self.create_dummy_dataset()

    def create_dummy_dataset(self):
        """创建虚拟数据集作为最后的备用方案"""
        print("Creating dummy dataset with synthetic images...")
        image_text_pairs = []
        
        # 创建一些简单的合成图像
        for i in range(min(10, self.sample_size)):
            # 创建随机颜色的图像
            color = tuple(np.random.randint(0, 255, 3))
            image = Image.new('RGB', (224, 224), color)
            caption = f"A synthetic image with color RGB{color}"
            image_text_pairs.append((image, caption))
        
        return image_text_pairs

    def load_mscoco_dataset(self):
        """加载和预处理 MSCOCO 数据集，带有错误处理和备用方案"""
        try:
            print("Attempting to load MSCOCO dataset...")
            dataset = load_dataset(
                "shunk031/MSCOCO",
                year=2014,
                coco_task="captions",
                split='train',
                streaming=True
            )
            dataset = dataset.take(self.sample_size)

            image_text_pairs = []
            for item in dataset:
                try:
                    # 根据长度选择最具描述性的标题
                    best_caption = max(item["captions"], key=len)
                    if len(best_caption.split()) >= 5:  # 过滤掉过短的标题
                        image_text_pairs.append((item["image"], best_caption))
                except Exception as e:
                    print(f"Error processing MSCOCO item: {e}")
                    continue
                    
            if len(image_text_pairs) > 0:
                return image_text_pairs
            else:
                raise Exception("No valid image-text pairs found in MSCOCO")
                
        except Exception as e:
            print(f"Error loading MSCOCO dataset: {e}")
            print("Trying alternative datasets...")
            
            # 尝试 Conceptual Captions
            try:
                return self.load_conceptual_captions_dataset()
            except Exception as e2:
                print(f"Conceptual Captions also failed: {e2}")
                
                # 尝试 Flickr30k
                try:
                    return self.load_flickr30k_dataset()
                except Exception as e3:
                    print(f"Flickr30k also failed: {e3}")
                    
                    # 最后使用虚拟数据集
                    return self.create_dummy_dataset()

def main():
    # 初始化数据集创建器
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # 加载和创建数据集
    print("Loading image-text dataset...")
    image_text_pairs = creator.load_mscoco_dataset()
    
    if len(image_text_pairs) == 0:
        print("No image-text pairs loaded. Exiting...")
        return
    
    print(f"Successfully loaded {len(image_text_pairs)} image-text pairs")
    
    print("Creating unrelated pairs...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Creating textual pairs...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Creating visual pairs...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # 从每个数据集中打印样本
    print("\nDataset Samples:")
    if len(image_text_pairs) > 0:
        print(f"Image-Text Pair: Image type: {type(image_text_pairs[0][0])}, Caption: {image_text_pairs[0][1]}")
    if len(unrelated_pairs) > 0:
        print(f"Unrelated Pair: Image type: {type(unrelated_pairs[0][0])}, Caption: {unrelated_pairs[0][1]}")
    if len(textual_pairs) > 0:
        print(f"Textual Pair: {textual_pairs[0]}")
    if len(visual_pairs) > 0:
        print(f"Visual Pair: Original type: {type(visual_pairs[0][0])}, Augmented type: {type(visual_pairs[0][1])}")
    
    print(f"\nDataset sizes:")
    print(f"Image-Text pairs: {len(image_text_pairs)}")
    print(f"Unrelated pairs: {len(unrelated_pairs)}")
    print(f"Textual pairs: {len(textual_pairs)}")
    print(f"Visual pairs: {len(visual_pairs)}")

if __name__ == "__main__":
    main()