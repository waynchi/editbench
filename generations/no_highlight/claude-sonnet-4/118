def create_hierarchical_dictionary(posts_generator):
    """
    Creates a hierarchical dictionary structure from posts and their replies.
    
    Structure:
    {
        "post_author/post_permlink": {
            "post_data": {
                "author": str,
                "permlink": str,
                "title": str,
                "body": str,
                "children_count": int
            },
            "replies": {
                "reply_author/reply_permlink": {
                    "author": str,
                    "permlink": str,
                    "body": str,
                    "parent_author": str,
                    "parent_permlink": str,
                    "processed": bool,
                    "banned": bool,
                    "own_author": bool
                }
            },
            "valid_replies_count": int,
            "meets_criteria": bool
        }
    }
    """
    hierarchical_dict = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_key = f"{post_author}/{post_permlink}"
        post_replies = post['children']
        
        # Initialize post entry
        hierarchical_dict[post_key] = {
            "post_data": {
                "author": post_author,
                "permlink": post_permlink,
                "title": post.get('title', ''),
                "body": post.get('body', ''),
                "children_count": post_replies
            },
            "replies": {},
            "valid_replies_count": 0,
            "meets_criteria": False
        }
        
        if post_replies > n_respuestas_minimas:
            comment = Comment(authorperm=f"{post_author}/{post_permlink}")
            post_replies_list = comment.get_replies()
            
            valid_count = 0
            for reply in post_replies_list:
                reply_author = reply['author']
                reply_permlink = reply['permlink']
                reply_key = f"{reply_author}/{reply_permlink}"
                reply_text = reply['body']
                
                # Check various conditions
                is_own = is_own_author(reply_author)
                is_banned_user = is_banned(reply_author)
                is_processed = procesar(reply_text)
                
                # Add reply to hierarchical structure
                hierarchical_dict[post_key]["replies"][reply_key] = {
                    "author": reply_author,
                    "permlink": reply_permlink,
                    "body": reply_text,
                    "parent_author": post_author,
                    "parent_permlink": post_permlink,
                    "processed": is_processed,
                    "banned": is_banned_user,
                    "own_author": is_own
                }
                
                # Break conditions
                if is_own:
                    break
                if is_banned_user:
                    break
                if is_processed:
                    valid_count += 1
            
            hierarchical_dict[post_key]["valid_replies_count"] = valid_count
            hierarchical_dict[post_key]["meets_criteria"] = valid_count > 3
    
    return hierarchical_dict

