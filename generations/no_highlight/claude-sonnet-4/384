            self._debug_logger.logger.debug(f"Starting _run_with_manager with {len(args)} arguments")
            
            # Create config with debugging
            config = AgentConfig(*args)
            self._debug_logger.logger.debug(f"Created AgentConfig: {config.agent_type}, {config.llm_provider}")
            
            async with browser_session(config) as runner:
                self._debug_logger.logger.debug("Browser session created, starting run")
