@dataclass
class AgentConfig:
    agent_type: str
    llm_provider: str
    llm_model_name: str
    llm_temperature: float = DEFAULT_TEMPERATURE
    llm_base_url: Optional[str] = None
    llm_api_key: Optional[str] = None
    use_own_browser: bool = False
    headless: bool = False
    disable_security: bool = False
    window_w: int = DEFAULT_WINDOW_WIDTH
    window_h: int = DEFAULT_WINDOW_HEIGHT
    save_recording_path: Optional[str] = None
    task: str = ""
    add_infos: str = ""
    max_steps: int = DEFAULT_MAX_STEPS
    use_vision: bool = True

    def __post_init__(self) -> None:
        logger.debug(f"Validating AgentConfig: {self.agent_type}")
        self.validate()

    def validate(self) -> None:
        validation_errors = []
        
        if self.agent_type not in ["org", "custom"]:
            validation_errors.append(f"Invalid agent type: {self.agent_type}")

        if not self.llm_provider or not self.llm_model_name:
            validation_errors.append("LLM provider and model name are required")

        if self.llm_temperature < 0.0 or self.llm_temperature > 2.0:
            validation_errors.append(f"Invalid temperature: {self.llm_temperature}")

        if self.window_w <= 0 or self.window_h <= 0:
            validation_errors.append(f"Invalid window dimensions: {self.window_w}x{self.window_h}")

        if self.max_steps <= 0:
            validation_errors.append(f"Invalid max steps: {self.max_steps}")
        
        if validation_errors:
            error_msg = "Configuration validation failed:\n" + "\n".join(validation_errors)
            logger.error(error_msg)
            raise ConfigError(error_msg)
        
        logger.debug("AgentConfig validation passed")

