class ResourceManager:
    def __init__(self):
        self._debug_logger = DebugLogger("ResourceManager")
        self.temp_files: List[Path] = []
        self.active_contexts: List[Union[None, Any]] = []
        self._lock = threading.Lock()

    @async_debug_decorator
    async def cleanup(self) -> None:
        errors = []
        
        with self._lock:
            self._debug_logger.logger.debug(f"Starting cleanup: {len(self.active_contexts)} contexts, {len(self.temp_files)} temp files")
            
            # Wyczyść konteksty
            for i, context in enumerate(self.active_contexts):
                if context:
                    try:
                        await context.close()
                        self._debug_logger.logger.debug(f"Closed context {i}")
                    except Exception as e:
                        error_msg = f"Failed to close context {i}: {e}"
                        self._debug_logger.logger.error(error_msg)
                        errors.append(error_msg)

            # Usuń pliki tymczasowe
            for i, file in enumerate(self.temp_files):
                try:
                    if file.exists():
                        if file.is_file():
                            file.unlink(missing_ok=True)
                            self._debug_logger.logger.debug(f"Removed temp file: {file}")
                        else:
                            shutil.rmtree(file, ignore_errors=True)
                            self._debug_logger.logger.debug(f"Removed temp directory: {file}")
                except Exception as e:
                    error_msg = f"Failed to remove {file}: {e}"
                    self._debug_logger.logger.error(error_msg)
                    errors.append(error_msg)

            # Wyczyść listy po sprzątaniu
            self.temp_files.clear()
            self.active_contexts.clear()
            
        if errors:
            error_summary = f"Cleanup completed with {len(errors)} errors"
            self._debug_logger.logger.error(error_summary)
            self._debug_logger.logger.debug("Cleanup errors:\n" + "\n".join(errors))
            raise Exception("Errors occurred during cleanup:\n" + "\n".join(errors))
        else:
            self._debug_logger.logger.debug("Cleanup completed successfully")

def setup_logging(log_path: Optional[str] = None) -> logging.Logger:
    logger = logging.getLogger("browser_agent")
    
    # Set debug level if DEBUG environment variable is set
    debug_mode = os.getenv('DEBUG', 'False').lower() == 'true'
    logger.setLevel(logging.DEBUG if debug_mode else logging.INFO)

    if not logger.handlers:
        # Enhanced formatter with more details for debugging
        formatter = logging.Formatter(
            '%(asctime)s - %(name)s - %(levelname)s - [%(filename)s:%(lineno)d] - %(message)s',
            datefmt='%Y-%m-%d %H:%M:%S'
        )

        console_handler = logging.StreamHandler()
        console_handler.setLevel(logging.DEBUG if debug_mode else logging.INFO)
        console_handler.setFormatter(formatter)
        logger.addHandler(console_handler)

        if log_path:
            file_handler = logging.FileHandler(log_path)
            file_handler.setLevel(logging.DEBUG)
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
            
            # Add error-only file handler
            error_handler = logging.FileHandler(log_path.replace('.log', '_errors.log'))
            error_handler.setLevel(logging.ERROR)
            error_handler.setFormatter(formatter)
            logger.addHandler(error_handler)

    logger.debug(f"Logging setup completed. Debug mode: {debug_mode}")
    return logger

