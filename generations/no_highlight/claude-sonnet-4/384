def init_database():
    """Initialize the settings database if it doesn't exist."""
    try:
        with sqlite3.connect(SETTINGS_DB) as conn:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS settings (
                    key TEXT PRIMARY KEY,
                    value TEXT NOT NULL
                )
            """)
            conn.commit()
        logger.debug("Database initialized successfully")
    except Exception as e:
        logger.error(f"Failed to initialize database: {e}")
        logger.debug(f"Database error traceback: {traceback.format_exc()}")
        raise

class DebugLogger:
    """Enhanced logging for debugging purposes"""
    
    def __init__(self, name: str):
        self.logger = logging.getLogger(name)
        self.debug_mode = os.getenv('DEBUG', 'False').lower() == 'true'
    
    def debug_method_call(self, method_name: str, *args, **kwargs):
        if self.debug_mode:
            self.logger.debug(f"Calling {method_name} with args: {args}, kwargs: {kwargs}")
    
    def debug_method_result(self, method_name: str, result: Any):
        if self.debug_mode:
            self.logger.debug(f"Method {method_name} returned: {type(result).__name__}")
    
    def debug_exception(self, method_name: str, exception: Exception):
        self.logger.error(f"Exception in {method_name}: {exception}")
        self.logger.debug(f"Full traceback for {method_name}: {traceback.format_exc()}")

def debug_decorator(func):
    """Decorator for debugging method calls"""
    @wraps(func)
    def wrapper(self, *args, **kwargs):
        debug_logger = getattr(self, '_debug_logger', None)
        if debug_logger:
            debug_logger.debug_method_call(func.__name__, *args, **kwargs)
        
        try:
            result = func(self, *args, **kwargs)
            if debug_logger:
                debug_logger.debug_method_result(func.__name__, result)
            return result
        except Exception as e:
            if debug_logger:
                debug_logger.debug_exception(func.__name__, e)
            raise
    return wrapper

def async_debug_decorator(func):
    """Decorator for debugging async method calls"""
    @wraps(func)
    async def wrapper(self, *args, **kwargs):
        debug_logger = getattr(self, '_debug_logger', None)
        if debug_logger:
            debug_logger.debug_method_call(func.__name__, *args, **kwargs)
        
        try:
            result = await func(self, *args, **kwargs)
            if debug_logger:
                debug_logger.debug_method_result(func.__name__, result)
            return result
        except Exception as e:
            if debug_logger:
                debug_logger.debug_exception(func.__name__, e)
            raise
    return wrapper

class SettingsManager:
    _instance = None
    _lock = threading.Lock()

    def __new__(cls):
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super().__new__(cls)
                    cls._instance._setup_pool()
        return cls._instance

    def _setup_pool(self):
        try:
            self._debug_logger = DebugLogger("SettingsManager")
            self._pool = sqlite3.connect(
                SETTINGS_DB,
                check_same_thread=False,
                timeout=30.0
            )
            with self._lock:
                self._pool.row_factory = sqlite3.Row
            
            # Inicjalizuj pamięć podręczną
            self._cache = {}
            self._debug_logger.logger.debug("Settings manager pool setup completed")
        except Exception as e:
            logger.error(f"Failed to setup settings manager pool: {e}")
            logger.debug(f"Settings manager setup error traceback: {traceback.format_exc()}")
            raise

    @debug_decorator
    def get_cached(self, key: str) -> Any:
        with self._lock:
            if key in self._cache:
                value, expires_at = self._cache[key]
                if expires_at > time.time():
                    self._debug_logger.logger.debug(f"Cache hit for key: {key}")
                    return value
                del self._cache[key]
                self._debug_logger.logger.debug(f"Cache expired for key: {key}")
        return None

    @debug_decorator
    def set_cached(self, key: str, value: Any, ttl: int = 300):
        with self._lock:
            self._cache[key] = (value, time.time() + ttl)
            self._debug_logger.logger.debug(f"Cached value for key: {key}, TTL: {ttl}")

    @debug_decorator
    def save_setting(self, key: str, value: Any):
        try:
            with self._lock:
                with self._pool:
                    self._pool.execute(
                        "INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)",
                        (key, json.dumps(value))
                    )
                self._debug_logger.logger.debug(f"Saved setting: {key}")
        except Exception as e:
            self._debug_logger.debug_exception("save_setting", e)
            raise

    @debug_decorator
    def load_setting(self, key: str, default: Any = None) -> Any:
        try:
            with self._lock:
                cursor = self._pool.execute(
                    "SELECT value FROM settings WHERE key = ?",
                    (key,)
                )
                result = cursor.fetchone()
                loaded_value = json.loads(result[0]) if result else default
                self._debug_logger.logger.debug(f"Loaded setting {key}: {type(loaded_value).__name__}")
                return loaded_value
        except Exception as e:
            self._debug_logger.debug_exception("load_setting", e)
            return default

    @debug_decorator
    def close(self):
        with self._lock:
            if hasattr(self, '_pool'):
                self._pool.close()
                self._debug_logger.logger.debug("Settings manager pool closed")

class SecurityManager:
    def __init__(self):
        self._debug_logger = DebugLogger("SecurityManager")
        self.rate_limits = {}
        self.max_requests = 100
        self.time_window = 3600
        self._lock = threading.Lock()

    @debug_decorator
    def check_rate_limit(self, key: str) -> bool:
        now = time.time()
        with self._lock:
            if key not in self.rate_limits:
                self.rate_limits[key] = []
            
            # Clean old entries
            old_count = len(self.rate_limits[key])
            self.rate_limits[key] = [t for t in self.rate_limits[key] if t > now - self.time_window]
            new_count = len(self.rate_limits[key])
            
            if old_count != new_count:
                self._debug_logger.logger.debug(f"Cleaned {old_count - new_count} old rate limit entries for {key}")
            
            if len(self.rate_limits[key]) >= self.max_requests:
                self._debug_logger.logger.warning(f"Rate limit exceeded for {key}")
                return False
            
            self.rate_limits[key].append(now)
            self._debug_logger.logger.debug(f"Rate limit check passed for {key}: {len(self.rate_limits[key])}/{self.max_requests}")
        return True

def rate_limited(func: Callable[..., Awaitable]):
    @wraps(func)
    async def wrapper(*args, **kwargs):
        security_manager = SecurityManager()
        if not security_manager.check_rate_limit(func.__name__):
            error_msg = f"Rate limit exceeded for {func.__name__}"
            logger.error(error_msg)
            raise Exception(error_msg)
        return await func(*args, **kwargs)
    return wrapper

@asynccontextmanager
async def browser_session(config: "AgentConfig"):
    logger.debug(f"Creating browser session with config: {config.agent_type}")
    runner = BrowserAgentRunner(config)
    try:
        yield runner
    except Exception as e:
        logger.error(f"Error in browser session: {e}")
        logger.debug(f"Browser session error traceback: {traceback.format_exc()}")
        raise
    finally:
        logger.debug("Cleaning up browser session")
        await runner.cleanup()

class BrowserAgentRunner:
    def __init__(self, config: "AgentConfig"):
        self._debug_logger = DebugLogger("BrowserAgentRunner")
        self.config = config
        self.playwright = None
        self.browser_context = None
        self.browser = None
        self.resource_manager = ResourceManager()
        self.security_manager = SecurityManager()
        self._start_time = time.time()
        self._debug_logger.logger.debug(f"BrowserAgentRunner initialized with config: {config}")

    @property
    def execution_time(self) -> float:
        return time.time() - self._start_time

    @async_debug_decorator
    async def run(self):
        try:
            self._debug_logger.logger.debug("Starting browser agent run")
            async with async_playwright() as p:
                self._debug_logger.logger.debug("Playwright context created")
                
                browser_args = []
                if self.config.disable_security:
                    browser_args.extend([
                        '--disable-web-security',
                        '--disable-features=VizDisplayCompositor'
                    ])
                
                self.browser = await p.chromium.launch(
                    headless=self.config.headless,
                    args=browser_args
                )
                self._debug_logger.logger.debug(f"Browser launched (headless: {self.config.headless})")
                
                self.browser_context = await self.browser.new_context(
                    viewport={'width': self.config.window_w, 'height': self.config.window_h}
                )
                self._debug_logger.logger.debug(f"Browser context created with viewport: {self.config.window_w}x{self.config.window_h}")
                
                page = await self.browser_context.new_page()
                self._debug_logger.logger.debug("New page created")
    
                # Enhanced task execution with debugging
                task_result = await self._execute_task(page)
                
                self._debug_logger.logger.debug(f"Task execution completed in {self.execution_time:.2f}s")
                return task_result
                
        except Exception as e:
            error_msg = f"Detailed error during run: {e}"
            self._debug_logger.debug_exception("run", e)
            return "", error_msg, "", ""
        finally:
            await self.cleanup()

    @async_debug_decorator
    async def _execute_task(self, page):
        """Execute the actual task with detailed debugging"""
        try:
            self._debug_logger.logger.debug(f"Executing task: {self.config.task[:100]}...")
            
            # Example task execution with debugging
            if "google.com" in self.config.task.lower():
                self._debug_logger.logger.debug("Detected Google task")
                await page.goto("https://google.com")
                self._debug_logger.logger.debug("Navigated to Google")
                
                # Wait for page load
                await page.wait_for_load_state('networkidle')
                self._debug_logger.logger.debug("Page loaded completely")
                
                # Take screenshot for debugging
                if self._debug_logger.debug_mode:
                    screenshot_path = TEMP_DIR / f"debug_screenshot_{int(time.time())}.png"
                    await page.screenshot(path=screenshot_path)
                    self._debug_logger.logger.debug(f"Debug screenshot saved: {screenshot_path}")
                
                return "Task completed successfully", "", "Navigated to Google", "Task executed with debugging"
            else:
                # Generic task execution
                await page.goto("https://example.com")
                self._debug_logger.logger.debug("Executed generic task")
                return "Generic task completed", "", "Navigated to example.com", "Generic task executed"
                
        except Exception as e:
            self._debug_logger.debug_exception("_execute_task", e)
            return "", str(e), "", ""

    @async_debug_decorator
    async def cleanup(self):
        self._debug_logger.logger.debug("Starting cleanup process")
        cleanup_errors = []
        
        try:
            if self.browser_context:
                await self.browser_context.close()
                self._debug_logger.logger.debug("Browser context closed successfully")
                self.browser_context = None
        except Exception as e:
            error_msg = f"Error closing browser context: {e}"
            cleanup_errors.append(error_msg)
            self._debug_logger.logger.error(error_msg)

        try:
            if self.browser:
                await self.browser.close()
                self._debug_logger.logger.debug("Browser closed successfully")
                self.browser = None
        except Exception as e:
            error_msg = f"Error closing browser: {e}"
            cleanup_errors.append(error_msg)
            self._debug_logger.logger.error(error_msg)

        try:
            await self.resource_manager.cleanup()
            self._debug_logger.logger.debug("Resource manager cleanup completed")
        except Exception as e:
            error_msg = f"Error in resource manager cleanup: {e}"
            cleanup_errors.append(error_msg)
            self._debug_logger.logger.error(error_msg)
        
        if cleanup_errors:
            self._debug_logger.logger.warning(f"Cleanup completed with {len(cleanup_errors)} errors")
        else:
            self._debug_logger.logger.debug("Cleanup completed successfully")

class ProcessManager:
    def __init__(self):
        self._debug_logger = DebugLogger("ProcessManager")
        self.processes = []
        self._lock = threading.Lock()
        self.current_task = None

    @async_debug_decorator
    async def start_task(self, task):
        with self._lock:
            self._debug_logger.logger.debug(f"Starting task: {type(task).__name__}")
            self.current_task = task
            # Enhanced task management logic here

    @async_debug_decorator
    async def stop_task(self):
        with self._lock:
            if self.current_task:
                self._debug_logger.logger.debug("Stopping current task")
                self.current_task = None
                return "Task stopped successfully", ""
            else:
                self._debug_logger.logger.debug("No active task to stop")
                return "No active task", ""

    @debug_decorator
    def cleanup(self):
        with self._lock:
            self._debug_logger.logger.debug(f"Cleaning up {len(self.processes)} processes")
            self.processes.clear()
            self.current_task = None

