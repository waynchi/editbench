def find_words_by_length(n):
    """
    Find words with exactly N characters from the dictionary
    
    Args:
        n (int): Number of characters in the word
    
    Returns:
        list: List of words with N characters
    """
    if n in english_dictionary:
        words = english_dictionary[n]
        # If there are more than 10 words, randomly select 10
        if len(words) >= 10:
            return random.sample(words, 10)
        else:
            return words
    else:
        return []

def main():
    """
    Main function to run the English dictionary lookup program
    """
    print("欢迎使用英语词典查找程序！")
    print("Welcome to the English Dictionary Lookup Program!")
    print("-" * 50)
    
    while True:
        try:
            # Get user input
            user_input = input("\n请输入您想要查找的单词字符数 (输入 'quit' 退出): ")
            
            # Check if user wants to quit
            if user_input.lower() in ['quit', 'exit', 'q']:
                print("谢谢使用！再见！")
                break
            
            # Convert input to integer
            n = int(user_input)
            
            # Validate input
            if n <= 0:
                print("请输入一个正整数！")
                continue
            
            # Find words with N characters
            words = find_words_by_length(n)
            
            # Display results
            if words:
                print(f"\n找到 {len(words)} 个包含 {n} 个字符的单词：")
                print("-" * 30)
                for i, word in enumerate(words, 1):
                    print(f"{i:2d}. {word}")
            else:
                print(f"抱歉，没有找到包含 {n} 个字符的单词。")
                print("请尝试输入 1-10 之间的数字。")
        
        except ValueError:
            print("请输入一个有效的数字！")
        except KeyboardInterrupt:
            print("\n\n程序被用户中断。再见！")
            break
        except Exception as e:
            print(f"发生错误：{e}")

if __name__ == "__main__":
    main()