def init_database():
    """Initialize the settings database if it doesn't exist."""
    try:
        with sqlite3.connect(SETTINGS_DB) as conn:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS settings (
                    key TEXT PRIMARY KEY,
                    value TEXT NOT NULL
                )
            """)
            conn.commit()
        logger.debug("Database initialized successfully")
    except Exception as e:
        logger.error(f"Failed to initialize database: {e}")
        raise

class SettingsManager:
    _instance = None
    _lock = threading.Lock()

    def __new__(cls):
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super().__new__(cls)
                    cls._instance._setup_pool()
        return cls._instance

    def _setup_pool(self):
        try:
            self._pool = sqlite3.connect(
                SETTINGS_DB,
                check_same_thread=False,
                timeout=30.0
            )
            with self._lock:
                self._pool.row_factory = sqlite3.Row
            
            # Инициализировать кэш
            self._cache = {}
            logger.debug("Settings manager pool setup completed")
        except Exception as e:
            logger.error(f"Failed to setup settings manager pool: {e}")
            raise

    def get_cached(self, key: str) -> Any:
        try:
            with self._lock:
                if key in self._cache:
                    value, expires_at = self._cache[key]
                    if expires_at > time.time():
                        logger.debug(f"Cache hit for key: {key}")
                        return value
                    del self._cache[key]
                    logger.debug(f"Cache expired for key: {key}")
            return None
        except Exception as e:
            logger.error(f"Error getting cached value for {key}: {e}")
            return None

    def set_cached(self, key: str, value: Any, ttl: int = 300):
        try:
            with self._lock:
                self._cache[key] = (value, time.time() + ttl)
            logger.debug(f"Cached value set for key: {key}")
        except Exception as e:
            logger.error(f"Error setting cached value for {key}: {e}")

    def save_setting(self, key: str, value: Any):
        try:
            with self._lock:
                with self._pool:
                    self._pool.execute(
                        "INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)",
                        (key, json.dumps(value))
                    )
            logger.debug(f"Setting saved: {key}")
        except Exception as e:
            logger.error(f"Error saving setting {key}: {e}")
            raise

    def load_setting(self, key: str, default: Any = None) -> Any:
        try:
            with self._lock:
                cursor = self._pool.execute(
                    "SELECT value FROM settings WHERE key = ?",
                    (key,)
                )
                result = cursor.fetchone()
                value = json.loads(result[0]) if result else default
                logger.debug(f"Setting loaded: {key} = {value}")
                return value
        except Exception as e:
            logger.error(f"Error loading setting {key}: {e}")
            return default

    def close(self):
        try:
            with self._lock:
                if hasattr(self, '_pool'):
                    self._pool.close()
            logger.debug("Settings manager closed")
        except Exception as e:
            logger.error(f"Error closing settings manager: {e}")

class SecurityManager:
    def __init__(self):
        self.rate_limits = {}
        self.max_requests = 100
        self.time_window = 3600
        self._lock = threading.Lock()
        logger.debug("Security manager initialized")

    def check_rate_limit(self, key: str) -> bool:
        try:
            now = time.time()
            with self._lock:
                if key not in self.rate_limits:
                    self.rate_limits[key] = []
                self.rate_limits[key] = [t for t in self.rate_limits[key] if t > now - self.time_window]
                if len(self.rate_limits[key]) >= self.max_requests:
                    logger.warning(f"Rate limit exceeded for {key}")
                    return False
                self.rate_limits[key].append(now)
            logger.debug(f"Rate limit check passed for {key}")
            return True
        except Exception as e:
            logger.error(f"Error checking rate limit for {key}: {e}")
            return False

def rate_limited(func: Callable[..., Awaitable]):
    @wraps(func)
    async def wrapper(*args, **kwargs):
        try:
            if not SecurityManager().check_rate_limit(func.__name__):
                raise Exception("Rate limit exceeded")
            logger.debug(f"Executing rate-limited function: {func.__name__}")
            return await func(*args, **kwargs)
        except Exception as e:
            logger.error(f"Error in rate-limited function {func.__name__}: {e}")
            raise
    return wrapper

@asynccontextmanager
async def browser_session(config: "AgentConfig"):
    runner = None
    try:
        logger.debug("Creating browser session")
        runner = BrowserAgentRunner(config)
        yield runner
    except Exception as e:
        logger.error(f"Error in browser session: {e}")
        raise
    finally:
        if runner:
            await runner.cleanup()
        logger.debug("Browser session closed")

class BrowserAgentRunner:
    def __init__(self, config: "AgentConfig"):
        self.config = config
        self.playwright = None
        self.browser_context = None
        self.browser = None
        self.resource_manager = ResourceManager()
        self.security_manager = SecurityManager()
        self._start_time = time.time()
        logger.debug(f"BrowserAgentRunner initialized with config: {config}")

    @property
    def execution_time(self) -> float:
        return time.time() - self._start_time

    async def run(self):
        try:
            logger.info("Starting browser agent run")
            async with async_playwright() as p:
                logger.debug("Launching browser")
                self.browser = await p.chromium.launch(headless=self.config.headless)
                
                logger.debug("Creating browser context")
                self.browser_context = await self.browser.new_context(
                    viewport={'width': self.config.window_w, 'height': self.config.window_h}
                )
                
                logger.debug("Creating new page")
                page = await self.browser_context.new_page()
    
                # Пример задачи: перейти по указанному URL-адресу
                logger.info("Navigating to example.com")
                await page.goto("https://example.com")
                
                # Выполните дополнительные действия здесь в зависимости от задачи
                logger.info("Task completed successfully")
                return "Task completed successfully", "", "", ""
                
        except Exception as e:
            logger.error(f"Detailed error during run: {e}")
            return "", str(e), "", ""
        finally:
            await self.cleanup()

    async def cleanup(self):
        logger.debug("Cleaning up browser session.")
        try:
            if self.browser_context:
                await self.browser_context.close()
                logger.debug("Browser context closed successfully.")
                self.browser_context = None

            if self.browser:
                await self.browser.close()
                logger.debug("Browser closed successfully.")
                self.browser = None

            await self.resource_manager.cleanup()
            logger.debug("Resource manager cleanup completed")
        except Exception as e:
            logger.error(f"Error during cleanup: {e}")

class ProcessManager:
    def __init__(self):
        self.processes = []
        self._lock = threading.Lock()
        logger.debug("Process manager initialized")

    async def start_task(self, task):
        try:
            with self._lock:
                # Логика для запуска задачи
                logger.debug(f"Starting task: {task}")
                pass
        except Exception as e:
            logger.error(f"Error starting task: {e}")
            raise

    async def stop_task(self):
        try:
            with self._lock:
                # Логика остановки задач
                logger.debug("Stopping tasks")
                return "", ""
        except Exception as e:
            logger.error(f"Error stopping task: {e}")
            return str(e), str(e)

    def cleanup(self):
        try:
            with self._lock:
                # Логика очистки после выполнения задач
                logger.debug("Process manager cleanup")
                pass
        except Exception as e:
            logger.error(f"Error in process manager cleanup: {e}")

class GradioInterface:
