def consultar_diccionario():
    """
    Programa que consulta el diccionario en inglés y permite al usuario
    pedir palabras con N caracteres. Imprime 10 palabras con ese número de caracteres.
    """
    print("¡Bienvenido al Consultor de Diccionario en Inglés!")
    print("=" * 50)
    
    while True:
        try:
            # Solicitar al usuario el número de caracteres
            print("\nOpciones disponibles:")
            print("- Ingresa un número del 1 al 10 para buscar palabras con esa cantidad de caracteres")
            print("- Ingresa 0 para salir del programa")
            
            n_caracteres = int(input("\n¿Cuántos caracteres deben tener las palabras? "))
            
            # Opción para salir
            if n_caracteres == 0:
                print("¡Gracias por usar el Consultor de Diccionario! ¡Hasta luego!")
                break
            
            # Verificar si el número está en el rango válido
            if n_caracteres < 1 or n_caracteres > 10:
                print("❌ Por favor, ingresa un número entre 1 y 10.")
                continue
            
            # Verificar si hay palabras disponibles para esa longitud
            if n_caracteres not in english_dictionary:
                print(f"❌ No hay palabras disponibles con {n_caracteres} caracteres.")
                continue
            
            palabras_disponibles = english_dictionary[n_caracteres]
            
            # Seleccionar hasta 10 palabras (o todas si hay menos de 10)
            num_palabras_mostrar = min(10, len(palabras_disponibles))
            palabras_seleccionadas = random.sample(palabras_disponibles, num_palabras_mostrar)
            
            # Mostrar los resultados
            print(f"\n✅ Aquí tienes {num_palabras_mostrar} palabras con {n_caracteres} caracteres:")
            print("-" * 40)
            
            for i, palabra in enumerate(palabras_seleccionadas, 1):
                print(f"{i:2d}. {palabra}")
            
            print(f"\nTotal de palabras disponibles con {n_caracteres} caracteres: {len(palabras_disponibles)}")
            
        except ValueError:
            print("❌ Por favor, ingresa un número válido.")
        except KeyboardInterrupt:
            print("\n\n¡Programa interrumpido por el usuario! ¡Hasta luego!")
            break
        except Exception as e:
            print(f"❌ Ha ocurrido un error inesperado: {e}")

# Ejecutar el programa
if __name__ == "__main__":
    consultar_diccionario()