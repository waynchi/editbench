"""
Main entry point for the Audio Recorder and Transcriber application.
"""

import os
import sys
import logging
import tkinter as tk
import tkinterdnd2
from tkinter import messagebox
import traceback

def setup_logging():
    """
    Set up logging configuration for the application.
    """
    try:
        log_format = '%(asctime)s - %(levelname)s - %(message)s'
        logging.basicConfig(
            level=logging.INFO,
            format=log_format,
            handlers=[
                logging.StreamHandler(),
                logging.FileHandler('app.log', encoding='utf-8')
            ]
        )
        logging.info("Logging setup completed successfully")
    except Exception as e:
        print(f"Failed to setup logging: {e}")
        # 如果日志设置失败，至少设置基本的控制台输出
        logging.basicConfig(level=logging.INFO, format='%(levelname)s - %(message)s')

def get_resource_path():
    """
    Get the resource path that works for both development and PyInstaller.

    Returns:
        str: Path to resources directory
    """
    try:
        if getattr(sys, 'frozen', False):
            # 作为编译后的可执行文件运行
            resource_path = os.path.join(os.path.dirname(sys.executable), 'resources')
        else:
            # 作为脚本运行
            resource_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'resources')
        
        logging.info(f"Resource path determined: {resource_path}")
        return resource_path
    except Exception as e:
        logging.error(f"Error determining resource path: {e}")
        # 返回默认路径作为后备
        return os.path.join(os.getcwd(), 'resources')

def check_resources():
    """
    Check if required resource files exist.

    Returns:
        bool: True if all required resources are present
    """
    try:
        required_files = ['sound.mp3', 'done.mp3', 'cancel.wav', 'help_text.txt']
        resource_dir = get_resource_path()
        
        # 检查资源目录是否存在
        if not os.path.exists(resource_dir):
            logging.error(f"Resource directory does not exist: {resource_dir}")
            return False
        
        # 检查每个所需文件是否存在
        missing_files = []
        for file in required_files:
            file_path = os.path.join(resource_dir, file)
            if not os.path.exists(file_path):
                missing_files.append(file)
            else:
                logging.debug(f"Found resource file: {file_path}")
        
        # 如果有任何必需的文件丢失，则返回 False
        if missing_files:
            logging.error(f"Missing resource files: {', '.join(missing_files)}")
            return False
        
        logging.info("All required resource files found")
        return True
        
    except Exception as e:
        logging.error(f"Error checking resources: {e}")
        logging.error(f"Traceback: {traceback.format_exc()}")
        return False

def show_error_dialog(title, message):
    """
    Show error dialog to user.
    
    Args:
        title (str): Dialog title
        message (str): Error message
    """
    try:
        # 创建一个临时的根窗口来显示错误对话框
        temp_root = tk.Tk()
        temp_root.withdraw()  # 隐藏主窗口
        messagebox.showerror(title, message)
        temp_root.destroy()
    except Exception as e:
        # 如果GUI错误对话框失败，至少打印到控制台
        print(f"Error Dialog Failed: {e}")
        print(f"Original Error - {title}: {message}")

def handle_critical_error(error_msg, exception=None):
    """
    Handle critical errors that prevent application startup.
    
    Args:
        error_msg (str): Error message to display
        exception (Exception, optional): The exception that occurred
    """
    try:
        logging.critical(f"Critical error: {error_msg}")
        if exception:
            logging.critical(f"Exception details: {exception}")
            logging.critical(f"Traceback: {traceback.format_exc()}")
        
        # 显示错误对话框给用户
        show_error_dialog("Critical Error", f"{error_msg}\n\nPlease check the log file for more details.")
        
    except Exception as e:
        print(f"Failed to handle critical error: {e}")
        print(f"Original critical error: {error_msg}")
    finally:
        sys.exit(1)

def main():
    """
    Main function to start the application.
    """
    try:
        # 设置日志记录
        setup_logging()
        logging.info("Starting Audio Recorder and Transcriber application")

        # 检查资源
        try:
            if not check_resources():
                handle_critical_error("Required resource files are missing. Application cannot start.")
        except Exception as e:
            handle_critical_error("Failed to check required resources", e)

        # 初始化支持拖放的主窗口
        try:
            root = tkinterdnd2.TkinterDnD.Tk()
            logging.info("Main window initialized successfully")
        except Exception as e:
            handle_critical_error("Failed to initialize main window", e)
        
        # 在这里导入以避免循环导入
        try:
            from gui.main_window import AudioTranscriberApp
            logging.info("GUI module imported successfully")
        except ImportError as e:
            handle_critical_error("Failed to import GUI module. Please check if all dependencies are installed", e)
        except Exception as e:
            handle_critical_error("Unexpected error while importing GUI module", e)
        
        # 创建应用程序实例
        try:
            app = AudioTranscriberApp(root)
            logging.info("Application instance created successfully")
        except Exception as e:
            logging.error(f"Failed to create application instance: {e}")
            logging.error(f"Traceback: {traceback.format_exc()}")
            try:
                root.destroy()
            except:
                pass
            handle_critical_error("Failed to create application instance", e)
        
        # 启动主事件循环
        try:
            logging.info("Starting main event loop")
            root.mainloop()
            logging.info("Application closed normally")
        except KeyboardInterrupt:
            logging.info("Application interrupted by user")
        except Exception as e:
            logging.error(f"Error in main event loop: {e}")
            logging.error(f"Traceback: {traceback.format_exc()}")
            show_error_dialog("Application Error", f"An unexpected error occurred: {e}")
        finally:
            try:
                if 'root' in locals():
                    root.quit()
                    root.destroy()
            except Exception as e:
                logging.error(f"Error during cleanup: {e}")
        
    except Exception as e:
        # 捕获任何未处理的异常
        error_msg = f"Unexpected application error: {e}"
        try:
            logging.critical(error_msg)
            logging.critical(f"Traceback: {traceback.format_exc()}")
        except:
            print(error_msg)
            print(f"Traceback: {traceback.format_exc()}")
        
        handle_critical_error("An unexpected error occurred during application startup", e)

if __name__ == "__main__":
    main()