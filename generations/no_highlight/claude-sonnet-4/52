from main13 import knn, mlp
import pandas as pd
import numpy as np

# Create a reference DataFrame with all possible Embarked columns
reference_embarked = pd.get_dummies(pd.DataFrame({"Embarked": ["S", "Q", "C"]}), columns=["Embarked"], prefix="Embarked")

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in ["S", "Q", "C"]:
            # Create base DataFrame
            my_df = pd.DataFrame({
                "Pclass": [pclass],
                "Name": [24],
                "Sex": [0],
                "Age": [19],
                "SibSp": [0],
                "Parch": [0],
                "Fare": [fare],
                "Embarked": [embarked]
            })
            
            # Apply one-hot encoding
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
            
            # Ensure all Embarked columns exist (add missing ones with 0 values)
            for col in reference_embarked.columns:
                if col not in my_df.columns:
                    my_df[col] = 0
            
            # Convert boolean values to integers
            embarked_cols = [col for col in my_df.columns if col.startswith("Embarked_")]
            for col in embarked_cols:
                my_df[col] = my_df[col].astype(int)
            
            # Ensure column order consistency
            non_embarked_cols = [col for col in my_df.columns if not col.startswith("Embarked_")]
            embarked_cols_sorted = sorted([col for col in my_df.columns if col.startswith("Embarked_")])
            my_df = my_df[non_embarked_cols + embarked_cols_sorted]
            
            try:
                knn_prediction = knn.predict(my_df)[0]
                mlp_prediction = mlp.predict(my_df)[0]
                
                print(f"""-------------------------------------------------------
Параметры: класс {pclass}, плата {fare}, embarked {embarked}
По knn: {knn_prediction}
По mlp: {mlp_prediction}""")
            except Exception as e:
                print(f"""-------------------------------------------------------
Параметры: класс {pclass}, плата {fare}, embarked {embarked}
Ошибка при предсказании: {e}""")