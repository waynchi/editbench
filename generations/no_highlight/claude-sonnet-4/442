# generar un módulo de medio sumador de verilog con python

# código verilog
verilog_code = """
module half_adder(a, b, c_in, enable, reset, c, sum, carry);
    input a, b, c_in, enable, reset;
    output c, sum, carry;
    assign c = enable ? (reset ? 1'b0 : (a ^ b ^ c_in)) : 1'b0;
    assign sum = enable ? (reset ? 1'b0 : ((a & b) | (a & c_in) | (b & c_in))) : 1'b0;
    assign carry = enable ? (reset ? 1'b0 : ((a & b) | (a & c_in) | (b & c_in))) : 1'b0;
endmodule
"""

