from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt

def cluster_data(features_transformed, clustering_config, n_clusters=2, clustering_method='kmeans'):
    """
    Выполняет кластеризацию данных независимо для указанных наборов столбцов.

    Args:
        features_transformed (pandas.DataFrame): Преобразованный DataFrame с параметрами.
        clustering_config (dict): Словарь вида {cluster_feature_name: (column1, column2, ...)}, 
                                 где ключи - имена новых столбцов для меток кластеров,
                                 значения - кортежи с именами столбцов для кластеризации.
        n_clusters (int or dict): Количество кластеров. Может быть числом (для всех кластеризаций)
                                 или словарем вида {cluster_feature_name: n_clusters}.
        clustering_method (str): Метод кластеризации ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame с добавленными столбцами меток кластеров.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_result = features_transformed.copy()

    for cluster_feature_name, columns in clustering_config.items():
        print(f"\nВыполнение кластеризации для столбцов {columns} -> '{cluster_feature_name}'")
        
        # Проверяем наличие столбцов в DataFrame
        missing_columns = [col for col in columns if col not in features_result.columns]
        if missing_columns:
            print(f"Ошибка: столбцы {missing_columns} не найдены в DataFrame.")
            continue
            
        # Получаем данные для кластеризации
        features_for_clustering = features_result[list(columns)].copy()
        
        # Определяем количество кластеров для текущей кластеризации
        if isinstance(n_clusters, dict):
            current_n_clusters = n_clusters.get(cluster_feature_name, 2)
        else:
            current_n_clusters = n_clusters
            
        print(f"Количество кластеров: {current_n_clusters}")
        print(f"Размер данных для кластеризации: {features_for_clustering.shape}")

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=current_n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_for_clustering)
            
            # Оценка качества кластеризации (например, с помощью коэффициента силуэта)
            if len(np.unique(cluster_labels)) > 1: # Проверка на случай, когда все точки отнесены к одному кластеру
                silhouette_avg = silhouette_score(features_for_clustering, cluster_labels)
                print(f"Коэффициент силуэта для {current_n_clusters} кластеров: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {current_n_clusters} кластера (все точки в одном кластере).")

        else:
            print("Неподдерживаемый метод кластеризации.")
            continue

        features_result[cluster_feature_name] = cluster_labels
        print(f"Кластеризация выполнена. Метки кластеров добавлены в столбец '{cluster_feature_name}'.")
        
        # Распределение по кластерам
        unique, counts = np.unique(cluster_labels, return_counts=True)
        print(f"Распределение по кластерам: {dict(zip(unique, counts))}")

    return features_result

def visualize_clusters(features_transformed, clustering_config):
    """
    Визуализация результатов кластеризации.
    
    Args:
        features_transformed (pandas.DataFrame): DataFrame с результатами кластеризации.
        clustering_config (dict): Конфигурация кластеризации.
    """
    for cluster_feature_name, columns in clustering_config.items():
        if cluster_feature_name not in features_transformed.columns:
            continue
            
        print(f"\nВизуализация кластеров для '{cluster_feature_name}'")
        
        # Получаем числовые признаки из указанных столбцов
        numerical_features = features_transformed[list(columns)].select_dtypes(include=np.number)
        
        if numerical_features.shape[1] >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], 
                       c=features_transformed[cluster_feature_name], cmap='viridis', alpha=0.7)
            plt.xlabel(numerical_features.columns[0])
            plt.ylabel(numerical_features.columns[1])
            plt.title(f'Результаты кластеризации: {cluster_feature_name}')
            plt.colorbar(label='Номер кластера')
            plt.show()
        elif numerical_features.shape[1] == 1:
            plt.figure(figsize=(8, 6))
            plt.hist([numerical_features.iloc[:, 0][features_transformed[cluster_feature_name] == i] 
                     for i in sorted(features_transformed[cluster_feature_name].unique())], 
                    bins=20, alpha=0.7, label=[f'Кластер {i}' for i in sorted(features_transformed[cluster_feature_name].unique())])
            plt.xlabel(numerical_features.columns[0])
            plt.ylabel('Частота')
            plt.title(f'Распределение по кластерам: {cluster_feature_name}')
            plt.legend()
            plt.show()
        else:
            print("Недостаточно числовых признаков для визуализации кластеров.")

# Выполнение кластеризации (после этапа 5 и до этапа 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Конфигурация кластеризации - словарь вида {имя_кластера: (столбцы_для_кластеризации)}
    clustering_config = {
        'cluster_main': ('feature1', 'feature2'),  # Замените на реальные имена столбцов
        'cluster_secondary': ('feature3',),        # Замените на реальные имена столбцов
        # 'cluster_third': ('feature4', 'feature5', 'feature6'),  # Пример для большего количества признаков
    }
    
    # Количество кластеров для каждой кластеризации
    n_clusters_config = {
        'cluster_main': 3,
        'cluster_secondary': 2,
        # 'cluster_third': 4,
    }
    
    # Альтернативно можно задать одинаковое количество кластеров для всех:
    # n_clusters_config = 3
    
    features_transformed = cluster_data(features_transformed, clustering_config, n_clusters_config)
    
    # Визуализация результатов
    if features_transformed is not None:
        visualize_clusters(features_transformed, clustering_config)
        
        # Вывод информации о созданных кластерах
        print("\nСозданные столбцы с кластерами:")
        for cluster_name in clustering_config.keys():
            if cluster_name in features_transformed.columns:
                print(f"- {cluster_name}: {features_transformed[cluster_name].nunique()} уникальных кластеров")

else:
    print("Сначала выполните этап 5 (Преобразование данных).")