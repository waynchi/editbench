import os
import hashlib
import base64

project_name = "CheckerKMV"


def createLicense(secretKey: str) -> None:
    # Ruta a la carpeta del proyecto en %appdata%/Local
    appdata_path = os.path.join(os.environ["LOCALAPPDATA"], project_name)

    if not os.path.exists(appdata_path):
        os.makedirs(appdata_path)

    # Encriptar la clave secreta usando hash SHA256 y codificar en base64
    hashed_key = hashlib.sha256(secretKey.encode('utf-8')).digest()
    encoded_key = base64.b64encode(hashed_key)

    with open(os.path.join(appdata_path, "license.dat"), "wb") as f:
        f.write(encoded_key)


def verifyLicense(secretKey: str) -> bool:
    # Ruta a la carpeta del proyecto en %appdata%/Local
    appdata_path = os.path.join(os.environ["LOCALAPPDATA"], project_name)
    license_path = os.path.join(appdata_path, "license.dat")
    
    if not os.path.exists(license_path):
        return False
    
    try:
        with open(license_path, "rb") as f:
            stored_key = f.read()
        
        # Generar hash de la clave proporcionada
        hashed_key = hashlib.sha256(secretKey.encode('utf-8')).digest()
        encoded_key = base64.b64encode(hashed_key)
        
        return stored_key == encoded_key
    except:
        return False


def deleteLicense() -> bool:
    # Ruta a la carpeta del proyecto en %appdata%/Local
    appdata_path = os.path.join(os.environ["LOCALAPPDATA"], project_name)
    license_path = os.path.join(appdata_path, "license.dat")
    
    try:
        if os.path.exists(license_path):
            os.remove(license_path)
            return True
        return False
    except:
        return False