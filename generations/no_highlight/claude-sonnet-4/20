import numpy as np
from pathlib import Path
from typing import List, Tuple

# Use a single input file path - comment/uncomment as needed
INPUT_FILE_PATH = './input.txt'
# INPUT_FILE_PATH = './example_in.txt'

def parse_input_file(file_path: str) -> List[str]:
    """
    Parse the input file and return non-empty lines.
    
    Args:
        file_path: Path to the input file
        
    Returns:
        List of non-empty lines from the file
        
    Raises:
        FileNotFoundError: If the input file doesn't exist
        IOError: If there's an error reading the file
    """
    path = Path(file_path)
    if not path.exists():
        raise FileNotFoundError(f"Input file not found: {file_path}")
    
    try:
        with open(path, 'r', encoding='utf-8') as f:
            lines = [line.strip() for line in f if line.strip()]
        return lines
    except IOError as e:
        raise IOError(f"Error reading file {file_path}: {e}")

def parse_columns(lines: List[str]) -> Tuple[np.ndarray, np.ndarray]:
    """
    Parse lines into two columns of integers.
    
    Args:
        lines: List of strings, each containing two integers separated by spaces
        
    Returns:
        Tuple of two numpy arrays representing the two columns
        
    Raises:
        ValueError: If parsing fails or data format is invalid
    """
    if not lines:
        raise ValueError("No data to parse")
    
    try:
        # Split each line and convert to integers
        cols = []
        for line in lines:
            parts = line.split()
            if len(parts) != 2:
                raise ValueError(f"Expected 2 columns, got {len(parts)} in line: {line}")
            cols.append([int(parts[0]), int(parts[1])])
        
        # Convert to numpy array and transpose
        cols_array = np.array(cols).T
        return cols_array[0], cols_array[1]
    
    except (ValueError, IndexError) as e:
        raise ValueError(f"Error parsing columns: {e}")

def calculate_total_distance(col1: np.ndarray, col2: np.ndarray) -> int:
    """
    Calculate the total distance by pairing smallest elements from each column.
    
    This is more efficient than the original implementation as it sorts once
    instead of finding minimum elements repeatedly.
    
    Args:
        col1: First column of integers
        col2: Second column of integers
        
    Returns:
        Sum of absolute differences between paired elements
    """
    if len(col1) != len(col2):
        raise ValueError("Columns must have the same length")
    
    # Sort both arrays once (more efficient than repeated argmin operations)
    sorted_col1 = np.sort(col1)
    sorted_col2 = np.sort(col2)
    
    # Calculate distances and sum them
    distances = np.abs(sorted_col1 - sorted_col2)
    return np.sum(distances)

def main():
    """Main function to execute the distance calculation."""
    try:
        # Parse input file
        lines = parse_input_file(INPUT_FILE_PATH)
        print(f"Parsed {len(lines)} lines from input file")
        
        # Parse columns
        col1, col2 = parse_columns(lines)
        print(f"Parsed two columns with {len(col1)} elements each")
        
        # Calculate total distance
        total_distance = calculate_total_distance(col1, col2)
        print(f"Total distance: {total_distance}")
        
    except (FileNotFoundError, IOError, ValueError) as e:
        print(f"Error: {e}")
        return 1
    
    return 0

if __name__ == "__main__":
    exit(main())