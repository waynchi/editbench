function createTurnState(allyStates, foeStates) {
  // 根据哪个组仍然有可以行动的单位来确定当前回合
  let currentTurn = "player";
  let turnNumber = 1;

  function hasUnitsCanAct(units) {
    return units.some(unit => !unit.hasActed && unit.isAlive !== false);
  }

  function determineCurrentTurn() {
    const allyCanAct = hasUnitsCanAct(allyStates);
    const foeCanAct = hasUnitsCanAct(foeStates);

    if (allyCanAct && !foeCanAct) {
      currentTurn = "player";
    } else if (!allyCanAct && foeCanAct) {
      currentTurn = "cpu";
    } else if (!allyCanAct && !foeCanAct) {
      // 如果两组都没有可行动的单位，开始新回合
      startNewTurn();
    }
    // 如果两组都有可行动单位，保持当前回合不变
  }

  function startNewTurn() {
    turnNumber++;
    // 重置所有单位的行动状态
    allyStates.forEach(unit => unit.hasActed = false);
    foeStates.forEach(unit => unit.hasActed = false);
    
    // 确定新回合的开始方（默认玩家先手）
    currentTurn = "player";
  }

  function getCurrentTurn() {
    determineCurrentTurn();
    return currentTurn;
  }

  function getTurnNumber() {
    return turnNumber;
  }

  function nextTurn() {
    if (currentTurn === "player") {
      // 检查是否还有盟友可以行动
      if (!hasUnitsCanAct(allyStates)) {
        currentTurn = "cpu";
        if (hasUnitsCanAct(foeStates)) {
          cpuTurn();
        } else {
          // 敌方也没有可行动单位，开始新回合
          startNewTurn();
        }
      }
    } else {
      // 检查是否还有敌方可以行动
      if (!hasUnitsCanAct(foeStates)) {
        currentTurn = "player";
        if (!hasUnitsCanAct(allyStates)) {
          // 盟友也没有可行动单位，开始新回合
          startNewTurn();
        }
      }
    }
  }

  function cpuTurn() {
    // 示例 CPU 行为（用您实际的 AI 逻辑替换）
    for (const cpuUnit of foeStates) {
      if (!cpuUnit.hasActed && cpuUnit.isAlive !== false) {
        // 执行CPU动作（例如，移动，攻击）
        // ...在这里编写你的CPU AI逻辑...

        cpuUnit.hasActed = true; // 将该单位标记为已行动
      }
    }

    // 检查CPU回合是否结束
    nextTurn();
  }

  // 初始化时确定当前回合
  determineCurrentTurn();

  return {
    getCurrentTurn,
    getTurnNumber,
    nextTurn
  };
}

export { createTurnState };