def is_prime(n):
    """
    Проверяет, является ли число простым.
    
    Args:
        n (int): Число для проверки
        
    Returns:
        bool: True если число простое, False в противном случае
    """
    if n < 2:
        return False
    
    if n == 2:
        return True
    
    if n % 2 == 0:
        return False
    
    # Проверяем делители только до квадратного корня из n
    for i in range(3, int(n**0.5) + 1, 2):
        if n % i == 0:
            return False
    
    return True