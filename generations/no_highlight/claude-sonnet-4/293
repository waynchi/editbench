# Определить функцию для нахождения линии наилучшего соответствия для массива def fit_line(x, y):
import numpy as np

def fit_line(x, y):
    """Функция для нахождения линии наилучшего соответствия для массива"""
    # Вычислить среднее значение x и y
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # Вычисление отклонения x и y
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # Вычисление произведения отклонений x и y
    xy_dev = x_dev * y_dev
    
    # Вычислить квадрат отклонения x
    x_dev_squared = x_dev ** 2
    
    # Вычисление наклона и пересечения прямой
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean
    
    # Вычисление предсказанных значений y
    y_pred = slope * x + intercept
    
    # Вычисление отклонений от линии
    deviations = np.abs(y - y_pred)
    
    # Поиск максимального отклонения
    max_deviation = np.max(deviations)
    max_deviation_index = np.argmax(deviations)
    
    # Вычисление среднеквадратичного отклонения
    rmse = np.sqrt(np.mean((y - y_pred)**2))
    
    # Вычисление коэффициента детерминации R²
    ss_res = np.sum((y - y_pred)**2)
    ss_tot = np.sum((y - y_mean)**2)
    r_squared = 1 - (ss_res / ss_tot)
    
    return slope, intercept, max_deviation, max_deviation_index, rmse, r_squared

# Определить функцию для нахождения квадратичной аппроксимации массива xy
def fit_quadratic(x, y):
    """Функция для нахождения квадратичной аппроксимации массива"""
    # Создать матрицу Вандермонда
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # Использовать метод наименьших квадратов для нахождения коэффициентов
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    # Вычисление предсказанных значений y
    y_pred = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    
    # Вычисление отклонений от квадратичной кривой
    deviations = np.abs(y - y_pred)
    
    # Поиск максимального отклонения
    max_deviation = np.max(deviations)
    max_deviation_index = np.argmax(deviations)
    
    # Вычисление среднеквадратичного отклонения
    rmse = np.sqrt(np.mean((y - y_pred)**2))
    
    # Вычисление коэффициента детерминации R²
    y_mean = np.mean(y)
    ss_res = np.sum((y - y_pred)**2)
    ss_tot = np.sum((y - y_mean)**2)
    r_squared = 1 - (ss_res / ss_tot)
    
    return coeffs, max_deviation, max_deviation_index, rmse, r_squared

def find_outliers(x, y, method='linear', threshold_factor=2.0):
    """Функция для поиска выбросов на основе отклонений от аппроксимации"""
    if method == 'linear':
        slope, intercept, max_dev, max_idx, rmse, r2 = fit_line(x, y)
        y_pred = slope * x + intercept
    elif method == 'quadratic':
        coeffs, max_dev, max_idx, rmse, r2 = fit_quadratic(x, y)
        y_pred = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    
    # Вычисление отклонений
    deviations = np.abs(y - y_pred)
    
    # Определение порога для выбросов
    threshold = threshold_factor * np.std(deviations)
    
    # Поиск индексов выбросов
    outlier_indices = np.where(deviations > threshold)[0]
    
    return outlier_indices, deviations, threshold