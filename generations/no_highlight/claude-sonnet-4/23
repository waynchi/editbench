        return word_list
    
    def get_words_by_length(self, n):
        """Get all words with exactly n characters"""
        filtered_words = [word for word in self.words if len(word) == n]
        return filtered_words
    
    def get_random_words_by_length(self, n, count=10):
        """Get random words with exactly n characters"""
        filtered_words = self.get_words_by_length(n)
        
        if not filtered_words:
            return []
        
        # If we have fewer words than requested, return all available words
        if len(filtered_words) <= count:
            return filtered_words
        
        # Return random selection of words
        return random.sample(filtered_words, count)

def main():
    print("=" * 50)
    print("English Dictionary Word Lookup")
    print("=" * 50)
    print("This program will show you 10 random words with a specific number of characters.")
    print()
    
    dictionary = EnglishDictionary()
    
    while True:
        try:
            print("-" * 30)
            user_input = input("Enter the number of characters you want (or 'quit' to exit): ").strip()
            
            if user_input.lower() in ['quit', 'exit', 'q']:
                print("Thank you for using the English Dictionary Lookup!")
                break
            
            n = int(user_input)
            
            if n <= 0:
                print("Please enter a positive number.")
                continue
            
            if n > 20:
                print("Please enter a number 20 or less for better results.")
                continue
            
            print(f"\nSearching for words with {n} character(s)...")
            words = dictionary.get_random_words_by_length(n, 10)
            
            if not words:
                print(f"Sorry, no words found with exactly {n} character(s) in our dictionary.")
                print("Try a different number of characters.")
            else:
                print(f"\nFound {len(words)} word(s) with {n} character(s):")
                print("-" * 40)
                for i, word in enumerate(words, 1):
                    print(f"{i:2d}. {word.capitalize()}")
                
                # Show total count available
                total_words = len(dictionary.get_words_by_length(n))
                if total_words > len(words):
                    print(f"\n(Showing {len(words)} out of {total_words} available words)")
            
            print()
            
        except ValueError:
            print("Please enter a valid number or 'quit' to exit.")
        except KeyboardInterrupt:
            print("\n\nProgram interrupted. Goodbye!")
            break
        except Exception as e:
            print(f"An error occurred: {e}")
            print("Please try again.")

if __name__ == "__main__":
    main()