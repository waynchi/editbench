"""
Main entry point for the Audio Recorder and Transcriber application.
"""

import os
import sys
import logging
import tkinter as tk
import tkinterdnd2
from tkinter import messagebox
import traceback

def setup_logging():
    """
    Set up logging configuration for the application.
    """
    try:
        log_format = '%(asctime)s - %(levelname)s - %(message)s'
        logging.basicConfig(
            level=logging.INFO,
            format=log_format,
            handlers=[
                logging.StreamHandler(),
                logging.FileHandler('app.log', encoding='utf-8')
            ]
        )
        logging.info("Logging system initialized successfully")
    except Exception as e:
        print(f"Error setting up logging: {e}")
        # Fallback to basic logging
        logging.basicConfig(level=logging.INFO)

def get_resource_path():
    """
    Get the resource path that works for both development and PyInstaller.

    Returns:
        str: Path to resources directory
    """
    try:
        if getattr(sys, 'frozen', False):
            # Ejecutándose como ejecutable compilado
            return os.path.join(os.path.dirname(sys.executable), 'resources')
        else:
            # Ejecutando como script
            return os.path.join(os.path.dirname(os.path.abspath(__file__)), 'resources')
    except Exception as e:
        logging.error(f"Error getting resource path: {e}")
        # Fallback to current directory
        return os.path.join(os.getcwd(), 'resources')

def check_resources():
    """
    Check if required resource files exist.

    Returns:
        bool: True if all required resources are present
    """
    try:
        required_files = ['sound.mp3', 'done.mp3', 'cancel.wav', 'help_text.txt']
        resource_dir = get_resource_path()
        
        # Verificar si el directorio de recursos existe
        if not os.path.exists(resource_dir):
            logging.error(f"Resource directory does not exist: {resource_dir}")
            return False
        
        # Verificar si cada archivo requerido existe
        missing_files = []
        for file in required_files:
            file_path = os.path.join(resource_dir, file)
            if not os.path.exists(file_path):
                missing_files.append(file)
                logging.warning(f"Missing resource file: {file_path}")
        
        # Si faltan archivos requeridos, devolver False
        if missing_files:
            logging.error(f"Missing resource files: {', '.join(missing_files)}")
            return False
        
        logging.info("All required resource files found")
        return True
        
    except Exception as e:
        logging.error(f"Error checking resources: {e}")
        return False

def handle_exception(exc_type, exc_value, exc_traceback):
    """
    Global exception handler for unhandled exceptions.
    
    Args:
        exc_type: Exception type
        exc_value: Exception value
        exc_traceback: Exception traceback
    """
    if issubclass(exc_type, KeyboardInterrupt):
        # Allow keyboard interrupts to work normally
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    
    error_msg = f"Unhandled exception: {exc_type.__name__}: {exc_value}"
    logging.critical(error_msg, exc_info=(exc_type, exc_value, exc_traceback))
    
    # Show error dialog if tkinter is available
    try:
        root = tk.Tk()
        root.withdraw()  # Hide the main window
        messagebox.showerror(
            "Critical Error",
            f"A critical error occurred:\n\n{error_msg}\n\nCheck the log file for more details."
        )
        root.destroy()
    except:
        # If GUI is not available, just print to console
        print(f"Critical Error: {error_msg}")

def main():
    """
    Main function to start the application.
    """
    app = None
    root = None
    
    try:
        # Set up global exception handler
        sys.excepthook = handle_exception
        
        # Configurar el registro de eventos
        setup_logging()
        logging.info("Starting Audio Recorder and Transcriber application")

        # Verificar recursos
        if not check_resources():
            error_msg = "Required resource files are missing. Application cannot start."
            logging.error(error_msg)
            
            # Show error dialog
            try:
                root = tk.Tk()
                root.withdraw()
                messagebox.showerror("Resource Error", error_msg)
                root.destroy()
            except Exception as gui_error:
                logging.error(f"Error showing GUI error message: {gui_error}")
                print(error_msg)
            
            sys.exit(1)

        # Inicializar la ventana principal con soporte de arrastrar y soltar
        try:
            root = tkinterdnd2.TkinterDnD.Tk()
            logging.info("Main window initialized successfully")
        except Exception as e:
            logging.error(f"Error initializing main window: {e}")
            raise
        
        # Importar aquí para evitar importaciones circulares
        try:
            from gui.main_window import AudioTranscriberApp
            logging.info("GUI module imported successfully")
        except ImportError as e:
            logging.error(f"Error importing GUI module: {e}")
            messagebox.showerror("Import Error", f"Failed to import GUI module: {e}")
            sys.exit(1)
        except Exception as e:
            logging.error(f"Unexpected error importing GUI module: {e}")
            raise
        
        # Crear la instancia de la aplicación
        try:
            app = AudioTranscriberApp(root)
            logging.info("Application instance created successfully")
        except Exception as e:
            logging.error(f"Error creating application instance: {e}")
            messagebox.showerror("Application Error", f"Failed to create application: {e}")
            raise
        
        # Iniciar el bucle principal de eventos
        try:
            logging.info("Starting main event loop")
            root.mainloop()
            logging.info("Application closed normally")
        except Exception as e:
            logging.error(f"Error in main event loop: {e}")
            raise
        
    except KeyboardInterrupt:
        logging.info("Application interrupted by user")
        sys.exit(0)
    except SystemExit:
        logging.info("Application exit requested")
        raise
    except Exception as e:
        error_msg = f"Application error: {e}"
        logging.error(error_msg)
        logging.error(f"Traceback: {traceback.format_exc()}")
        
        # Show error dialog if possible
        try:
            if root is None:
                root = tk.Tk()
                root.withdraw()
            messagebox.showerror("Application Error", error_msg)
        except Exception as gui_error:
            logging.error(f"Error showing error dialog: {gui_error}")
            print(error_msg)
        
        sys.exit(1)
    finally:
        # Cleanup
        try:
            if app:
                logging.info("Cleaning up application resources")
                # Add any cleanup code here if needed
            if root:
                try:
                    root.quit()
                    root.destroy()
                except:
                    pass
        except Exception as cleanup_error:
            logging.error(f"Error during cleanup: {cleanup_error}")

if __name__ == "__main__":
    main()