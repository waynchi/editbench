import numpy as np
from typing import Dict, Any
from simulator.model.bidder import _Bidder
from simulator.simulation.modules import History
from simulator.model.traffic import Traffic


class Mystique(_Bidder):
    """Mystique bidder implementation following PEP8 standards."""
    
    default_params = {
        'traffic_path': '../data/traffic_share.csv',
        'pf0': 300,
        'C_max': 50,
        'C_min': 5,
        'E_max': 10,
        'E_gmc': 10
    }
    
    def __init__(self, params: dict = None):
        """Initialize Mystique bidder with given parameters.
        
        Args:
            params: Dictionary of parameters to override defaults
        """
        super().__init__()
        
        self.day_initial_balance = 0
        self.count = 0
        
        params = params or {}
      
        self.traffic = Traffic(
            path=params.get("traffic_path", self.default_params['traffic_path'])
        )
        self.c_max = params.get('C_max', self.default_params['C_max'])
        self.c_min = params.get('C_min', self.default_params['C_min'])
        self.e_max = params.get('E_max', self.default_params['E_max'])
        self.e_gmc = params.get('E_gmc', self.default_params['E_gmc'])

        self.balance_previous = np.array([])
        self.bid_previous = np.array([])
        self.timestamp_previous = np.array([])

    def place_bid(self, bidding_input_params: Dict[str, Any], 
                  history: History) -> float:
        """Place a bid based on current state and history.
        
        Args:
            bidding_input_params: Dictionary containing bidding parameters
            history: History object containing past bidding data
            
        Returns:
            float: The calculated bid amount
        """
        self.count += 1
        start = bidding_input_params['campaign_start_time']
        end = bidding_input_params['campaign_end_time']
        initial_balance = bidding_input_params['initial_balance']
        balance = bidding_input_params['balance']
        curr_time = bidding_input_params['curr_time']

        if len(self.bid_previous) == 0:
            return self._handle_first_bid(balance, curr_time)
        else:
            return self._calculate_bid(
                bidding_input_params, start, end, initial_balance, 
                balance, curr_time
            )

    def _handle_first_bid(self, balance: float, curr_time: int) -> float:
        """Handle the first bid placement.
        
        Args:
            balance: Current balance
            curr_time: Current timestamp
            
        Returns:
            float: Initial bid amount
        """
        self.balance_previous = np.pad(
            self.balance_previous,
            pad_width=[0, 1],
            constant_values=balance,
        )

        self.timestamp_previous = np.pad(
            self.timestamp_previous,
            pad_width=[0, 1],
            constant_values=curr_time,
        )

        self.bid_previous = np.pad(
            self.bid_previous,
            pad_width=[0, 1],
            constant_values=300.0,
        )
        return 300.0

    def _calculate_bid(self, bidding_input_params: Dict[str, Any], 
                      start: int, end: int, initial_balance: float,
                      balance: float, curr_time: int) -> float:
        """Calculate bid based on current conditions.
        
        Args:
            bidding_input_params: Dictionary containing bidding parameters
            start: Campaign start time
            end: Campaign end time
            initial_balance: Initial campaign balance
            balance: Current balance
            curr_time: Current timestamp
            
        Returns:
            float: Calculated bid amount
        """
        day = (curr_time - start) // 3600 // 24
        hour = (curr_time - start) // 3600 % 24
        desired_days = (end - start) // 3600 // 24
        day_quote = initial_balance / desired_days
        
        region_id = bidding_input_params['region_id']
        
        traffic_campaign = self.traffic.get_traffic_share(
            region_id, start, start + 3600 * 24
        )
        hours = np.arange(start, start + 3600 * 24, 3600)
        
        traffic_list = np.array([
            self.traffic.get_traffic_share(region_id, hour0, hour0 + 3600) 
            for hour0 in hours
        ])
        
        if traffic_campaign != 0:
            traffic_list = traffic_list / traffic_campaign
        else:
            traffic_list = np.zeros_like(traffic_list)
            
        target_spend = day_quote * np.cumsum(traffic_list)
        
        initial_day_balance = self._get_initial_day_balance(
            start, day, hour, initial_balance
        )

        if initial_day_balance - balance >= day_quote:
            return self._handle_overspend_case(balance, curr_time)
        else:
            return self._handle_normal_case(
                initial_day_balance, balance, target_spend, hour, 
                curr_time
            )

    def _get_initial_day_balance(self, start: int, day: int, hour: int, 
                                initial_balance: float) -> float:
        """Get the initial balance for the current day.
        
        Args:
            start: Campaign start time
            day: Current day
            hour: Current hour
            initial_balance: Initial campaign balance
            
        Returns:
            float: Initial day balance
        """
        hour_previous = [
            (t - start) // 3600 % 24 for t in self.timestamp_previous
        ]
        
        if day == 0:
            return initial_balance
        else:
            if hour_previous[-1] > hour:
                return self.balance_previous[-1]
            else:
                for i in range(
                    len(hour_previous) - 1, 
                    max(-1, len(hour_previous) - 12), 
                    -1
                ):
                    if hour_previous[i] < hour_previous[i - 1]:
                        return self.balance_previous[i]
        
        return self.balance_previous[-1]

    def _handle_overspend_case(self, balance: float, curr_time: int) -> float:
        """Handle case when spending exceeds day quota.
        
        Args:
            balance: Current balance
            curr_time: Current timestamp
            
        Returns:
            float: Calculated bid
        """
        if self.count % 3 != 1:
            bid = self.bid_previous[-1]
        else:
            bid = 0.95 * self.bid_previous[-1]
            
        self._update_history(balance, curr_time, bid)
        return bid

    def _handle_normal_case(self, initial_day_balance: float, balance: float,
                           target_spend: np.ndarray, hour: int, 
                           curr_time: int) -> float:
        """Handle normal bidding case.
        
        Args:
            initial_day_balance: Initial balance for the day
            balance: Current balance
            target_spend: Array of target spending amounts
            hour: Current hour
            curr_time: Current timestamp
            
        Returns:
            float: Calculated bid
        """
        spend_error = (
            initial_day_balance - balance - target_spend[int(hour)]
        )
        
        gradient_spend_error = self._calculate_gradient_error(
            target_spend, hour, balance, curr_time
        )
        
        ws, wg = self._calculate_weights(spend_error, gradient_spend_error)
        
        if self.count % 3 != 1:
            bid = self.bid_previous[-1]
        else:
            spend_error_c = min(
                self.c_max, self.c_max * abs(spend_error) / self.e_max
            )
            gradient_spend_error_i = min(1, abs(gradient_spend_error))
            gradient_spend_error_c = max(
                self.c_min, self.c_max * gradient_spend_error_i / self.e_gmc
            )

            bid = (
                self.bid_previous[-1] 
                - ws * spend_error_c * np.sign(spend_error)
                - wg * gradient_spend_error_c * np.sign(gradient_spend_error)
            )
        
        self._update_history(balance, curr_time, bid)
        return bid

    def _calculate_gradient_error(self, target_spend: np.ndarray, hour: int,
                                 balance: float, curr_time: int) -> float:
        """Calculate gradient spending error.
        
        Args:
            target_spend: Array of target spending amounts
            hour: Current hour
            balance: Current balance
            curr_time: Current timestamp
            
        Returns:
            float: Gradient spending error
        """
        if int(hour) > 0:
            desired_gradient = (
                (target_spend[int(hour)] - target_spend[int(hour) - 1]) / 3600
            )
            real_gradient = (
                (self.balance_previous[-1] - balance) 
                / (curr_time - self.timestamp_previous[-1])
            )
            return real_gradient - desired_gradient
        else:
            return 0

    def _calculate_weights(self, spend_error: float, 
                          gradient_spend_error: float) -> tuple:
        """Calculate weights for spend and gradient errors.
        
        Args:
            spend_error: Spending error amount
            gradient_spend_error: Gradient spending error
            
        Returns:
            tuple: (ws, wg) weight values
        """
        if gradient_spend_error == 0:
            tau = 1000000
        else:
            tau = -spend_error / gradient_spend_error
        
        if tau < 0:
            ws = 0.5
            wg = 0.5
        else:
            ws = min(0.9, 0.2 * tau)
            wg = 1 - ws
            
        return ws, wg

    def _update_history(self, balance: float, curr_time: int, bid: float):
        """Update historical data arrays.
        
        Args:
            balance: Current balance
            curr_time: Current timestamp
            bid: Current bid amount
        """
        self.balance_previous = np.pad(
            self.balance_previous,
            pad_width=[0, 1],
            constant_values=balance,
        )

        self.timestamp_previous = np.pad(
            self.timestamp_previous,
            pad_width=[0, 1],
            constant_values=curr_time,
        )

        self.bid_previous = np.pad(
            self.bid_previous,
            pad_width=[0, 1],
            constant_values=bid,
        )