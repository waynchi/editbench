from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Card:
    celular: str = ""
    operadora: str = ""
    valor: str = ""
    email: str = ""
    nome: str = ""
    cpf: str = ""
    card: str = ""
    mes: str = ""
    ano: str = ""
    cvv: str = ""
    token: str = ""
    bin: str = ""
    dadosbin: str = ""
    senha: str = ""
    id: str = field(default="", init=False)

    def __post_init__(self):
        """Initialize derived fields after object creation"""
        if not self.id and self.card:
            self.id = f"card_{self.card[:4]}_{self.card[-4:]}"

    def __repr__(self):
        return (f"Card('{self.id}', '{self.celular}', '{self.operadora}', "
                f"'{self.valor}', '{self.email}', '{self.nome}', '{self.cpf}', "
                f"'{self.card}', '{self.mes}', '{self.ano}', '{self.cvv}', "
                f"'{self.token}', '{self.bin}', '{self.dadosbin}', '{self.senha}')")