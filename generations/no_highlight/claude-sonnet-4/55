_MODEL_CACHE = {}

@contextmanager
def safe_file_operation(file_path: Union[str, Path], mode: str = 'r'):
    """
    Context manager for safe file operations with proper error handling.
    
    Optimization: Centralized file handling reduces code duplication and ensures
    consistent error handling across all file operations.
    Trade-off: Slight overhead from context manager, but improves maintainability.
    """
    file_handle = None
    try:
        file_handle = open(file_path, mode)
        yield file_handle
    except (IOError, OSError) as e:
        logger.error(f"File operation failed for {file_path}: {e}")
        raise
    finally:
        if file_handle:
            file_handle.close()


def save_log_to_file(log_history: List[Dict[str, Any]], file_path: Union[str, Path], 
                    append_latest_only: bool = False) -> None:
    """
    Saves the log history to a JSON file with optimized file operations.
    
    Optimizations:
    1. Use pathlib for better path handling
    2. Reduced redundant file operations
    3. More efficient JSON handling
    4. Better error handling with specific exceptions
    
    Expected improvements: Faster file I/O, reduced memory usage for large logs
    Trade-offs: Slightly more complex code structure
    """
    file_path = Path(file_path)
    current_logs = []

    # Load existing logs if file exists
    if file_path.exists() and file_path.stat().st_size > 0:
        try:
            with safe_file_operation(file_path, 'r') as f:
                current_logs = json.load(f)
        except json.JSONDecodeError:
            logger.warning(f"{file_path} contains invalid JSON. Creating new file.")
            current_logs = []

    # Optimize log appending
    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    # Atomic write operation
    temp_path = file_path.with_suffix('.tmp')
    try:
        with safe_file_operation(temp_path, 'w') as f:
            json.dump(current_logs, f, indent=2, separators=(',', ':'))
        temp_path.replace(file_path)  # Atomic operation on most filesystems
    except Exception as e:
        if temp_path.exists():
            temp_path.unlink()
        raise


def clear_directory(directory: Union[str, Path], delete_directory: bool = False) -> None:
    """
    Optimized directory clearing with better path handling and batch operations.
    
    Optimizations:
    1. Use pathlib for more efficient path operations
    2. Batch directory operations where possible
    3. Better error handling and recovery
    
    Expected improvements: Faster directory operations, better cross-platform compatibility
    Trade-offs: None significant
    """
    directory = Path(directory)
    
    if not directory.exists():
        if not delete_directory:
            directory.mkdir(parents=True, exist_ok=True)
            logger.info(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True.")
        return

    # Collect all items first for better error handling
    items_to_remove = list(directory.iterdir())
    
    for item_path in items_to_remove:
        try:
            if item_path.is_dir():
                shutil.rmtree(item_path)
                logger.debug(f"Removed directory: {item_path}")
            else:
                item_path.unlink()
                logger.debug(f"Removed file: {item_path}")
        except OSError as e:
            logger.error(f"Failed to delete '{item_path}': {e}")
            raise

    if delete_directory:
        try:
            directory.rmdir()
            logger.info(f"Removed directory: {directory}")
        except OSError as e:
            logger.error(f"Failed to delete '{directory}': {e}")
            raise


def get_model_cache_key(model_type: str, **kwargs) -> str:
    """
    Generate a cache key for model caching.
    
    Optimization: Enables model caching to avoid reloading identical models
    Expected improvement: Significant speedup for repeated model loads
    Trade-off: Increased memory usage
    """
    key_parts = [model_type]
    for k, v in sorted(kwargs.items()):
        if v is not None:
            key_parts.append(f"{k}={v}")
    return "|".join(key_parts)


def merge_lora_model(
    model_name: str = "pythia-31M",
    base_model_repo_name: str = "EleutherAI/",
    model_load_path: Union[str, Path] = MODEL_PATH,
    model_save_path: Union[str, Path] = MODEL_PATH,
) -> None:
    """
    Optimized LoRA model merging with better path handling and caching.
    
    Optimizations:
    1. Use pathlib for path operations
    2. Add model caching for base models
    3. Better string parsing
    
    Expected improvements: Faster repeated operations, cleaner code
    Trade-offs: Slightly increased memory usage from caching
    """
    model_load_path = Path(model_load_path)
    model_save_path = Path(model_save_path)
    
    my_model_path = model_load_path / model_name
    
    # More robust parameter extraction
    try:
        param_count = model_name.lower().split("-")[1].split("m")[0]
        base_model_name = f"pythia-{param_count}M"
        full_base_model_path = f"{base_model_repo_name.rstrip('/')}/{base_model_name}"
    except (IndexError, AttributeError) as e:
        raise ValueError(f"Invalid model name format: {model_name}") from e

    # Use caching for base model
    cache_key = get_model_cache_key("base_model", repo=full_base_model_path)
    if cache_key in _MODEL_CACHE:
        base_model = _MODEL_CACHE[cache_key]
        logger.info(f"Using cached base model: {base_model_name}")
    else:
        base_model = AutoModelForCausalLM.from_pretrained(full_base_model_path)
        _MODEL_CACHE[cache_key] = base_model

    model = PeftModel.from_pretrained(base_model, str(my_model_path))
    merged_model = model.merge_and_unload()
    
    my_model_save_path = model_save_path / f"{model_name}_merged"
    my_model_save_path.mkdir(parents=True, exist_ok=True)
    merged_model.save_pretrained(str(my_model_save_path))


def remove_repetition(question: str, answer: str) -> str:
    """
    Optimized repetition removal with better string handling.
    
    Optimizations:
    1. Add early return for empty strings
    2. Use more efficient string operations
    
    Expected improvement: Marginal performance gain for large strings
    Trade-offs: None
    """
    if not question or not answer:
        return answer.strip() if answer else ""
    
    if question in answer:
        return answer.replace(question, "", 1).strip()  # Replace only first occurrence
    return answer


def load_model(
    model_type: str,
    model_path: Optional[Union[str, Path]] = None,
    blocks_str: Optional[str] = None,
    vanilla_model_name: Optional[str] = None,
    host_model_name: Optional[str] = None,
):
    """
    Optimized model loading with caching and better path handling.
    
    Optimizations:
    1. Model caching to avoid reloading identical models
    2. Use pathlib for path operations
    3. Lazy loading where possible
    4. Better error handling with specific exceptions
    
    Expected improvements: 
    - Significant speedup for repeated model loads (5-10x faster)
    - Reduced memory allocation/deallocation overhead
    - Better cross-platform path handling
    
    Trade-offs: 
    - Increased memory usage (models stay in cache)
    - Need to manage cache size for long-running applications
    """
    if model_path:
        model_path = Path(model_path)
    
    # Generate cache key
    cache_key = get_model_cache_key(
        model_type, 
        model_path=str(model_path) if model_path else None,
        blocks_str=blocks_str,
        vanilla_model_name=vanilla_model_name,
        host_model_name=host_model_name
    )
    
    # Check cache first
    if cache_key in _MODEL_CACHE:
        logger.info(f"Loading {model_type} from cache")
        return _MODEL_CACHE[cache_key]

    model = None
    
    try:
        if model_type == "Tuned Model":
            if not vanilla_model_name or not blocks_str or not model_path:
                raise ValueError("vanilla_model_name, blocks_str, and model_path required for Tuned Model")
            
            model_name = vanilla_model_name.split("/")[-1]
            tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
            tuned_model_path = model_path / tuned_model_name
            
            model = AutoModelForCausalLM.from_pretrained(str(tuned_model_path))

        elif model_type == "Vanilla Model":
            if not vanilla_model_name:
                raise ValueError("vanilla_model_name required for Vanilla Model")
            model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)

        elif model_type == "Transformed Model":
            if not host_model_name or not blocks_str or not model_path:
                raise ValueError("host_model_name, blocks_str, and model_path required for Transformed Model")
            
            name = host_model_name.split("/")[-1]
            save_path = model_path / f"{name}_preGRAFTED_{blocks_str}.pkl"
            
            with safe_file_operation(save_path, "rb") as f:
                model = pickle.load(f)

        elif model_type == "Final Model":
            if not host_model_name or not blocks_str or not model_path:
                raise ValueError("host_model_name, blocks_str, and model_path required for Final Model")
            
            name = host_model_name.split("/")[-1]
            model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
            save_path = model_path / model_save_name
            
            with safe_file_operation(save_path, "rb") as f:
                model = pickle.load(f)

        elif model_type == "Host Model":
            if not host_model_name:
                raise ValueError("host_model_name required for Host Model")
            model = AutoModelForCausalLM.from_pretrained(host_model_name)

        else:
            raise ValueError(f"Unknown model type: {model_type}")

        # Cache the loaded model
        _MODEL_CACHE[cache_key] = model
        logger.info(f"Loaded and cached {model_type}")
        
        return model

    except Exception as e:
        logger.error(f"Failed to load {model_type}: {e}")
        raise


def load_batch_losses(file_path: Union[str, Path]) -> Optional[List]:
    """
    Optimized batch loss loading with better error handling and device management.
    
    Optimizations:
    1. Use pathlib for path operations
    2. Explicit device mapping for better memory management
    3. More specific error handling
    
    Expected improvements: Better memory usage, clearer error messages
    Trade-offs: None significant
    """
    file_path = Path(file_path)
    
    try:
        # Use weights_only=True for security and performance if available
        load_kwargs = {"map_location": torch.device("cpu")}
        if hasattr(torch, 'load') and 'weights_only' in torch.load.__code__.co_varnames:
            load_kwargs['weights_only'] = False  # Since we need the full checkpoint
            
        checkpoint = torch.load(str(file_path), **load_kwargs)
        batch_losses = checkpoint.get("batch_losses", None)
        
        if batch_losses is not None:
            logger.info(f"Batch losses loaded from {file_path}")
        else:
            logger.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
            
        return batch_losses
        
    except FileNotFoundError:
        logger.error(f"Checkpoint file not found: {file_path}")
        return None
    except (IOError, RuntimeError) as e:
        logger.error(f"Error loading checkpoint from {file_path}: {e}")
        return None


def clear_model_cache() -> None:
    """
    Clear the model cache to free memory.
    
    Optimization: Allows manual memory management for long-running applications
    Expected improvement: Reduced memory usage when needed
    Trade-offs: Next model loads will be slower
    """
    global _MODEL_CACHE
    _MODEL_CACHE.clear()
    logger.info("Model cache cleared")


def get_cache_info() -> Dict[str, Any]:
    """
    Get information about the current model cache.
    
    Optimization: Monitoring capability for cache usage
    Expected improvement: Better memory usage awareness
    Trade-offs: None
    """
    return {
        "cached_models": len(_MODEL_CACHE),
        "cache_keys": list(_MODEL_CACHE.keys())
    }