import pandas as pd
import scipy.stats as stats
import numpy as np

data = {
    'Brand': ['A'] * len(brand_A) + ['B'] * len(brand_B) + ['C'] * len(brand_C),
    'Cost': all_data
}

df = pd.DataFrame(data)

# Выполнить анализ ANOVA
brand_groups = [df[df['Brand'] == brand]['Cost'].values for brand in df['Brand'].unique()]
f_statistic, p_value = stats.f_oneway(*brand_groups)

# Создать таблицу ANOVA вручную
n_groups = len(df['Brand'].unique())
n_total = len(df)
df_between = n_groups - 1
df_within = n_total - n_groups
df_total = n_total - 1

# Вычислить суммы квадратов
grand_mean = df['Cost'].mean()
ss_total = np.sum((df['Cost'] - grand_mean) ** 2)
ss_between = np.sum([len(group) * (np.mean(group) - grand_mean) ** 2 for group in brand_groups])
ss_within = ss_total - ss_between

# Вычислить средние квадраты
ms_between = ss_between / df_between
ms_within = ss_within / df_within

# Создать таблицу результатов
anova_results = pd.DataFrame({
    'sum_sq': [ss_between, ss_within],
    'df': [df_between, df_within],
    'mean_sq': [ms_between, ms_within],
    'F': [f_statistic, np.nan],
    'PR(>F)': [p_value, np.nan]
}, index=['Brand', 'Residual'])

# Вывести таблицу ANOVA
print(anova_results)