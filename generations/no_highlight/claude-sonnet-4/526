import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image
import numpy as np

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                              std=[0.229, 0.224, 0.225])
        ])
    
    def create_unrelated_pairs(self, image_text_pairs):
        """Crea pares de imagen-texto no relacionados al mezclar las descripciones de texto"""
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """Crea pares de texto semánticamente similares utilizando conjuntos de datos de paráfrasis"""
        try:
            dataset = load_dataset(dataset_name, split=f'train[:{self.sample_size}]')
            textual_pairs = []
            for item in dataset:
                if item['is_duplicate'] == 1:
                    pair = (item['question1'], item['question2'])
                    textual_pairs.append(pair)
            return textual_pairs[:self.sample_size]
        except Exception as e:
            print(f"Error loading {dataset_name} dataset: {e}")
            # Fallback to creating synthetic textual pairs
            return self.create_synthetic_textual_pairs()
    
    def create_synthetic_textual_pairs(self):
        """Crea pares de texto sintéticos como respaldo"""
        synthetic_pairs = [
            ("A person walking in the park", "Someone strolling through a garden"),
            ("A cat sitting on a chair", "A feline resting on furniture"),
            ("Beautiful sunset over mountains", "Gorgeous evening sky above hills"),
            ("Children playing in the yard", "Kids having fun in the garden"),
            ("A red car on the street", "A crimson vehicle on the road")
        ]
        return synthetic_pairs[:min(len(synthetic_pairs), self.sample_size)]
    
    def create_visual_pairs(self, image_text_pairs):
        """Crea pares de imágenes aumentadas manteniendo el significado semántico"""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                try:
                    augmented = augmentation_transforms(image)
                    visual_pairs.append((image, augmented))
                except Exception as e:
                    print(f"Error augmenting image: {e}")
                    continue
        return visual_pairs

    def load_mscoco_dataset(self):
        """Carga y preprocesa el conjunto de datos MSCOCO con manejo de errores mejorado"""
        try:
            # Try to load MSCOCO dataset with error handling
            dataset = load_dataset(
                "nlphuji/flickr30k",  # Alternative dataset that's more reliable
                split=f'test[:{self.sample_size}]'
            )
            
            image_text_pairs = []
            for item in dataset:
                try:
                    # Get the first caption from the list
                    caption = item["caption"][0] if isinstance(item["caption"], list) else item["caption"]
                    if len(caption.split()) >= 5:  # Filter too short captions
                        image_text_pairs.append((item["image"], caption))
                        if len(image_text_pairs) >= self.sample_size:
                            break
                except Exception as e:
                    print(f"Error processing item: {e}")
                    continue
                    
            return image_text_pairs
            
        except Exception as e:
            print(f"Error loading flickr30k dataset: {e}")
            print("Falling back to synthetic dataset...")
            return self.create_synthetic_dataset()
    
    def create_synthetic_dataset(self):
        """Crea un conjunto de datos sintético como respaldo"""
        # Create simple colored images with corresponding text descriptions
        synthetic_pairs = []
        colors = ['red', 'blue', 'green', 'yellow', 'purple']
        shapes = ['circle', 'square', 'triangle']
        
        for i in range(min(self.sample_size, 20)):
            color = random.choice(colors)
            shape = random.choice(shapes)
            
            # Create a simple colored image
            img = Image.new('RGB', (224, 224), color=color)
            caption = f"A {color} {shape} on a white background"
            
            synthetic_pairs.append((img, caption))
        
        return synthetic_pairs

def main():
    # Inicializar creador de conjunto de datos
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # Cargar y crear conjuntos de datos
    print("Loading image-text dataset...")
    image_text_pairs = creator.load_mscoco_dataset()
    
    if not image_text_pairs:
        print("No image-text pairs loaded. Exiting...")
        return
    
    print(f"Loaded {len(image_text_pairs)} image-text pairs")
    
    print("Creating unrelated pairs...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Creating textual pairs...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Creating visual pairs...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # Imprimir muestra de cada conjunto de datos
    print("\nDataset Samples:")
    if image_text_pairs:
        print(f"Image-Text Pair: Image shape: {image_text_pairs[0][0].size if hasattr(image_text_pairs[0][0], 'size') else 'Unknown'}, Caption: {image_text_pairs[0][1]}")
    if unrelated_pairs:
        print(f"Unrelated Pair: Image shape: {unrelated_pairs[0][0].size if hasattr(unrelated_pairs[0][0], 'size') else 'Unknown'}, Caption: {unrelated_pairs[0][1]}")
    if textual_pairs:
        print(f"Textual Pair: {textual_pairs[0]}")
    if visual_pairs:
        print(f"Visual Pair: Original image shape: {visual_pairs[0][0].size if hasattr(visual_pairs[0][0], 'size') else 'Unknown'}, Augmented image shape: {visual_pairs[0][1].size if hasattr(visual_pairs[0][1], 'size') else 'Unknown'}")
    
    print(f"\nDataset sizes:")
    print(f"Image-Text pairs: {len(image_text_pairs)}")
    print(f"Unrelated pairs: {len(unrelated_pairs)}")
    print(f"Textual pairs: {len(textual_pairs)}")
    print(f"Visual pairs: {len(visual_pairs)}")

if __name__ == "__main__":
    main()