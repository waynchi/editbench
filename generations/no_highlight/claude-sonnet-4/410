function createTurnState(allyStates, foeStates) {
  // Znajdź bieżącą turę na podstawie tego, która grupa nadal ma jednostki mogące działać
  let currentTurn = determineCurrentTurn();
  let turnNumber = 1;

  function determineCurrentTurn() {
    const allyCanAct = allyStates.some(unit => !unit.hasActed);
    const foeCanAct = foeStates.some(unit => !unit.hasActed);
    
    if (allyCanAct && !foeCanAct) {
      return "player";
    } else if (!allyCanAct && foeCanAct) {
      return "cpu";
    } else if (allyCanAct && foeCanAct) {
      // Jeśli obie grupy mogą działać, sprawdź która była ostatnia
      return currentTurn || "player"; // Domyślnie gracz zaczyna
    } else {
      // Jeśli żadna grupa nie może działać, rozpocznij nową turę
      return "player";
    }
  }

  function getCurrentTurn() {
    currentTurn = determineCurrentTurn();
    return currentTurn;
  }

  function getTurnNumber() {
    return turnNumber;
  }

  function nextTurn() {
    currentTurn = determineCurrentTurn();
    
    if (currentTurn === "player") {
      // Sprawdź czy wszystkie jednostki gracza już działały
      const allAlliesActed = allyStates.every(unit => unit.hasActed);
      if (allAlliesActed) {
        currentTurn = "cpu";
        foeStates.forEach(unit => unit.hasActed = false);
        cpuTurn();
      }
    } else if (currentTurn === "cpu") {
      // Sprawdź czy wszystkie jednostki CPU już działały
      const allFoesActed = foeStates.every(unit => unit.hasActed);
      if (allFoesActed) {
        currentTurn = "player";
        allyStates.forEach(unit => unit.hasActed = false);
        turnNumber++; // Inkrementuj numer tury tylko po turze gracza
      }
    }
    
    // Jeśli żadna grupa nie może działać, zresetuj wszystkie jednostki
    const allyCanAct = allyStates.some(unit => !unit.hasActed);
    const foeCanAct = foeStates.some(unit => !unit.hasActed);
    
    if (!allyCanAct && !foeCanAct) {
      allyStates.forEach(unit => unit.hasActed = false);
      foeStates.forEach(unit => unit.hasActed = false);
      currentTurn = "player";
      turnNumber++;
    }
  }

  function cpuTurn() {
    // Przykładowe zachowanie CPU (zastąp własną logiką AI)
    for (const cpuUnit of foeStates) {
      if (!cpuUnit.hasActed) { // Sprawdź, czy jednostka już działała w tej turze
        // Wykonaj akcje CPU (np. ruch, atak)
        // ... tutaj twoja logika AI CPU ...

        cpuUnit.hasActed = true; // Oznacz jednostkę jako działającą
      }
    }

    // Po tym, jak wszystkie jednostki CPU wykonały ruch, sprawdź następną turę
    nextTurn();
  }  

  return {
    getCurrentTurn,
    getTurnNumber,
    nextTurn
  };
}

export { createTurnState };