import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=1000):
    """
    共轭梯度法求解线性方程组 Ax = b
    
    参数:
    A: 系数矩阵 (n x n)，必须是对称正定矩阵
    b: 右端向量 (n x 1)
    x0: 初始解向量 (n x 1)，默认为零向量
    tol: 收敛容差，默认 1e-6
    max_iter: 最大迭代次数，默认 1000
    
    返回:
    x: 解向量
    residual_norm: 最终残差范数
    iterations: 实际迭代次数
    """
    
    n = len(b)
    
    # 初始化
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    # 计算初始残差
    r = b - A @ x
    p = r.copy()
    
    # 初始残差范数
    r_norm_sq = np.dot(r, r)
    initial_residual = np.sqrt(r_norm_sq)
    
    # 如果初始残差已经很小，直接返回
    if initial_residual < tol:
        return x, initial_residual, 0
    
    iterations = 0
    
    for k in range(max_iter):
        # 计算 A * p
        Ap = A @ p
        
        # 计算步长 alpha
        alpha = r_norm_sq / np.dot(p, Ap)
        
        # 更新解
        x = x + alpha * p
        
        # 更新残差
        r = r - alpha * Ap
        
        # 计算新的残差范数
        r_norm_sq_new = np.dot(r, r)
        residual_norm = np.sqrt(r_norm_sq_new)
        
        iterations = k + 1
        
        # 检查收敛性
        if residual_norm < tol:
            break
        
        # 计算 beta
        beta = r_norm_sq_new / r_norm_sq
        
        # 更新搜索方向
        p = r + beta * p
        
        # 更新残差范数平方
        r_norm_sq = r_norm_sq_new
    
    return x, residual_norm, iterations


def preconditioned_conjugate_gradient(A, b, M=None, x0=None, tol=1e-6, max_iter=1000):
    """
    预条件共轭梯度法求解线性方程组 Ax = b
    
    参数:
    A: 系数矩阵 (n x n)，必须是对称正定矩阵
    b: 右端向量 (n x 1)
    M: 预条件矩阵 (n x n)，默认为单位矩阵
    x0: 初始解向量 (n x 1)，默认为零向量
    tol: 收敛容差，默认 1e-6
    max_iter: 最大迭代次数，默认 1000
    
    返回:
    x: 解向量
    residual_norm: 最终残差范数
    iterations: 实际迭代次数
    """
    
    n = len(b)
    
    # 初始化
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    # 如果没有预条件矩阵，使用标准共轭梯度法
    if M is None:
        return conjugate_gradient(A, b, x0, tol, max_iter)
    
    # 计算初始残差
    r = b - A @ x
    
    # 求解 M * z = r
    z = np.linalg.solve(M, r)
    p = z.copy()
    
    # 初始值
    rz = np.dot(r, z)
    initial_residual = np.sqrt(np.dot(r, r))
    
    # 如果初始残差已经很小，直接返回
    if initial_residual < tol:
        return x, initial_residual, 0
    
    iterations = 0
    
    for k in range(max_iter):
        # 计算 A * p
        Ap = A @ p
        
        # 计算步长 alpha
        alpha = rz / np.dot(p, Ap)
        
        # 更新解
        x = x + alpha * p
        
        # 更新残差
        r = r - alpha * Ap
        
        # 检查收敛性
        residual_norm = np.sqrt(np.dot(r, r))
        iterations = k + 1
        
        if residual_norm < tol:
            break
        
        # 求解 M * z = r
        z = np.linalg.solve(M, r)
        
        # 计算 beta
        rz_new = np.dot(r, z)
        beta = rz_new / rz
        
        # 更新搜索方向
        p = z + beta * p
        
        # 更新 rz
        rz = rz_new
    
    return x, residual_norm, iterations


def cg_solve_quadratic(A, b, c=0, x0=None, tol=1e-6, max_iter=1000):
    """
    使用共轭梯度法求解二次优化问题: min 0.5 * x^T * A * x - b^T * x + c
    等价于求解线性方程组 Ax = b
    
    参数:
    A: 二次项系数矩阵 (n x n)，必须是对称正定矩阵
    b: 线性项系数向量 (n x 1)
    c: 常数项，默认为 0
    x0: 初始解向量 (n x 1)，默认为零向量
    tol: 收敛容差，默认 1e-6
    max_iter: 最大迭代次数，默认 1000
    
    返回:
    x: 最优解向量
    objective_value: 目标函数值
    residual_norm: 最终残差范数
    iterations: 实际迭代次数
    """
    
    # 求解 Ax = b
    x, residual_norm, iterations = conjugate_gradient(A, b, x0, tol, max_iter)
    
    # 计算目标函数值
    objective_value = 0.5 * np.dot(x, A @ x) - np.dot(b, x) + c
    
    return x, objective_value, residual_norm, iterations


# 示例使用
if __name__ == "__main__":
    # 创建测试问题
    n = 5
    np.random.seed(42)
    
    # 生成对称正定矩阵
    A_temp = np.random.randn(n, n)
    A = A_temp.T @ A_temp + np.eye(n)  # 确保正定
    
    # 真实解
    x_true = np.random.randn(n)
    b = A @ x_true
    
    print("共轭梯度法测试:")
    print(f"矩阵大小: {n} x {n}")
    print(f"真实解: {x_true}")
    
    # 标准共轭梯度法
    x_cg, residual, iterations = conjugate_gradient(A, b)
    print(f"\n标准共轭梯度法:")
    print(f"计算解: {x_cg}")
    print(f"误差: {np.linalg.norm(x_cg - x_true):.2e}")
    print(f"残差: {residual:.2e}")
    print(f"迭代次数: {iterations}")
    
    # 预条件共轭梯度法（使用对角预条件）
    M = np.diag(np.diag(A))  # 对角预条件矩阵
    x_pcg, residual_pcg, iterations_pcg = preconditioned_conjugate_gradient(A, b, M)
    print(f"\n预条件共轭梯度法:")
    print(f"计算解: {x_pcg}")
    print(f"误差: {np.linalg.norm(x_pcg - x_true):.2e}")
    print(f"残差: {residual_pcg:.2e}")
    print(f"迭代次数: {iterations_pcg}")
    
    # 二次优化问题
    c = 1.0
    x_quad, obj_val, residual_quad, iterations_quad = cg_solve_quadratic(A, b, c)
    print(f"\n二次优化问题:")
    print(f"最优解: {x_quad}")
    print(f"目标函数值: {obj_val:.6f}")
    print(f"残差: {residual_quad:.2e}")
    print(f"迭代次数: {iterations_quad}")