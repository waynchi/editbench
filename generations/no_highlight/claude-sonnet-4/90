import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image
import numpy as np

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                              std=[0.229, 0.224, 0.225])
        ])
    
    def create_unrelated_pairs(self, image_text_pairs):
        """Creates unrelated image-text pairs by shuffling the text descriptions"""
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='glue', config_name='mrpc'):
        """Creates semantically similar text pairs using paraphrase datasets"""
        try:
            dataset = load_dataset(dataset_name, config_name, split=f'train[:{self.sample_size}]')
            textual_pairs = []
            for item in dataset:
                if item['label'] == 1:  # Similar pairs
                    pair = (item['sentence1'], item['sentence2'])
                    textual_pairs.append(pair)
            return textual_pairs[:self.sample_size]
        except Exception as e:
            print(f"Error loading {dataset_name}: {e}")
            # Fallback to creating simple textual pairs
            return self._create_fallback_textual_pairs()
    
    def _create_fallback_textual_pairs(self):
        """Creates fallback textual pairs when dataset loading fails"""
        fallback_pairs = [
            ("A dog is running in the park", "A canine is jogging through the park"),
            ("The cat is sleeping on the bed", "A feline is resting on the mattress"),
            ("Children are playing in the garden", "Kids are having fun in the yard"),
            ("The car is parked outside", "The vehicle is stationed outdoors"),
            ("She is reading a book", "She is perusing a novel")
        ]
        return fallback_pairs * (self.sample_size // len(fallback_pairs) + 1)[:self.sample_size]
    
    def create_visual_pairs(self, image_text_pairs):
        """Creates augmented image pairs while maintaining semantic meaning"""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                augmented = augmentation_transforms(image)
                visual_pairs.append((image, augmented))
        return visual_pairs

    def load_conceptual_captions_dataset(self):
        """Loads and preprocesses Conceptual Captions dataset as alternative to MSCOCO"""
        try:
            dataset = load_dataset(
                "conceptual_captions",
                split=f'train[:{self.sample_size}]',
                streaming=False
            )
            
            image_text_pairs = []
            for item in dataset:
                try:
                    if item["image"] is not None and item["caption"]:
                        # Filter captions that are descriptive enough
                        if len(item["caption"].split()) >= 5:
                            image_text_pairs.append((item["image"], item["caption"]))
                except Exception as e:
                    print(f"Error processing item: {e}")
                    continue
                    
            return image_text_pairs[:self.sample_size]
        
        except Exception as e:
            print(f"Error loading Conceptual Captions: {e}")
            return self._create_fallback_image_text_pairs()
    
    def _create_fallback_image_text_pairs(self):
        """Creates fallback image-text pairs when dataset loading fails"""
        # Create simple colored images as fallback
        fallback_pairs = []
        captions = [
            "A red square on white background",
            "A blue circle on white background", 
            "A green triangle on white background",
            "A yellow rectangle on white background",
            "A purple oval on white background"
        ]
        
        colors = [(255, 0, 0), (0, 0, 255), (0, 255, 0), (255, 255, 0), (128, 0, 128)]
        
        for i in range(min(self.sample_size, len(captions))):
            # Create a simple colored image
            img = Image.new('RGB', (224, 224), color='white')
            # Add a colored shape (simplified as colored rectangle)
            pixels = img.load()
            color = colors[i % len(colors)]
            for x in range(50, 174):
                for y in range(50, 174):
                    pixels[x, y] = color
            
            fallback_pairs.append((img, captions[i % len(captions)]))
        
        # Repeat pairs to reach sample_size
        while len(fallback_pairs) < self.sample_size:
            fallback_pairs.extend(fallback_pairs[:min(len(fallback_pairs), self.sample_size - len(fallback_pairs))])
        
        return fallback_pairs[:self.sample_size]

    def load_mscoco_dataset(self):
        """Loads and preprocesses MSCOCO dataset with improved error handling"""
        try:
            # Try the original MSCOCO dataset first
            dataset = load_dataset(
                "shunk031/MSCOCO",
                year=2014,
                coco_task="captions",
                split='train',
                streaming=True
            )
            dataset = dataset.take(self.sample_size)

            image_text_pairs = []
            for item in dataset:
                try:
                    # Select most descriptive caption based on length
                    best_caption = max(item["captions"], key=len)
                    if len(best_caption.split()) >= 5:  # Filter out too short captions
                        image_text_pairs.append((item["image"], best_caption))
                except Exception as e:
                    print(f"Error processing MSCOCO item: {e}")
                    continue
                    
            return image_text_pairs
        
        except Exception as e:
            print(f"MSCOCO dataset failed to load: {e}")
            print("Falling back to Conceptual Captions dataset...")
            return self.load_conceptual_captions_dataset()

def main():
    # Initialize dataset creator
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # Load and create datasets
    print("Loading image-text dataset...")
    image_text_pairs = creator.load_mscoco_dataset()
    
    print("Creating unrelated pairs...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Creating textual pairs...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Creating visual pairs...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # Print sample from each dataset
    print("\nDataset Samples:")
    if image_text_pairs:
        print(f"Image-Text Pair: Image size {image_text_pairs[0][0].size}, Caption: '{image_text_pairs[0][1][:50]}...'")
    if unrelated_pairs:
        print(f"Unrelated Pair: Image size {unrelated_pairs[0][0].size}, Caption: '{unrelated_pairs[0][1][:50]}...'")
    if textual_pairs:
        print(f"Textual Pair: ('{textual_pairs[0][0][:30]}...', '{textual_pairs[0][1][:30]}...')")
    if visual_pairs:
        print(f"Visual Pair: Original size {visual_pairs[0][0].size}, Augmented size {visual_pairs[0][1].size}")
    
    print(f"\nDataset sizes:")
    print(f"Image-Text pairs: {len(image_text_pairs)}")
    print(f"Unrelated pairs: {len(unrelated_pairs)}")
    print(f"Textual pairs: {len(textual_pairs)}")
    print(f"Visual pairs: {len(visual_pairs)}")

if __name__ == "__main__":
    main()