def is_sum_of_four_squares(n):
    if n < 0:
        return False
    for a in range(1, int(n**0.5) + 1):
        for b in range(1, int(n**0.5) + 1):
            for c in range(1, int(n**0.5) + 1):
                for d in range(1, int(n**0.5) + 1):
                    if a**2 + b**2 + c**2 + d**2 == n:
                        return a, b, c, d
    return None

def find_four_squares_sums(limit):
    """Находит числа до заданного предела, которые могут быть выражены как сумма четырех ненулевых квадратов."""
    results = []
    for n in range(1, limit + 1):
        result = is_sum_of_four_squares(n)
        if result:
            a, b, c, d = result
            results.append((n, a, b, c, d))
    return results

# Пример использования:
limit = int(input("Введите верхний предел: "))
sums_found = find_four_squares_sums(limit)
print("Числа, которые могут быть выражены как сумма четырех ненулевых квадратов:")
for num, a, b, c, d in sums_found:
    print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")