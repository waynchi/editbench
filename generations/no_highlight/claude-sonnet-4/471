import math
import numpy as np

class Value:
    """almacena un único valor escalar y su gradiente"""

    def __init__(self, data, _children=(), _op=''):
        self.data = data
        self.grad = 0
        # variables internas utilizadas para la construcción del gráfico de autograd
        self._backward = lambda: None
        self._prev = set(_children)
        self._op = _op # la operación que produjo este nodo, para graphviz / depuración / etc

    def __add__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data + other.data, (self, other), '+')

        def _backward():
            self.grad += out.grad
            other.grad += out.grad
        out._backward = _backward

        return out

    def __mul__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data * other.data, (self, other), '*')

        def _backward():
            self.grad += other.data * out.grad
            other.grad += self.data * out.grad
        out._backward = _backward

        return out

    def __pow__(self, other):
        assert isinstance(other, (int, float)), "only supporting int/float powers for now"
        out = Value(self.data**other, (self,), f'**{other}')

        def _backward():
            self.grad += (other * self.data**(other-1)) * out.grad
        out._backward = _backward

        return out

    def exp(self):
        print(f'** EXP {self}')
        out = Value(math.exp(self.data), (self,), "e")
        def _backward():
            self.grad += math.exp(self.data) * out.grad
        out._backward = _backward
        
        return out
    
    def log(self):
        out = Value(math.log(self.data), (self,), f'log{self.data}')
        def _backward():
            self.grad += 1 / self.data
        out._backward = _backward       
        
        return out
    
    def relu(self):
        assert isinstance(self.data, (int, float)), "only supporting int/float powers for now"
        out = Value(0 if self.data < 0 else self.data, (self,), 'ReLU')

        def _backward():
            self.grad += (out.data > 0) * out.grad
        out._backward = _backward

        return out
    
    @staticmethod
    def softmax(values):
        """
        Aplica la función softmax a una lista de objetos Value
        Retorna una lista de objetos Value con los valores softmax
        """
        assert isinstance(values, list) and all(isinstance(v, Value) for v in values), "Input debe ser una lista de objetos Value"
        
        # Convertir a numpy array para cálculos
        data_array = np.array([v.data for v in values])
        
        # Calcular softmax: exp(x_i) / sum(exp(x_j))
        exp_values = np.exp(data_array - np.max(data_array))  # Restar max para estabilidad numérica
        softmax_values = exp_values / np.sum(exp_values)
        
        # Crear objetos Value de salida
        outputs = []
        for i, softmax_val in enumerate(softmax_values):
            out = Value(softmax_val, tuple(values), f'softmax_{i}')
            outputs.append(out)
        
        # Definir función backward para cada salida
        def create_backward(idx):
            def _backward():
                # Gradiente de softmax: s_i * (δ_ij - s_j) donde δ_ij es delta de Kronecker
                for j, input_val in enumerate(values):
                    if idx == j:
                        # Gradiente diagonal: s_i * (1 - s_i)
                        input_val.grad += outputs[idx].data * (1 - outputs[idx].data) * outputs[idx].grad
                    else:
                        # Gradiente no diagonal: -s_i * s_j
                        input_val.grad += -outputs[idx].data * outputs[j].data * outputs[idx].grad
            return _backward
        
        # Asignar función backward a cada salida
        for i, out in enumerate(outputs):
            out._backward = create_backward(i)
        
        return outputs

    def backward(self):

        # orden topológico de todos los hijos en el grafo
        topo = []
        visited = set()
        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for child in v._prev:
                    build_topo(child)
                topo.append(v)
        build_topo(self)

        # ir una variable a la vez y aplicar la regla de la cadena para obtener su gradiente
        self.grad = 1
        for v in reversed(topo):
            v._backward()

    def __neg__(self): # -self
        return self * -1
    def __gt__(self, other):
        return self.data > other.data

    def __radd__(self, other): # otro + self
        return self + other

    def __sub__(self, other): # self - otro
        return self + (-other)

    def __rsub__(self, other): # otro - self
        return other + (-self)

    def __rmul__(self, other): # otro * self
        return self * other

    def __truediv__(self, other): # self / otro
        return self * other**-1

    def __rtruediv__(self, other): # otro / self
        return other * self**-1

    def __repr__(self):
        return f"Value(data={self.data}, grad={self.grad})"