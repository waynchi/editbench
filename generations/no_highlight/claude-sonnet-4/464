from langchain_ollama import ChatOllama
from langchain_core.prompts.chat import ChatPromptTemplate
import json

# Inicializar el modelo ChatOllama
chat_model = ChatOllama(model="llama3.2", base_url="http://localhost:11434")

# Cargar valores SHAP desde archivo JSON
try:
    with open("Vuori_Final_Approval_2024_09_24.json", "r") as file:
        shap_values_json = json.load(file).get("shap_values")
except FileNotFoundError:
    print("Error: No se encontró el archivo Vuori_Final_Approval_2024_09_24.json")
    exit(1)
except json.JSONDecodeError:
    print("Error: El archivo JSON no tiene un formato válido")
    exit(1)

# Cargar el mensaje del sistema desde el archivo
try:
    with open("system.prompt", "r") as file:
        sys_prompt = file.read().strip()
except FileNotFoundError:
    print("Error: No se encontró el archivo system.prompt")
    exit(1)

# Preparar los mensajes
template = ChatPromptTemplate([
    ("system", sys_prompt),
    ("human", "{user_input}"),
])

# Generar la respuesta
user_input = json.dumps(shap_values_json)
prompt_value = template.invoke({"user_input": user_input})

chain = prompt_value | chat_model

# Imprimir la respuesta
try:
    response = chain.invoke({})
    print(response.content)
except Exception as e:
    print(f"Error al generar la respuesta: {e}")