import tkinter as tk
import random
import math

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        self.dx = random.choice([-3, -2, -1, 1, 2, 3])
        self.dy = random.choice([-3, -2, -1, 1, 2, 3])
        # Случайный цвет для квадрата
        colors = ["red", "blue", "green", "yellow", "orange", "purple", "pink", "cyan", "magenta", "lime"]
        self.color = random.choice(colors)
        self.square = canvas.create_rectangle(x, y, x + size, y + size, fill=self.color, outline="black")

    def move(self):
        # Получить текущие размеры холста
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()
        
        # Обновить позицию
        self.x += self.dx
        self.y += self.dy
        
        # Переместить квадрат на холсте
        self.canvas.move(self.square, self.dx, self.dy)
        
        # Проверка границ
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            # Удалить текущий квадрат
            self.canvas.delete(self.square)
            # Создать два новых квадрата, если размер достаточно большой
            if self.size > 15:
                new_size = self.size / 2
                # Создать новые квадраты в центре с небольшим смещением
                squares.append(Square(self.canvas, new_size, 
                                   canvas_width/2 - new_size, 
                                   canvas_height/2 - new_size))
                squares.append(Square(self.canvas, new_size, 
                                   canvas_width/2 + new_size/2, 
                                   canvas_height/2 + new_size/2))
            return False
        return True

def update():
    global squares
    # Переместить все квадраты и удалить те, которые достигли границ
    squares = [square for square in squares if square.move()]
    root.after(50, update)  # Обновление каждые 50 мс для лучшей видимости

# Создать главное окно
root = tk.Tk()
root.title("Splitting Squares")
root.geometry("800x600")

# Создать холст
canvas = tk.Canvas(root, width=800, height=600, bg="white")
canvas.pack(expand=True, fill="both")

# Дать время холсту инициализироваться
root.update()

# Создать начальный квадрат
squares = [Square(canvas, 80, 360, 260)]

# Запустить анимацию
update()

# Запустить главный цикл
root.mainloop()