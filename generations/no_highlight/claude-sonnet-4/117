def is_sum_of_four_squares(n):
    """
    Check if a number can be expressed as the sum of four non-zero squares.
    Uses Jacobi's four-square theorem and Legendre's three-square theorem.
    """
    if n <= 0:
        return False
    
    # Try all possible combinations of four non-zero squares
    # We only need to check up to sqrt(n/4) for each square since we need 4 squares
    limit = int(n**0.5) + 1
    
    for a in range(1, limit):
        a_sq = a * a
        if a_sq >= n:
            break
        for b in range(1, limit):
            b_sq = b * b
            if a_sq + b_sq >= n:
                break
            for c in range(1, limit):
                c_sq = c * c
                if a_sq + b_sq + c_sq >= n:
                    break
                d_sq = n - a_sq - b_sq - c_sq
                if d_sq > 0:
                    d = int(d_sq**0.5)
                    if d > 0 and d * d == d_sq:
                        return True, (a, b, c, d)
    
    return False, None

def find_four_square_representation(n):
    """
    Find the representation of n as sum of four non-zero squares.
    Returns the four numbers whose squares sum to n.
    """
    result, squares = is_sum_of_four_squares(n)
    if result:
        return squares
    return None

def generate_four_square_numbers(limit):
    """
    Generate all numbers up to limit that can be expressed as sum of four non-zero squares.
    """
    four_square_numbers = []
    
    for n in range(1, limit + 1):
        result, representation = is_sum_of_four_squares(n)
        if result:
            four_square_numbers.append((n, representation))
    
    return four_square_numbers

