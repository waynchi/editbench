    """
    Optimized version using mathematical properties.
    A positive integer can be expressed as sum of four squares if and only if
    it's not of the form 4^a(8b + 7) where a, b are non-negative integers.
    However, we need non-zero squares, so we need additional checking.
    """
    if n <= 0:
        return False
    
    # For small numbers, use brute force
    if n <= 100:
        result, _ = is_sum_of_four_squares(n)
        return result
    
