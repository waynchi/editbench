def binary_search(arr, target):
    """
    Выполняет бинарный поиск элемента в отсортированном массиве.
    
    Args:
        arr: Отсортированный список элементов
        target: Искомый элемент
    
    Returns:
        int: Индекс элемента в массиве, если найден, иначе -1
    """
    low = 0
    high = len(arr) - 1
    
    while low <= high:
        mid = (low + high) // 2
        
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    
    return -1