def crear_diccionario_jerarquico(posts_generator):
    """Tworzy hierarchiczny słownik na podstawie posts_generator i replies"""
    diccionario_jerarquico = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_key = f"{post_author}/{post_permlink}"
        
        # Dodaj post do słownika
        diccionario_jerarquico[post_key] = {
            'post_data': dict(post),
            'replies': {}
        }
        
        # Pobierz odpowiedzi do posta
        if post['children'] > 0:
            try:
                comment = Comment(authorperm=post_key)
                post_replies = comment.get_replies()
                
                for reply in post_replies:
                    reply_author = reply['author']
                    reply_permlink = reply['permlink']
                    reply_key = f"{reply_author}/{reply_permlink}"
                    
                    # Dodaj odpowiedź do słownika pod kluczem posta
                    diccionario_jerarquico[post_key]['replies'][reply_key] = {
                        'reply_data': dict(reply),
                        'replies': {}  # Można rozszerzyć o kolejny poziom zagnieżdżenia
                    }
                    
            except Exception as e:
                print(f"Błąd podczas pobierania odpowiedzi dla {post_key}: {e}")
    
    return diccionario_jerarquico

