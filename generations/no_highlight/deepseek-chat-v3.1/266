def crear_diccionario_jerarquico(posts_generator):
    """Crea un diccionario jerárquico con posts y sus replies"""
    diccionario_jerarquico = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_key = f"{post_author}/{post_permlink}"
        
        # Crear entrada principal para el post
        diccionario_jerarquico[post_key] = {
            'post_data': {
                'author': post_author,
                'permlink': post_permlink,
                'title': post.get('title', ''),
                'body': post.get('body', ''),
                'created': post.get('created', ''),
                'children': post.get('children', 0)
            },
            'replies': {}
        }
        
        # Obtener y procesar replies si el post tiene suficientes respuestas
        if post.get('children', 0) > n_respuestas_minimas:
            try:
                comment = Comment(authorperm=post_key)
                post_replies = comment.get_replies()
                
                for reply in post_replies:
                    reply_author = reply['author']
                    reply_permlink = reply['permlink']
                    reply_key = f"{reply_author}/{reply_permlink}"
                    
                    # Añadir reply al diccionario jerárquico
                    diccionario_jerarquico[post_key]['replies'][reply_key] = {
                        'author': reply_author,
                        'permlink': reply_permlink,
                        'body': reply.get('body', ''),
                        'created': reply.get('created', ''),
                        'procesado': procesar(reply.get('body', ''))
                    }
                    
            except Exception as e:
                print(f"Error procesando replies de {post_key}: {e}")
    
    return diccionario_jerarquico

