import numpy as np

INPUT_FILE_PATH = './input.txt'

def main():
    lines = parse_input_file()
    
    # Parse and validate data
    try:
        cols = [line.split() for line in lines if line.strip()]
        cols = np.array(cols).T.astype(int)
    except (ValueError, IndexError) as e:
        print(f"Error parsing input data: {e}")
        return
    
    if cols.shape[0] < 2:
        print("Error: Input must contain at least two columns")
        return
    
    list_1 = cols[0].copy()
    list_2 = cols[1].copy()
    
    # Calculate minimum distances using vectorized operations
    list_1_sorted = np.sort(list_1)
    list_2_sorted = np.sort(list_2)
    
    # Calculate absolute differences between sorted arrays
    distances = np.abs(list_1_sorted - list_2_sorted)
    total_distance = np.sum(distances)
    
    print(f"Total distance: {total_distance}")

def parse_input_file():
    """Read and parse input file with error handling"""
    try:
        with open(INPUT_FILE_PATH, 'r') as f:
            lines = [line.strip() for line in f.readlines() if line.strip()]
        return lines
    except FileNotFoundError:
        print(f"Error: File '{INPUT_FILE_PATH}' not found")
        return []
    except IOError as e:
        print(f"Error reading file: {e}")
        return []

if __name__ == "__main__":
    main()