def is_sum_of_four_nonzero_squares(n):
    if n < 4:  # Minimum sum of four nonzero squares is 1+1+1+1=4
        return None
    
    max_val = int(n**0.5) + 1
    for a in range(1, max_val):  # Start from 1 to exclude zero
        for b in range(1, max_val):
            for c in range(1, max_val):
                remaining = n - (a**2 + b**2 + c**2)
                if remaining < 1:  # d must be at least 1
                    continue
                d = int(remaining**0.5)
                if d >= 1 and a**2 + b**2 + c**2 + d**2 == n:
                    return a, b, c, d
    return None

def find_four_squares_sums(limit):
    """Znajduje liczby do określonego limitu, które można wyrazić jako sumę czterech kwadratów, przy czym żaden z kwadratów nie jest zerem."""
    results = []
    for n in range(4, limit + 1):  # Start from 4 (minimum possible)
        result = is_sum_of_four_nonzero_squares(n)
        if result:
            results.append(n)
    return results

# Przykład użycia:
limit = int(input("Digite o limite superior: "))
sums_found = find_four_squares_sums(limit)
print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
for num in sums_found:
    result = is_sum_of_four_nonzero_squares(num)
    a, b, c, d = result
    print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")