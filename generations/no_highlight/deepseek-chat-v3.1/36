import numpy as np


def linear_regression_gradient_descent(
    X: np.ndarray, y: np.ndarray, alpha: float, iterations: int
) -> np.ndarray:
    # Ensure y is a column vector with proper shape
    m, n = X.shape
    y = y.reshape(-1, 1)  # Reshape y to (m, 1) to match broadcasting requirements
    theta = np.zeros((n, 1))

    for _ in range(iterations):
        predictions = X @ theta
        error = predictions - y
        gradient = (1/m) * X.T @ error
        theta -= alpha * gradient

    return theta


print(
    linear_regression_gradient_descent(
        np.array([[1, 1], [1, 2], [1, 3]]), np.array([1, 2, 3]), 0.01, 1000
    )
)