function createTurnState(allyStates, foeStates) {
  let turnNumber = 1;
  let currentTurn = "player"; // Start with player's turn

  function getCurrentTurn() {
    return currentTurn;
  }

  function getTurnNumber() {
    return turnNumber;
  }

  function hasUnitsThatCanAct(units) {
    return units.some(unit => !unit.hasActed);
  }

  function nextTurn() {
    // Check if current turn group still has units that can act
    const currentUnits = currentTurn === "player" ? allyStates : foeStates;
    
    if (hasUnitsThatCanAct(currentUnits)) {
      // Current turn group still has units that can act, don't switch turns
      return;
    }

    // Switch to the other group's turn
    if (currentTurn === "player") {
      currentTurn = "cpu";
      foeStates.forEach(unit => unit.hasActed = false); // Reset CPU units for their turn
      cpuTurn();
    } else {
      currentTurn = "player";
      allyStates.forEach(unit => unit.hasActed = false); // Reset player units for their turn
      turnNumber++; // Increment turn number only after both sides have completed their turns
    }
  }

  function cpuTurn() {
    // Example CPU behavior (replace with your actual AI logic)
    for (const cpuUnit of foeStates) {
      if (!cpuUnit.hasActed) { // Check if the unit has already acted in this turn
        // Perform CPU actions (e.g., movement, attack)
        // ... your CPU AI logic here ...

        cpuUnit.hasActed = true; // Mark the unit as having acted
      }
    }

    // After all CPU units have acted (or chosen not to), end the CPU turn
    nextTurn(); // Check if CPU turn should end and switch if needed
  }  

  return {
    getCurrentTurn,
    getTurnNumber,
    nextTurn
  };
}

export { createTurnState };