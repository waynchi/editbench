def crear_diccionario_jerarquico(posts_generator):
    """Crea un diccionario jerárquico con la estructura de posts y sus replies"""
    diccionario_posts = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_replies = post['children']
        
        # Crear entrada principal para el post
        post_key = f"{post_author}/{post_permlink}"
        diccionario_posts[post_key] = {
            'author': post_author,
            'permlink': post_permlink,
            'title': post.get('title', ''),
            'created': post.get('created', ''),
            'replies_count': post_replies,
            'replies': {}  # Diccionario para almacenar las replies
        }
        
        # Si el post tiene suficientes respuestas, obtener y procesar las replies
        if post_replies > n_respuestas_minimas:
            try:
                comment = Comment(authorperm=post_key)
                replies_list = comment.get_replies()
                
                for reply in replies_list:
                    reply_author = reply['author']
                    reply_permlink = reply['permlink']
                    reply_body = reply['body']
                    
                    # Crear entrada para cada reply
                    reply_key = f"{reply_author}/{reply_permlink}"
                    diccionario_posts[post_key]['replies'][reply_key] = {
                        'author': reply_author,
                        'permlink': reply_permlink,
                        'body': reply_body,
                        'created': reply.get('created', ''),
                        'processed': procesar(reply_body),
                        'own_author': is_own_author(reply_author),
                        'banned': is_banned(reply_author)
                    }
                    
            except Exception as e:
                print(f"Error al obtener replies para {post_key}: {e}")
                continue
    
    return diccionario_posts

q = Query()
