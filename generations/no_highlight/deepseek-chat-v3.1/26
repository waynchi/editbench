import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=None):
    """
    Реализация метода спряжённых градиентов для решения системы линейных уравнений Ax = b.
    
    Параметры:
    A: матрица коэффициентов (n x n)
    b: вектор правой части (n,)
    x0: начальное приближение (по умолчанию нулевой вектор)
    tol: допустимая погрешность
    max_iter: максимальное число итераций (по умолчанию n)
    
    Возвращает:
    x: решение системы
    convergence: история сходимости (нормы невязки)
    """
    n = len(b)
    
    # Установка параметров по умолчанию
    if x0 is None:
        x = np.zeros_like(b)
    else:
        x = x0.copy()
    
    if max_iter is None:
        max_iter = n
    
    # Инициализация
    r = b - A @ x  # начальная невязка
    p = r.copy()    # начальное направление
    rs_old = r @ r  # квадрат нормы невязки
    
    convergence = [np.sqrt(rs_old)]
    
    # Основной цикл
    for i in range(max_iter):
        Ap = A @ p          # матрично-векторное произведение
        
        # Коэффициент шага
        alpha = rs_old / (p @ Ap)
        
        # Обновление решения и невязки
        x += alpha * p
        r -= alpha * Ap
        
        # Проверка сходимости
        rs_new = r @ r
        norm_r = np.sqrt(rs_new)
        convergence.append(norm_r)
        
        if norm_r < tol:
            break
        
        # Обновление направления
        beta = rs_new / rs_old
        p = r + beta * p
        rs_old = rs_new
    
    return x, convergence

# Пример использования
if __name__ == "__main__":
    # Тестовый пример: диагональная матрица
    n = 5
    A = np.diag(np.arange(1, n+1))  # положительно определённая матрица
    b = np.ones(n)
    
    # Решение системы
    x, convergence = conjugate_gradient(A, b)
    
    print("Решение:")
    print(x)
    print("\nПроверка: A@x =", A @ x)
    print("Правая часть b =", b)
    print("\nИстория сходимости:")
    for i, res in enumerate(convergence):
        print(f"Итерация {i}: норма невязки = {res:.2e}")

Данная реализация метода спряжённых градиентов:

1. **Алгоритм**: Использует классическую версию метода Флетчера-Ривса
2. **Сходимость**: Возвращает историю норм невязки для мониторинга сходимости
3. **Остановка**: Критерий остановки по достижении заданной точности
4. **Эффективность**: Минимизирует количество матрично-векторных произведений (одно на итерацию)
5. **Применимость**: Работает для симметричных положительно определённых матриц

Метод особенно эффективен для больших разреженных систем, где прямое вычисление обратной матрицы невозможно.