logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

def save_log_to_file(log_history, file_path, append_latest_only=False):
    """Guarda el historial de registros en un archivo JSON. Si el archivo ya existe, se añade a él.

Parámetros:
- log_history: Lista de entradas de registro (cada entrada es un diccionario).
- file_path: Ruta al archivo donde se guardarán los registros.
- append_latest_only: Si es True, solo se añade la última entrada de registro.
"""
    file_path = Path(file_path)
    current_logs = []
    
    # Cargar logs existentes si el archivo existe
    if file_path.exists():
        try:
            content = file_path.read_text().strip()
            if content:
                current_logs = json.loads(content)
        except json.JSONDecodeError:
            logging.warning(f"{file_path} contains invalid JSON. Overwriting file.")
        except Exception as e:
            logging.error(f"Error reading {file_path}: {e}")
            return

    # Decidir qué logs añadir
    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    # Guardar logs actualizados
    try:
        file_path.parent.mkdir(parents=True, exist_ok=True)
        with file_path.open("w") as f:
            json.dump(current_logs, f, indent=4)
    except Exception as e:
        logging.error(f"Error writing to {file_path}: {e}")

def clear_directory(directory, delete_directory=False):
    """Limpia todos los archivos y subdirectorios dentro de un directorio dado. 
    Opcionalmente elimina el directorio en sí. Crea el directorio si no existe y delete_directory es False.

Args:
    directory (str): La ruta al directorio a limpiar.
    delete_directory (bool): Si es True, elimina el directorio después de limpiar su contenido.

Raises:
    OSError: Si ocurre algún error durante la eliminación de archivos o directorios.
"""
    directory = Path(directory)
    
    if not directory.exists():
        if delete_directory:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        directory.mkdir(parents=True, exist_ok=True)
        logging.info(f"Directory '{directory}' created.")
        return

    # Usar rmtree para eliminar todo el contenido de forma más eficiente
    if delete_directory:
        try:
            shutil.rmtree(directory)
            logging.info(f"Removed directory: {directory}")
        except OSError as e:
            logging.error(f"Failed to delete '{directory}'. Reason: {e}")
            raise
    else:
        # Limpiar contenido sin eliminar el directorio
        for item in directory.iterdir():
            try:
                if item.is_dir():
                    shutil.rmtree(item)
                else:
                    item.unlink()
                logging.info(f"Removed: {item}")
            except OSError as e:
                logging.error(f"Failed to delete '{item}'. Reason: {e}")
                raise

def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """Fusiona un modelo LoRA con su modelo base."""
    my_model_path = Path(model_load_path) / model_name
    param_count = model_name.lower().split("m")[0].split("-")[1]
    base_model_name = f"pythia-{param_count}M"

    # Cargar modelo base y LoRA
    base_model = AutoModelForCausalLM.from_pretrained(
        base_model_repo_name + base_model_name
    )
    model = PeftModel.from_pretrained(base_model, str(my_model_path))
    
    # Fusionar y guardar
    merged_model = model.merge_and_unload()
    my_model_save_path = Path(model_save_path) / f"{model_name}_merged"
    merged_model.save_pretrained(my_model_save_path)

def remove_repetition(question, answer):
    """Elimina repeticiones de la pregunta en la respuesta."""
    return answer.replace(question, "").strip() if question in answer else answer

def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Loads different types of models based on the model_type parameter.

    Parameters:
    model_type (str): The type of model to load. One of 'Tuned Model', 'Vanilla Model',
                      'Transformed Model', 'Final Model', or 'Host Model'.
    model_path (str): The base path where models are stored.
    blocks_str (str): A string representing the layers or blocks used in model naming.
    vanilla_model_name (str): The name or path of the vanilla (base) model.
    host_model_name (str): The name or path of the host model.

    Returns:
    model: The loaded model object.

    Raises:
    ValueError: If an unknown model_type is provided or required parameters are missing.
    """
    model_path = Path(model_path) if model_path else None
    
    if model_type == "Tuned Model":
        if not all([model_path, blocks_str, vanilla_model_name]):
            raise ValueError("Missing required parameters for Tuned Model")
        
        model_name = vanilla_model_name.split("/")[-1]
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        return AutoModelForCausalLM.from_pretrained(model_path / tuned_model_name)

    elif model_type == "Vanilla Model":
        if not vanilla_model_name:
            raise ValueError("vanilla_model_name is required for Vanilla Model")
        return AutoModelForCausalLM.from_pretrained(vanilla_model_name)

    elif model_type == "Transformed Model":
        if not all([model_path, blocks_str, host_model_name]):
            raise ValueError("Missing required parameters for Transformed Model")
        
        name = host_model_name.split("/")[-1]
        save_path = model_path / f"{name}_preGRAFTED_{blocks_str}.pkl"
        with save_path.open("rb") as f:
            return pickle.load(f)

    elif model_type == "Final Model":
        if not all([model_path, blocks_str, host_model_name]):
            raise ValueError("Missing required parameters for Final Model")
        
        name = host_model_name.split("/")[-1]
        model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
        save_path = model_path / model_save_name
        with save_path.open("rb") as f:
            return pickle.load(f)

    elif model_type == "Host Model":
        if not host_model_name:
            raise ValueError("host_model_name is required for Host Model")
        return AutoModelForCausalLM.from_pretrained(host_model_name)

    else:
        raise ValueError(f"Unknown model type: {model_type}")

def load_batch_losses(file_path):
    """Carga datos de pérdidas por lote desde un archivo de punto de control.

Parámetros:
file_path (str): La ruta al archivo de punto de control.

Devuelve:
list o None: Las pérdidas por lote si están disponibles, None en caso contrario.
"""
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"), weights_only=True)
        batch_losses = checkpoint.get("batch_losses")
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None