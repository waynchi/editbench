const cameraService = require('./camera.service');
const db = require('../database'); // Assuming you have a database connection module

const createCamera = async (req, res) => {
  try {
    // First create the camera
    const camera = await cameraService.createCamera(req.body);
    
    // Get the newly created camera with area_name using a raw join query
    const query = `
      SELECT cameras.*, areas.name as area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id 
      WHERE cameras.id = ?
    `;
    
    const [result] = await db.query(query, [camera.id]);
    
    res.status(201).json(result[0]);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const getAllCameras = async (req, res) => {
  try {
    // Modify to use raw query with join
    const query = `
      SELECT cameras.*, areas.name as area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id
    `;
    
    const cameras = await db.query(query);
    res.status(200).json(cameras);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const getCameraById = async (req, res) => {
  try {
    // Modify to use raw query with join
    const query = `
      SELECT cameras.*, areas.name as area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id 
      WHERE cameras.id = ?
    `;
    
    const [camera] = await db.query(query, [req.params.id]);
    
    if (!camera || camera.length === 0) {
      return res.status(404).json({ message: 'Camera not found' });
    }
    
    res.status(200).json(camera[0]);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const updateCamera = async (req, res) => {
  try {
    const camera = await cameraService.updateCamera(req.params.id, req.body);
    if (!camera) {
      return res.status(404).json({ message: 'Camera not found' });
    }
    
    // Get the updated camera with area_name using a raw join query
    const query = `
      SELECT cameras.*, areas.name as area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id 
      WHERE cameras.id = ?
    `;
    
    const [result] = await db.query(query, [req.params.id]);
    
    res.status(200).json(result[0]);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const deleteCamera = async (req, res) => {
  try {
    const success = await cameraService.deleteCamera(req.params.id);
    if (!success) {
      return res.status(404).json({ message: 'Camera not found' });
    }
    res.status(204).send();
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

module.exports = {
  createCamera,
  getAllCameras,
  getCameraById,
  updateCamera,
  deleteCamera,
};