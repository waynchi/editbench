# создать модуль полусумматора на Verilog с помощью Python

# код на verilog
verilog_code = """
module half_adder(a, b, c, d, e, sum, carry);
    input a, b, c, d, e;
    output sum, carry;
    wire temp_sum1, temp_carry1, temp_sum2, temp_carry2, temp_sum3, temp_carry3;
    
    // Первый полусумматор для a и b
    assign temp_sum1 = a ^ b;
    assign temp_carry1 = a & b;
    
    // Второй полусумматор для c и d
    assign temp_sum2 = c ^ d;
    assign temp_carry2 = c & d;
    
    // Третий полусумматор для temp_sum1 и e
    assign temp_sum3 = temp_sum1 ^ e;
    assign temp_carry3 = temp_sum1 & e;
    
    // Четвертый полусумматор для temp_sum2 и temp_sum3
    assign sum = temp_sum2 ^ temp_sum3;
    wire final_carry1 = temp_sum2 & temp_sum3;
    
    // Суммирование всех переносов
    assign carry = temp_carry1 | temp_carry2 | temp_carry3 | final_carry1;
endmodule
"""

# имя модуля verilog
module_name = "half_adder"

# входные и выходные порты модуля verilog
input_ports = ["a", "b", "c", "d", "e"]
