const cameraService = require('./camera.service');
const db = require('../config/database'); // 假设数据库配置在这里

const createCamera = async (req, res) => {
  try {
    const camera = await cameraService.createCamera(req.body);
    
    // 获取新创建的相机及其关联的区域名称
    const query = `
      SELECT cameras.*, areas.area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id 
      WHERE cameras.id = ?
    `;
    
    const [result] = await db.query(query, [camera.id]);
    res.status(201).json(result[0]);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const getAllCameras = async (req, res) => {
  try {
    const query = `
      SELECT cameras.*, areas.area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id
    `;
    
    const [cameras] = await db.query(query);
    res.status(200).json(cameras);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const getCameraById = async (req, res) => {
  try {
    const query = `
      SELECT cameras.*, areas.area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id 
      WHERE cameras.id = ?
    `;
    
    const [cameras] = await db.query(query, [req.params.id]);
    
    if (cameras.length === 0) {
      return res.status(404).json({ message: 'Camera not found' });
    }
    
    res.status(200).json(cameras[0]);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const updateCamera = async (req, res) => {
  try {
    const camera = await cameraService.updateCamera(req.params.id, req.body);
    
    if (!camera) {
      return res.status(404).json({ message: 'Camera not found' });
    }
    
    // 获取更新后的相机及其关联的区域名称
    const query = `
      SELECT cameras.*, areas.area_name 
      FROM cameras 
      LEFT JOIN areas ON cameras.area_id = areas.id 
      WHERE cameras.id = ?
    `;
    
    const [result] = await db.query(query, [req.params.id]);
    res.status(200).json(result[0]);
  } catch (error) {
     res.status(500).json({ error: error.message });
  }
};

const deleteCamera = async (req, res) => {
  try {
    const success = await cameraService.deleteCamera(req.params.id);
    if (!success) {
      return res.status(404).json({ message: 'Camera not found' });
    }
    res.status(204).send();
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

module.exports = {
  createCamera,
  getAllCameras,
  getCameraById,
  updateCamera,
  deleteCamera,
};