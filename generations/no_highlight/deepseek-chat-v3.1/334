# wygeneruj moduł półsumatora w verilog za pomocą pythona

# kod verilog
verilog_code = """
module half_adder(a, b, enable, clk, rst, c, sum, carry, valid);
    input a, b, enable, clk, rst;
    output c, sum, carry, valid;
    reg valid_reg;
    
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            valid_reg <= 1'b0;
        end else if (enable) begin
            valid_reg <= 1'b1;
        end else begin
            valid_reg <= 1'b0;
        end
    end
    
    assign c = a ^ b;
    assign sum = a & b;
    assign carry = a & b;
    assign valid = valid_reg;
endmodule
"""

