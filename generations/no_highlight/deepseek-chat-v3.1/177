import os
import time
import undetected_chromedriver as uc

# 获取当前脚本的目录
script_dir = os.path.dirname(os.path.abspath(__file__))

# 构建到 Chrome 浏览器的路径，而不是 chromedriver
# 通常 Chrome 安装在默认位置，或者需要指定正确的路径
chrome_binary_path = r"C:\Program Files\Google\Chrome\Application\chrome.exe"

# 检查 Chrome 是否存在
if not os.path.exists(chrome_binary_path):
    raise FileNotFoundError(f"Chrome browser not found at: {chrome_binary_path}")

options = uc.ChromeOptions()
options.binary_location = chrome_binary_path  # 设置 Chrome 浏览器的路径

# 添加一些常用选项来避免连接问题
options.add_argument("--no-sandbox")
options.add_argument("--disable-dev-shm-usage")
options.add_argument("--remote-debugging-port=0")
options.add_argument("--disable-blink-features=AutomationControlled")
options.add_experimental_option("excludeSwitches", ["enable-automation"])
options.add_experimental_option("useAutomationExtension", False)

print("Starting browser...")
try:
    with uc.Chrome(options=options) as driver:
        print("Browser started successfully")
        driver.execute_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")
        driver.get("https://lmarena.ai/")
        print("Page loaded")
        time.sleep(10)
        print("Test completed successfully")
except Exception as e:
    print(f"Error occurred: {e}")
    print("Make sure Chrome browser is installed and up to date")