from langchain_ollama import ChatOllama
from langchain_core.prompts.chat import ChatPromptTemplate
import json

def generate_shap_explanation(shap_json_path="Vuori_Final_Approval_2024_09_24.json", 
                             system_prompt_path="system.prompt",
                             model_name="llama3.2",
                             base_url="http://localhost:11434",
                             **kwargs):
    """
    Generuje wyjaśnienie wartości SHAP przy użyciu modelu ChatOllama.
    
    Args:
        shap_json_path (str): Ścieżka do pliku JSON z wartościami SHAP
        system_prompt_path (str): Ścieżka do pliku z promptem systemowym
        model_name (str): Nazwa modelu Ollama do użycia
        base_url (str): URL bazy Ollama
        **kwargs: Dodatkowe argumenty dla ChatOllama
        
    Returns:
        str: Wygenerowana odpowiedź modelu
    """
    # Zainicjuj model ChatOllama
    chat_model = ChatOllama(model=model_name, base_url=base_url, **kwargs)
    
    # Załaduj wartości SHAP z pliku JSON
    with open(shap_json_path, "r") as file:
        shap_values_json = json.load(file).get("shap_values")
    
    # Wczytaj systemowy prompt z pliku
    with open(system_prompt_path, "r") as file:
        sys_prompt = file.read().strip()
    
    # Przygotuj wiadomości
    prompt = ChatPromptTemplate(
        [
            ("system", sys_prompt),
            ("human", "{user_input}"),
        ]
    )
    
    # Przygotuj dane wejściowe użytkownika
    user_input = json.dumps(shap_values_json)
    
    # Utwórz łańcuch i wywołaj
    chain = prompt | chat_model
    response = chain.invoke(user_input)
    
    return response.content

# Przykład użycia:
if __name__ == "__main__":
    # Podstawowe użycie
    result = generate_shap_explanation()
    print(result)
    
