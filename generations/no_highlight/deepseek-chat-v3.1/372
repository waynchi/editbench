from pyspark.sql import SparkSession
from pyspark.sql.functions import col, from_json, schema_of_json
from pyspark.sql.types import StructType, StringType

# Utwórz sesję Spark
spark = SparkSession.builder.appName("AnalizaDanychAPI").getOrCreate()

# Przykładowe dane JSON z API (zastąp rzeczywistymi danymi z API)
json_data = [
    '{"id": 1, "nombre": "Juan", "edad": 30, "ciudad": "Madrid"}',
    '{"id": 2, "nombre": "Ana", "edad": 25, "departamento": "IT"}',
    '{"id": 3, "nombre": "Pedro", "edad": 40, "pais": "España", "salario": 50000}'
]

# Utwórz RDD z danych JSON
rdd = spark.sparkContext.parallelize(json_data)

# Odczytaj dane jako DataFrame z kolumną wartości string
df_raw = spark.read.json(rdd)

# Wyświetl surowe dane do analizy struktury
print("Surowe dane z API:")
df_raw.show(truncate=False)
print("Schema surowych danych:")
df_raw.printSchema()

# Jeśli dane mają spójną strukturę, można je bezpośrednio przetworzyć
