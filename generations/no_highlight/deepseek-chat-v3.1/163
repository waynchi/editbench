def crear_estructura_jerarquica(post, replies_list):
    """Crea una estructura jerárquica para un post y sus respuestas"""
    post_structure = {
        'post': {
            'author': post['author'],
            'permlink': post['permlink'],
            'title': post.get('title', ''),
            'body': post.get('body', ''),
            'children': []
        }
    }
    
    for reply in replies_list:
        reply_data = {
            'author': reply['author'],
            'permlink': reply['permlink'],
            'body': reply['body'],
            'children': []
        }
        post_structure['post']['children'].append(reply_data)
    
    return post_structure

q = Query()
d = Discussions()
posts_generator = d.get_discussions("created", q, limit=6000)
X = 0
estructura_jerarquica = {}

for post in posts_generator:
    post_author = post['author']
    post_permlink = post['permlink']
    post_replies = post['children']
    cnt = 0
    X += 1
    
    if post_replies > n_respuestas_minimas:
        comment = Comment(authorperm=f"{post_author}/{post_permlink}")
        post_replies_list = comment.get_replies()
        
        cnt = 0
        for reply in post_replies_list:
            author = reply['author']
            text = reply['body']
            
            if is_own_author(author):
                break
            if is_banned(author):
                break
            if procesar(text):
                cnt += 1
        
        # Crear estructura jerárquica para este post
        if cnt > 3:
            post_key = f"{post_author}/{post_permlink}"
            estructura_jerarquica[post_key] = crear_estructura_jerarquica(post, post_replies_list)
            
            print("Iterador: ", X)
            print(f"Post: {post_author}/{post_permlink}")
            print(f"Respuestas procesadas: {len(post_replies_list)}")
            print("---")

# Mostrar la estructura jerárquica completa
