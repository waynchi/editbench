import numpy as np

INPUT_FILE_PATH = './input.txt'

def main():
    """
    Main function that reads input data, processes it, and calculates the sum of distances.
    """
    try:
        lines = parse_input_file()
        if not lines or len(lines) == 0:
            print("Input file is empty")
            return
            
        print("Input data:", lines)
        
        # Process data into columns
        cols = [line.split() for line in lines if line.strip()]
        cols = np.array(cols).T.astype(int)
        
        list_1 = list(cols[0])
        list_2 = list(cols[1])
        
        all_dists = []
        
        # Process lists until empty
        while list_1 and list_2:
            argmin_1 = np.argmin(list_1)
            min_1 = list_1.pop(argmin_1)
            
            argmin_2 = np.argmin(list_2)
            min_2 = list_2.pop(argmin_2)
            
            dist = abs(min_1 - min_2)
            all_dists.append(dist)
            
        result = sum(all_dists)
        print(f"Sum of distances: {result}")
        
    except FileNotFoundError:
        print(f"Error: File '{INPUT_FILE_PATH}' not found")
    except ValueError as e:
        print(f"Error: Invalid data format in input file - {e}")
    except Exception as e:
        print(f"Unexpected error: {e}")

def parse_input_file():
    """
    Read and parse the input file.
    
    Returns:
        list: List of lines from the input file
    """
    with open(INPUT_FILE_PATH, 'r') as f:
        lines = [line.strip() for line in f.readlines() if line.strip()]
    return lines

if __name__ == "__main__":
    main()