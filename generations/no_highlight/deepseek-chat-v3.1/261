from langchain_ollama import ChatOllama
from langchain.schema import HumanMessage, SystemMessage
import json

# Load SHAP values from JSON file
with open("Vuori_Final_Approval_2024_09_24.json", "r") as file:
    shap_values_json = json.load(file).get("shap_values")

# Load system prompt
with open("system.prompt", "r") as file:
    sys_prompt = file.read().strip()

# Create the ChatOllama instance instead of using the client directly
llm = ChatOllama(
    model="llama3.2",
    base_url="http://localhost:11434"
)

# Prepare messages using LangChain schema
messages = [
    SystemMessage(content=sys_prompt),
    HumanMessage(content=str(shap_values_json))
]

# Get response using LangChain's invoke method
response = llm.invoke(messages)

print(response.content)