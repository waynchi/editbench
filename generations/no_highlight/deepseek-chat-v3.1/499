import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_config, n_clusters=2, clustering_method='kmeans'):
    """Realiza la agrupación de datos de manera independiente para conjuntos de columnas especificados.

Args:
    features_transformed (pandas.DataFrame): DataFrame transformado con parámetros.
    cluster_config (dict): Diccionario donde las claves son nombres de nuevas columnas y los valores son tuplas/listas de columnas a agrupar.
    n_clusters (int): Número de clústeres.
    clustering_method (str): Método de agrupación ('kmeans').

Returns:
    pandas.DataFrame: DataFrame con las columnas de etiquetas de clústeres añadidas."""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()

    for cluster_feature_name, columns in cluster_config.items():
        # Verificar que las columnas existan en el DataFrame
        missing_columns = [col for col in columns if col not in features_for_clustering.columns]
        if missing_columns:
            print(f"Advertencia: Las siguientes columnas no existen y serán omitidas: {missing_columns}")
            columns = [col for col in columns if col in features_for_clustering.columns]
        
        if len(columns) == 0:
            print(f"Advertencia: No hay columnas válidas para el cluster '{cluster_feature_name}'. Se omite.")
            continue

        # Seleccionar solo las columnas especificadas para este cluster
        cluster_data_subset = features_for_clustering[columns]

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(cluster_data_subset)
            
            # Evaluación de la calidad de la agrupación
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(cluster_data_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров в '{cluster_feature_name}': {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера в '{cluster_feature_name}' (все точки в одном кластере).")

        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        features_transformed[cluster_feature_name] = cluster_labels
        print(f"Кластеризация para '{cluster_feature_name}' выполнена. Метки кластеров добавлены в столбец '{cluster_feature_name}'.")

    return features_transformed

# Ejecución de la clusterización (después de la etapa 5 y antes de la etapa 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Configuración de clusters: {nombre_columna: (col1, col2, ...)}
    cluster_config = {
        'cluster_group1': ('columna1', 'columna2'),
        'cluster_group2': ('columna3',)
    }
    
    n_clusters = 3  # Cantidad de clústeres (seleccione el valor óptimo)
    features_transformed = cluster_data(features_transformed, cluster_config, n_clusters)
    
    # Visualización de los clústeres para cada grupo
    for cluster_feature_name in cluster_config.keys():
        if cluster_feature_name in features_transformed.columns:
            numerical_features = features_transformed.select_dtypes(include=np.number)
            # Seleccionar solo las columnas utilizadas para este cluster
            cluster_columns = cluster_config[cluster_feature_name]
            available_columns = [col for col in cluster_columns if col in numerical_features.columns]
            
            if len(available_columns) >= 2:
                plt.figure(figsize=(8, 6))
                plt.scatter(numerical_features[available_columns[0]], 
                           numerical_features[available_columns[1]], 
                           c=features_transformed[cluster_feature_name], 
                           cmap='viridis')
                plt.xlabel(available_columns[0])
                plt.ylabel(available_columns[1])
                plt.title(f'Результаты кластеризации - {cluster_feature_name}')
                plt.colorbar(label='Номер кластера')
                plt.show()
            elif len(available_columns) == 1:
                print(f"Solo hay una columna numérica disponible para visualizar '{cluster_feature_name}'.")
            else:
                print(f"No hay columnas numéricas disponibles para visualizar '{cluster_feature_name}'.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")