import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=None):
    """
    Rozwiązuje układ równań liniowych Ax = b przy użyciu metody sprzężonych gradientów.
    
    Parametry:
    A: macierz współczynników (n x n) - musi być symetryczna, dodatnio określona
    b: wektor wyrazów wolnych (n,)
    x0: początkowy wektor rozwiązania (domyślnie wektor zerowy)
    tol: tolerancja błędu (domyślnie 1e-6)
    max_iter: maksymalna liczba iteracji (domyślnie n)
    
    Zwraca:
    x: przybliżone rozwiązanie układu równań
    converged: flaga wskazująca czy metoda zbiegła
    k: liczba wykonanych iteracji
    """
    n = len(b)
    
    if max_iter is None:
        max_iter = n
    
    # Sprawdzenie wymiarów
    if A.shape != (n, n):
        raise ValueError("Niezgodne wymiary macierzy A i wektora b")
    
    # Inicjalizacja wektora startowego
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    # Obliczenie residuum
    r = b - A @ x
    p = r.copy()
    
    # Pierwsza norma residuum
    r_norm_sq = np.dot(r, r)
    
    # Sprawdzenie zbieżności początkowej
    if np.sqrt(r_norm_sq) < tol:
        return x, True, 0
    
    for k in range(max_iter):
        # Obliczenie iloczynu macierz-wektor
        Ap = A @ p
        
        # Współczynnik alpha
        alpha = r_norm_sq / np.dot(p, Ap)
        
        # Aktualizacja rozwiązania
        x += alpha * p
        
        # Aktualizacja residuum
        r_new = r - alpha * Ap
        
        # Sprawdzenie zbieżności
        r_new_norm_sq = np.dot(r_new, r_new)
        if np.sqrt(r_new_norm_sq) < tol:
            return x, True, k + 1
        
        # Współczynnik beta
        beta = r_new_norm_sq / r_norm_sq
        
        # Aktualizacja kierunku
        p = r_new + beta * p
        
        # Aktualizacja zmiennych dla następnej iteracji
        r = r_new
        r_norm_sq = r_new_norm_sq
    
    return x, False, max_iter

# Przykład użycia
if __name__ == "__main__":
    # Przykładowa macierz symetryczna, dodatnio określona
    A = np.array([[4, 1], [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # Rozwiązanie referencyjne
    x_ref = np.linalg.solve(A, b)
    
    # Rozwiązanie metodą sprzężonych gradientów
    x, converged, iterations = conjugate_gradient(A, b)
    
    print("Macierz A:")
    print(A)
    print("\nWektor b:", b)
    print("\nRozwiązanie referencyjne:", x_ref)
    print("Rozwiązanie CG:", x)
    print("Czy zbiegło?:", converged)
    print("Liczba iteracji:", iterations)
    print("Błąd:", np.linalg.norm(x - x_ref))