from dataclasses import dataclass
import numpy as np
norm = np.random.normal

@dataclass
class NeuralNetwork:
    inp: ...  # 输入节点（输入中的神经元数量，即输入的数量）
    hid: ...  # 隐藏节点（中间神经元的数量，即在中间处理的数字数量）
    out: ...  # 输出节点（输出神经元的数量，即输出中的数字）
    lr: ...   # 学习率（平滑系数α）
    act: ...  # 激活函数（神经元输出对神经元输入的依赖性）
    epo: ...  # epochs（神经元的时代数）

    def __post_init__(self):  # 生成权重
        # 修正：使用正确的标准差计算方式，通常使用输入/输出节点数的平方根的倒数
        self.wih = norm(0.0, 1.0 / np.sqrt(self.inp), (self.hid, self.inp))
        self.who = norm(0.0, 1.0 / np.sqrt(self.hid), (self.out, self.hid))

    def train(self, x, y):
        x = np.array(x, ndmin=2).T
        y = np.array(y, ndmin=2).T

        # 前向传播
        ho = self.act(self.wih @ x)  # 隐藏层输出
        fo = self.act(self.who @ ho)  # 最终输出
        
        # 反向传播
        oe = y - fo  # 输出误差
        he = self.who.T @ oe  # 隐藏误差
        
        # 修正：添加激活函数导数项进行权重更新
        self.who += self.lr * ((oe * fo * (1.0 - fo)) @ ho.T)
        self.wih += self.lr * ((he * ho * (1.0 - ho)) @ x.T)

    def query(self, x):
        x = np.array(x, ndmin=2).T
        ho = self.act(self.wih @ x)  # 隐藏层输出
        fo = self.act(self.who @ ho)  # 最终输出
        return fo

    def fit(self, X, y):
        for e in range(self.epo):
            for i in range(len(y)):
                self.train(X[i], y[i])

    def predict(self, X):
        return np.array([np.argmax(self.query(x)) for x in X])

    def score(self, X, y):
        y = np.array([np.argmax(i) for i in y])
        return (self.predict(X) == y).mean()