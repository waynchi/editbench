from langchain_ollama import ChatOllama
from langchain_core.prompts.chat import ChatPromptTemplate
import json

def generate_shap_analysis(shap_json_file="Vuori_Final_Approval_2024_09_24.json", 
                          system_prompt_file="system.prompt",
                          model="llama3.2", 
                          base_url="http://localhost:11434"):
    """
    基于SHAP值生成分析响应的函数
    
    Args:
        shap_json_file: SHAP值的JSON文件路径
        system_prompt_file: 系统提示文件路径
        model: Ollama模型名称
        base_url: Ollama服务地址
    
    Returns:
        str: 模型的响应内容
    """
    # 初始化 ChatOllama 模型
    chat_model = ChatOllama(model=model, base_url=base_url)
    
    # 从 JSON 文件加载 SHAP 值
    with open(shap_json_file, "r") as file:
        shap_values_json = json.load(file).get("shap_values")
    
    # 从文件加载系统提示
    with open(system_prompt_file, "r") as file:
        sys_prompt = file.read().strip()
    
    # 准备消息模板
    prompt = ChatPromptTemplate(
        [
            ("system", sys_prompt),
            ("human", "{user_input}"),
        ]
    )
    
    # 准备用户输入
    user_input = json.dumps(shap_values_json)
    
    # 创建处理链
    chain = prompt | chat_model
    
    # 生成响应
    response = chain.invoke({"user_input": user_input})
    
    return response.content

# 使用示例
if __name__ == "__main__":
    result = generate_shap_analysis()
    print(result)