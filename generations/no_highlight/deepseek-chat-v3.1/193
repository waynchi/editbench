import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_config, n_clusters=2, clustering_method='kmeans'):
    """执行多组数据的独立聚类。

参数：
    features_transformed (pandas.DataFrame): 转换后的包含参数的DataFrame。
    cluster_config (dict): 聚类配置字典，格式为 {新列名: [特征列列表], ...}。
    n_clusters (int): 聚类数量。
    clustering_method (str): 聚类方法（'kmeans'）。

返回：
    pandas.DataFrame: 添加了多个聚类标签列的DataFrame。"""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    if not isinstance(cluster_config, dict):
        print("cluster_config должен быть словарем формата {новое_имя_столбца: [список_столбцов]}")
        return None

    features_for_clustering = features_transformed.copy()

    for cluster_name, feature_columns in cluster_config.items():
        if not isinstance(feature_columns, (list, tuple)):
            feature_columns = [feature_columns]
        
        # 检查所有指定的列是否存在
        missing_columns = [col for col in feature_columns if col not in features_for_clustering.columns]
        if missing_columns:
            print(f"Предупреждение: Столбцы {missing_columns} не найдены для кластера '{cluster_name}'. Пропускаем.")
            continue
        
        if len(feature_columns) == 0:
            print(f"Предупреждение: Не указаны столбцы для кластера '{cluster_name}'. Пропускаем.")
            continue
        
        # 提取指定列进行聚类
        cluster_data_subset = features_for_clustering[feature_columns]
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(cluster_data_subset)
            
            # 评估聚类质量
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(cluster_data_subset, cluster_labels)
                print(f"Коэффициент силуэта для кластера '{cluster_name}' ({n_clusters} кластеров): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для кластера '{cluster_name}' (все точки в одном кластере).")

        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        features_for_clustering[cluster_name] = cluster_labels
        print(f"Кластеризация '{cluster_name}' выполнена. Метки добавлены в столбец '{cluster_name}'.")

    return features_for_clustering

# 执行聚类（在步骤5之后和步骤6之前）
if 'features_transformed' in locals() and features_transformed is not None:
    # 配置多个独立的聚类
    cluster_config = {
        'cluster_group1': ['feature1', 'feature2'],  # 对前两列进行聚类
        'cluster_group2': ['feature3']               # 对第三列进行聚类
    }
    
    n_clusters = 3  # 簇的数量
    features_transformed = cluster_data(features_transformed, cluster_config, n_clusters)
    
    # 可视化每个聚类结果
    numerical_features = features_transformed.select_dtypes(include=np.number)
    
    for cluster_name in cluster_config.keys():
        if cluster_name in features_transformed.columns:
            if numerical_features.shape[1] >= 2:
                plt.figure(figsize=(8, 6))
                plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], 
                           c=features_transformed[cluster_name], cmap='viridis')
                plt.xlabel(numerical_features.columns[0])
                plt.ylabel(numerical_features.columns[1])
                plt.title(f'Результаты кластеризации: {cluster_name}')
                plt.colorbar(label='Номер кластера')
                plt.show()
            else:
                print(f"Недостаточно числовых признаков для визуализации кластера '{cluster_name}' на плоскости.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")