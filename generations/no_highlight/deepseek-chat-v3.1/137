def binary_search(arr, target):
    """
    在已排序的数组arr中查找目标值target
    
    参数:
    arr: 已排序的列表
    target: 要查找的目标值
    
    返回:
    如果找到目标值，返回其索引
    如果未找到目标值，返回-1
    """
    left = 0
    right = len(arr) - 1
    
    while left <= right:
        mid = (left + right) // 2
        
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    
    return -1