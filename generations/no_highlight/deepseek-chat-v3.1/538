import numpy as np

INPUT_FILE_PATH = './input.txt'
# INPUT_FILE_PATH = './example_in.txt'

def main():
    lines = parse_input_file()
    # Remove empty lines and ensure all lines have the same length
    lines = [line.strip() for line in lines if line.strip()]
    
    if not lines:
        print("No valid input found")
        return
        
    # Check if all lines have the same length
    line_lengths = [len(line) for line in lines]
    if len(set(line_lengths)) > 1:
        print("Warning: Lines have different lengths")
        # Use the minimum length to avoid index errors
        min_length = min(line_lengths)
        lines = [line[:min_length] for line in lines]
    
    grid = np.array([list(line) for line in lines])
    print(grid)
    str_to_match = "XMAS"
    count = 0
    
    # Check horizontally
    for row in grid:
        row_str = ''.join(row)
        count += row_str.count(str_to_match)
        count += row_str.count(str_to_match[::-1])  # Also count "SAMX"

    # Check vertically
    for col in range(grid.shape[1]):
        col_str = ''.join(grid[:, col])
        count += col_str.count(str_to_match)
        count += col_str.count(str_to_match[::-1])  # Also count "SAMX"

    # Check diagonally (top-left to bottom-right)
    for i in range(-(grid.shape[0]-1), grid.shape[1]):
        diag = np.diagonal(grid, offset=i)
        diag_str = ''.join(diag)
        count += diag_str.count(str_to_match)
        count += diag_str.count(str_to_match[::-1])  # Also count "SAMX"

    # Check diagonally (top-right to bottom-left)
    flipped_grid = np.fliplr(grid)
    for i in range(-(flipped_grid.shape[0]-1), flipped_grid.shape[1]):
        diag = np.diagonal(flipped_grid, offset=i)
        diag_str = ''.join(diag)
        count += diag_str.count(str_to_match)
        count += diag_str.count(str_to_match[::-1])  # Also count "SAMX"

    print(f"Found {count} occurrences of {str_to_match} and {str_to_match[::-1]}")

def parse_input_file():
    try:
        with open(INPUT_FILE_PATH, 'r') as f:
            lines = f.read().split("\n")
        return lines
    except FileNotFoundError:
        print(f"File {INPUT_FILE_PATH} not found")
        return []

if __name__ == "__main__":
    main()