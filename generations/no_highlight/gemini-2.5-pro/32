import random
import string
from beem.discussions import Discussions, Query
from beem.comment import Comment

# --- Parámetros y Variables Globales ---
n_respuestas_minimas = 5
# El diccionario jerárquico que se va a poblar
diccionario = {}

# --- Funciones de Utilidad (Originales y Modificadas) ---

def procesar(texto: str) -> bool:
    """Verifica si el texto de un comentario contiene la frase de participación."""
    return "count me " in texto.lower()

def is_own_author(autor: str) -> bool:
    """Verifica si el autor es el autor propio del bot (corregido)."""
    # BUG FIX: La variable global 'author' no existe, se debe usar el parámetro 'autor'.
    return autor == 'subidu'

def is_banned(autor: str) -> bool:
    """Verifica si un autor está en la lista de baneados."""
    list_banned = []  # Ejemplo: ['bad-actor1', 'spammer_x']
    return autor in list_banned

def generar_permlink_unico() -> str:
    """Genera un permlink aleatorio para un nuevo comentario."""
    return "".join(random.choices(string.ascii_lowercase + string.digits, k=10))

