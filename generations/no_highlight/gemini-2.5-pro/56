def medcouple(data):
    """
    Computes the medcouple, a robust measure of skewness.
    This implementation is vectorized to fix the ValueError and improve performance.
    """
    data_arr = np.sort(np.asarray(data))
    n = len(data_arr)

    if n == 0:
        return np.nan

    median_val = np.median(data_arr)

    # Split data into left and right of the median
    left = data_arr[data_arr <= median_val]
    right = data_arr[data_arr >= median_val]

    # Count of values equal to the median
    k = np.sum(data_arr == median_val)

    # Create a meshgrid for all pairs (xi, xj) where xi is from the left part and xj from the right part
    xi, xj = np.meshgrid(left, right, indexing='ij')

    # Vectorized kernel function h(xi, xj)
    numerator = (xj - median_val) - (median_val - xi)
    denominator = xj - xi
    
    # Calculate the standard kernel for all pairs.
    # np.divide handles division by zero, returning 0 where xi == xj.
    h_matrix = np.divide(numerator, denominator, out=np.zeros_like(numerator, dtype=float), where=(denominator != 0))

    # If there are ties in the median, apply the special kernel for those specific pairs.
    if k > 1:
        # Vectorized version of the special_h function logic from the original code: sign((i+j-1)-k)
        # It is applied only where xi and xj are both the median.
        i_grid, j_grid = np.meshgrid(np.arange(len(left)), np.arange(len(right)), indexing='ij')
        
        # Calculate special kernel values based on indices. This translates the original
        # if/elif/else into a single vectorized numpy operation.
        special_h_vals = np.sign((i_grid + j_grid - 1) - k).astype(float)
        
        # Create a boolean mask to identify where both xi and xj are the median
        median_tie_mask = (xi == median_val) & (xj == median_val)
        
        # Use the mask to update h_matrix with the special values only for the relevant pairs
        h_matrix[median_tie_mask] = special_h_vals[median_tie_mask]
        
    return np.median(h_matrix)

def adjusted_boxplot_bounds(data):
    """
    Вычисляет границы adjusted boxplot с учетом skewness-adjusted fences.
    """
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """
    Нормализация с использованием adjusted boxplot.
    """
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

