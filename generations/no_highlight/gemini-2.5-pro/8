import math

def find_four_squares_sums(limit):
    """
    Efficiently finds all numbers up to a given limit that can be expressed as
    the sum of four non-zero squares.

    This implementation works by pre-calculating all possible sums of two non-zero
    squares up to the limit. It then combines these pairs of sums to find all
    possible sums of four non-zero squares.

    Args:
        limit (int): The upper bound for the search.

    Returns:
        dict: A dictionary where keys are the numbers that are sums of four
              non-zero squares, and values are the tuple (a, b, c, d)
              representing one such decomposition (n = a^2 + b^2 + c^2 + d^2).
    """
    results = {}
    if limit < 4:  # The smallest sum of four non-zero squares is 1+1+1+1=4
        return results

    # 1. Pre-calculate all sums of two non-zero squares up to the limit.
    # Store them in a dictionary {sum: (sqrt1, sqrt2)} for easy lookup.
    two_square_sums = {}
    max_val = int(math.sqrt(limit)) + 1
    for i in range(1, max_val):
        i_sq = i * i
        # j starts from i to avoid duplicate pairs (like 3^2+4^2 and 4^2+3^2)
        for j in range(1, i + 1):
            j_sq = j * j
            current_sum = i_sq + j_sq
            if current_sum > limit:
                break  # Optimization: further j values will also exceed the limit
            if current_sum not in two_square_sums:
                two_square_sums[current_sum] = (i, j)

    # 2. Combine pairs of these "two-square sums" to find "four-square sums".
    # Get a sorted list of the sums for efficient iteration.
    s1_keys = sorted(two_square_sums.keys())

    for i, s1 in enumerate(s1_keys):
        # Iterate from the current index `i` to avoid duplicate combinations
        # of sums (e.g., s1+s2 is the same as s2+s1).
        for j in range(i, len(s1_keys)):
            s2 = s1_keys[j]
            n = s1 + s2

            if n > limit:
                break  # Optimization: further s2 values will also exceed the limit

            # If we haven't found a solution for n yet, store this one.
            if n not in results:
                a, b = two_square_sums[s1]
                c, d = two_square_sums[s2]
                results[n] = (a, b, c, d)

    return results

# Main execution block
if __name__ == "__main__":
    try:
        limit_input = int(input("Digite o limite superior: "))

        sums_found = find_four_squares_sums(limit_input)

        print("\nNúmeros que podem ser expressos como a soma de quatro quadrados não nulos:")

        if not sums_found:
            print(f"Nenhum número encontrado até {limit_input}.")
        else:
            # Sort the results by the number `n` for ordered printing
            for num in sorted(sums_found.keys()):
                a, b, c, d = sums_found[num]
                print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")

    except ValueError:
        print("Entrada inválida. Por favor, digite um número inteiro.")
