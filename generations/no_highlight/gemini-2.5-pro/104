import unittest
import io
from contextlib import redirect_stdout
from collections import deque

class Graph:
    def __init__(self):
        """
        Initializes an undirected graph using an adjacency list representation.
        """
        self.adjacency_list = {}

    def add_vertex(self, vertex):
        """
        Adds a vertex to the graph if it doesn't already exist.
        Args:
            vertex: The vertex to add.
        """
        if vertex not in self.adjacency_list:
            self.adjacency_list[vertex] = []

    def add_edge(self, vertex1, vertex2):
        """
        Adds an undirected edge between two existing vertices.
        Args:
            vertex1: The first vertex.
            vertex2: The second vertex.
        """
        if vertex1 in self.adjacency_list and vertex2 in self.adjacency_list:
            # Check to avoid adding duplicate edges
            if vertex2 not in self.adjacency_list[vertex1]:
                self.adjacency_list[vertex1].append(vertex2)
            if vertex1 not in self.adjacency_list[vertex2]:
                self.adjacency_list[vertex2].append(vertex1)

    def __str__(self):
        """
        Returns a string representation of the graph's adjacency list.
        """
        return str(self.adjacency_list)

    def remove_vertex(self, vertex):
        """
        Removes a vertex and all its associated edges from the graph.
        Args:
            vertex: The vertex to remove.
        """
        if vertex in self.adjacency_list:
            # Remove edges from neighbors' lists pointing back to this vertex
            for neighbor in self.adjacency_list[vertex]:
                if neighbor in self.adjacency_list:
                    self.adjacency_list[neighbor].remove(vertex)
            # Delete the vertex itself from the adjacency list
            del self.adjacency_list[vertex]

    def remove_edge(self, vertex1, vertex2):
        """
        Removes an edge between two vertices.
        Args:
            vertex1: The first vertex.
            vertex2: The second vertex.
        """
        if vertex1 in self.adjacency_list and vertex2 in self.adjacency_list:
            try:
                self.adjacency_list[vertex1].remove(vertex2)
                self.adjacency_list[vertex2].remove(vertex1)
            except ValueError:
                # This block executes if the edge doesn't exist, which is a safe failure.
                pass

    def dfs(self, start_vertex, visited=None):
        """
        Perform a depth-first search (DFS) starting from the given vertex.
        This implementation prints the visited vertices.
        Args:
            start_vertex: The starting vertex for the DFS.
            visited (set, optional): A set of already visited vertices. Defaults to None.
        """
        if start_vertex not in self.adjacency_list:
            return

        if visited is None:
            visited = set()
        
        visited.add(start_vertex)
        print(start_vertex, end=' ')
        
        for neighbor in self.adjacency_list[start_vertex]:
            if neighbor not in visited:
                self.dfs(neighbor, visited)
    
    def bfs(self, start_vertex):
        """
        Perform a breadth-first search (BFS) starting from the given vertex.
        This implementation prints the visited vertices and uses an efficient deque.
        Args:
            start_vertex: The starting vertex for the BFS.
        """
        if start_vertex not in self.adjacency_list:
            return

        visited = {start_vertex}
        queue = deque([start_vertex])
        
        while queue:
            vertex = queue.popleft()
            print(vertex, end=' ')
            
            for neighbor in self.adjacency_list[vertex]:
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append(neighbor)


