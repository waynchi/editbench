import numpy as np
from typing import Dict, List, Any
from simulator.model.bidder import _Bidder
from simulator.simulation.modules import History
from simulator.model.traffic import Traffic


class Mystique(_Bidder):
    """
    Mystique bidding strategy implementation.

    This bidder uses a PID-like controller to adjust bids based on spending
    pace. It aims to follow a target spending curve derived from historical
    traffic patterns, adjusting the bid to correct for deviations in
    both total spend and spending rate.
    """

    default_params = {
        'traffic_path': '../data/traffic_share.csv',
        'initial_bid': 300.0,
        'c_max': 50,
        'c_min': 5,
        'e_max': 10,
        'e_gmc': 10
    }

    def __init__(self, params: dict = None):
        """
        Initializes the Mystique bidder.

        Args:
            params (dict, optional): A dictionary of parameters to override
                                     defaults. Defaults to None.
        """
        super().__init__()
        params = params or {}

        # --- Bidder State ---
        self.count: int = 0
        self.balance_previous: List[float] = []
        self.bid_previous: List[float] = []
        self.timestamp_previous: List[int] = []

        # --- Configuration Parameters ---
        self.initial_bid = params.get(
            'initial_bid', self.default_params['initial_bid']
        )
        self.c_max = params.get('c_max', self.default_params['c_max'])
        self.c_min = params.get('c_min', self.default_params['c_min'])
        self.e_max = params.get('e_max', self.default_params['e_max'])
        self.e_gmc = params.get('e_gmc', self.default_params['e_gmc'])

        # --- External Data Models ---
        traffic_path = params.get(
            'traffic_path', self.default_params['traffic_path']
        )
        self.traffic = Traffic(path=traffic_path)

    def _update_history(self, balance: float, timestamp: int, bid: float):
        """Appends the latest auction results to the internal history."""
        self.balance_previous.append(balance)
        self.timestamp_previous.append(timestamp)
        self.bid_previous.append(bid)

    def place_bid(self, bidding_input_params: Dict[str, Any],
                  history: History) -> float:
        """
        Calculates and places a bid for the current auction opportunity.

        Args:
            bidding_input_params (Dict[str, Any]): A dictionary containing all
                necessary parameters for the current bidding context.
            history (History): The campaign history object (not used by this
                               implementation, which maintains its own).

        Returns:
            float: The calculated bid value.
        """
        self.count += 1

        # Unpack bidding parameters
        start = bidding_input_params['campaign_start_time']
        end = bidding_input_params['campaign_end_time']
        initial_balance = bidding_input_params['initial_balance']
        balance = bidding_input_params['balance']
        curr_time = bidding_input_params['curr_time']
        region_id = bidding_input_params['region_id']

        # --- Handle the first bid ---
        if not self.bid_previous:
            bid = self.initial_bid
            self._update_history(balance, curr_time, bid)
            return bid

        # --- Time and Budget Calculations ---
        desired_days = (end - start) // (3600 * 24)
        day_quote = initial_balance / desired_days if desired_days > 0 else initial_balance

        day = (curr_time - start) // (3600 * 24)
        hour = (curr_time - start) // 3600 % 24

        # --- Calculate Target Spending Curve based on Traffic ---
        campaign_duration_hours = 24
        hours_in_day = np.arange(
            start, start + 3600 * campaign_duration_hours, 3600
        )
        traffic_campaign_total = self.traffic.get_traffic_share(
            region_id, start, start + 3600 * campaign_duration_hours
        )
        
        hourly_traffic = np.array([
            self.traffic.get_traffic_share(region_id, h, h + 3600)
            for h in hours_in_day
        ])

        if traffic_campaign_total > 0:
            traffic_dist = hourly_traffic / traffic_campaign_total
        else:
            traffic_dist = np.zeros_like(hourly_traffic)

        target_spend_cumulative = day_quote * np.cumsum(traffic_dist)

        # --- Determine Initial Balance for the Current Day ---
        if day == 0:
            initial_day_balance = initial_balance
        else:
            # Look back in recent history for the last hour rollover,
            # which marks the start of a new day's balance.
            hour_previous = [(t - start) // 3600 % 24 for t in self.timestamp_previous]
            # Set a fallback in case no day change is found in the look-back window
            initial_day_balance = self.balance_previous[-1]
            look_back_window = 12
            start_index = len(hour_previous) - 1
            end_index = max(0, start_index - look_back_window)
            
            for i in range(start_index, end_index, -1):
                if hour_previous[i] < hour_previous[i - 1]:
                    initial_day_balance = self.balance_previous[i]
                    break
        
        # --- Bid Calculation Logic ---
        
        # Recalculate bid only every 3rd call to reduce volatility
        if self.count % 3 != 1:
            bid = self.bid_previous[-1]
            self._update_history(balance, curr_time, bid)
            return bid

        # If a full day's quote has been spent, aggressively reduce the bid
        if initial_day_balance - balance >= day_quote:
            bid = 0.95 * self.bid_previous[-1]
            self._update_history(balance, curr_time, bid)
            return bid

        # --- PID-like Controller Logic ---
        
        # P-Component: Proportional error based on total spend deviation
        current_spend = initial_day_balance - balance
        target_spend_at_hour = target_spend_cumulative[int(hour)]
        spend_error = current_spend - target_spend_at_hour

        # D-Component: Derivative error based on spending rate deviation
        if int(hour) > 0:
            desired_gradient = (target_spend_cumulative[int(hour)] -
                                target_spend_cumulative[int(hour) - 1]) / 3600
            
            time_delta = curr_time - self.timestamp_previous[-1]
            real_gradient = ((self.balance_previous[-1] - balance) / time_delta
                             if time_delta > 0 else 0)
            
            gradient_spend_error = real_gradient - desired_gradient
        else:
            gradient_spend_error = 0

        # Calculate dynamic weights (ws, wg) for P and D components
        if gradient_spend_error == 0:
            tau = 1_000_000  # Avoid division by zero
        else:
            tau = -spend_error / gradient_spend_error

        if tau < 0:
            ws = 0.5  # Weight for spend error
            wg = 0.5  # Weight for gradient error
        else:
            ws = min(0.9, 0.2 * tau)
            wg = 1 - ws

        # Scale the error components
        spend_error_c = min(self.c_max,
                            self.c_max * abs(spend_error) / self.e_max)
        
        gradient_spend_error_i = min(1, abs(gradient_spend_error))
        gradient_spend_error_c = max(
            self.c_min,
            self.c_max * gradient_spend_error_i / self.e_gmc
        )

        # Calculate final bid adjustment
        bid_adjustment = (
            ws * spend_error_c * np.sign(spend_error) +
            wg * gradient_spend_error_c * np.sign(gradient_spend_error)
        )
        bid = self.bid_previous[-1] - bid_adjustment

        self._update_history(balance, curr_time, bid)
        return bid