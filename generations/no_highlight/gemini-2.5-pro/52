import pandas as pd
# Предполагается, что в файле main13.py находятся обученные модели knn и mlp.
# Например, они могли быть обучены на датасете Titanic.
from main13 import knn, mlp

# Определим полный список колонок, на которых были обучены модели.
# Это ключевой шаг для исправления ошибки. Модели всегда должны получать
# на вход данные с одинаковым набором и порядком колонок.
# Имена колонок взяты из исходного кода.
MODEL_COLUMNS = [
    'Pclass', 'Name', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare',
    'Embarked_C', 'Embarked_Q', 'Embarked_S'
]

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in ["S", "Q", "C"]:
            # 1. Создаем словарь с данными для одного пассажира
            #    Используем значения из циклов и константы, как в оригинале.
            passenger_data = {
                "Pclass": pclass,
                "Name": 24,
                "Sex": 0,
                "Age": 19,
                "SibSp": 0,
                "Parch": 0,
                "Fare": fare,
                "Embarked": embarked
            }

            # 2. Создаем DataFrame из одной строки.
            #    Данные нужно обернуть в список, чтобы DataFrame имел одну строку.
            my_df = pd.DataFrame([passenger_data])

            # 3. Применяем one-hot encoding к колонке "Embarked".
            #    pd.get_dummies создаст только одну из колонок (например, Embarked_S),
            #    если на входе было только одно значение ('S').
            my_df = pd.get_dummies(my_df, columns=["Embarked"])

            # 4. ГЛАВНОЕ ИСПРАВЛЕНИЕ:
            #    Приводим колонки DataFrame в полное соответствие с теми, что
            #    ожидает модель. Метод .reindex() добавит недостающие колонки
            #    (например, Embarked_C, Embarked_Q) и заполнит их нулями (fill_value=0),
            #    а также установит правильный порядок.
            my_df = my_df.reindex(columns=MODEL_COLUMNS, fill_value=0)

            # 5. Делаем предсказание.
            #    Метод .predict() возвращает массив, поэтому берем первый элемент [0].
            try:
                knn_pred = knn.predict(my_df)[0]
                mlp_pred = mlp.predict(my_df)[0]

                print(f"""-------------------------------------------------------
                      Параметры: класс {pclass}, плата {fare}, embarked {embarked}
                      По knn: {knn_pred}
                      По mlp: {mlp_pred}""")
            except Exception as e:
                print(f"Ошибка при предсказании для pclass={pclass}, fare={fare}, embarked={embarked}: {e}")
                print("Убедитесь, что список 'MODEL_COLUMNS' соответствует колонкам, на которых обучались модели.")
                break
        else:
            continue
        break
    else:
        continue
    break
