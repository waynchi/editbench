@eel.expose
def get_task_list(settings):
    """
    Gets a list of *.xml files from the settings['taskPath'] folder.
    For each file, it extracts a comment from the first line and the modification date.
    Returns a list of objects {fileName, comment, file_date_str}.
    """
    path = settings.get('taskPath')
    if not path or not os.path.isdir(path):
        print(f"Ошибка: Директория задач '{path}' не найдена или не является директорией.")
        return []

    task_list = []
    try:
        # Get a list of all .xml files in the directory
        filenames = [f for f in os.listdir(path) if f.endswith('.xml') and os.path.isfile(os.path.join(path, f))]

        for file_name in filenames:
            file_path = os.path.join(path, file_name)
            comment = ""
            file_date_str = ""

            try:
                # Get the file modification date
                mtime = os.path.getmtime(file_path)
                dt_object = datetime.fromtimestamp(mtime)
                file_date_str = dt_object.strftime('%d.%m.%Y %H:%M')

                # Read the first line to get the comment
                with open(file_path, 'r', encoding='utf-8') as f:
                    first_line = f.readline().strip()
                    # Use regex to find comment: <!-- comment -->
                    match = re.match(r'<!--\s*(.*?)\s*-->', first_line)
                    if match:
                        comment = match.group(1).strip()
            except Exception as e:
                # Log the error but continue processing so the file still appears in the list
                print(f"Ошибка при обработке файла {file_name}: {e}")

            task_list.append({
                'fileName': file_name,
                'comment': comment,
                'file_date_str': file_date_str
            })

        # Sort the list by file name for consistency
        task_list.sort(key=lambda x: x['fileName'])
        return task_list

    except FileNotFoundError:
        print(f"Ошибка: Директория не найдена: {path}")
        return []
    except Exception as e:
        print(f"Общая ошибка при получении списка задач: {e}")
        return []


