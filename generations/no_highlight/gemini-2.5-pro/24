import aiohttp # для асинхронных запросов к API
import aiofiles # для асинхронной работы с файлами
import asyncio # для управления асинхронными задачами
import xml.etree.ElementTree # для обработки xml-ответа API
import matplotlib.pyplot as plt # для построения графиков
import pandas as pd # для создания датафрейма и разденеия всех свечей на два типа: close и open
import datetime # для дат по оси иксов
import pickle # для хранения переменных в файле
import json # для работы с датабазой
import io # для работы с байтами в памяти

# нет проблем с инструментами теханализа и пустыми днями (без торгов), тк дни без торгов в датафрейме не нули, а просто не существуют. Поэтому они не портят значения индикаторов
# класс тикер, методы график и тек. цена
class ticker():
    """Тикер акции и всё с ним связанное, через MoexApi \n
    Требуются библеотеки: \n
    aiohttp \n
    aiofiles \n
    asyncio \n
    io \n
    xml.etree.ElementTree \n
    matplotlib.pyplot as plt \n
    pandas as pd \n
    datetime \n
    pickle \n
    json \n
    """
    def __init__(self, name: str):
        """self.name - имя тикера
        self.tech_dict - словарь теханализа"""
        self.name = name 
        """Имя тикера, то есть сам по себе тикер"""
        # в принципе тут можно менять общие для всех юзеров настройки по умолчанию. Потенциально надо через это реализовать кастомные инструменты теханализа
        self.tech_dict = {"value" : {"use" : False, "has_periods" : False, "need_graph_space" : True}, 
                          "sma" : {"use" : False, "has_periods" : True, "periods" : [], "need_graph_space" : False},
                          "ema" : {"use" : False, "has_periods" : True, "periods" : [],"need_graph_space" : False}
                          }
        """Словарь реализованных опций теханализа. Имеет вид \n
        {"sma": {"use": True, "periods": [20, 50], "need_graph_space": False}, "rsi": {"use": True, "periods": [10], "need_graph_space": True}} \n
        Где use отвечает за использование, period - список периодов, по которым будут считаться значения, need_graph_space за то, требует ли осциллятор доп места на графике \n
        Изначально все use имеют значение False, а списки периодов пусты \n \n
        При реализации нового инструмента теханализа достаточно дописать его в self.tech_dict \n
        При этом функцию, соответствующую этому инструменту важно назвать также, как и сам инструмент в словаре. А её аргументы - self и ax (редактируемый/заполняемый график) \n
        Доп графики инструментов теханализа, которые их требуют, будут отображаться в таком же порядке, в котором инструменты располагаются в словаре. Также в этом порядке будут высвечиваться кнопки в боте и уже выбранные инструменты теханализа"""

    async def correct_name(self) -> bool:
        """Асинхронно проверяет имя тикера на наличие в множестве тикеров. Множество обновляется не чаще раза в день."""
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        tickers_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_tickers.bin"

        async with aiofiles.open(info_path, "r", encoding="utf-8") as info_file:
            info_content = await info_file.read()
            info = json.loads(info_content)

        if datetime.datetime.now() - datetime.timedelta(days=1) > datetime.datetime.strptime(info["last_day_check"]["ticker"], "%Y-%m-%d %H:%M:%S.%f"):
            set_tickers = set()
            s = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities.xml?iss.meta=off"
            async with aiohttp.ClientSession() as session:
                async with session.get(s) as response:
                    content = await response.read()
            
            root = xml.etree.ElementTree.fromstring(content)
            for data in root.findall("data"):
                if data.get("id") == "securities":
                    rows = data.find("rows")
                    for row in rows.findall("row"):
                        set_tickers.add(row.get("SECID"))

            async with aiofiles.open(tickers_path, "wb") as set_tickers_file:
                await set_tickers_file.write(pickle.dumps(set_tickers))
            
            info["last_day_check"]["ticker"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, "w", encoding="utf-8") as info_file:
                await info_file.write(json.dumps(info, indent=3, ensure_ascii=False))

        async with aiofiles.open(tickers_path, "rb") as set_tickers_file:
            set_tickers_data = await set_tickers_file.read()
            set_tickers = pickle.loads(set_tickers_data)

        return self.name in set_tickers

    async def CurrentPrice(self) -> str:
        """Асинхронно получает текущую цену по этому тикеру."""
        s = f"https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/{self.name}.xml?iss.meta=off"
        async with aiohttp.ClientSession() as session:
            async with session.get(s) as response:
                content = await response.read()
        
        root = xml.etree.ElementTree.fromstring(content)
        for data in root.findall("data"):
            if data.get("id") == "marketdata":
                rows = data.find("rows")
                row = rows.find("row")
                return row.get("LAST")

    async def candles(self, candles_name: str, timeframe: str, start: str, end: str) -> list:
        """Асинхронно получает лист свечей для этого тикера \n
        candles_name - необходимая составляющая свечей \n
        candles_name: open, close, high, low, value, volume, begin, end \n
        timeframe - таймфрейм: 1 - 1 мин, 10 - 10 мин, 60 - 1ч, 24 - 1д, 7 - 1н, 31 - 1мес, 4 - 4мес \n
        start, end - начало и конец периода, формат ГГГГ-ММ-ДД ЧЧ:ММ:СС
        """
        s = f"https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/{self.name}/candles.xml?iss.meta=off&interval={timeframe}&till={end}&from={start}"
        async with aiohttp.ClientSession() as session:
            async with session.get(s) as response:
                content = await response.read()

        root = xml.etree.ElementTree.fromstring(content)
        candles = root.find("data")
        rows = candles.find("rows")
        listcandles = []
        if candles_name in ["begin", "end"]:
            for row in rows.findall("row"):
                datetime_str = row.get(candles_name)
                datetime_datetime = datetime.datetime.strptime(datetime_str, "%Y-%m-%d %H:%M:%S")
                listcandles.append(datetime_datetime)
        else:
            for row in rows.findall("row"):
                listcandles.append(float(row.get(candles_name)))
        return listcandles

    async def setattr_candles_dataframe(self, timeframe: str = "24", start: str = "", end: str = ""):
        """Асинхронно создаёт датафрйм свечей с соответствующим timeframe, start и end и помещает в self.candles_dataframe \n
        Данные для датафрейма загружаются конкурентно."""
        candle_types = ["open", "close", "high", "low", "value", "begin"]
        tasks = [self.candles(name, timeframe, start, end) for name in candle_types]
        results = await asyncio.gather(*tasks)
        
        candles_dict = dict(zip(candle_types, results))
        candles_dataframe = pd.DataFrame(candles_dict)
        setattr(self, "candles_dataframe", candles_dataframe)

    async def graphic(self, timeframe: str = "24", start: str = "", end: str = "") -> io.BytesIO:
        """Асинхронно возвращает свечной график цены от времени в виде объекта io.BytesIO \n
        timeframe - таймфрейм: 1 - 1 мин, 10 - 10 мин, 60 - 1ч, 24 - 1д, 7 - 1н, 31 - 1мес, 4 - 4мес | None = 24 \n
        start, end - начало и конец периода, формат ГГГГ-ММ-ДД ЧЧ:ММ:СС  | None = ""
        """
        await self.setattr_candles_dataframe(timeframe, start, end)
        
        up = self.candles_dataframe[self.candles_dataframe.close >= self.candles_dataframe.open]
        down = self.candles_dataframe[self.candles_dataframe.close < self.candles_dataframe.open]
        setattr(self, "up", up)
        setattr(self, "down", down)

        timeframe_widths = {
            "1": 1/24/60, "10": 1/24/6, "60": 1/24, "24": 1,
            "7": 7, "31": 30, "4": 90
        }
        width_big = timeframe_widths.get(timeframe, 0)
        width_small = width_big / 10
        setattr(self, "width_big", width_big)

        number_of_additional_graphics = sum(
            1 for tech in self.tech_dict.values() if tech["use"] and tech["need_graph_space"]
        )
        
        main_plot_index = 0
        
        if number_of_additional_graphics > 0:
            height_ratios_list = [10 - number_of_additional_graphics] + [1] * number_of_additional_graphics
            fig, axs = plt.subplots(
                nrows=1 + number_of_additional_graphics, ncols=1, 
                sharex=True, height_ratios=height_ratios_list
            )
            ax_main = axs[main_plot_index]
            plt.suptitle(self.name, fontsize=15)
        else:
            fig = plt.figure()
            ax_main = fig.add_subplot()
            plt.title(self.name, fontsize=15)
            axs = [ax_main] 

        ax_main.grid(True)
        ax_main.bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
        ax_main.bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
        ax_main.bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
        ax_main.bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
        ax_main.bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
        ax_main.bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")

        additional_ax_idx = 1
        for tech_name, tech_props in self.tech_dict.items():
            if tech_props["use"]:
                tech_func = getattr(self, tech_name)
                if tech_props["need_graph_space"]:
                    if additional_ax_idx < len(axs):
                        ax_tech = axs[additional_ax_idx]
                        ax_tech.grid(True)
                        tech_func(ax_tech)
                        additional_ax_idx += 1
                else:
                    tech_func(ax_main)

        graphic_path = r"D:\Python files\!MoexApiBot\graphic.png"
        fig.savefig(graphic_path)
        plt.close(fig) # Закрываем фигуру, чтобы освободить память

        async with aiofiles.open(graphic_path, "rb") as f:
            image_bytes = await f.read()
        
        return io.BytesIO(image_bytes)

    def sma(self, ax):
        for period in self.tech_dict["sma"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                sma_series = self.candles_dataframe.close.rolling(window=period).mean()
                ax.plot(self.candles_dataframe.begin[period - 1:], sma_series.dropna())

    def ema(self, ax):
        for period in self.tech_dict["ema"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                ema_series = self.candles_dataframe.close.ewm(span=period, adjust=False).mean()
                ax.plot(self.candles_dataframe.begin, ema_series)

    def value(self, ax):
        ax.bar(x=self.up.begin, height=self.up.value, width=self.width_big, color="green")
        ax.bar(x=self.down.begin, height=self.down.value, width=self.width_big, color="red")
        ax.set_title("Value", fontsize=7)


