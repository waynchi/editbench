import numpy as np

def fit_line(x, y):
    """Funkcja dopasowująca prostą do tablicy oraz obliczająca maksymalne odchylenie.
    
    Parametry:
      x : array_like
          Wartości x danych.
      y : array_like
          Wartości y danych.
    
    Zwraca:
      slope : float
          Nachylenie dopasowanej prostej.
      intercept : float
          Współczynnik przesunięcia (punkt przecięcia z osią y).
      max_deviation : float
          Maksymalne odchylenie (błąd) pomiędzy wartościami y a wartościami wyznaczonymi przez prostą.
    """
    # Oblicz średnie wartości x i y
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # Oblicz odchylenia od średnich
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # Oblicz nachylenie i punkt przecięcia
    slope = np.sum(x_dev * y_dev) / np.sum(x_dev ** 2)
    intercept = y_mean - slope * x_mean

    # Oblicz wartości dopasowane przez prostą
    y_fit = slope * x + intercept
    # Oblicz maksymalne odchylenie
    max_deviation = np.max(np.abs(y - y_fit))
    
    return slope, intercept, max_deviation

def fit_quadratic(x, y):
    """Funkcja dopasowania krzywej kwadratowej do tablicy oraz obliczania maksymalnego odchylenia.
    
    Parametry:
      x : array_like
          Wartości x danych.
      y : array_like
          Wartości y danych.
    
    Zwraca:
      coeffs : ndarray
          Współczynniki dopasowanej krzywej kwadratowej (a, b, c) dla a*x^2 + b*x + c.
      max_deviation : float
          Maksymalne odchylenie (błąd) pomiędzy wartościami y a wartościami wyznaczonymi przez krzywą.
    """
    # Utwórz macierz Vandermonde'a dla regresji kwadratowej
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    # Oblicz współczynniki metodą najmniejszych kwadratów
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]

    # Oblicz wartości dopasowane przez krzywą kwadratową
    y_fit = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    # Oblicz maksymalne odchylenie
    max_deviation = np.max(np.abs(y - y_fit))
    
    return coeffs, max_deviation