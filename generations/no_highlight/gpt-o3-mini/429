import xml.etree.ElementTree
import matplotlib.pyplot as plt
import pandas as pd
import datetime
import pickle
import json
import requests
from typing import List
from matplotlib.axes import Axes

# Ustawimy standardowy słownik technicznej analizy. Będziemy go używać do analizy zapytań callback w routerze budowania wykresu (ponieważ tam niewygodnie jest pobierać tick_inp)
standart_tech_dict = {
    "value": {"use": False, "has_periods": False, "need_graph_space": True},
    "sma": {"use": False, "has_periods": True, "periods": [], "need_graph_space": False},
    "ema": {"use": False, "has_periods": True, "periods": [], "need_graph_space": False}
}

class ticker():
    """Ticker akcji i wszystko z nim związane, przez MoexApi (wersja synchroniczna)"""
    def __init__(self, name: str):
        """
        self.name - nazwa tickera
        self.tech_dict - słownik analizy technicznej
        """
        self.name = name
        self.tech_dict = standart_tech_dict

    def correct_name(self) -> bool:
        """
        Sprawdzenie, czy nazwa tickera znajduje się w zbiorze tickerów.
        Zbiór jest aktualizowany nie częściej niż raz dziennie.
        """
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        tickers_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_tickers.bin"
        
        with open(info_path, "r", encoding="utf-8") as info_file:
            info = json.load(info_file)
        
        last_check_time = datetime.datetime.strptime(info["last_day_check"]["ticker"], "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check_time:
            # Aktualizujemy listę tickerów
            set_tickers = set()
            url = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities.xml?iss.meta=off"
            response = requests.get(url)
            root = xml.etree.ElementTree.fromstring(response.text)
            for data in root.findall("data"):
                if data.get("id") == "securities":
                    rows = data.find("rows")
                    for row in rows.findall("row"):
                        set_tickers.add(row.get("SECID"))
            with open(tickers_path, "wb") as tickers_file:
                pickle.dump(set_tickers, tickers_file)
            # Aktualizujemy czas ostatniej aktualizacji
            info["last_day_check"]["ticker"] = str(datetime.datetime.now())
            with open(info_path, "w", encoding="utf-8") as info_file:
                json.dump(info, info_file, indent=3, ensure_ascii=False)
        
        with open(tickers_path, "rb") as tickers_file:
            set_tickers = pickle.load(tickers_file)
        return self.name in set_tickers

    def CurrentPrice(self):
        """Bieżąca cena dla tego tickera"""
        url = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/" + self.name + ".xml?iss.meta=off"
        response = requests.get(url)
        root = xml.etree.ElementTree.fromstring(response.text)
        for data in root.findall("data"):
            if data.get("id") == "marketdata":
                rows = data.find("rows")
                row = rows.find("row")
                return row.get("LAST")

    def candles(self, candles_name: str, timeframe: str, start: str, end: str):
        """
        Lista świec dla tego tickera

        candles_name - niezbędny składnik świec
        candles_name: open, close, high, low, value, volume, begin, end

        timeframe - interwał czasowy: 1 - 1 min, 10 - 10 min, 60 - 1 godz, 24 - 1 dzień, 7 - 1 tydzień, 31 - 1 miesiąc, 4 - 4 miesiące

        start, end - początek i koniec okresu, format RRRR-MM-DD GG:MM:SS
        """
        url = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/" + self.name + f"/candles.xml?iss.meta=off&interval={timeframe}&till={end}&from={start}"
        response = requests.get(url)
        root = xml.etree.ElementTree.fromstring(response.text)
        candles = root.find("data")
        rows = candles.find("rows")
        listcandles = []
        if candles_name == "begin" or candles_name == "end":
            for row in rows.findall("row"):
                datetime_str = row.get(candles_name)
                datetime_datetime = datetime.datetime(
                    int(datetime_str[0:4]),
                    int(datetime_str[5:7]),
                    int(datetime_str[8:10]),
                    int(datetime_str[11:13]),
                    int(datetime_str[14:16]),
                    int(datetime_str[17:])
                )
                listcandles.append(datetime_datetime)
        else:
            for row in rows.findall("row"):
                listcandles.append(float(row.get(candles_name)))
        return listcandles

    def setattr_candles_dataframe(self, timeframe: str = "24", start: str = "", end: str = ""):
        """
        Tworzy dataframe świec z odpowiednim timeframe, start i end i umieszcza w self.candles_dataframe

        Nie przy inicjacji, ponieważ jeśli ticker jest inicjowany w celu uzyskania bieżącej ceny, nie ma powodu do wykonywania zbędnych operacji.
        """
        candles_dataframe = pd.DataFrame({
            "open":  self.candles("open", timeframe, start, end),
            "close": self.candles("close", timeframe, start, end),
            "high":  self.candles("high", timeframe, start, end),
            "low":   self.candles("low", timeframe, start, end),
            "value": self.candles("value", timeframe, start, end),
            "begin": self.candles("begin", timeframe, start, end)
        })
        setattr(self, "candles_dataframe", candles_dataframe)

    def graphic(self, timeframe: str = "24", start: str = "", end: str = "", user_id: int = 1124123332):
        """
        Zwraca otwarty wykres świecowy ceny od czasu

        timeframe - interwał czasowy: 1 - 1 min, 10 - 10 min, 60 - 1h, 24 - 1d, 7 - 1t, 31 - 1mies, 4 - 4mies | None = 24
        start, end - początek i koniec okresu, format RRRR-MM-DD GG:MM:SS | None = ""
        user_id - id użytkownika, dla którego ten plik. Będzie częścią nazwy pliku

        Dodaje wszystkie niezbędne narzędzia analizy technicznej, opierając się na self.tech_dict.
        """
        self.setattr_candles_dataframe(timeframe, start, end)
        # Dzielimy dataframe na up i down
        up = self.candles_dataframe[self.candles_dataframe.close >= self.candles_dataframe.open]
        down = self.candles_dataframe[self.candles_dataframe.close < self.candles_dataframe.open]
        setattr(self, "up", up)
        setattr(self, "down", down)

        # Ustalamy szerokości świec w zależności od interwału czasowego
        if timeframe == "1":       # minuta
            width_big = 1/24/60
        elif timeframe == "10":    # 10 minut
            width_big = 1/24/6
        elif timeframe == "60":    # godzina
            width_big = 1/24
        elif timeframe == "24":    # dzień
            width_big = 1
        elif timeframe == "7":     # tydzień
            width_big = 7
        elif timeframe == "31":    # miesiąc
            width_big = 30
        elif timeframe == "4":     # 4 miesiące
            width_big = 90
        else:
            width_big = 0
        width_small = width_big / 10
        setattr(self, "width_big", width_big)
        setattr(self, "width_small", width_small)

        # Obliczamy ile dodatkowych wykresów wymagają narzędzia analizy technicznej
        number_of_additional_graphics = 0
        for tech in self.tech_dict:
            if self.tech_dict[tech]["use"] and self.tech_dict[tech]["need_graph_space"]:
                number_of_additional_graphics += 1

        if number_of_additional_graphics != 0:
            height_rations_list = [10 - number_of_additional_graphics] + [1] * number_of_additional_graphics
            fig, axs = plt.subplots(nrows=1 + number_of_additional_graphics, ncols=1, sharex=True, height_ratios=height_rations_list)
            axs: List[Axes]
            plt.suptitle(self.name, fontsize=15)
            axs[0].grid(True)
            # Rysujemy świeczki dla up
            axs[0].bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
            axs[0].bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
            axs[0].bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
            # Rysujemy świeczki dla down
            axs[0].bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
            axs[0].bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
            axs[0].bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")
            
            # Dodajemy narzędzia analizy technicznej
            additional_index = 0
            for tech in self.tech_dict:
                if self.tech_dict[tech]["use"]:
                    tech_func = getattr(self, tech)
                    if not self.tech_dict[tech]["need_graph_space"]:
                        tech_func(axs[0])
                    else:
                        # Umieszczamy każdy wymagalny dodatkowy wykres w kolejnych osa, zaczynając od 1
                        axs[additional_index + 1].grid(True)
                        tech_func(axs[additional_index + 1])
                        additional_index += 1
        else:
            fig = plt.figure()
            plt.title(self.name, fontsize=15)
            ax = fig.add_subplot()
            ax.grid(True)
            # Rysowanie świeczek dla up
            ax.bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
            ax.bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
            ax.bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
            # Rysowanie świeczek dla down
            ax.bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
            ax.bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
            ax.bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")
            # Dodanie narzędzi analizy technicznej, które nie wymagają dodatkowego wykresu
            for tech in self.tech_dict:
                if self.tech_dict[tech]["use"]:
                    tech_func = getattr(self, tech)
                    tech_func(ax)
        
        # Zapisujemy wykres jako obraz w pliku
        fig.savefig(r"D:\MoexAPI_bot_aiogram3\data_files\graph_for_" + str(user_id) + ".png")
        plt.close(fig)
        return True

    def sma(self, ax):
        """Prosta średnia krocząca (SMA)"""
        for period in self.tech_dict["sma"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                sma_list = []
                sma_list.append(sum(self.candles_dataframe.close[0:period]) / period)
                for i in range(period, len(self.candles_dataframe.begin)):
                    sma_list.append(sma_list[i - period] + (self.candles_dataframe.close[i] - self.candles_dataframe.close[i - period]) / period)
                ax.plot(self.candles_dataframe.begin[period - 1:], sma_list)

    def ema(self, ax):
        """Exponential Moving Average (EMA)"""
        for period in self.tech_dict["ema"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                ema_list = []
                ema_list.append(sum(self.candles_dataframe.close[0:period]) / period)
                for i in range(period, len(self.candles_dataframe.begin)):
                    ema_list.append(((period - 1) * ema_list[i - period] + 2 * self.candles_dataframe.close[i]) / (period + 1))
                ax.plot(self.candles_dataframe.begin[period - 1:], ema_list)

    def value(self, ax):
        """Wartości - wykres słupkowy dla wartości świec"""
        ax.bar(x=self.up.begin, height=self.up.value, width=self.width_big, color="green")
        ax.bar(x=self.down.begin, height=self.down.value, width=self.width_big, color="red")
        ax.set_title("Value", fontsize=7)

