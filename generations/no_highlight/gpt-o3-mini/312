"""
Main entry point for the Audio Recorder and Transcriber application.
"""

import os
import sys
import logging
import tkinter as tk
import tkinterdnd2

def setup_logging():
    """
    Set up logging configuration for the application.
    """
    log_format = '%(asctime)s - %(levelname)s - %(message)s'
    logging.basicConfig(
        level=logging.INFO,
        format=log_format,
        handlers=[
            logging.StreamHandler(),
            logging.FileHandler('app.log', encoding='utf-8')
        ]
    )

def get_resource_path():
    """
    Get the resource path that works for both development and PyInstaller.

    Returns:
        str: Path to resources directory
    Raises:
        Exception: If the resource path cannot be determined.
    """
    try:
        if getattr(sys, 'frozen', False):
            # Running as a bundled executable
            resource_path = os.path.join(os.path.dirname(sys.executable), 'resources')
        else:
            # Running as a script
            resource_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'resources')

        if not os.path.exists(resource_path):
            raise Exception(f"Resource directory not found: {resource_path}")
        return resource_path
    except Exception as e:
        logging.error(f"Error determining resource path: {e}")
        raise

def check_resources():
    """
    Check if required resource files exist.

    Returns:
        bool: True if all required resources are present, False otherwise.
    """
    try:
        required_files = ['sound.mp3', 'done.mp3', 'cancel.wav', 'help_text.txt']
        resource_dir = get_resource_path()

        missing_files = []
        for file in required_files:
            file_path = os.path.join(resource_dir, file)
            if not os.path.exists(file_path):
                missing_files.append(file)

        if missing_files:
            logging.error(f"Missing resource files: {', '.join(missing_files)}")
            return False

        return True
    except Exception as e:
        logging.error(f"Error checking resources: {e}")
        return False

def main():
    """
    Main function to start the application.
    """
    try:
        # Set up logging
        setup_logging()
        logging.info("Starting Audio Recorder and Transcriber application")

        # Check resources
        if not check_resources():
            logging.error("Required resource files are missing. Application cannot start.")
            sys.exit(1)

        try:
            # Initialize main window with drag-and-drop support
            root = tkinterdnd2.TkinterDnD.Tk()
        except Exception as e:
            logging.error(f"Failed to initialize TkinterDnD: {e}")
            sys.exit(1)

        try:
            # Import here to avoid cyclic dependencies
            from gui.main_window import AudioTranscriberApp
        except ImportError as e:
            logging.error(f"Failed to import the GUI module: {e}")
            sys.exit(1)

        try:
            # Create application instance
            app = AudioTranscriberApp(root)
        except Exception as e:
            logging.error(f"Error initializing the AudioTranscriberApp: {e}")
            sys.exit(1)

        try:
            # Start the main event loop
            root.mainloop()
        except Exception as e:
            logging.error(f"Error during mainloop execution: {e}")
            sys.exit(1)
            
    except Exception as e:
        logging.error(f"Application error: {e}")
        raise

if __name__ == "__main__":
    main()