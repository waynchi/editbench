from dataclasses import dataclass

@dataclass
class Card:
    celular: str
    operadora: str
    valor: str
    email: str
    nome: str
    cpf: str
    card: str
    mes: str
    ano: str
    cvv: str
    token: str
    bin: str
    dadosbin: str
    senha: str

    def __repr__(self):
        # Corrected __repr__ to display all attributes properly
        return (
            f"Card(celular='{self.celular}', operadora='{self.operadora}', valor='{self.valor}', "
            f"email='{self.email}', nome='{self.nome}', cpf='{self.cpf}', card='{self.card}', "
            f"mes='{self.mes}', ano='{self.ano}', cvv='{self.cvv}', token='{self.token}', "
            f"bin='{self.bin}', dadosbin='{self.dadosbin}', senha='{self.senha}')"
        )

if __name__ == '__main__':
