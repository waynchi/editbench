# generar un módulo de medio sumador de verilog con python (con señales de entrada adicionales)

# código verilog
verilog_code = """
module half_adder(a, b, clk, reset, c, sum, carry);
    input a, b, clk, reset;
    output c, sum, carry;
    assign c = a ^ b;
    assign sum = a & b;
    assign carry = a & b;
endmodule
"""

# nombre del módulo verilog
module_name = "half_adder"

# puertos de entrada y salida del módulo verilog (agregamos clk y reset como señales de entrada adicionales)
input_ports = ["a", "b", "clk", "reset"]
output_ports = ["c", "sum", "carry"]

# parámetros del módulo verilog
parameters = ["WIDTH"]

# valor de los parámetros del módulo verilog
parameter_values = ["8"]

# cuerpo del módulo verilog (modificado para incluir las nuevas señales de entrada)
module_body = """
    input a, b, clk, reset;
    output c, sum, carry;
    assign c = a ^ b;
    assign sum = a & b;
    assign carry = a & b;
endmodule
"""

# instanciación de módulo verilog (se conectan las señales adicionales)
module_instantiation = """
half_adder half_adder_inst(
    .a(a),
    .b(b),
    .clk(clk),
    .reset(reset),
    .c(c),
    .sum(sum),
    .carry(carry)
);
"""