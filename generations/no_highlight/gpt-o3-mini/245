def is_sum_of_four_nonzero_squares(n):
    """
    Проверяет, можно ли представить число n как сумму четырех ненулевых квадратов.
    Если представление найдено, возвращает кортеж (a, b, c, d), где a^2 + b^2 + c^2 + d^2 == n.
    Если представления нет, возвращает None.
    """
    # Минимальное число, которое можно представить как 1^2 + 1^2 + 1^2 + 1^2 = 4.
    if n < 4:
        return None

    # Максимальное значение для a, b, c, d. 
    # Если k^2 > n, k точно не может входить в представление.
    max_candidate = int(n**0.5) + 1

    # Перебираем все комбинации ненулевых чисел от 1 до max_candidate - 1.
    for a in range(1, max_candidate):
        for b in range(1, max_candidate):
            for c in range(1, max_candidate):
                for d in range(1, max_candidate):
                    if a * a + b * b + c * c + d * d == n:
                        return (a, b, c, d)
    return None


def find_four_nonzero_squares_sums(limit):
    """
    Находит числа до заданного предела, которые могут быть выражены как сумма четырех ненулевых квадратов.
    Возвращает список таких чисел.
    """
    results = []
    for n in range(1, limit + 1):
        if is_sum_of_four_nonzero_squares(n) is not None:
            results.append(n)
    return results


def main():
    try:
        limit = int(input("Введите верхний предел: "))
    except ValueError:
        print("Неверный ввод. Пожалуйста, введите целое число.")
        return

    sums_found = find_four_nonzero_squares_sums(limit)
    if sums_found:
        print("Числа, которые могут быть выражены как сумма четырех ненулевых квадратов:")
        for num in sums_found:
            representation = is_sum_of_four_nonzero_squares(num)
            a, b, c, d = representation
            print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")
    else:
        print("Не найдено чисел, удовлетворяющих условию в заданном диапазоне.")


if __name__ == "__main__":
    main()