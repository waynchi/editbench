import requests
from pyspark.sql import SparkSession
from pyspark.sql.functions import col

# Crear una sesión Spark
spark = SparkSession.builder.appName("EscrituraParquetADL2").getOrCreate()

# URL del endpoint de la API (reemplazar con la URL real de la API)
api_url = "https://api.example.com/data"  # Reemplazar con la URL real

# Realizar la petición GET a la API
try:
    response = requests.get(api_url)
    response.raise_for_status()  # Lanza un error si la solicitud no fue exitosa
    data_json = response.json()   # Asume que la respuesta es un JSON
except Exception as e:
    print("Error al obtener los datos de la API:", e)
    spark.stop()
    exit(1)

# Imprimir algunos datos para el análisis preliminar
print("Datos obtenidos de la API:")
print(data_json)

# Si los datos vienen en formato lista de diccionarios, podemos crear un DataFrame
# En caso contrario, ajustar la extracción según la estructura del JSON.
if isinstance(data_json, list):
    df = spark.createDataFrame(data_json)
else:
    # Si el JSON tiene otro nivel de anidamiento, extrae la parte que contiene los registros.
    # Por ejemplo, si la estructura es {"records": [...]}:
    df = spark.createDataFrame(data_json.get("records", []))

# Mostrar el esquema y algunas filas para su análisis
df.printSchema()
df.show(truncate=False)

# Ejemplo de análisis: contar el número de registros y mostrar estadísticas
row_count = df.count()
print(f"Número de registros: {row_count}")
df.describe().show()

# Configurar la conexión a ADL2 usando la identidad de Microsoft ID
# No es necesario proporcionar credenciales explícitamente en un notebook de Synapse
# Spark utilizará la identidad administrada del notebook para autenticarse.

# Especificar la ruta al contenedor y la carpeta en ADL2
container_name = "<your_container_name>"           # Reemplazar con el nombre de tu contenedor
folder_path = "<your_folder_path>"                   # Reemplazar con la ruta a la carpeta dentro del contenedor
storage_account_name = "<your_storage_account_name>" # Reemplazar con el nombre de tu cuenta de almacenamiento

adl2_path = f"abfss://{container_name}@{storage_account_name}.dfs.core.windows.net/{folder_path}"

# Escribir el DataFrame en formato parquet en ADL2
df.write.parquet(adl2_path, mode="overwrite")

# Opcional: leer el archivo parquet para verificar
df_leido = spark.read.parquet(adl2_path)
df_leido.show(truncate=False)

# Detener la sesión Spark
spark.stop()