import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew

def medcouple(data):
    """
    Вычисляет медиакулятор (medcouple) для оценки асимметрии распределения.
    Функция использует векторизованное вычисление для повышения эффективности.
    """
    data = np.sort(data)
    median_val = np.median(data)

    # Разделить данные на левую и правую части относительно медианы
    left = data[data <= median_val]
    right = data[data >= median_val]

    # Количество повторяющихся медианных значений
    k = np.sum(data == median_val)

    # Создаем сетку значений для левой и правой выборок
    xi, xj = np.meshgrid(left, right, indexing='ij')

    # Для избежания деления на ноль и недопустимых операций
    with np.errstate(divide='ignore', invalid='ignore'):
        # Вычисляем ядро h для ненулевого знаменателя
        h_non_special = (xi + xj - 2 * median_val) / (xj - xi)
    # Если знаменатель равен нулю, то условно определим h = 0
    h_non_special = np.where(xj == xi, 0, h_non_special)

    if k > 1:
        # Индексы для левой и правой части
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        i, j = np.meshgrid(left_indices, right_indices, indexing='ij')
        # Вычисляем специальное ядро в случаях, когда xi и xj равны медиане
        special = np.where(i + j - 1 < k, -1, np.where(i + j - 1 == k, 0, 1))
        # Используем специальное ядро там, где одновременно xi и xj == median_val
        condition = (xi == median_val) & (xj == median_val)
        h_matrix = np.where(condition, special, h_non_special)
    else:
        h_matrix = h_non_special

    # Возвращаем медиану по всем вычисленным значениям h
    return np.median(h_matrix.flatten())

def adjusted_boxplot_bounds(data):
    """
    Вычисляет границы скорректированного boxplot с учетом асимметрии данных.
    Границы вычисляются на основе интерквартильного размаха и статистики medcouple.
    """
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """
    Нормализация данных с использованием скорректированного ящичного графика.
    Данные масштабируются так, чтобы нижняя граница соответствовала 0, а верхняя 1.
    """
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(f"Нижняя граница: {lower_fence}, Верхняя граница: {upper_fence}")
    return (data - lower_fence) / (upper_fence - lower_fence)

# Генерация данных
np.random.seed(42)
data_normal = np.random.normal(loc=50, scale=10, size=10000)
data_skewed = np.random.exponential(scale=20, size=10000)
# Добавляем выбросы и аномальные значения в скошенные данные
data_skewed = np.concatenate([data_skewed[5:], [200, 250, 300, -100, -50]])
data_with_outliers = np.concatenate([data_normal, [150, 160, 170]])

# Формируем DataFrame с различными наборами данных
df = pd.DataFrame({
    "Normal": data_normal,
    "Skewed": data_skewed,
    # Если нужно добавить данные с выбросами, раскомментируйте следующую строку:
    # "With_Outliers": data_with_outliers,
})

# Нормализация данных в каждом столбце
normalized_df = df.apply(normalize_column)

# Гистограмма до нормализации
plt.figure(figsize=(16, 4), dpi=250)
bins = np.linspace(-5, 200, 206)
bin_width = bins[1] - bins[0]

for col in df.columns:
    hist, _ = np.histogram(df[col], bins=bins)
    bin_centers = (bins[:-1] + bins[1:]) / 2
    offset = bin_width / 4
    plt.bar(bin_centers - offset, hist, width=bin_width, align='center', alpha=0.2, label=f'{col}')
plt.legend()
plt.title("Histogram Before Normalization")
plt.xlim(-10, 200)
plt.show()

# Гистограмма после нормализации
plt.figure(figsize=(16, 4), dpi=250)
bins = np.linspace(-2, 2, 101)
bin_width = bins[1] - bins[0]

for col in normalized_df.columns:
    hist, _ = np.histogram(normalized_df[col], bins=bins)
    bin_centers = (bins[:-1] + bins[1:]) / 2
    offset = bin_width / 2
    plt.bar(bin_centers - offset, hist, width=bin_width, align='center', label=f'{col}', alpha=0.2)
plt.legend()
plt.title("Histogram After Normalization")
plt.show()