from manim import *

class MaroAnimation(Scene):
    def construct(self):
        # Create text "Maro" with a large font size
        text = Text("Maro", font_size=120)
        
        # Apply a beautiful gradient from blue to purple to pink
        text.set_color_by_gradient(BLUE, PURPLE, PINK)
        
        # Write the text onto the scene with a smooth animation
        self.play(
            Write(text, run_time=2),
            rate_func=smooth
        )
        
        # Apply a gentle pulse (scale up and then back)
        self.play(
            text.animate.scale(1.2),
            rate_func=there_and_back,
            run_time=1.5
        )
        
        # Combine rotation and upward shift in a single animation call
        self.play(
            text.animate.rotate(PI / 12).shift(UP * 0.5),
            rate_func=ease_in_out_sine,
            run_time=1
        )
        
        # Hold the final frame for 2 seconds
        self.wait(2)