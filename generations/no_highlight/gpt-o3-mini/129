import requests  # for API request
import xml.etree.ElementTree  # for processing the API's XML response
import datetime  # for dates on the x-axis
import pickle  # to store variables in a file
import json
import aiofiles  # for asynchronous file operations
import asyncio

# currency class
class valute():
    """Currency and everything related to it, through the Central Bank of Russia

Required libraries:

requests

xml.etree.ElementTree

datetime

pickle

json"""
    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """Checking the currency name for presence in the set of currencies. The set is updated no more than once a day."""
        # open the info file, encoding to avoid issues
        async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\Info.json", "r", encoding="utf-8") as info_file:
            info_content = await info_file.read()
        info = json.loads(info_content)
        
        # checking the condition that the date of the currency list update is at least 1 day ago
        last_checked = datetime.datetime.strptime(info["last_day_check"]["valute"], "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_checked:
            # if it differs by more than 1 day, then rewrite the list (set) of currencies:
            set_valutes = set()  # create an empty set, we will fill it with currencies
            s = "http://www.cbr.ru/scripts/XML_daily.asp"
            r = requests.get(s)
            root = xml.etree.ElementTree.fromstring(r.content)  # The request still returns the site data as a string, so fromstring is necessary.
            for Valute in root.findall("Valute"):
                CharCode = Valute.find("CharCode")
                set_valutes.add(CharCode.text)  # pouring currencies into our set
            # write the created set into a binary file
            async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin", "wb") as set_file:
                data = pickle.dumps(set_valutes)
                await set_file.write(data)
            # change the last update time
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\Info.json", "w", encoding="utf-8") as info_file:
                new_info = json.dumps(info, indent=3, ensure_ascii=False)
                await info_file.write(new_info)
        # now just check if the currency is in the list of currencies
        async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin", "rb") as set_file:
            data = await set_file.read()
            set_valutes = pickle.loads(data)
        if self.name in set_valutes:  # just check if the currency is in the set of tickers
            return True
        else:
            return False

    def CurrentExchangeRate(self):
        '''Current exchange rate of the currency to ruble'''
        r = requests.get("http://www.cbr.ru/scripts/XML_daily.asp")  # CB RF API
        root = xml.etree.ElementTree.fromstring(r.content)
        for Valute in root.findall("Valute"):  # searching for currency containers
            for CharCode in Valute.findall("CharCode"):  # searching for charcode containers
                if CharCode.text == self.name:  # find the container with the required currency
                    return Valute.find("VunitRate").text