import random
import string
from beem.discussions import Discussions, Query
from beem.comment import Comment

# Global variables/constants
n_respuestas_minimas = 5
diccionario = {}

# Helper functions
def procesar(texto: str):
    return "count me " in texto

def is_own_author(autor: str):
    return autor == 'subidu'

def is_banned(autor: str):
    list_banned = []
    return autor in list_banned

def generar_permlink_unico() -> str:
    return "".join(random.choices(string.digits, k=10))

def preparar_comentario(parent_author: str,
                         parent_permlink: str,
                         permlink: str,
                         title: str = '',
                         author: str = 'subidu',
                         body: str = 'Count me in ^^ @subidu') -> dict:
    return {
        "parent_author": parent_author,
        "parent_permlink": parent_permlink,
        "author": author,
        "permlink": permlink,
        "title": title,
        "body": body,
    }

# Recursive function to build the hierarchy of replies.
def build_replies_hierarchy(comment_obj: Comment) -> list:
    """
    Given a Comment object, recursively build a list of replies with their own children.
    Each reply is represented as a dictionary with keys: author, permlink, body, and children.
    """
    try:
        # Get immediate replies as a list of dictionaries.
        replies_list = comment_obj.get_replies()
    except Exception as e:
        print(f"Error getting replies: {e}")
        return []
    
    hierarchy = []
    for reply in replies_list:
        reply_data = {
            "author": reply['author'],
            "permlink": reply['permlink'],
            "body": reply.get('body', ''),
            "children": []
        }
        
        # If the reply indicates that there are further nested replies, attempt to process them.
        if reply.get('children', 0) > 0:
            # Build the Comment object for the reply to fetch its children.
            try:
                child_comment = Comment(authorperm=f"{reply['author']}/{reply['permlink']}")
                reply_data["children"] = build_replies_hierarchy(child_comment)
            except Exception as e:
                print(f"Error processing nested replies for {reply['author']}/{reply['permlink']}: {e}")
                reply_data["children"] = []
                
        hierarchy.append(reply_data)
    return hierarchy

# Function to create a hierarchical dictionary based on posts and their replies
def create_hierarchical_structure() -> dict:
    """
    Iterates through posts (from posts_generator) and builds a hierarchical dictionary
    where each post (with enough replies) is keyed by a unique identifier, and its value
    is a dictionary containing post information and a list of nested replies.
    """
    hierarchical_dict = {}
    q = Query()
    d = Discussions()
    posts_generator = d.get_discussions("created", q, limit=6000)
    
    post_index = 0
    for post in posts_generator:
        post_index += 1
        post_author = post.get('author')
        post_permlink = post.get('permlink')
        num_replies = post.get('children', 0)
        
        # Only process posts that have at least a minimum number of replies
        if num_replies > n_respuestas_minimas:
            # Build the Comment object for the post to fetch replies.
            try:
                post_comment = Comment(authorperm=f"{post_author}/{post_permlink}")
                replies = build_replies_hierarchy(post_comment)
            except Exception as e:
                print(f"Error processing replies for post {post_author}/{post_permlink}: {e}")
                replies = []
            
            # Optionally, you can filter or process replies further.
            valid_reply_count = 0
            for reply in replies:
                # Process only if the reply is not from our own author and not banned,
                # and if its text passes the processing function.
                if is_own_author(reply["author"]):
                    continue  # Skip our own reply
                if is_banned(reply["author"]):
                    continue  # Skip banned authors
                if procesar(reply["body"]):
                    valid_reply_count += 1
            
            # If the post has more than a threshold of valid replies, add it to the hierarchy.
            if valid_reply_count > 3:
                # Use a unique key for the post, for example by combining author and permlink.
                post_key = f"{post_author}/{post_permlink}"
                hierarchical_dict[post_key] = {
                    "post_index": post_index,
                    "author": post_author,
                    "permlink": post_permlink,
                    "body": post.get('body', ''),
                    "replies": replies
                }
                print("Processed post:", post_key)
                
    return hierarchical_dict

# Original processing loop (with slight modifications)
def process_posts():
    q = Query()
    d = Discussions()
    posts_generator = d.get_discussions("created", q, limit=6000)
    X = 0

    for post in posts_generator:
        post_author = post.get('author')
        post_permlink = post.get('permlink')
        num_replies = post.get('children', 0)
        cnt = 0
        X += 1
        if num_replies > n_respuestas_minimas:
            try:
                comment = Comment(authorperm=f"{post_author}/{post_permlink}")
                post_replies = comment.get_replies()
            except Exception as e:
                print(f"Error retrieving replies for post {post_author}/{post_permlink}: {e}")
                continue

            for reply in post_replies:
                author = reply.get('author')
                text = reply.get('body', '')
                if is_own_author(author):
                    # Re-asses the comment; using break as in original behavior.
                    break
                if is_banned(author):
                    break
                if procesar(text):
                    cnt += 1
        if cnt > 3:
            print("Iterador:", X)
            # Print the last reply processed as in the original code.
            print(reply.get('author'), '/', reply.get('permlink'))

if __name__ == '__main__':
    # Build and optionally store the hierarchical dictionary of posts and replies.
    diccionario = create_hierarchical_structure()
    
    # Optionally, process posts in the original way (this loop may be kept for legacy behavior).
    process_posts()
    
    # For demonstration, print out the hierarchical structure collected.
    print("Hierarchical Dictionary of Posts and Replies:")
    for key, value in diccionario.items():
        print(f"Post: {key}")
        print(f"Data: {value}")