import requests
import json

def interact_with_local_llm(prompt, base_url="http://localhost:11434"):
    """
    Interakcja z lokalnym LLM za pomocą API Ollama.

    :param prompt: Wejściowy prompt dla LLM.
    :param base_url: Bazowy URL API Ollama.
    :return: Odpowiedź z LLM lub None, jeśli wystąpił problem.
    """
    endpoint = f"{base_url}/api/generate"
    payload = {
        "model": "llama3.2:latest",  # Zastąp nazwą swojego modelu
        "prompt": prompt,
        "max_tokens": 2048  # Dostosuj w razie potrzeby
    }
    headers = {
        "Content-Type": "application/json"
    }
    
    try:
        response = requests.post(endpoint, json=payload, headers=headers)
        response.raise_for_status()

        # Próba deserializacji JSON z wykorzystaniem response.json()
        try:
            data = response.json()
        except json.JSONDecodeError as e:
            # Jeśli wystąpił błąd dekodowania JSON, używamy decoder.raw_decode aby spróbować naprawić sytuację
            try:
                decoder = json.JSONDecoder()
                data, idx = decoder.raw_decode(response.text)
            except json.JSONDecodeError as e_inner:
                # W przypadku kolejnego błędu, zwracamy None
                print(f"Błąd dekodowania JSON: {e_inner}")
                return None

        return data.get('response', '')

    except requests.exceptions.RequestException as e:
        print(f"Błąd żądania: {e}")
        return None

# Przykład użycia
if __name__ == "__main__":
    prompt = "Hello, how are you?"
    response_text = interact_with_local_llm(prompt)
    if response_text:
        print(f"LLM Response: {response_text}")
    else:
        print("Nie udało się uzyskać odpowiedzi od LLM.")