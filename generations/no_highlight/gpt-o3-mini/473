import numpy as np

def linear_regression_gradient_descent(
    X: np.ndarray, y: np.ndarray, alpha: float, iterations: int
) -> np.ndarray:
    m, n = X.shape
    theta = np.zeros((n, 1))
    
    # Convert y to a column vector if necessary
    if y.ndim == 1:
        y = y.reshape(-1, 1)
    
    for _ in range(iterations):
        # Compute the error ensuring proper shapes for broadcasting
        error = X @ theta - y
        gradient = (1 / m) * (X.T @ error)
        theta -= alpha * gradient

    return theta

if __name__ == "__main__":
    result = linear_regression_gradient_descent(
        np.array([[1, 1], [1, 2], [1, 3]]), np.array([1, 2, 3]), 0.01, 1000
    )
    print(result)