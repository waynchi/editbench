import pandas as pd
import random

class Stock:
    def __init__(self, filename, name):
        self.filename = filename
        try:
            self.data = pd.read_csv(self.filename, index_col=0, parse_dates=True)
        except Exception as e:
            print(f"Unable to read file {self.filename}")
            raise e
        self.data.index.name = 'time'
        self.name = name
        self.attrs = {}

    def get_attr(self, key):
        try:
            return self.attrs[key]
        except KeyError:
            return None

    def set_attr(self, key, value):
        self.attrs[key] = value

    def get(self, i):
        return self.data.iloc[i]

    def get_range(self, s, t):
        return self.data.iloc[s:t+1]

    def __len__(self):
        return len(self.data)

class Transaction:
    def __init__(self, num, price):
        self.num = num
        self.price = price
        self.date = None

    def set_date(self, date):
        self.date = date

class Trade:
    def __init__(self, stock, long=True, num=0, price=0.0):
        self.stock = stock
        self.num = 0
        self.profit = 0
        self.closed = False
        self.long = long

        self.opens = []
        self.closes = []

        if num != 0:
            self.open(num, price)

    def close(self, num, price):
        if num > self.num:
            raise ValueError(f"ERR: Trying to close {num} of {self.stock.name} but only {self.num} available")
        self.num -= num
        self.closes.append(Transaction(num, price))

        if self.long:
            self.profit = self.get_num_closed() * (self.get_avg_close_price() - self.get_avg_open_price())
        else:
            self.profit = self.get_num_closed() * (self.get_avg_open_price() - self.get_avg_close_price())

        if self.num == 0:
            self.closed = True

    def open(self, num, price):
        self.num += num
        self.opens.append(Transaction(num, price))

    def get_equity(self, i):
        current_price = self.stock.get(i)["close"]
        if self.long:
            return self.num * current_price
        else:
            # Для коротких сделок капитал может отражать потенциальные затраты на закрытие позиции
            return self.num * (self.get_avg_open_price() - current_price)

    def set_date(self, date):
        [transaction.set_date(date) for transaction in self.opens if transaction.date is None]
        [transaction.set_date(date) for transaction in self.closes if transaction.date is None]

    def get_avg_open_price(self):
        total_price = sum(transaction.price * transaction.num for transaction in self.opens)
        total_num = sum(transaction.num for transaction in self.opens)
        return total_price / total_num if total_num else 0

    def get_avg_close_price(self):
        total_price = sum(transaction.price * transaction.num for transaction in self.closes)
        total_num = sum(transaction.num for transaction in self.closes)
        return total_price / total_num if total_num else 0

    def get_num_opened(self):
        return sum(transaction.num for transaction in self.opens)

    def get_num_closed(self):
        return sum(transaction.num for transaction in self.closes)

class Strategy:
    def __init__(self):
        self.stocks = []
        self.starting_money = 100000.0
        self.money = self.starting_money
        self.closed_trades = []
        self.open_trades = []
        self.attrs = {}
        self.analyzers = []

    def get_attr(self, key):
        return self.attrs[key]

    def set_attr(self, key, value):
        self.attrs[key] = value

    def add_analyzer(self, analyzer):
        analyzer.strategy = self
        self.analyzers.append(analyzer)

    def has_open_trade(self, stock):
        for trade in self.open_trades:
            if stock is trade.stock:
                return True
        return False

    def get_open_trade(self, stock):
        for trade in self.open_trades:
            if trade.stock is stock:
                return trade
        raise ValueError("No open trade on stock " + str(stock.name))

    def open_trade(self, stock, num, price):
        # Use the current candle's identifier (e.g. its timestamp) from stock.get(i)["close"] row.
        i = self.attrs.get("i", 0)
        if self.money < num * price:
            raise ValueError("Insufficient funds: have $" + str(self.money) + 
                             " available and trying to open " + str(num) + " of " + 
                             str(stock.name) + " at $" + str(price) + " on " + str(stock.get(i).name))

        if self.has_open_trade(stock):
            trade = self.get_open_trade(stock)
            trade.open(num, price)
            trade.set_date(stock.get(i).name)
        else:
            new_trade = Trade(stock, True, num, price)
            new_trade.set_date(stock.get(i).name)
            self.open_trades.append(new_trade)

        self.money -= num * price

    def sell(self, stock, num, price):
        if self.has_open_trade(stock):
            trade = self.get_open_trade(stock)
            trade.close(num, price)
            if trade.closed:
                self.open_trades.remove(trade)
                self.closed_trades.append(trade)
            trade.set_date(stock.get(self.attrs.get("i", 0)).name)
        else:
            raise ValueError("No position to close in " + str(stock.name))

        self.money += num * price

    def get_equity(self, i):
        res = self.money
        for trade in self.open_trades:
            res += trade.get_equity(i)
        return res

    def next(self, i):
        pass

class Computer:
    def __init__(self):
        self.stocks = []
        self.strategies = []
        # Number of intraday samples to simulate for the candle that is still forming.
        # The last sample (sample index samples_per_candle-1) will be the actual final values.
        self.samples_per_candle = 5

    def add_stock(self, stock):
        if type(stock) is not Stock:
            exit("ERR: called 'add_stock' on type: " + str(type(stock)))
        self.stocks.append(stock)
    
    def add_strategy(self, strategy):
        if not isinstance(strategy, Strategy):
            exit("ERR: called 'add_strategy' on type: " + str(type(strategy)))
        self.strategies.append(strategy)

    def run(self):
        # Internal helper to generate a variation of the candle row.
        def generate_variation(row):
            new_row = row.copy()
            # Make sure 'low', 'high', 'close', and 'volume' exist in the row.
            # For close, simulate that the evolving value is somewhere between the low and high of the final candle.
            low = row['low']
            high = row['high']
            # If low and high are identical, no variation is possible.
            if low == high:
                new_close = row['close']
            else:
                new_close = random.uniform(low, high)
            new_row['close'] = new_close
            # For high: current high might not have reached the final high yet.
            new_high = random.uniform(new_close, high) if new_close < high else high
            new_row['high'] = new_high
            # For low: current low might be higher than the final low if prices are rising.
            new_low = random.uniform(low, new_close) if low < new_close else low
            new_row['low'] = new_low
            # Simulate volume accumulation: during the candle, volume is lower than the final volume.
            final_volume = row['volume']
            if final_volume > 0:
                new_volume = random.uniform(0.5 * final_volume, final_volume)
            else:
                new_volume = 0
            new_row['volume'] = new_volume
            # If there's an 'open' column, keep it fixed.
            if 'open' in row:
                new_row['open'] = row['open']
            return new_row

        # Перебираем стратегии и для каждой из них - все акции
        for strategy in self.strategies:
            j = 1
            for stock in self.stocks:
                strategy.stocks = [stock]
                print(f"stock #{j}/{len(self.stocks)}")
                j += 1

                for i in range(len(stock)):
                    strategy.set_attr("i", i)
                    # Если это последняя свеча (которая считается ещё формирующейся),
                    # то проводим несколько "образцов" с вариациями.
                    if i == len(stock) - 1:
                        # Сохраним оригинальную строку свечи.
                        original_row = stock.data.iloc[i].copy()
                        for sample in range(self.samples_per_candle):
                            if sample < self.samples_per_candle - 1:
                                # Генерируем вариацию для текущей свечи.
                                variation = generate_variation(original_row)
                                stock.data.loc[stock.data.index[i]] = variation
                            else:
                                # На последнем образце используем окончательные (оригинальные) данные.
                                stock.data.loc[stock.data.index[i]] = original_row
                            # Вызываем логику стратегии для данного временного шага (образца).
                            strategy.next(i)
                            for analyzer in strategy.analyzers:
                                analyzer.next(i)
                    else:
                        # Для исторических свечей без вариаций просто вызываем стратегию один раз.
                        strategy.next(i)
                        for analyzer in strategy.analyzers:
                            analyzer.next(i)

                    # Если это последняя свеча, закрываем все открытые сделки,
                    # используя окончательное значение close из оригинальной строки.
                    if i == len(stock) - 1:
                        for strat in self.strategies:
                            while len(strat.open_trades) > 0:
                                trade = strat.open_trades[0]
                                strat.sell(trade.stock, trade.num, original_row["close"])
                # После обработки акции сбрасываем список акций в стратегии.
                strategy.stocks = []