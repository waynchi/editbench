async def main():
    # 实例化并测试股票代码
    beb = ticker("SBER")
    is_valid = await beb.correct_name()
    if not is_valid:
        print("Ticker name not valid!")
        return

    # 获取当前价格
    current_price = await beb.CurrentPrice()
    print(f"Current Price: {current_price}")

    # 设置技术指标
    beb.tech_dict["sma"]["use"] = True
    beb.tech_dict["sma"]["periods"] = [20, 10]
    beb.tech_dict["ema"]["use"] = True
    beb.tech_dict["ema"]["periods"] = [150, 250]
    beb.tech_dict["value"]["use"] = True

    # 生成图表，指定时间框架与时间段
    graphic_path = await beb.graphic("24", "2024-01-01", "2024-05-01")
    print(f"Graphic saved to: {graphic_path}")
    # 若需要展示图像，可取消下面两行的注释:
    # img = plt.imread(graphic_path)
    # plt.imshow(img); plt.show()

if __name__ == "__main__":
    asyncio.run(main())