import torch
import torch.nn as nn

class SimpleConvNet(nn.Module):
    def __init__(self, input_shape):
        """
        Konstruktor sieci przyjmuje input_shape jako krotkę (C, H, W).
        Sieć składa się z dwóch warstw splotowych a następnie z w pełni połączonych.
        """
        super(SimpleConvNet, self).__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(input_shape[0], 32, kernel_size=3),  # Warstwa splotowa: kanały wejściowe, wyjściowe, rozmiar jądra
            nn.ReLU(),
            nn.MaxPool2d(2)  # Redukcja wymiarów przez pooling
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.flatten = nn.Flatten()

        # Obliczamy automatycznie rozmiar "spłaszczonego" tensora, który jest wynikiem przejścia przez warstwy splotowe.
        with torch.no_grad():
            dummy = torch.zeros(1, *input_shape)
            dummy = self.conv1(dummy)
            dummy = self.conv2(dummy)
            flat_size = dummy.view(1, -1).shape[1]
        
        self.fc = nn.Sequential(
            nn.Linear(flat_size, 512),
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc(x)
        return x

if __name__ == '__main__':
    # Przykładowe wejście: obraz o wymiarach (3, 32, 32)
    input_shape = (3, 32, 32)
    model = SimpleConvNet(input_shape)
    x = torch.randn(1, *input_shape)
    output = model(x)
    print("Output shape:", output.shape)