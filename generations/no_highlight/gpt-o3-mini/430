from dataclasses import dataclass
import numpy as np
norm = np.random.normal


@dataclass
class NeuralNetwork:
    inp: int       # liczba neuronów wejściowych
    hid: int       # liczba neuronów w warstwie ukrytej
    out: int       # liczba neuronów wyjściowych
    lr: float      # współczynnik uczenia się (learning rate)
    act: callable  # funkcja aktywacji
    epo: int       # liczba epok

    def __post_init__(self):
        # Poprawa błędu: standardowe odchylenie powinno być 1/√(liczba wejść)
        self.wih = norm(0., 1.0 / np.sqrt(self.inp), (self.hid, self.inp))
        self.who = norm(0., 1.0 / np.sqrt(self.hid), (self.out, self.hid))

    def train(self, x, y):
        x = np.array(x, ndmin=2).T
        y = np.array(y, ndmin=2).T

        ho = self.act(self.wih @ x)    # wyjścia warstwy ukrytej
        fo = self.act(self.who @ ho)   # wyjścia końcowe
        oe = y - fo                   # błąd warstwy wyjściowej
        he = self.who.T @ oe          # błąd warstwy ukrytej

        # Aktualizacja wag między warstwą ukrytą a wyjściową
        self.who += self.lr * (oe * fo * (1. - fo)) @ ho.T
        # Aktualizacja wag między warstwą wejściową a ukrytą
        self.wih += self.lr * (he * ho * (1. - ho)) @ x.T

    def query(self, x):
        x = np.array(x, ndmin=2).T
        hidden_outputs = self.act(self.wih @ x)
        final_outputs = self.act(self.who @ hidden_outputs)
        return final_outputs

    def fit(self, X, y):
        for _ in range(self.epo):
            for i in range(len(y)):
                self.train(X[i], y[i])

    def predict(self, X):
        return np.array([np.argmax(self.query(x)) for x in X])

    def score(self, X, y):
        true_labels = np.array([np.argmax(target) for target in y])
        predictions = self.predict(X)
        return (predictions == true_labels).mean()