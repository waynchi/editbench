from pathlib import Path
import shutil

target_folder = 'F:/Maverick/desktop/Windows/temp/'

def get_content_delivery_path():
    """Obtener la ruta de Windows Content Delivery"""
    path = Path('C:/Users/admin/AppData/Local/Packages/')
    matched = path.glob('*Microsoft.Windows.ContentDeliveryManager*')
    if result := next(matched, None):
        suffix = 'LocalState/Assets/'
        return result / suffix
    else:
        raise Exception('ContentDeliveryManager Not Found')

def jpeg(source_folder, target_folder):
    """
    Copiar archivos de la carpeta de origen a la carpeta de destino y agregar el sufijo .jpeg a cada archivo.
    Se asegura de que la carpeta de destino exista, y luego copia cada archivo renombrándolo.
    """
    source_folder = Path(source_folder)
    target_folder = Path(target_folder)
    target_folder.mkdir(parents=True, exist_ok=True)

    # Recorremos todos los archivos en la carpeta de origen
    for file in source_folder.iterdir():
        if file.is_file():
            # Crear el nombre del archivo de destino añadiendo el sufijo ".jpeg"
            # Por ejemplo, si el archivo es "abc", el nuevo nombre será "abc.jpeg"
            # Si el archivo tiene extensión, se conserva el nombre completo y se le añade el sufijo ".jpeg"
            nuevo_nombre = file.name + ".jpeg"
            destino = target_folder / nuevo_nombre

            # Copiar el archivo a la carpeta de destino
            shutil.copy2(file, destino)
            print(f"Copiado: {file} -> {destino}")

if __name__ == '__main__':
    source_folder = get_content_delivery_path()
    print(f"Windows Content Delivery path: {source_folder}")
    jpeg(source_folder, target_folder)