import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self, flattened_size):
        super(SimpleConvNet1, self).__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )

        self.flatten = nn.Flatten()
        self.fc1 = nn.Sequential(
            nn.Linear(flattened_size, 512),  # flattened_size determined from conv output dimensions
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x

if __name__ == "__main__":
    # Example: using an input image of size 3 x 32 x 32
    # After conv1:
    #   Conv2d with kernel_size=3: from 32x32 -> 30x30 (calculation: 32 - 3 + 1 = 30)
    #   MaxPool2d with kernel_size=2: from 30x30 -> floor(30/2)=15x15
    # After conv2:
    #   Conv2d with kernel_size=3: from 15x15 -> 13x13 (15 - 3 + 1 = 13)
    #   MaxPool2d with kernel_size=2: from 13x13 -> floor(13/2)=6x6
    # Therefore, the flattened size will be: 64 channels * 6 * 6 = 2304
    flattened_size = 64 * 6 * 6

    # Initialize the network
    net = SimpleConvNet1(flattened_size)
    
    # Create a dummy input tensor with batch_size=1 and dimensions (channels, height, width) = (3, 32, 32)
    dummy_input = torch.randn(1, 3, 32, 32)
    
    # Forward pass
    output = net(dummy_input)
    print("Output shape:", output.shape)