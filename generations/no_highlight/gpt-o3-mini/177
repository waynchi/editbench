import os
import time
import undetected_chromedriver as uc

def main():
    # Get the directory of the current script
    script_dir = os.path.dirname(os.path.abspath(__file__))

    # Build the path to the chromedriver executable
    # Note: In undetected_chromedriver, you should not set options.binary_location to the chromedriver path.
    # Instead, if you want to force a particular driver executable, pass it as driver_executable_path.
    driver_executable_path = os.path.join(script_dir, "chromedriver-win64", "chromedriver.exe")

    # Create a ChromeOptions instance.
    options = uc.ChromeOptions()
    # If you needed to specify a custom Chrome browser binary (not the chromedriver),
    # you would set options.binary_location to that path.
    # For example:
    # options.binary_location = r"C:\Path\To\Google\Chrome\Application\chrome.exe"

    print("Starting undetected_chromedriver session...")

    # Initialize the driver.
    # The parameter driver_executable_path tells UC to use your given chromedriver instead of downloading one.
    try:
        with uc.Chrome(driver_executable_path=driver_executable_path, use_subprocess=True, options=options) as driver:
            print("Driver started successfully. Navigating to the website...")
            driver.get("https://lmarena.ai/")
            print("Website loaded. Waiting for 10 seconds...")
            time.sleep(10)
    except Exception as e:
        print("An error occurred:", e)

if __name__ == "__main__":
    main()