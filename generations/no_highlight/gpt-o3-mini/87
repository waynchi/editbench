import tkinter as tk
import random

def random_color():
    # Generate a random hex color
    return "#%06x" % random.randint(0, 0xFFFFFF)

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        # Increase speed for better visualization
        self.dx = random.choice([-3, 3])
        self.dy = random.choice([-3, 3])
        # Use a random fill color instead of fixed blue
        self.color = random_color()
        self.square = canvas.create_rectangle(x, y, x + size, y + size, fill=self.color, outline="black")

    def move(self):
        self.x += self.dx
        self.y += self.dy
        self.canvas.move(self.square, self.dx, self.dy)
        
        # Force update to obtain correct dimensions
        self.canvas.update_idletasks()
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()
        
        # Check if the square touches any canvas boundary
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            # Delete the current square
            self.canvas.delete(self.square)
            # Create two new squares if the current size is big enough
            if self.size > 10:
                new_size = self.size / 2
                # Create new squares centered around the canvas center
                squares.append(Square(self.canvas, new_size,
                                      canvas_width/2 - new_size * 1.5,
                                      canvas_height/2 - new_size * 1.5))
                squares.append(Square(self.canvas, new_size,
                                      canvas_width/2 + new_size * 0.5,
                                      canvas_height/2 + new_size * 0.5))
            return False
        return True

def update():
    global squares
    # Move all squares and filter out those that have been deleted
    squares = [square for square in squares if square.move()]
    root.after(20, update)

# Create main window
root = tk.Tk()
root.title("Splitting Colored Squares")

# Create canvas with a white background
canvas = tk.Canvas(root, width=600, height=600, bg="white")
canvas.pack(expand=True, fill="both")

# Create initial square (colored)
squares = [Square(canvas, 100, 250, 250)]

# Start animation
update()

# Start main event loop
root.mainloop()