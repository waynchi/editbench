import json
from langchain_ollama import ChatOllama
from langchain_core.prompts.chat import ChatPromptTemplate

def main():
    # Инициализировать модель ChatOllama
    try:
        chat_model = ChatOllama(model="llama3.2", base_url="http://localhost:11434")
    except Exception as e:
        print(f"Ошибка инициализации модели: {e}")
        return

    # Загрузить значения SHAP из файла JSON
    try:
        with open("Vuori_Final_Approval_2024_09_24.json", "r", encoding="utf-8") as file:
            data = json.load(file)
            shap_values = data.get("shap_values")
            if shap_values is None:
                print("SHAP значения не найдены в JSON файле.")
                return
    except Exception as e:
        print(f"Ошибка чтения файла JSON: {e}")
        return

    # Загрузить системный запрос из файла
    try:
        with open("system.prompt", "r", encoding="utf-8") as file:
            sys_prompt = file.read().strip()
            if not sys_prompt:
                print("Системный запрос пуст.")
                return
    except Exception as e:
        print(f"Ошибка чтения системного запроса: {e}")
        return

    # Подготовить шаблон для сообщений
    template = ChatPromptTemplate([
        ("system", sys_prompt),
        ("human", "{user_input}"),
    ])

    # Интегрировать данные (SHAP значения) в качестве пользовательского ввода.
    # Преобразуем объект SHAP в форматированный JSON для удобного чтения.
    user_input = json.dumps(shap_values, ensure_ascii=False, indent=2)
    prompt_value = template.invoke(user_input=user_input)

    # Скомбинировать prompt и модель, используя оператор Pipe (если он реализован)
    chain = prompt_value | chat_model

    # Сгенерировать и вывести ответ модели
    try:
        response = chain.invoke()
        print("Ответ модели:")
        print(response)
    except Exception as e:
        print(f"Ошибка при выполнении цепочки: {e}")

if __name__ == "__main__":
    main()