import math

class Value:
    """Almacena un único valor escalar y su gradiente, y construye el gráfico de computación para autograd."""

    def __init__(self, data, _children=(), _op=''):
        self.data = data
        self.grad = 0
        # variables internas utilizadas para la construcción del gráfico de autograd
        self._backward = lambda: None
        self._prev = set(_children)
        self._op = _op  # la operación que produjo este nodo, para graphviz / depuración / etc

    def __add__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data + other.data, (self, other), '+')

        def _backward():
            self.grad += out.grad
            other.grad += out.grad
        out._backward = _backward

        return out

    def __mul__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data * other.data, (self, other), '*')

        def _backward():
            self.grad += other.data * out.grad
            other.grad += self.data * out.grad
        out._backward = _backward

        return out

    def __pow__(self, other):
        assert isinstance(other, (int, float)), "only supporting int/float powers for now"
        out = Value(self.data ** other, (self,), f'**{other}')

        def _backward():
            self.grad += (other * self.data**(other - 1)) * out.grad
        out._backward = _backward

        return out

    def log(self):
        out = Value(math.log(self.data), (self,), f'log')
        def _backward():
            self.grad += (1 / self.data) * out.grad
        out._backward = _backward       
        return out

    def relu(self):
        assert isinstance(self.data, (int, float)), "only supporting int/float values for ReLU"
        out = Value(0 if self.data < 0 else self.data, (self,), 'ReLU')

        def _backward():
            self.grad += (out.data > 0) * out.grad
        out._backward = _backward

        return out

    def exp(self):
        """Función exponencial diferenciable."""
        out = Value(math.exp(self.data), (self,), 'exp')
        def _backward():
            self.grad += math.exp(self.data) * out.grad
        out._backward = _backward
        return out

    @staticmethod
    def softmax(values):
        """
        Calcula la función softmax de una lista de valores Value de forma numéricamente estable,
        y conecta los nodos de la computación para permitir la diferenciación a través del softmax.
        
        Sea:
            s_i = exp(v_i - max(v)) / sum_j exp(v_j - max(v))
        la función backward que aplica la derivada de softmax es:
            para cada entrada i:
                dL/dv_i = s_i * ( dL/ds_i - sum_j (dL/ds_j * s_j) )
        """
        # Para estabilidad numérica se le resta el máximo de los datos.
        max_val = max(v.data for v in values)
        # Calcular cada exponencial: exp(v_i - max_val)
        exps = [(v - max_val).exp() for v in values]

        # Sumar todas las exponenciales
        sum_exps = Value(0)
        for e in exps:
            sum_exps = sum_exps + e

        # Calcular cada componente del softmax
        outs = [e / sum_exps for e in exps]

        # Conectar el backward de softmax de forma conjunta.
        # Notar que cada nodo outs[i] ya tiene su propia computación de backward,
        # pero debido a la dependencia compartida en sum_exps, la derivada completa del softmax
        # incluye efectos cruzados entre las entradas.
        #
        # Para asegurar que la diferenciación conjunta se realice correctamente, sobreescribimos
        # el _backward de cada uno de los nodos softmax para que se realice la acumulación conjunta.
        #
        # La derivada del softmax es:
        #   ∂s_i/∂v_j = s_i * (δ_ij - s_j)
        #
        # Y la regla de la cadena completa da, para cada entrada j:
        #   dL/dv_j = sum_i (dL/ds_i) * s_i * (δ_ij - s_j)
        #
        # Implementamos esto en un _backward común que se asocia a cada uno de los outs.
        def _backward_softmax():
            # Primero, se calcula el sumatorio ponderado de gradientes: sum_i (s_i * out_i.grad)
            grad_sum = sum(out.grad * out.data for out in outs)
            # Luego, para cada entrada, se acumula la contribución:
            for i, v in enumerate(values):
                v.grad += outs[i].data * (outs[i].grad - grad_sum)

        # Para evitar la doble propagación, asignamos la misma función _backward_softmax a cada nodo softmax.
        for out in outs:
            # Se combina la retropropagación individual (por la división, etc.) con la retropropagación
            # conjunta del softmax. En este ejemplo, reemplazamos la función _backward existente por la
            # función softmax conjunta. En un sistema de autograd completo se podrían combinar ambos.
            out._backward = _backward_softmax

        return outs

    def backward(self):
        # Orden topológico de todos los nodos en el grafo
        topo = []
        visited = set()
        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for child in v._prev:
                    build_topo(child)
                topo.append(v)
        build_topo(self)

        # Establecer gradiente inicial
        self.grad = 1
        for v in reversed(topo):
            v._backward()

    def __neg__(self):  # -self
        return self * -1

    def __gt__(self, other):
        return self.data > other.data

    def __radd__(self, other):  # other + self
        return self + other

    def __sub__(self, other):  # self - other
        return self + (-other)

    def __rsub__(self, other):  # other - self
        return other + (-self)

    def __rmul__(self, other):  # other * self
        return self * other

    def __truediv__(self, other):  # self / other
        return self * other**-1

    def __rtruediv__(self, other):  # other / self
        return other * self**-1

    def __repr__(self):
        return f"Value(data={self.data}, grad={self.grad})"