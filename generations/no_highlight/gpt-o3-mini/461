# [2379] Mínimo de recoloreos para obtener K bloques negros consecutivos
#
# https://leetcode.com/problems/minimum-recolors-to-get-k-consecutive-black-blocks/description/
#
# algoritmos
# Fácil (59.47%)
# Me gusta: 751
# Disgustos: 21
# Total aceptados: 61.3K
# Total de envíos: 103K
# Ejemplo de caso de prueba: '"WBBWWBBWBW"\n7
#
# Se te da una cadena blocks de longitud n indexada desde 0, donde blocks[i] es
# ya sea 'W' o 'B', representando el color del bloque i-ésimo. Los caracteres
# 'W' y 'B' denotan los colores blanco y negro, respectivamente.
# 
# También se te da un entero k, que es el número deseado de consecutivos
# bloques negros.
# 
# En una operación, puedes recolorear un bloque blanco para que se convierta en un
# bloque negro.
# 
# Devuelve el número mínimo de operaciones necesarias para que haya al menos
# una ocurrencia de k bloques negros consecutivos.
# 
# 
# Ejemplo 1:
# 
# Entrada: blocks = "WBBWWBBWBW", k = 7
# Salida: 3
# Explicación:
# Una forma de lograr 7 bloques negros consecutivos es recolorear el bloque 0º, 3º y
# 4º para que los bloques queden como "BBBBBBBWBW".
# Se puede demostrar que no hay forma de lograr 7 bloques negros consecutivos en
# menos de 3 operaciones.
# Por lo tanto, se devuelve 3.
# 
# Ejemplo 2:
# 
# Entrada: blocks = "WBWBBBW", k = 2
# Salida: 0
# Explicación:
# No se requieren cambios ya que ya existen 2 bloques negros consecutivos.
# Por lo tanto, se devuelve 0.
#
# Restricciones:
#
# n == len(blocks)
# 1 <= n <= 100
# blocks[i] es 'W' o 'B'.
# 1 <= k <= n
#

# @lc code=inicio
class Solution:
    def minimumRecolors(self, blocks: str, k: int) -> int:
        # Contar los bloques blancos en la primera ventana de tamaño k
        white_count = blocks[:k].count('W')
        min_operations = white_count
        
        # Usamos una ventana deslizante para revisar cada subsecuencia de k bloques
        for i in range(k, len(blocks)):
            # Si el nuevo bloque en la ventana es blanco, incrementamos el contador
            if blocks[i] == 'W':
                white_count += 1
            # Si el bloque que sale de la ventana es blanco, decrementamos el contador
            if blocks[i - k] == 'W':
                white_count -= 1
            # Actualizamos el mínimo de operaciones necesarias
            min_operations = min(min_operations, white_count)
        
        return min_operations
# @lc code=end