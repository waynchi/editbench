import math

class Value:
    """хранит одно скалярное значение и его градиент"""

    def __init__(self, data, _children=(), _op=''):
        self.data = data
        self.grad = 0
        # внутренние переменные, используемые для построения графа автоградаций
        self._backward = lambda: None
        self._prev = set(_children)
        self._op = _op  # операция, которая создала этот узел, для graphviz / отладки / и т.д.

    def __add__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data + other.data, (self, other), '+')

        def _backward():
            self.grad += out.grad
            other.grad += out.grad
        out._backward = _backward

        return out

    def __mul__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data * other.data, (self, other), '*')

        def _backward():
            self.grad += other.data * out.grad
            other.grad += self.data * out.grad
        out._backward = _backward

        return out

    def __pow__(self, other):
        assert isinstance(other, (int, float)), "only supporting int/float powers for now"
        out = Value(self.data**other, (self,), f'**{other}')

        def _backward():
            self.grad += (other * self.data**(other-1)) * out.grad
        out._backward = _backward

        return out

    def log(self):
        out = Value(math.log(self.data), (self,), f'log({self.data})')

        def _backward():
            self.grad += (1 / self.data) * out.grad
        out._backward = _backward       

        return out

    def relu(self):
        assert isinstance(self.data, (int, float)), "only supporting int/float values for ReLU"
        out = Value(0 if self.data < 0 else self.data, (self,), 'ReLU')

        def _backward():
            self.grad += (1 if out.data > 0 else 0) * out.grad
        out._backward = _backward

        return out

    def backward(self):
        # строим топологический порядок всех узлов, участвующих в вычислениях
        topo = []
        visited = set()
        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for child in v._prev:
                    build_topo(child)
                topo.append(v)
        build_topo(self)

        self.grad = 1
        for v in reversed(topo):
            v._backward()

    def __neg__(self):  # -self
        return self * -1

    def __gt__(self, other):
        return self.data > other.data

    def __radd__(self, other):  # компонентный + сам
        return self + other

    def __sub__(self, other):  # self - other
        return self + (-other)

    def __rsub__(self, other):  # другое - self
        return other + (-self)

    def __rmul__(self, other):  # другое * self
        return self * other

    def __truediv__(self, other):  # self / other
        return self * other**-1

    def __rtruediv__(self, other):  # другое / self
        return other * self**-1

    def __repr__(self):
        return f"Value(data={self.data}, grad={self.grad})"


def softmax(xs):
    """
    Вычисляет softmax для списка Value объектов и назначает специальную
    функцию _backward, реализующую дифференцирование softmax.
    
    Аргументы:
      xs -- список экземпляров Value, представляющих входы (логиты)
    
    Возвращает:
      outs -- список Value, содержащих softmax-праверабилити
     
    При обратном проходе (backward) обновляются градиенты объектов xs согласно
    якобиану softmax:
      d(softmax_k)/d(x_j) = softmax_k * (δ_kj - softmax_j)
    """
    # Для численной устойчивости вычтем max
    max_val = max(x.data for x in xs)
    exp_vals = [math.exp(x.data - max_val) for x in xs]
    sum_exp = sum(exp_vals)
    softmax_vals = [e / sum_exp for e in exp_vals]
    
    # Создаем новые Value объекты для выходов softmax.
    outs = [Value(val, _children=(), _op='softmax') for val in softmax_vals]

    # Используем флаг, чтобы гарантировать вызов обратного прохода лишь единожды
    _did_backward = [False]
    def _backward():
        if _did_backward[0]:
            return
        _did_backward[0] = True
        # Собираем градиенты, переданные на выходные softmax узлы.
        grads = [out.grad for out in outs]
        # Обновляем градиенты входных узлов xs с учётом полного якобиана softmax.
        for i in range(len(xs)):
            grad_sum = 0
            for j in range(len(xs)):
                # δ_ij = 1 если i == j, иначе 0
                delta = 1 if i == j else 0
                grad_sum += grads[j] * softmax_vals[j] * (delta - softmax_vals[i])
            xs[i].grad += grad_sum

    # Назначаем общую функцию _backward для всех выходных softmax узлов.
    for out in outs:
        out._backward = _backward

    return outs