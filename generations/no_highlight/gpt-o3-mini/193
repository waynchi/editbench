import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_columns, n_clusters=2, clustering_method='kmeans'):
    """
    对指定的列集进行独立聚类。

    参数：
        features_transformed (pandas.DataFrame): 转换后的包含参数的DataFrame。
        cluster_columns (dict): 以新列名为键，以对应的用于聚类的列名序列（如tuple或list）为值。例如：
                                {'集群1': ('列1', '列2'), '集群2': ('列3',)}
        n_clusters (int): 聚类数量。
        clustering_method (str): 聚类方法（目前仅支持 'kmeans'）。

    返回：
        pandas.DataFrame: 添加了聚类标签列的DataFrame，每个聚类的结果都存储在对应的键名列中。
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    # 对每个指定列集分别进行聚类
    for cluster_feature_name, cols in cluster_columns.items():
        # 检查指定的列是否存在于DataFrame
        missing_cols = [col for col in cols if col not in features_transformed.columns]
        if missing_cols:
            print(f"列 {missing_cols} 不存在于DataFrame中。跳过聚类: {cluster_feature_name}")
            continue

        features_for_clustering = features_transformed[list(cols)].copy()
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_for_clustering)
            
            # 评估聚类质量（例如，使用轮廓系数）
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_for_clustering, cluster_labels)
                print(f"Коэффициент силуэта для {cluster_feature_name} ({cols}), кластеров={n_clusters}: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {cluster_feature_name} ({cols}) с {n_clusters} кластером (все точки в одном кластере)。")
        else:
            print(f"Неподдерживаемый метод кластеризации для {cluster_feature_name}。")
            continue
        
        # 将聚类标签添加到DataFrame中，新列名由字典的键指定
        features_transformed[cluster_feature_name] = cluster_labels
        print(f"Кластеризация выполнена для {cluster_feature_name}。 Метки кластеров добавлены в столбец '{cluster_feature_name}'.")
    
    return features_transformed

# 示例：假设 features_transformed 已经生成（步骤5完成后）
if 'features_transformed' in globals() and features_transformed is not None:
    # 定义每个聚类要使用的列以及对应的新聚类标签列名称
    cluster_columns = {
        '集群1': ('列1', '列2'),
        '集群2': ('列3',)
    }
    n_clusters = 3  # 每个聚类使用的簇数量
    features_transformed = cluster_data(features_transformed, cluster_columns, n_clusters)

    # 对于可视化示例，选择其中一个聚类结果来作二维散点图（仅当所用特征数>=2时）
    # 这里选择 '集群1' 对应的特征进行可视化
    cluster_key = '集群1'
    if cluster_key in cluster_columns:
        cols = cluster_columns[cluster_key]
        if len(cols) >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(features_transformed[cols[0]], features_transformed[cols[1]], 
                        c=features_transformed[cluster_key], cmap='viridis')
            plt.xlabel(cols[0])
            plt.ylabel(cols[1])
            plt.title(f'Результаты кластеризации: {cluster_key}')
            plt.colorbar(label='Номер кластера')
            plt.show()
        else:
            print(f"Недостаточно числовых признаков для визуализации кластеров в {cluster_key}.")
    else:
        print(f"聚类结果中不包含键 {cluster_key}，无法进行可视化。")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")