import pygame

# 初始化 Pygame
pygame.init()

# 设置显示器
screen_width = 800
screen_height = 800
screen = pygame.display.set_mode((screen_width, screen_height))
pygame.display.set_caption('Flappy Bird Clone')

# 鸟的属性
bird_x = 100
bird_y = screen_height // 2
bird_width = 40
bird_height = 30
bird_flap_height = 10
gravity = 1
bird_velocity = 0

# 设置时钟以控制帧率
clock = pygame.time.Clock()

# 主循环
running = True
while running:
    # 处理事件
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                bird_velocity = -bird_flap_height

    # 应用重力和更新小鸟位置
    bird_velocity += gravity
    bird_y += bird_velocity

    # 防止小鸟飞出屏幕上边和下边
    if bird_y < 0:
        bird_y = 0
        bird_velocity = 0
    elif bird_y + bird_height > screen_height:
        bird_y = screen_height - bird_height
        bird_velocity = 0

    # 填充屏幕背景颜色
    screen.fill((0, 0, 0))
    
    # 绘制小鸟
    pygame.draw.rect(screen, (255, 255, 0), (bird_x, bird_y, bird_width, bird_height))

    # 更新显示器
    pygame.display.flip()

    # 控制帧率
    clock.tick(60)

# 退出 Pygame
pygame.quit()