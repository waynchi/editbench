def save_log_to_file(log_history, file_path, append_latest_only=False):
    """
    Optimized log saving function.
    Improvements:
      - Uses pathlib.Path for file handling which is cross-platform and usually more 
        readable.
      - Simplifies file reading logic.
    Expected Improvement: Cleaner code with improved readability and slight performance boost 
    on file system operations.
    Trade-offs: Migrating to pathlib might require additional familiarity for developers used 
    to os.path.
    """
    log_file = Path(file_path)
    current_logs = []

    if log_file.exists():
        try:
            content = log_file.read_text().strip()
            if content:
                current_logs = json.loads(content)
        except json.JSONDecodeError:
            logging.warning(f"{file_path} contains invalid JSON. Overwriting file.")
        except Exception as e:
            logging.error(f"An error occurred while reading {file_path}: {e}")

    # Append only the latest log entry if specified
    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    try:
        log_file.write_text(json.dumps(current_logs, indent=4))
    except Exception as e:
        logging.error(f"An error occurred while writing to {file_path}: {e}")


def clear_directory(directory, delete_directory=False):
    """
    Optimized directory clearing function.
    Improvements:
      - Utilizes os.scandir to iterate over directory entries, which is more efficient 
        than os.listdir.
      - Uses pathlib for better path handling.
    Expected Improvement: Reduced overhead when scanning directory entries and improved 
    code readability.
    Trade-offs: No major trade-offs, but developers must be familiar with os.scandir.
    """
    dir_path = Path(directory)

    if not dir_path.exists():
        if not delete_directory:
            try:
                dir_path.mkdir(parents=True, exist_ok=True)
                logging.info(f"Directory '{directory}' created.")
            except Exception as e:
                logging.error(f"Failed to create directory '{directory}': {e}")
                raise
        else:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        return

    try:
        for entry in os.scandir(directory):
            path = Path(entry.path)
            if entry.is_dir():
                shutil.rmtree(path)
                logging.info(f"Removed directory: {path}")
            else:
                path.unlink()
                logging.info(f"Removed file: {path}")
    except OSError as e:
        logging.error(f"Failed to delete '{path}'. Reason: {e}")
        raise  # Re-raise the exception to halt execution if a deletion fails

    if delete_directory:
        try:
            dir_path.rmdir()
            logging.info(f"Removed directory: {directory}")
        except OSError as e:
            logging.error(f"Failed to delete '{directory}'. Reason: {e}")
            raise  # Re-raise the exception to halt execution if directory removal fails


def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """
    Merges a LoRA model into its base model and saves the merged model.
    Improvements:
      - Uses pathlib.Path for file path operations.
      - Avoids redundant variable assignments.
    Expected Improvement: Cleaner path manipulations and easier-to-read code.
    Trade-offs: Minimal; primarily a readability and slight performance improvement.
    """
    model_load_dir = Path(model_load_path)
    my_model_path = model_load_dir / model_name

    # Extract parameter count from the model_name
    try:
        param_count = model_name.lower().split("m")[0].split("-")[1]
    except IndexError:
        logging.error("Invalid model name format for extracting parameter count.")
        raise

    base_model_name = f"pythia-{param_count}M"
    base_model_path = os.path.join(base_model_repo_name, base_model_name)
    base_model = AutoModelForCausalLM.from_pretrained(base_model_path)
    model = PeftModel.from_pretrained(base_model, str(my_model_path))
    merged_model = model.merge_and_unload()

    save_dir = Path(model_save_path) / f"{model_name}_merged"
    merged_model.save_pretrained(str(save_dir))
    logging.info(f"Merged model saved to {save_dir}")


def remove_repetition(question, answer):
    """
    Removes a duplicate occurrence of the question in the answer.
    Improvements:
      - Simple string operation with minimal overhead.
    Expected Improvement: Minor performance gain by avoiding unnecessary operations.
    Trade-offs: None.
    """
    if question in answer:
        return answer.replace(question, "").strip()
    return answer


def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Loads different types of models based on the model_type parameter.
    Improvements:
      - Refactored repetitive code to improve readability.
      - Uses pathlib.Paths for file path formations.
    Expected Improvement: Easier maintenance and potential reduction in I/O errors.
    Trade-offs: Code restructuring requires careful testing in production settings.
    """
    if model_type == "Tuned Model":
        if not vanilla_model_name or not blocks_str:
            raise ValueError("vanilla_model_name and blocks_str are required for Tuned Model.")
        model_name = vanilla_model_name.split("/")[-1]
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        tuned_model_path = Path(model_path) / tuned_model_name
        tuned_model = AutoModelForCausalLM.from_pretrained(str(tuned_model_path))
        return tuned_model

    elif model_type == "Vanilla Model":
        if not vanilla_model_name:
            raise ValueError("vanilla_model_name is required for Vanilla Model.")
        vanilla_model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)
        return vanilla_model

    elif model_type == "Transformed Model":
        if not host_model_name or not blocks_str:
            raise ValueError("host_model_name and blocks_str are required for Transformed Model.")
        name = host_model_name.split("/")[-1]
        save_file = Path(model_path) / f"{name}_preGRAFTED_{blocks_str}.pkl"
        with save_file.open("rb") as f:
            transformed_model = pickle.load(f)
        return transformed_model

    elif model_type == "Final Model":
        if not host_model_name or not blocks_str:
            raise ValueError("host_model_name and blocks_str are required for Final Model.")
        name = host_model_name.split("/")[-1]
        model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
        save_file = Path(model_path) / model_save_name
        with save_file.open("rb") as f:
            final_model = pickle.load(f)
        return final_model

    elif model_type == "Host Model":
        if not host_model_name:
            raise ValueError("host_model_name is required for Host Model.")
        host_model = AutoModelForCausalLM.from_pretrained(host_model_name)
        return host_model

    else:
        raise ValueError(f"Unknown model type: {model_type}")


def load_batch_losses(file_path):
    """
    Loads batch loss data from a checkpoint file.
    Improvements:
      - Added logging to track successful or failed model load operations.
      - Utilizes torch.load error handling.
    Expected Improvement: Better error reporting and easier debugging.
    Trade-offs: None.
    """
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"))
        batch_losses = checkpoint.get("batch_losses", None)
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None