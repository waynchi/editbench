import numpy as np

def fit_line(x, y):
    """
    求数组拟合直线的函数

    参数:
        x (array): 自变量数组
        y (array): 因变量数组

    返回:
        slope (float): 直线斜率
        intercept (float): 直线截距
    """
    # 计算x和y的平均值
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # 计算x和y的偏差
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # 计算x和y的偏差的乘积
    xy_dev = x_dev * y_dev
    
    # 计算x的偏差的平方
    x_dev_squared = x_dev ** 2
    
    # 计算直线的斜率和截距
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean
    
    return slope, intercept

def max_deviation_line(x, y, slope, intercept):
    """
    计算线性拟合的最大偏差值

    参数:
        x (array): 自变量数组
        y (array): 实际的因变量数组
        slope (float): 拟合直线的斜率
        intercept (float): 拟合直线的截距

    返回:
        max_dev (float): 最大偏差值（绝对值）
    """
    # 使用拟合直线计算预测值
    y_pred = slope * x + intercept
    # 计算预测值与真实值之间的绝对误差
    deviation = np.abs(y - y_pred)
    # 返回最大偏差
    max_dev = np.max(deviation)
    return max_dev

def fit_quadratic(x, y):
    """
    求数组二次曲线拟合的函数

    参数:
        x (array): 自变量数组
        y (array): 因变量数组

    返回:
        coeffs (array): 二次曲线系数，[a, b, c] 对应 ax^2 + bx + c
    """
    # 创建一个Vandermonde矩阵
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # 使用最小二乘法求解系数
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    return coeffs

def max_deviation_quadratic(x, y, coeffs):
    """
    计算二次曲线拟合的最大偏差值

    参数:
        x (array): 自变量数组
        y (array): 实际的因变量数组
        coeffs (array): 二次曲线系数，[a, b, c] 对应 ax^2 + bx + c

    返回:
        max_dev (float): 最大偏差值（绝对值）
    """
    # 根据拟合系数计算预测值
    y_pred = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    # 计算预测值与真实值之间的绝对误差
    deviation = np.abs(y - y_pred)
    # 返回最大偏差
    max_dev = np.max(deviation)
    return max_dev