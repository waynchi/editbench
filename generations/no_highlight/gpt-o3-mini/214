async def process_command(chat_id, text_command):
    """
    根据用户要求，将text_command中删除所有非字母符号，然后再处理命令。
    注意：由于删除了非字母符号，一些原本命令需要的特殊字符或数字会被清除，
    这可能会影响原有命令逻辑（例如 /load123 将变成 "load"）。
    """
    # 删除所有非字母字符
    filtered_text = re.sub(r'[^A-Za-z]', '', text_command)

    if filtered_text.lower().startswith('load'):
        # 提取 load 命令后的数字信息已被删除，所以这里演示时默认使用0或者给出提示
        await bot.send_message(chat_id, "Пакет не может быть загружен, так как числовые данные отсутствуют после фильтрации.")
    else:
        if text_command.startswith('/'):
            if all_chats.get(chat_id) and all_chats[chat_id].cur_question != -1:
                # 对于其他命令，使用过滤后的内容传递给 check_answer
                await check_answer(chat_id, filtered_text[2:])
        # 这里示例回复过滤后文本的逆序
        await bot.send_message(chat_id, filtered_text[::-1])
            

@dp.message()
async def echo_handler(message: Message) -> None:
    """
    Handler will forward received message back to the sender.
    """
    await process_command(message.chat.id, message.text)


async def main() -> None:
    dp.include_router(start_router)
    await dp.start_polling(bot)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, stream=sys.stdout)
    asyncio.run(main())