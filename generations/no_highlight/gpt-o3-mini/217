import asyncio
import aiohttp
import aiofiles
import xml.etree.ElementTree as ET
import datetime
import pickle
import json

# “货币类”
class valute:
    """
    货币及其相关内容，通过俄罗斯央行

    所需库：
      aiohttp
      aiofiles
      xml.etree.ElementTree
      datetime
      pickle
      json
    """
    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """检查货币名称是否存在于货币集合中。集合每天更新不超过一次。"""
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        set_valutes_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin"

        # 异步读取Info.json文件内容
        async with aiofiles.open(info_path, "r", encoding="utf-8") as f:
            info_data = await f.read()
        info = json.loads(info_data)

        last_check_str = info["last_day_check"]["valute"]
        last_check_time = datetime.datetime.strptime(last_check_str, "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check_time:
            # 如果上次检查已超过1天，则重写货币列表（集合）
            set_valutes = set()
            url = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    content = await response.read()
            root = ET.fromstring(content)
            for Valute in root.findall("Valute"):
                CharCode = Valute.find("CharCode")
                if CharCode is not None and CharCode.text:
                    set_valutes.add(CharCode.text)

            # 序列化集合并写入文件
            # 使用 pickle.dumps 在内存中生成二进制数据，然后异步写入文件
            pickled_set = pickle.dumps(set_valutes)
            async with aiofiles.open(set_valutes_path, "wb") as f:
                await f.write(pickled_set)

            # 更新最后检查时间
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            new_info = json.dumps(info, indent=3, ensure_ascii=False)
            async with aiofiles.open(info_path, "w", encoding="utf-8") as f:
                await f.write(new_info)

        # 异步读取已存在的集合数据
        async with aiofiles.open(set_valutes_path, "rb") as f:
            data = await f.read()
            set_valutes = pickle.loads(data)

        return self.name in set_valutes

    async def CurrentExchangeRate(self):
        '''当前货币兑换卢布的汇率'''
        url = "http://www.cbr.ru/scripts/XML_daily.asp"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = ET.fromstring(content)
        for Valute in root.findall("Valute"):
            char_code_element = Valute.find("CharCode")
            if char_code_element is not None and char_code_element.text == self.name:
                # 部分XML数据可能包含 VunitRate 或 Rate 字段
                rate_element = Valute.find("VunitRate")
                if rate_element is None:
                    rate_element = Valute.find("Value")
                if rate_element is not None:
                    return rate_element.text
        return None

