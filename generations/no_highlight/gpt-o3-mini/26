import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-10, max_iter=None):
    """
    Функция для метода спряжённых градиентов.
    Решает систему линейных уравнений Ax = b, где A — симметричная положительно определённая матрица.
    
    Аргументы:
        A (numpy.ndarray): Квадратная матрица коэффициентов.
        b (numpy.ndarray): Вектор правых частей.
        x0 (numpy.ndarray, optional): Начальное приближение решения. Если None, используется нулевой вектор.
        tol (float, optional): Точность решения. Итерации прекращаются, когда норма остатка становится меньше tol.
        max_iter (int, optional): Максимальное число итераций. Если None, устанавливается равным размеру системы.
        
    Возвращает:
        numpy.ndarray: Приближённое решение системы Ax = b.
    """
    n = b.shape[0]
    if max_iter is None:
        max_iter = n
        
    if x0 is None:
        x = np.zeros_like(b, dtype=float)
    else:
        x = x0.astype(float)
    
    # Начальный остаток r = b - A * x
    r = b - A @ x
    # Начальное направление
    p = r.copy()
    rsold = np.dot(r, r)
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rsold / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rsnew = np.dot(r, r)
        
        if np.sqrt(rsnew) < tol:
            print(f"Сходимость достигнута после {i+1} итераций.")
            break
        
        p = r + (rsnew / rsold) * p
        rsold = rsnew
        
    return x

if __name__ == "__main__":
    # Пример использования метода спряжённых градиентов
    
    # Определим симметричную положительно определённую матрицу A и вектор b
    A = np.array([[4, 1],
                  [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # Вычисляем решение системы Ax=b
    x = conjugate_gradient(A, b)
    print("Решение системы Ax=b:", x)
    
    # Проверка: Вычислим произведение A * x и сравним с b
    Ax = A @ x
    print("A * x =", Ax)
    print("Погрешность:", np.linalg.norm(Ax - b))