import pandas as pd
import random

class Stock:
    def __init__(self, filename, name):
        self.filename = filename
        try:
            self.data = pd.read_csv(self.filename, index_col=0, parse_dates=True)
        except Exception as e:
            print(f"Unable to read file {self.filename}")
            raise e
        self.data.index.name = 'time'
        self.name = name
        self.attrs = {}

    def get_attr(self, key):
        try:
            return self.attrs[key]
        except KeyError:
            return None

    def set_attr(self, key, value):
        self.attrs[key] = value

    def get(self, i):
        return self.data.iloc[i]

    def get_range(self, s, t):
        return self.data.iloc[s:t+1]

    def __len__(self):
        return len(self.data)

class Transaction:
    def __init__(self, num, price):
        self.num = num
        self.price = price
        self.date = None

    def set_date(self, date):
        self.date = date

class Trade:
    def __init__(self, stock, long=True, num=0, price=0.0):
        self.stock = stock
        self.num = 0
        self.profit = 0
        self.closed = False
        self.long = long

        self.opens = []
        self.closes = []

        if num != 0:
            self.open(num, price)

    def close(self, num, price):
        if num > self.num:
            raise ValueError(f"ERR: Trying to close {num} of {self.stock.name} but only {self.num} available")
        self.num -= num
        self.closes.append(Transaction(num, price))

        if self.long:
            self.profit = self.get_num_closed() * (self.get_avg_close_price() - self.get_avg_open_price())
        else:
            self.profit = self.get_num_closed() * (self.get_avg_open_price() - self.get_avg_close_price())

        if self.num == 0:
            self.closed = True

    def open(self, num, price):
        self.num += num
        self.opens.append(Transaction(num, price))

    def get_equity(self, i):
        current_price = self.stock.get(i)["close"]
        if self.long:
            return self.num * current_price
        else:
            # Для коротких сделок капитал может отражать потенциальные затраты на закрытие позиции
            return self.num * (self.get_avg_open_price() - current_price)

    def set_date(self, date):
        [transaction.set_date(date) for transaction in self.opens if transaction.date is None]
        [transaction.set_date(date) for transaction in self.closes if transaction.date is None]

    def get_avg_open_price(self):
        total_price = sum(transaction.price * transaction.num for transaction in self.opens)
        total_num = sum(transaction.num for transaction in self.opens)
        return total_price / total_num if total_num else 0

    def get_avg_close_price(self):
        total_price = sum(transaction.price * transaction.num for transaction in self.closes)
        total_num = sum(transaction.num for transaction in self.closes)
        return total_price / total_num if total_num else 0

    def get_num_opened(self):
        return sum(transaction.num for transaction in self.opens)

    def get_num_closed(self):
        return sum(transaction.num for transaction in self.closes)

class Strategy:
    def __init__(self):
        self.stocks = []
        self.starting_money = 100000.0
        self.money = self.starting_money
        self.closed_trades = []
        self.open_trades = []
        self.attrs = {}
        self.analyzers = []

    def get_attr(self, key):
        return self.attrs.get(key)

    def set_attr(self, key, value):
        self.attrs[key] = value

    def add_analyzer(self, analyzer):
        analyzer.strategy = self
        self.analyzers.append(analyzer)

    def has_open_trade(self, stock):
        for trade in self.open_trades:
            if stock is trade.stock:
                return True
        return False

    def get_open_trade(self, stock):
        for trade in self.open_trades:
            if trade.stock is stock:
                return trade
        raise ValueError("No open trade on stock " + str(stock.name))

    def open_trade(self, stock, num, price):
        # Use current candle's time from stock data at index stored in attribute "i"
        candle = stock.get(self.get_attr("i"))
        if self.money < num * price:
            raise ValueError("Insufficient funds: have $" + str(self.money) +
                             " available and trying to open " + str(num) + " of " + str(stock.name) +
                             " at $" + str(price) + " on " + str(candle.name))

        if self.has_open_trade(stock):
            trade = self.get_open_trade(stock)
            trade.open(num, price)
            trade.set_date(candle.name)
        else:
            new_trade = Trade(stock, True, num, price)
            new_trade.set_date(candle.name)
            self.open_trades.append(new_trade)

        self.money -= num * price

    def sell(self, stock, num, price):
        if self.has_open_trade(stock):
            trade = self.get_open_trade(stock)
            trade.close(num, price)
            if trade.closed:
                self.open_trades.remove(trade)
                self.closed_trades.append(trade)
            candle = stock.get(self.get_attr("i"))
            trade.set_date(candle.name)
        else:
            raise ValueError("No position to close in " + str(stock.name))

        self.money += num * price

    def get_equity(self, i):
        res = self.money
        for trade in self.open_trades:
            res += trade.get_equity(i)
        return res

    def next(self, i):
        # This method should be overridden by concrete strategies.
        pass

class Computer:
    def __init__(self, simulation_rounds=1):
        self.stocks = []
        self.strategies = []
        self.simulation_rounds = simulation_rounds  # number of simulation variations per candle

    def add_stock(self, stock):
        if not isinstance(stock, Stock):
            exit("ERR: called 'add_stock' on type: " + str(type(stock)))
        self.stocks.append(stock)
    
    def add_strategy(self, strategy):
        if not isinstance(strategy, Strategy):
            exit("ERR: called 'add_strategy' on type: " + str(type(strategy)))
        self.strategies.append(strategy)

    def run(self):
        # Для каждой стратегии, для каждого акции, запускаем симуляцию по дням с вариациями свечей
        for strategy in self.strategies:
            j = 1
            for stock in self.stocks:
                # Перед запуском привязываем текущую акцию к стратегии
                strategy.stocks = [stock]
                print(f"Обработка акции #{j}/{len(self.stocks)}: {stock.name}")
                j += 1

                # Проходим по каждой свече (дням)
                for i in range(len(stock)):
                    # Получаем индекс времени для выбранной свечи
                    candle_time = stock.data.index[i]
                    # Сохраняем оригинальные значения для столбцов, которые будут варьироваться
                    orig_high = stock.data.at[candle_time, 'high']
                    orig_low = stock.data.at[candle_time, 'low']
                    orig_close = stock.data.at[candle_time, 'close']
                    orig_volume = stock.data.at[candle_time, 'volume']

                    # Прогоняем n симуляций для текущей свечи
                    for sim in range(self.simulation_rounds):
                        # Генерируем случайную вариацию (% изменения) для каждого атрибута.
                        # Например, от -5% до +5% от оригинала.
                        variation_high = random.uniform(-0.05, 0.05)
                        variation_low = random.uniform(-0.05, 0.05)
                        variation_close = random.uniform(-0.05, 0.05)
                        variation_volume = random.uniform(-0.05, 0.05)

                        # Применяем вариацию. Можно добавить условия, чтобы high был максимальным, а low минимальным, если необходимо.
                        simulated_high = orig_high * (1 + variation_high)
                        simulated_low = orig_low * (1 + variation_low)
                        simulated_close = orig_close * (1 + variation_close)
                        simulated_volume = orig_volume * (1 + variation_volume)

                        # Обновляем текущую свечу в датафрейме на симулированные значения
                        stock.data.at[candle_time, 'high'] = simulated_high
                        stock.data.at[candle_time, 'low'] = simulated_low
                        stock.data.at[candle_time, 'close'] = simulated_close
                        stock.data.at[candle_time, 'volume'] = simulated_volume

                        # Вызываем стратегию для смоделированной свечи
                        strategy.set_attr("i", i)
                        strategy.next(i)
                        for analyzer in strategy.analyzers:
                            analyzer.next(i)

                    # После симуляций возвращаем окончательные (оригинальные) значения в свечу
                    stock.data.at[candle_time, 'high'] = orig_high
                    stock.data.at[candle_time, 'low'] = orig_low
                    stock.data.at[candle_time, 'close'] = orig_close
                    stock.data.at[candle_time, 'volume'] = orig_volume

                    # Если это последняя свеча, закрываем все открытые сделки
                    if i == len(stock) - 1:
                        for strat in self.strategies:
                            while len(strat.open_trades) > 0:
                                trade = strat.open_trades[0]
                                # Используем окончательные значения последней свечи для закрытия
                                final_close = trade.stock.get(i)["close"]
                                strat.sell(trade.stock, trade.num, final_close)

                # После обработки свечей для текущей акции удаляем её из стратегии
                strategy.stocks = []