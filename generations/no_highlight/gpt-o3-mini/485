def create_matrix(rows: int, cols: int, fill_value=0) -> list:
    """
    Crea una matriz de tamaño rows x cols, llena con el valor fill_value.
    
    Parámetros:
        rows (int): número de filas.
        cols (int): número de columnas.
        fill_value (cualquier tipo): valor para llenar la matriz.
        
    Retorna:
        list: matriz como lista de listas.
    """
    return [[fill_value for _ in range(cols)] for _ in range(rows)]


def add_matrices(matrix_a: list, matrix_b: list) -> list:
    """
    Suma dos matrices del mismo tamaño de forma elemento a elemento.
    
    Parámetros:
        matrix_a (list): primera matriz.
        matrix_b (list): segunda matriz.
        
    Retorna:
        list: resultado de la suma de matrices.
    """
    # Verificar que ambas matrices tengan la misma dimensión
    if len(matrix_a) != len(matrix_b) or any(len(row_a) != len(row_b) for row_a, row_b in zip(matrix_a, matrix_b)):
        raise ValueError("Las matrices deben tener el mismo tamaño para poder sumarlas.")
    
    result = []
    for row_a, row_b in zip(matrix_a, matrix_b):
        result_row = []
        for a, b in zip(row_a, row_b):
            result_row.append(a + b)
        result.append(result_row)
    return result


def scalar_multiply(matrix: list, scalar: float) -> list:
    """
    Multiplica todos los elementos de la matriz por un escalar.
    
    Parámetros:
        matrix (list): matriz original.
        scalar (float): número por el cual se multiplican los elementos de la matriz.
        
    Retorna:
        list: resultado de la multiplicación de la matriz por el escalar.
    """
    result = []
    for row in matrix:
        result_row = []
        for element in row:
            result_row.append(element * scalar)
        result.append(result_row)
    return result


def multiply_matrices(matrix_a: list, matrix_b: list) -> list:
    """
    Multiplica dos matrices.
    
    La multiplicación es posible si el número de columnas de matrix_a coincide con
    el número de filas de matrix_b.
    
    Parámetros:
        matrix_a (list): primera matriz.
        matrix_b (list): segunda matriz.
        
    Retorna:
        list: resultado de la multiplicación de matrices.
    """
    # Obtener dimensiones
    rows_a = len(matrix_a)
    cols_a = len(matrix_a[0]) if rows_a > 0 else 0
    rows_b = len(matrix_b)
    cols_b = len(matrix_b[0]) if rows_b > 0 else 0

    if cols_a != rows_b:
        raise ValueError("El número de columnas de la primera matriz debe ser igual al número de filas de la segunda matriz.")
    
    # Crear una matriz resultado con dimensiones rows_a x cols_b
    result = create_matrix(rows_a, cols_b, fill_value=0)
    
    # Multiplicación de matrices
    for i in range(rows_a):
        for j in range(cols_b):
            sum_product = 0
            for k in range(cols_a):
                sum_product += matrix_a[i][k] * matrix_b[k][j]
            result[i][j] = sum_product
    return result


def transpose_matrix(matrix: list) -> list:
    """
    Transpone una matriz.
    Las filas de la matriz original se convierten en columnas y viceversa.
    
    Parámetros:
        matrix (list): matriz original.
        
    Retorna:
        list: matriz transpuesta.
    """
    if not matrix:
        return []
    
    # Asumir que todas las filas tienen la misma longitud
    rows = len(matrix)
    cols = len(matrix[0])
    transposed = create_matrix(cols, rows)
    
    for i in range(rows):
        for j in range(cols):
            transposed[j][i] = matrix[i][j]
    return transposed


def determinant_3x3(matrix: list) -> float:
    """
    Calcula el determinante de una matriz 3x3.
    
    Parámetros:
        matrix (list): matriz original de tamaño 3x3.
        
    Retorna:
        float: determinante de la matriz.
    """
    if len(matrix) != 3 or any(len(row) != 3 for row in matrix):
        raise ValueError("La matriz debe ser de tamaño 3x3.")
    
    a11, a12, a13 = matrix[0]
    a21, a22, a23 = matrix[1]
    a31, a32, a33 = matrix[2]
    
    det = (a11 * (a22 * a33 - a23 * a32)
           - a12 * (a21 * a33 - a23 * a31)
           + a13 * (a21 * a32 - a22 * a31))
    return float(det)


