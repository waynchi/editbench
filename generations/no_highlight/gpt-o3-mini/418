import tkinter as tk
import random

# Lista kolorów do losowego wyboru
COLORS = ["red", "green", "blue", "yellow", "magenta", "cyan", "orange", "purple"]

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        self.dx = random.choice([-2, 2])
        self.dy = random.choice([-2, 2])
        # Losowy kolor z dostępnej listy
        self.color = random.choice(COLORS)
        self.square = canvas.create_rectangle(x, y, x + size, y + size, fill=self.color, outline="black")

    def move(self):
        self.x += self.dx
        self.y += self.dy
        self.canvas.move(self.square, self.dx, self.dy)

        # Pobierz aktualne wymiary płótna
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()

        # Sprawdź czy kwadrat dotknął granic
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            # Usuń bieżący kwadrat
            self.canvas.delete(self.square)
            # Jeśli rozmiar jest wystarczająco duży, podziel kwadrat na dwa mniejsze
            if self.size > 10:
                new_size = self.size / 2
                # Nowe kwadraty pojawią się w centrum płótna
                new_x = canvas_width / 2 - new_size / 2
                new_y = canvas_height / 2 - new_size / 2
                squares.append(Square(self.canvas, new_size, new_x, new_y))
                squares.append(Square(self.canvas, new_size, new_x, new_y))
            return False
        return True

def update():
    global squares
    # Przesuń wszystkie kwadraty; usuń te, które uderzyły w granice
    squares = [square for square in squares if square.move()]
    root.after(20, update)

# Utwórz główne okno
root = tk.Tk()
root.title("Kolorowe Kwadraty")

# Utwórz płótno i upewnij się, że jego wymiary są poprawnie ustawione
canvas = tk.Canvas(root, width=600, height=600, bg="white")
canvas.pack(expand=True, fill="both")
root.update()  # Uaktualnij okno, aby ustawić poprawne wymiary płótna

# Utwórz początkowy kwadrat
squares = [Square(canvas, 100, 250, 250)]

# Rozpocznij animację
update()

# Uruchom główną pętlę tk
root.mainloop()