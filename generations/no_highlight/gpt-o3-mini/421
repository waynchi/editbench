import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image, ImageFile
import numpy as np
import os

# To handle truncated images gracefully
ImageFile.LOAD_TRUNCATED_IMAGES = True

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                                 std=[0.229, 0.224, 0.225])
        ])

    def create_unrelated_pairs(self, image_text_pairs):
        """Tworzy niepowiązane pary obraz-tekst poprzez przetasowanie opisów tekstowych"""
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """Tworzy semantycznie podobne pary tekstowe używając zbiorów danych z parafrazami"""
        dataset = load_dataset(dataset_name, split=f'train[:{self.sample_size}]')
        textual_pairs = []
        for item in dataset:
            if item.get('is_duplicate', 0) == 1:
                pair = (item['question1'], item['question2'])
                textual_pairs.append(pair)
        return textual_pairs[:self.sample_size]

    def create_visual_pairs(self, image_text_pairs):
        """Tworzy zaugumentowane pary obrazów, zachowując znaczenie semantyczne"""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                augmented = augmentation_transforms(image)
                visual_pairs.append((image, augmented))
        return visual_pairs

    def load_mscoco_dataset(self):
        """
        Ładuje i przetwarza zbiór danych MSCOCO z ulepszonym filtrowaniem.
        Jeśli nie uda się załadować obrazu (np. FileNotFoundError),
        dana próbka jest pomijana.
        """
        # Używamy streaming=False, aby pobrać dane lokalnie i uniknąć problemów
        # z otwieraniem plików z archiwów zip.
        dataset = load_dataset(
            "shunk031/MSCOCO",
            year=2014,
            coco_task="captions",
            split='train',
            streaming=False  # Przełączamy na nie-streamingowy tryb
        )
        
        # Ograniczamy zbiór do sample_size elementów
        dataset = dataset.select(range(min(self.sample_size * 2, len(dataset))))
        
        image_text_pairs = []
        for item in dataset:
            try:
                # Wybierz najbardziej opisowy podpis na podstawie długości
                captions = item.get("captions", [])
                if not captions:
                    continue
                best_caption = max(captions, key=len)
                # Filtruj zbyt krótkie podpisy
                if len(best_caption.split()) < 5:
                    continue

                # Spróbuj otworzyć obraz, jeśli nie powiedzie się to pomiń ten przykład
                image = item["image"]
                if not isinstance(image, Image.Image):
                    image = Image.open(image) if isinstance(image, str) and os.path.exists(image) else image

                image_text_pairs.append((image, best_caption))
            except (FileNotFoundError, OSError) as e:
                print(f"Pominięto przykład z powodu błędu ładowania obrazu: {e}")
                continue

            if len(image_text_pairs) >= self.sample_size:
                break

        return image_text_pairs

def main():
    # Zainicjuj tworzenie zbioru danych
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # Załaduj i utwórz zestawy danych
    print("Ładowanie zestawu danych MSCOCO...")
    image_text_pairs = creator.load_mscoco_dataset()
    
    if not image_text_pairs:
        print("Nie udało się załadować żadnych obrazów z MSCOCO. Przerywanie.")
        return
    
    print("Tworzenie niepowiązanych par...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Tworzenie par tekstowych...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Tworzenie wizualnych par...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # Wydrukuj próbkę z każdego zbioru danych
    print("Próbki zbiorów danych:")
    print(f"Para obraz-tekst: {image_text_pairs[0]}")
    print(f"Para niepowiązana: {unrelated_pairs[0]}")
    if textual_pairs:
        print(f"Para tekstowa: {textual_pairs[0]}")
    else:
        print("Brak danych dla par tekstowych.")
    if visual_pairs:
        print(f"Para wizualna: {visual_pairs[0]}")
    else:
        print("Brak danych dla par wizualnych.")

if __name__ == "__main__":
    main()