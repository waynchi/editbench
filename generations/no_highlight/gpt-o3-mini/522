"""
Main entry point for the Audio Recorder and Transcriber application.
"""

import os
import sys
import logging
import tkinter as tk
import tkinterdnd2
import traceback

def setup_logging():
    """
    Set up logging configuration for the application.
    """
    log_format = '%(asctime)s - %(levelname)s - %(message)s'
    logging.basicConfig(
        level=logging.INFO,
        format=log_format,
        handlers=[
            logging.StreamHandler(),
            logging.FileHandler('app.log', encoding='utf-8')
        ]
    )

def handle_exception(exc_type, exc_value, exc_traceback):
    """
    Global exception handler to catch any uncaught exceptions.
    """
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    logging.error("Uncaught exception: %s", "".join(traceback.format_exception(exc_type, exc_value, exc_traceback)))

# Set the exception hook to our handler
sys.excepthook = handle_exception

def get_resource_path():
    """
    Get the resource path that works for both development and PyInstaller.

    Returns:
        str: Path to resources directory
    """
    try:
        if getattr(sys, 'frozen', False):
            # Ejecutándose como ejecutable compilado
            resource_path = os.path.join(os.path.dirname(sys.executable), 'resources')
        else:
            # Ejecutando como script
            resource_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'resources')
        return resource_path
    except Exception as e:
        logging.exception("Error obtaining the resource path:")
        raise

def check_resources():
    """
    Check if required resource files exist.

    Returns:
        bool: True if all required resources are present
    """
    try:
        required_files = ['sound.mp3', 'done.mp3', 'cancel.wav', 'help_text.txt']
        resource_dir = get_resource_path()

        # Verificar si cada archivo requerido existe
        missing_files = []
        for file in required_files:
            if not os.path.exists(os.path.join(resource_dir, file)):
                missing_files.append(file)

        # Si faltan archivos requeridos, devolver False
        if missing_files:
            logging.error("Missing resource files: %s", ", ".join(missing_files))
            return False
        return True
    except Exception as e:
        logging.exception("Error while checking resources:")
        raise

def main():
    """
    Main function to start the application.
    """
    try:
        # Configurar el registro de eventos
        setup_logging()
        logging.info("Starting Audio Recorder and Transcriber application")

        # Verificar recursos
        if not check_resources():
            logging.error("Required resource files are missing. Application cannot start.")
            sys.exit(1)

        try:
            # Inicializar la ventana principal con soporte de arrastrar y soltar
            root = tkinterdnd2.TkinterDnD.Tk()
        except Exception as e:
            logging.exception("Error initializing the TkinterDnD window:")
            raise

        try:
            # Importar aquí para evitar importaciones circulares
            from gui.main_window import AudioTranscriberApp
        except Exception as e:
            logging.exception("Error importing AudioTranscriberApp from gui.main_window:")
            raise

        try:
            # Crear la instancia de la aplicación
            app = AudioTranscriberApp(root)
        except Exception as e:
            logging.exception("Error creating an instance of AudioTranscriberApp:")
            raise

        try:
            # Iniciar el bucle principal de eventos
            root.mainloop()
        except Exception as e:
            logging.exception("Error during the main event loop:")
            raise

    except Exception as e:
        logging.error("Application error: %s", e)
        # Raising the exception after logging, you may choose to handle it differently
        raise

if __name__ == "__main__":
    main()