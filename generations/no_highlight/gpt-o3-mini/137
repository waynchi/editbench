def binary_search(arr, target):
    """
    在已排序的数组 arr 中进行二分查找查找 target 元素。
    如果找到，则返回该元素的索引；否则返回 -1。

    参数:
    arr: 一个升序排列的列表。
    target: 需要查找的值。

    返回:
    如果找到 target，则返回它在列表中的索引。
    如果未找到，则返回 -1。
    """
    left, right = 0, len(arr) - 1

    while left <= right:
        mid = left + (right - left) // 2
        
        # 检查中间元素
        if arr[mid] == target:
            return mid
        # 如果 target 大于中间值，则忽略左半部分
        elif arr[mid] < target:
            left = mid + 1
        # 如果 target 小于中间值，则忽略右半部分
        else:
            right = mid - 1

    return -1

# 示例用法
if __name__ == "__main__":
    sorted_list = [1, 3, 5, 7, 9, 11, 13, 15]
    target_value = 7

    result = binary_search(sorted_list, target_value)
    if result != -1:
        print(f"在索引 {result} 找到了元素 {target_value}.")
    else:
        print(f"未找到元素 {target_value}.")