import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data(features_transformed, cluster_columns_map, n_clusters=2, clustering_method='kmeans'):
    """
    Выполняет независимую кластеризацию данных для каждого набора столбцов, заданных в cluster_columns_map.

    Args:
        features_transformed (pandas.DataFrame): Преобразованный DataFrame с параметрами.
        cluster_columns_map (dict): Словарь, где ключ — имя нового столбца, в который будут записаны метки кластеров,
                                    а значение — кортеж или список имен столбцов, по которым следует проводить кластеризацию.
        n_clusters (int): Количество кластеров для каждой кластеризации.
        clustering_method (str): Метод кластеризации ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame с добавленными столбцами меток кластеров для каждого набора столбцов.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    for new_cluster_col, cols in cluster_columns_map.items():
        if not isinstance(cols, (list, tuple)):
            print(f"Набор столбцов для '{new_cluster_col}' должен быть списком или кортежем.")
            continue

        features_subset = features_transformed[list(cols)].copy()
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)
            unique_clusters = np.unique(cluster_labels)
            
            # Оценка качества кластеризации (например, с помощью коэффициента силуэта)
            if len(unique_clusters) > 1:
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта для '{new_cluster_col}' с {n_clusters} кластерами: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для '{new_cluster_col}' с {n_clusters} кластера (все точки в одном кластере).")
        else:
            print(f"Неподдерживаемый метод кластеризации для '{new_cluster_col}'.")
            continue

        features_transformed[new_cluster_col] = cluster_labels
        print(f"Кластеризация для '{new_cluster_col}' выполнена. Метки кластеров добавлены в столбец '{new_cluster_col}'.")

    return features_transformed

# Пример использования
if __name__ == "__main__":
    # Предположим, что features_transformed уже определен (после этапа 5)
    try:
        features_transformed
    except NameError:
        features_transformed = None

    if features_transformed is not None:
        # Определяем, какие столбцы использовать для каждой кластеризации.
        # Например, если мы передаем словарь вида {'Кластер1': ('столбец1', 'столбец2'), 'Кластер2': ('столбец3',)},
        # это означает, что кластеризация будет проведена отдельно для пары столбцов ('столбец1', 'столбец2')
        # и для столбца 'столбец3'.
        cluster_columns_map = {
            'Кластер1': ('столбец1', 'столбец2'),
            'Кластер2': ('столбец3',)
        }
        n_clusters = 3  # Количество кластеров, можно настроить под задачу
        features_transformed = cluster_data(features_transformed, cluster_columns_map, n_clusters)

        # Визуализация кластеров для каждого набора столбцов (для 2-мерных данных)
        for new_cluster_col, cols in cluster_columns_map.items():
            features_subset = features_transformed[list(cols)]
            if features_subset.shape[1] >= 2:
                plt.figure(figsize=(8, 6))
                plt.scatter(features_subset.iloc[:, 0], features_subset.iloc[:, 1],
                            c=features_transformed[new_cluster_col], cmap='viridis')
                plt.xlabel(features_subset.columns[0])
                plt.ylabel(features_subset.columns[1])
                plt.title(f'Результаты кластеризации: {new_cluster_col}')
                plt.colorbar(label='Номер кластера')
                plt.show()
            else:
                print(f"Недостаточно числовых признаков для визуализации кластеров '{new_cluster_col}' на плоскости.")
    else:
        print("Сначала выполните этап 5 (Преобразование данных).")