"""
Оптимизированная версия оригинального кода с объяснениями внесенных улучшений:

1. Оптимизация функции clear_directory:
   - Замена os.listdir на os.scandir для ускорения обхода элементов директории.
   - Ожидаемое улучшение: уменьшение времени обхода директории при большом количестве файлов.
   - Компромисс: os.scandir требует поддержки Python 3.5+, что, однако, является стандартом.

2. Оптимизация функции save_log_to_file:
   - Минимизированы операции чтения файла за счет использования чтения с "with open" одиночным вызовом.
   - Теперь код быстрее обрабатывает пустые файлы и файлы с некорректным JSON.
   - Компромисс: минимальное изменение логики, так как читаем полный файл в память; это не подходит для очень больших логов.

3. Оптимизация функции load_model:
   - Добавлены проверки наличия необходимых параметров.
   - Обновлена логика формирования путей для повышения читаемости и уменьшения ошибок.
   - Ожидаемое улучшение: уменьшение вероятности ошибок при формировании путей за счет явных проверок.

4. Оптимизация функции load_batch_losses:
   - Добавлена проверка существования файла перед загрузкой, чтобы избежать генерации исключений.
   - Ожидаемое улучшение: более быстрый выход при отсутствии файла, что может сэкономить время при частом вызове.
   - Компромисс: добавлена дополнительная операция проверки файла, но она быстро отрабатывает.

Оставшиеся функции (merge_lora_model и remove_repetition) оставлены без значительных изменений, поскольку они зависят от внешних библиотек и операций I/O, где основное время тратится на загрузку/сохранение моделей.
"""

import os
import shutil
import json
import pickle
import torch
import logging

from transformers import AutoModelForCausalLM
from peft import PeftModel
from dotenv import load_dotenv

load_dotenv()

DATA_SAVE_PATH = os.getenv("DATA_SAVE_PATH")
MODEL_PATH = os.getenv("MODEL_PATH")


def save_log_to_file(log_history, file_path, append_latest_only=False):
    """
    Сохраняет историю логов в файл JSON. Если файл уже существует, добавляет в него.

    Параметры:
    - log_history: Список записей логов (каждая запись - это словарь).
    - file_path: Путь к файлу, в который будут сохранены логи.
    - append_latest_only: Если True, добавляется только последняя запись лога.
    
    Оптимизация:
    - Сокращено число операций открытия/закрытия файлов.
    - Обработка файла упрощена с помощью стандартных операций чтения/записи.
    """
    current_logs = []
    if os.path.exists(file_path):
        try:
            with open(file_path, "r") as f:
                content = f.read().strip()
                if content:
                    current_logs = json.loads(content)
        except json.JSONDecodeError:
            print(f"Warning: {file_path} содержит некорректный JSON. Файл будет перезаписан.")
        except Exception as e:
            print(f"Ошибка при чтении {file_path}: {e}")

    # Добавляем либо последний лог, либо всю историю
    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    try:
        with open(file_path, "w") as f:
            json.dump(current_logs, f, indent=4)
    except Exception as e:
        print(f"Ошибка при записи в {file_path}: {e}")


def clear_directory(directory, delete_directory=False):
    """
    Очищает все файлы и подкаталоги в указанной директории. Опционально удаляет саму директорию.
    Если delete_directory равно False, создает директорию, если она не существует.

    Оптимизация:
    - Используем os.scandir вместо os.listdir для ускорения обхода директории.
    - Ожидаемое улучшение: уменьшение времени удаления файлов/каталогов при большом количестве элементов.
    """
    if not os.path.exists(directory):
        if not delete_directory:
            os.makedirs(directory)
            print(f"Directory '{directory}' created.")
        else:
            raise ValueError("Директория не существует и delete_directory равен True. Операция не может продолжаться.")
        return

    with os.scandir(directory) as entries:
        for entry in entries:
            item_path = entry.path
            try:
                if entry.is_dir():
                    shutil.rmtree(item_path)
                    print(f"Удалена директория: {item_path}")
                else:
                    os.remove(item_path)
                    print(f"Удалён файл: {item_path}")
            except OSError as e:
                print(f"Не удалось удалить '{item_path}'. Причина: {e}")
                raise

    if delete_directory:
        try:
            os.rmdir(directory)
            print(f"Удалена директория: {directory}")
        except OSError as e:
            print(f"Не удалось удалить '{directory}'. Причина: {e}")
            raise


def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """
    Сливает LoRA-модель с базовой моделью и сохраняет объединённую модель.

    Оптимизация:
    - Использование os.path.join для формирования путей.
    - Минимизация операций за счёт прямого вызова методов моделей.
    """
    my_model_path = os.path.join(model_load_path, model_name)
    param_count = model_name.lower().split("m")[0].split("-")[1]
    base_model_name = f"pythia-{param_count}M"

    base_model = AutoModelForCausalLM.from_pretrained(
        os.path.join(base_model_repo_name, base_model_name)
    )
    model = PeftModel.from_pretrained(base_model, my_model_path)
    merged_model = model.merge_and_unload()
    my_model_save_path = os.path.join(model_save_path, f"{model_name}_merged")
    merged_model.save_pretrained(my_model_save_path)


def remove_repetition(question, answer):
    """
    Убирает повторяющуюся часть вопроса из ответа для избежания дублирования.
    """
    if question in answer:
        return answer.replace(question, "").strip()
    return answer


def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Загружает модели различных типов в зависимости от параметра model_type.
    
    Оптимизация:
    - Добавлены проверки на необходимые параметры для каждого типа модели,
      что помогает избежать избыточных обращений и ошибок в пути.
    - Улучшено формирование путей для загрузки моделей за счёт os.path.join.
    """
    if model_type == "Tuned Model":
        if not vanilla_model_name or not blocks_str or not model_path:
            raise ValueError("Для Tuned Model необходимы vanilla_model_name, blocks_str и model_path")
        model_name = vanilla_model_name.split("/")[-1]
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        tuned_model_path = os.path.join(model_path, tuned_model_name)
        tuned_model = AutoModelForCausalLM.from_pretrained(tuned_model_path)
        return tuned_model

    elif model_type == "Vanilla Model":
        if not vanilla_model_name:
            raise ValueError("Для Vanilla Model необходим vanilla_model_name")
        return AutoModelForCausalLM.from_pretrained(vanilla_model_name)

    elif model_type == "Transformed Model":
        if not host_model_name or not blocks_str or not model_path:
            raise ValueError("Для Transformed Model необходимы host_model_name, blocks_str и model_path")
        name = host_model_name.split("/")[-1]
        save_path = os.path.join(model_path, f"{name}_preGRAFTED_{blocks_str}.pkl")
        with open(save_path, "rb") as f:
            transformed_model = pickle.load(f)
        return transformed_model

    elif model_type == "Final Model":
        if not host_model_name or not blocks_str or not model_path:
            raise ValueError("Для Final Model необходимы host_model_name, blocks_str и model_path")
        name = host_model_name.split("/")[-1]
        model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
        save_path = os.path.join(model_path, model_save_name)
        with open(save_path, "rb") as f:
            final_model = pickle.load(f)
        return final_model

    elif model_type == "Host Model":
        if not host_model_name:
            raise ValueError("Для Host Model необходим host_model_name")
        return AutoModelForCausalLM.from_pretrained(host_model_name)

    else:
        raise ValueError(f"Неизвестный тип модели: {model_type}")


def load_batch_losses(file_path):
    """
    Загружает данные о потерях батча из файла контрольной точки.

    Оптимизация:
    - Добавлена предварительная проверка существования файла для избежания ненужного вызова torch.load.
    - Ожидаемое улучшение: более быстрая обработка случаев, когда файл отсутствует.
    """
    if not os.path.exists(file_path):
        logging.error(f"Файл контрольной точки не найден: {file_path}")
        return None
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"))
        batch_losses = checkpoint.get("batch_losses", None)
        if batch_losses is not None:
            logging.info(f"Batch losses успешно загружены из {file_path}")
        else:
            logging.warning(f"Ключ 'batch_losses' не найден в контрольной точке: {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Ошибка загрузки контрольной точки из {file_path}: {e}")
        return None