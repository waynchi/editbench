import React, { useRef, useEffect, useState } from 'react'
import { useGetQueryListQuery } from '../../api/query';
import { MdOutlineArrowDropDown } from 'react-icons/md';

const Query = () => {
  const abortController = useRef(null);
  const [isQueryOpen, setIsQueryOpen] = useState(false);
  const [selectedQuery, setSelectedQuery] = useState(null);

  const { data: queries, isFetching: queriesFetching, isLoading: queriesLoading } = useGetQueryListQuery({},
    {
      signal: abortController?.current?.signal
    }
  );

  // Obsługa wyboru zapytania
  const handleQuerySelect = (query) => {
    setSelectedQuery(query);
    setIsQueryOpen(false);
  };

  useEffect(() => {
    abortController.current = new AbortController();
    return () => {
      abortController.current.abort();
    };
  }, []);

  return (
    <div className="p-4 w-auto">
      <div className="grid grid-flow-col justify-end mb-2">
        <button
          type="button"
          className="w-auto bg-[#CB427C] focus:border focus:border-[#CB427C] focus:outline-none text-white text-sm px-4 py-2 rounded-[24px] disabled:opacity-50"
        >
          Add new
        </button>
      </div>
      <div className="grid grid-cols-2 gap-4 items-center">
        <div></div>
        <div className="flex justify-between items-center">
          <label className="font-thin border px-2 py-1">Query name</label>
          <div className="relative inline-block text-left">
            <button
              type="button"
              className="flex justify-between font-circe-light items-center w-auto h-8 p-4 text-sm border border-[#dde6e9] font-thin focus:outline-none focus:border focus:border-[#CB427C]"
              onClick={() => setIsQueryOpen(!isQueryOpen)}
            >
              {selectedQuery?.name || "Select query"}
              <MdOutlineArrowDropDown className="text-xl" />
            </button>
            {isQueryOpen && queries?.data?.length > 0 && (
              <div className="absolute left-0 bg-white border border-gray-200 shadow-lg z-10 max-h-[250px] overflow-y-auto">
                {queries?.data.length === 0 ? (
                  <div className="px-2 py-1 text-sm font-medium font-circe-light">
                    No queries available
                  </div>
                ) : (
                  queries.data.map((query) => (
                    <div
                      key={query.id}
                      onClick={() => handleQuerySelect(query)}
                      className={`px-2 py-1 text-sm cursor-pointer font-normal font-circe-light hover:bg-[#CB427C] hover:text-white ${
                        selectedQuery?.id === query.id
                          ? "bg-[#CB427C] text-white font-semibold"
                          : ""
                      }`}
                    >
                      {query.name}
                    </div>
                  ))
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}

export default Query