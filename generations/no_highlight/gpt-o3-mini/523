import tkinter as tk
import random

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        # Velocidades aleatorias para el movimiento
        self.dx = random.choice([-2, 2])
        self.dy = random.choice([-2, 2])
        # Asignar un color aleatorio para que sean visibles y variados
        self.color = random.choice(["red", "green", "blue", "purple", "orange", "magenta"])
        self.square = canvas.create_rectangle(x, y, x + size, y + size,
                                               fill=self.color, outline="black")

    def move(self):
        self.x += self.dx
        self.y += self.dy
        self.canvas.move(self.square, self.dx, self.dy)
        
        # Forzar la actualización de la geometría del canvas
        self.canvas.update_idletasks()
        # Obtener dimensiones actuales del canvas
        canvas_width = int(self.canvas['width'])
        canvas_height = int(self.canvas['height'])
        
        # Revisar si el cuadrado ha chocado con cualquiera de los bordes
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            # Eliminar el cuadrado que ha llegado al límite
            self.canvas.delete(self.square)
            # Si el cuadrado es lo suficientemente grande, dividirlo en dos nuevos cuadrados
            if self.size > 10:
                new_size = self.size / 2
                # Ubicar los nuevos cuadrados en el centro del canvas con un ligero offset
                squares.append(Square(self.canvas, new_size,
                                        canvas_width / 2 - new_size - 5,
                                        canvas_height / 2 - new_size - 5))
                squares.append(Square(self.canvas, new_size,
                                        canvas_width / 2 + 5,
                                        canvas_height / 2 + 5))
            return False  # Indicar que este cuadrado ya no debe seguir moviéndose
                
        return True  # El cuadrado sigue moviéndose

def update():
    global squares
    # Mover todos los cuadrados activos y eliminar aquellos que han desaparecido
    squares = [square for square in squares if square.move()]
    root.after(20, update)  # Actualizar cada 20ms

# Crear la ventana principal
root = tk.Tk()
root.title("Squaring y Coloreando")

# Crear y configurar el canvas, asegurándonos que tenga un tamaño fijo
canvas = tk.Canvas(root, width=600, height=600, bg="white")
canvas.pack(expand=True, fill="both")

# Crear un cuadrado inicial en el canvas
squares = [Square(canvas, 100, 250, 250)]

# Iniciar la animación
update()

# Iniciar el bucle de eventos principal
root.mainloop()