import aiohttp  # для асинхронных HTTP-запросов
import aiofiles  # для асинхронных операций с файлами
import asyncio
import xml.etree.ElementTree as ET  # для обработки XML-ответа API
import matplotlib.pyplot as plt  # для построения графиков
import pandas as pd  # для создания DataFrame и разделения всех свечей на два типа: close и open
import datetime  # для дат по оси иксов
import pickle  # для хранения переменных в файле
import json

# класс валюта
class Valute:
    """Валюта и всё с ней связанное, через ЦБ РФ.
    Требуются библиотеки:
      aiohttp
      aiofiles
      xml.etree.ElementTree
      matplotlib.pyplot as plt
      pandas as pd
      datetime
      pickle
      json
    """
    
    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """
        Проверка имени валюты на наличие в множестве валют.
        Множество обновляется не чаще раза в день.
        """
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        set_valutes_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin"

        # Читаем информацию из JSON-файла
        async with aiofiles.open(info_path, mode="r", encoding="utf-8") as info_file:
            info_content = await info_file.read()
            info = json.loads(info_content)

        # Проверяем дату последнего обновления списка валют
        last_check = datetime.datetime.strptime(info["last_day_check"]["valute"], "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check:
            # Если дата обновления более чем 1 день назад, то скачиваем актуальный список валют.
            set_valutes = set()
            url = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    data = await response.read()

            root = ET.fromstring(data)
            for valute_elem in root.findall("Valute"):
                char_code_elem = valute_elem.find("CharCode")
                if char_code_elem is not None:
                    set_valutes.add(char_code_elem.text)

            # Сохраняем множество валют в бинарный файл
            binary_data = pickle.dumps(set_valutes)
            async with aiofiles.open(set_valutes_path, mode="wb") as bin_file:
                await bin_file.write(binary_data)

            # Обновляем время последнего обновления в Info.json
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, mode="w", encoding="utf-8") as info_file:
                new_content = json.dumps(info, indent=3, ensure_ascii=False)
                await info_file.write(new_content)

        # Загружаем множество валют из бинарного файла для проверки
        async with aiofiles.open(set_valutes_path, mode="rb") as bin_file:
            binary_data = await bin_file.read()
            set_valutes = pickle.loads(binary_data)

        return self.name in set_valutes

    async def CurrentExchangeRate(self):
        """Текущий курс обмена валюты на рубль"""
        url = "http://www.cbr.ru/scripts/XML_daily.asp"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                data = await response.read()

        root = ET.fromstring(data)
        for valute_elem in root.findall("Valute"):
            for char_code_elem in valute_elem.findall("CharCode"):
                if char_code_elem.text == self.name:
                    vunit_rate_elem = valute_elem.find("VunitRate")
                    if vunit_rate_elem is not None:
                        return vunit_rate_elem.text
        return None