import requests
from pyspark.sql import SparkSession
from pyspark.sql.functions import col

# 创建一个Spark会话
spark = SparkSession.builder.appName("AnalizarYEscribirParquetADL2").getOrCreate()

# 从API获取数据（这里使用示例URL，请替换为实际API地址）
api_url = "https://api.example.com/data"  # 替换为实际API的URL
try:
    response = requests.get(api_url)
    response.raise_for_status()  # 如果响应状态码不是200，将引发异常
    # 假设API返回的数据为一个JSON格式的列表，例如：
    # [
    #   {"id": 1, "nombre": "Juan", "edad": 30},
    #   {"id": 2, "nombre": "Ana", "edad": 25},
    #   {"id": 3, "nombre": "Pedro", "edad": 40}
    # ]
    data = response.json()
except Exception as e:
    print("获取API数据时出错:", e)
    # 如果API调用失败，可以选择退出或使用备用数据
    data = [
        {"id": 1, "nombre": "Juan", "edad": 30},
        {"id": 2, "nombre": "Ana", "edad": 25},
        {"id": 3, "nombre": "Pedro", "edad": 40}
    ]

# 利用获取的数据创建一个DataFrame
df = spark.createDataFrame(data)

# 分析数据：打印表结构和描述性统计信息
print("数据结构:")
df.printSchema()

print("数据预览:")
df.show()

print("描述性统计信息:")
df.describe().show()

# 指定ADL2中容器和文件夹的路径（请替换为真实信息）
container_name = "<your_container_name>"      # 用你的容器名称替换
storage_account = "<your_storage_account_name>" # 替换为实际的存储账户名称
folder_path = "<your_folder_path>"             # 替换为容器内文件夹的路径
adl2_path = f"abfss://{container_name}@{storage_account}.dfs.core.windows.net/{folder_path}"

# 将DataFrame以Parquet格式写入ADL2
df.write.parquet(adl2_path, mode="overwrite")

# 可选：读取Parquet文件进行验证
df_leido = spark.read.parquet(adl2_path)
print("读取写入ADL2的Parquet文件:")
df_leido.show()

# 停止 Spark 会话
spark.stop()