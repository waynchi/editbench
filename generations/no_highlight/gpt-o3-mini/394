import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data_for_groups(features_transformed, cluster_groups, n_clusters=2, clustering_method='kmeans'):
    """
    Przeprowadza klasteryzację oddzielnie dla zestawów kolumn określonych w słowniku cluster_groups.
    
    Args:
        features_transformed (pandas.DataFrame): Przekształcony DataFrame z parametrami.
        cluster_groups (dict): Słownik, w którym klucz to nazwa nowej kolumny z etykietami klastra,
                               a wartość to krotka lub lista nazw kolumn, na podstawie których przeprowadzana jest klasteryzacja.
                               Przykład: {'Klaster1': ('kolumna1', 'kolumna2'), 'Klaster2': ('kolumna3',)}
        n_clusters (int): Liczba klastrów do utworzenia dla każdej grupy.
        clustering_method (str): Metoda klasteryzacji (tylko 'kmeans' jest obecnie obsługiwana).
        
    Returns:
        pandas.DataFrame: Oryginalny DataFrame z dodanymi kolumnami klastrów o nazwach zgodnych z kluczami w cluster_groups.
    """
    if features_transformed is None:
        print("Najpierw wykonaj transformację danych (etap 5).")
        return None

    # Dla każdej grupy kolumn wykonaj klasteryzację niezależnie
    for cluster_column, cols in cluster_groups.items():
        # Sprawdzenie czy wszystkie zadeklarowane kolumny istnieją w DataFrame
        missing_cols = [col for col in cols if col not in features_transformed.columns]
        if missing_cols:
            print(f"Brakuje kolumn w danych: {missing_cols}. Pomijam grupę '{cluster_column}'.")
            continue

        # Przygotowanie zbioru danych dla klasteryzacji (wybrane kolumny)
        features_subset = features_transformed.loc[:, cols].copy()

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)
            
            # Ocena jakości klasteryzacji za pomocą współczynnika sylwetki
            unique_labels = np.unique(cluster_labels)
            if len(unique_labels) > 1:
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Klaster: '{cluster_column}' - współczynnik sylwetki dla {n_clusters} klastrów: {silhouette_avg:.4f}")
            else:
                print(f"Klaster: '{cluster_column}' - niemożliwe obliczenie współczynnika sylwetki (wszystkie punkty w jednym klastrze).")
        else:
            print(f"Nieobsługiwana metoda klasteryzacji: {clustering_method} dla grupy '{cluster_column}'.")
            continue

        # Dodanie etykiet klastrów do oryginalnego DataFrame
        features_transformed[cluster_column] = cluster_labels
        print(f"Klasteryzacja wykonana dla grupy kolumn {cols}. Nowa kolumna: '{cluster_column}'.")

    return features_transformed

# Przykładowe użycie funkcji
if __name__ == "__main__":
    # Przykładowe dane - należy je zastąpić prawdziwymi danymi po etapie transformacji (etap 5)
    data = {
        'kolumna1': np.random.rand(100),
        'kolumna2': np.random.rand(100),
        'kolumna3': np.random.rand(100),
        'inna_cecha': np.random.randint(0, 50, 100)
    }
    features_transformed = pd.DataFrame(data)
    
    # Definicja zestawów kolumn do klasteryzacji
    cluster_groups = {
        'Klaster1': ('kolumna1', 'kolumna2'),  # klasteryzacja odbywa się na podstawie kolumna1 i kolumna2
        'Klaster2': ('kolumna3',)              # klasteryzacja odbywa się na podstawie kolumna3
    }
    
    # Ustawienie liczby klastrów do znalezienia
    n_clusters = 3  

    # Przeprowadzenie klasteryzacji na wskazanych zestawach kolumn
    features_transformed = cluster_data_for_groups(features_transformed, cluster_groups, n_clusters=n_clusters)

    # Wizualizacja wyników klasteryzacji dla pierwszej grupy (jeśli wybrano co najmniej 2 kolumny)
    if 'Klaster1' in cluster_groups:
        cols = cluster_groups['Klaster1']
        if len(cols) >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(features_transformed[cols[0]], features_transformed[cols[1]], 
                        c=features_transformed['Klaster1'], cmap='viridis')
            plt.xlabel(cols[0])
            plt.ylabel(cols[1])
            plt.title('Wizualizacja klasteryzacji dla grupy Klaster1')
            plt.colorbar(label='Numer Klastra')
            plt.show()
        else:
            print("Nie można wizualizować klasteryzacji dla grupy Klaster1 (mniej niż 2 cechy numeryczne).")
    
    # Wizualizacja wyników klasteryzacji dla drugiej grupy (jeśli jest tylko jedna kolumna, prezentujemy histogram)
    if 'Klaster2' in cluster_groups:
        cols = cluster_groups['Klaster2']
        if len(cols) == 1:
            plt.figure(figsize=(8, 6))
            plt.hist(features_transformed[cols[0]], bins=20, color='skyblue', edgecolor='black')
            plt.title('Histogram danych dla grupy Klaster2')
            plt.xlabel(cols[0])
            plt.ylabel('Liczba wystąpień')
            plt.show()
        elif len(cols) >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(features_transformed[cols[0]], features_transformed[cols[1]], 
                        c=features_transformed['Klaster2'], cmap='viridis')
            plt.xlabel(cols[0])
            plt.ylabel(cols[1])
            plt.title('Wizualizacja klasteryzacji dla grupy Klaster2')
            plt.colorbar(label='Numer Klastra')
            plt.show()
        else:
            print("Brak kolumn do wizualizacji dla grupy Klaster2.")