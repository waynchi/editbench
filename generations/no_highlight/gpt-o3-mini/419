import asyncio
import aiohttp
import aiofiles
import xml.etree.ElementTree as ET
import matplotlib.pyplot as plt  # do tworzenia wykresów
import pandas as pd  # do tworzenia ramki danych i podziału wszystkich świec na dwa typy: zamknięcie i otwarcie
import datetime
import pickle
import json

# Klasa waluta
class valute:
    """Waluta i wszystko z nią związane, przez CBRF

Wymagane biblioteki:
    aiohttp
    aiofiles
    xml.etree.ElementTree
    matplotlib.pyplot jako plt
    pandas jako pd
    datetime
    pickle
    json
    asyncio
    """

    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """Sprawdzanie nazwy waluty w zbiorze walut. Zbiór jest aktualizowany nie częściej niż raz dziennie."""
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        set_valutes_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin"

        # Odczyt pliku Info.json asynchronicznie
        async with aiofiles.open(info_path, "r", encoding="utf-8") as info_file:
            info_content = await info_file.read()
        info = json.loads(info_content)

        last_check = datetime.datetime.strptime(info["last_day_check"]["valute"], "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check:
            # Jeśli aktualizacja jest starsza niż jeden dzień, pobieramy nowe dane z API
            set_valutes = set()
            url = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    # Pobieramy zawartość jako bajty
                    content = await response.read()
            root = ET.fromstring(content)
            for valute_elem in root.findall("Valute"):
                char_code = valute_elem.find("CharCode")
                if char_code is not None and char_code.text:
                    set_valutes.add(char_code.text)

            # Zapisujemy nowy zbiór walut do pliku binarnego
            async with aiofiles.open(set_valutes_path, "wb") as set_file:
                await set_file.write(pickle.dumps(set_valutes))

            # Aktualizujemy czas ostatniej aktualizacji w info
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, "w", encoding="utf-8") as info_file:
                new_info = json.dumps(info, indent=3, ensure_ascii=False)
                await info_file.write(new_info)
        # Odczytujemy zbiór walut z pliku
        async with aiofiles.open(set_valutes_path, "rb") as set_file:
            set_bytes = await set_file.read()
        set_valutes = pickle.loads(set_bytes)

        return self.name in set_valutes

    async def CurrentExchangeRate(self):
        '''Bieżący kurs wymiany waluty na rubla'''
        url = "http://www.cbr.ru/scripts/XML_daily.asp"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = ET.fromstring(content)
        for valute_elem in root.findall("Valute"):
            char_code = valute_elem.find("CharCode")
            if char_code is not None and char_code.text == self.name:
                # Zwracamy kurs. W oryginalnym kodzie pobierany był "VunitRate"
                rate_elem = valute_elem.find("VunitRate")
                if rate_elem is not None:
                    return rate_elem.text
        return None

# Przykład użycia
if __name__ == "__main__":
    async def main():
        currency = valute("USD")
        # Najpierw sprawdzamy, czy waluta znajduje się na liście
        is_valid = await currency.correct_name()
        if is_valid:
            rate = await currency.CurrentExchangeRate()
            print(f"Aktualny kurs wymiany {currency.name} na rubla: {rate}")
        else:
            print(f"{currency.name} nie jest poprawną walutą według CBRF.")

    asyncio.run(main())