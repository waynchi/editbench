import requests
import json

def interact_with_local_llm(prompt, base_url="http://localhost:11434"):
    """
    Взаимодействие с локальной LLM с использованием Ollama API.

    :param prompt: Входной запрос для LLM.
    :param base_url: Базовый URL Ollama API.
    :return: Ответ от LLM или None в случае ошибки.
    """
    endpoint = f"{base_url}/api/generate"
    payload = {
        "model": "llama3.2:latest",  # Замените на имя вашей модели
        "prompt": prompt,
        "max_tokens": 2048  # Корректируйте по мере необходимости
    }
    headers = {
        "Content-Type": "application/json"
    }
    
    try:
        response = requests.post(endpoint, json=payload, headers=headers)
        response.raise_for_status()
        
        # Если сервер возвращает "лишние данные" после корректного JSON, пробуем декодировать только первый JSON объект.
        text = response.text.strip()
        decoder = json.JSONDecoder()
        json_response, _ = decoder.raw_decode(text)
        
        return json_response.get('response', '')
    except requests.exceptions.RequestException as e:
        # Здесь можно добавить логирование ошибки, если требуется.
        print(f"Ошибка запроса: {e}")
        return None
    except json.JSONDecodeError as je:
        # Если возникла ошибка JSON-декодирования, выведем ошибку и вернём None.
        print(f"Ошибка декодирования JSON: {je}")
        return None

# Пример использования
if __name__ == "__main__":
    prompt = "Hello, how are you?"
    response_text = interact_with_local_llm(prompt)
    if response_text:
        print(f"LLM Response: {response_text}")
    else:
        print("Не удалось получить ответ от LLM.")