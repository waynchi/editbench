from manim import *

class MaroAnimation(Scene):
    def construct(self):
        # Создать текст
        text = Text("Maro", font_size=120)
        
        # Добавить красивый цветовой градиент
        text.set_color_by_gradient(BLUE, PURPLE, PINK)
        
        # Анимация появления текста
        self.play(
            Write(text, run_time=2, rate_func=smooth)
        )
        
        # Анимация пульсации текста
        self.play(
            text.animate.scale(1.2),
            rate_func=there_and_back,
            run_time=1.5
        )
        
        # Объединяем вращение и сдвиг в одну анимацию, так как применяется к одному и тому же объекту.
        self.play(
            text.animate.shift(UP * 0.5).rotate(PI/12),
            rate_func=ease_in_out_sine,
            run_time=1
        )
        
        # Удержание последнего кадра
        self.wait(2)