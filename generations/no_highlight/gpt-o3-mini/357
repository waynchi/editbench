import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-8, max_iter=1000):
    """
    Rozwiązuje układ liniowy Ax = b przy użyciu metody sprzężonych gradientów.
    Zakłada, że A jest macierzą symetryczną i dodatnio określoną.

    Argumenty:
        A : numpy.ndarray, macierz o wymiarze (n, n)
        b : numpy.ndarray, wektor o długości n
        x0: numpy.ndarray, początkowe przybliżenie rozwiązania (domyślnie wektor zerowy)
        tol: float, zadana tolerancja normy reszty
        max_iter: int, maksymalna liczba iteracji

    Zwraca:
        x : numpy.ndarray, przybliżone rozwiązanie układu Ax = b
    """
    n = b.shape[0]
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    r = b - np.dot(A, x)
    p = r.copy()
    rsold = np.dot(r, r)

    for i in range(max_iter):
        Ap = np.dot(A, p)
        alpha = rsold / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rsnew = np.dot(r, r)
        if np.sqrt(rsnew) < tol:
            print(f"Zbieżność osiągnięta po {i+1} iteracjach.")
            break
        p = r + (rsnew / rsold) * p
        rsold = rsnew
    else:
        print("Osiągnięto maksymalną liczbę iteracji bez spełnienia kryterium zbieżności.")

    return x

if __name__ == "__main__":
    # Przykład użycia funkcji conjugate_gradient:
    # Tworzymy symetryczną i dodatnio określoną macierz A oraz wektor b.
    A = np.array([[4, 1],
                  [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # Rozwiązanie układu równań Ax = b
    x = conjugate_gradient(A, b)
    print("Rozwiązanie układu:", x)