async def check_answer(chat_id, text_command):
    # Здесь можно добавить логику проверки ответа.
    # Перед проверкой освобождаем строку от неалфавитных символов.
    cleaned_command = clean_text(text_command)
    # Реализация проверки ответа может зависеть от формата вопросов.
    await bot.send_message(chat_id, f"Проверка ответа: {cleaned_command}")


async def process_command(chat_id, text_command):
    # Если сообщение начинается с команды load, обрабатываем его без удаления символов,
    # чтобы не потерять информацию о номере пакета.
    if text_command.startswith('/load'):
        # Оставляем только цифры для номера пакета (без неалфавитных символов, т.к. цифры не проходят isalpha())
        # Таким образом, если после '/load' нет букв, условие не выполнится.
        pack_num_str = ''.join(ch for ch in text_command[5:] if ch.isdigit())
        if pack_num_str.isdigit():
            num_pack = int(pack_num_str)
            await load_pack(chat_id, num_pack)
    else:
        # Обработка других команд, начинающихся со слэша.
        if text_command.startswith('/'):
            # Для команд проверяем ответ без неалфавитных символов, начиная с символа после '/'
            if all_chats.get(chat_id) and all_chats[chat_id].cur_question != -1:
                cleaned_answer = clean_text(text_command[1:])
                await check_answer(chat_id, cleaned_answer)
        else:
            # Для обычных сообщений удаляем из текста все неалфавитные символы
            cleaned_text = clean_text(text_command)
            await bot.send_message(chat_id, cleaned_text[::-1])


@dp.message()
async def echo_handler(message: Message) -> None:
    """
    Handler will forward received message back to the sender
    """
    await process_command(message.chat.id, message.text)


async def main() -> None:
    dp.include_router(start_router)
    await dp.start_polling(bot)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, stream=sys.stdout)
    asyncio.run(main())