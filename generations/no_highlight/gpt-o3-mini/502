from manim import *

class MaroAnimation(Scene):
    def construct(self):
        # Creamos el texto con un tamaño de fuente adecuado.
        text = Text("Maro", font_size=120)
        
        # Aplicamos un degradado de color al texto.
        text.set_color_by_gradient(BLUE, PURPLE, PINK)
        
        # Animamos la escritura del texto.
        self.play(
            Write(text, run_time=2),
            rate_func=smooth
        )
        
        # Agregamos una animación de pulso suave (agrandamiento y reducción).
        self.play(
            text.animate.scale(1.2),
            rate_func=there_and_back,
            run_time=1.5
        )
        
        # Añadimos una animación que rota ligeramente y desplaza el texto hacia arriba.
        self.play(
            text.animate.rotate(PI/12),
            text.animate.shift(UP * 0.5),
            rate_func=ease_in_out_sine,
            run_time=1
        )
        
        # Mantenemos el fotograma final durante 2 segundos.
        self.wait(2)