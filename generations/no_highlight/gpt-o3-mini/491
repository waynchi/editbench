import os
import shutil
import logging
import json
import pickle
import torch

from dotenv import load_dotenv
from transformers import AutoModelForCausalLM
from peft import PeftModel

load_dotenv()

DATA_SAVE_PATH = os.getenv("DATA_SAVE_PATH")
MODEL_PATH = os.getenv("MODEL_PATH")

# Configure logging to display information that can help analyze performance.
logging.basicConfig(level=logging.INFO)


def save_log_to_file(log_history, file_path, append_latest_only=False):
    """
    Optimizations:
    - Use json.load() directly instead of reading file contents manually.
      Expected improvement: Less code, improved reliability and slight performance benefits with built-in parsing.
    - This implementation minimizes file I/O operations by reading and writing the file only once.
    """
    current_logs = []

    if os.path.exists(file_path):
        try:
            with open(file_path, "r") as f:
                # Directly load JSON; if file is empty, load will raise an error so we catch it.
                current_logs = json.load(f)
        except json.JSONDecodeError:
            logging.warning(f"Warning: {file_path} contains invalid JSON. Overwriting file.")
            current_logs = []
        except Exception as e:
            logging.error(f"An error occurred while reading {file_path}: {e}")
            current_logs = []

    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    try:
        with open(file_path, "w") as f:
            json.dump(current_logs, f, indent=4)
    except Exception as e:
        logging.error(f"An error occurred while writing to {file_path}: {e}")


def clear_directory(directory, delete_directory=False):
    """
    Optimizations:
    - Replace os.listdir with os.scandir for iterating over directory entries.
      Expected improvement: os.scandir yields DirEntry objects and is more efficient, especially in directories with many files.
    - Using a with-statement for os.scandir ensures resources are properly closed.
    """
    if not os.path.exists(directory):
        if not delete_directory:
            os.makedirs(directory)
            logging.info(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        return

    with os.scandir(directory) as entries:
        for entry in entries:
            item_path = entry.path
            try:
                if entry.is_dir(follow_symlinks=False):
                    shutil.rmtree(item_path)
                    logging.info(f"Removed directory: {item_path}")
                else:
                    os.remove(item_path)
                    logging.info(f"Removed file: {item_path}")
            except OSError as e:
                logging.error(f"Failed to delete '{item_path}'. Reason: {e}")
                raise

    if delete_directory:
        try:
            os.rmdir(directory)
            logging.info(f"Removed directory: {directory}")
        except OSError as e:
            logging.error(f"Failed to delete '{directory}'. Reason: {e}")
            raise


def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """
    Optimizations:
    - Utilize f-strings for clarity in string formatting.
      Expected improvement: Improved readability and slight performance benefit for string operations.
    """
    my_model_path = os.path.join(model_load_path, model_name)
    param_count = model_name.lower().split("m")[0].split("-")[1]
    base_model_name = f"pythia-{param_count}M"
    base_model_full_path = os.path.join(base_model_repo_name, base_model_name)

    base_model = AutoModelForCausalLM.from_pretrained(base_model_full_path)
    model = PeftModel.from_pretrained(base_model, my_model_path)
    merged_model = model.merge_and_unload()
    my_model_save_path = os.path.join(model_save_path, f"{model_name}_merged")
    merged_model.save_pretrained(my_model_save_path)


def remove_repetition(question, answer):
    # This simple function is efficient as-is.
    if question in answer:
        return answer.replace(question, "").strip()
    return answer


def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Optimizations:
    - Use os.path.basename to extract filenames, which is more reliable and clear than string splitting.
      Expected improvement: Better clarity and maintainability with equivalent performance.
    """
    if model_type == "Tuned Model":
        model_name = os.path.basename(vanilla_model_name)
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        tuned_model_path = os.path.join(model_path, tuned_model_name)
        tuned_model = AutoModelForCausalLM.from_pretrained(tuned_model_path)
        return tuned_model

    elif model_type == "Vanilla Model":
        vanilla_model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)
        return vanilla_model

    elif model_type == "Transformed Model":
        base_name = os.path.basename(host_model_name)
        save_path = os.path.join(model_path, f"{base_name}_preGRAFTED_{blocks_str}.pkl")
        with open(save_path, "rb") as f:
            transformed_model = pickle.load(f)
        return transformed_model

    elif model_type == "Final Model":
        base_name = os.path.basename(host_model_name)
        model_save_name = f"{base_name}_GRAFTED_{blocks_str}.pkl"
        save_path = os.path.join(model_path, model_save_name)
        with open(save_path, "rb") as f:
            final_model = pickle.load(f)
        return final_model

    elif model_type == "Host Model":
        host_model = AutoModelForCausalLM.from_pretrained(host_model_name)
        return host_model

    else:
        raise ValueError(f"Unknown model type: {model_type}")


def load_batch_losses(file_path):
    """
    Optimizations:
    - Check file existence before attempting to load to avoid unnecessary exception handling, reducing overhead.
      Expected improvement: More graceful handling and reduction in exception costs in performance.
    - Maintain consistent logging to monitor performance-related messages.
    """
    if not os.path.exists(file_path):
        logging.error(f"File {file_path} does not exist.")
        return None

    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"))
        batch_losses = checkpoint.get("batch_losses", None)
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None