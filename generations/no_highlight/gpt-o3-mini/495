import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self, flattened_size):  # Se acepta flattened_size como argumento
        super(SimpleConvNet1, self).__init__()
        
        self.conv1 = nn.Sequential(
            nn.Conv2d(in_channels=3, out_channels=32, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
        
        self.conv2 = nn.Sequential(
            nn.Conv2d(in_channels=32, out_channels=64, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
        
        self.flatten = nn.Flatten()
        self.fc1 = nn.Sequential(
            nn.Linear(flattened_size, 512),
            nn.ReLU(),
            nn.Linear(512, 3)
        )
    
    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x

if __name__ == "__main__":
    # Se asume que el tamaño aplanado (flattened_size) es conocido tras las capas convolucionales.
    # Por ejemplo: si la entrada es de tamaño (3, 32, 32)
    # aplice las capas convolucionales y pooling:
    # Después de conv1 (kernel_size=3 sin padding) -> tamaño: 30x30, después de maxpool -> 15x15.
    # Después de conv2 (kernel_size=3) -> tamaño: 13x13, después de maxpool -> 6x6.
    # Entonces, flattened_size = 64 canales * 6 * 6 = 2304.
    flattened_size = 64 * 6 * 6
    
    model = SimpleConvNet1(flattened_size)
    print(model)
    
    # Prueba con un tensor de entrada dummy
    dummy_input = torch.randn(1, 3, 32, 32)  # batch_size=1, 3 canales, 32x32 píxeles
    output = model(dummy_input)
    print("Output shape:", output.shape)