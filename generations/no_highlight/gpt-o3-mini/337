def binary_search(arr, target):
    """
    Performs a binary search on a sorted list 'arr' to find the index of 'target'.
    Returns the index if found, otherwise returns -1.

    Parameters:
    arr (list): A sorted list of elements.
    target: The element to search for.

    Returns:
    int: The index of target in arr, or -1 if not found.
    """
    low = 0
    high = len(arr) - 1

    while low <= high:
        mid = (low + high) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            low = mid + 1
        else:
            high = mid - 1

    return -1


if __name__ == "__main__":
    # Example usage:
    # The list must be sorted for binary search to work correctly.
    sample_list = [1, 3, 5, 7, 9, 11, 13, 15]
    target_value = 7

    result = binary_search(sample_list, target_value)
    if result != -1:
        print(f"Element {target_value} found at index {result}.")
    else:
        print(f"Element {target_value} not found in the list.")