from flask import Flask
from datetime import datetime

app = Flask(__name__)

@app.route('/')
def show_datetime():
    # 获取当前日期和时间
    now = datetime.now()
    formatted_time = now.strftime("%Y-%m-%d %H:%M:%S")
    return f"当前日期和时间：{formatted_time}"

if __name__ == '__main__':
    app.run(debug=True)