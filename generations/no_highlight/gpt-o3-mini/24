import asyncio
import aiohttp
import aiofiles
import xml.etree.ElementTree as ET
import matplotlib.pyplot as plt
import pandas as pd
import datetime
import pickle
import json
import os

class ticker():
    """
    Тикер акции и всё с ним связанное, через MoexApi.
    Требуются библиотеки: aiohttp, aiofiles, xml.etree.ElementTree, matplotlib.pyplot, pandas, datetime, pickle, json
    """
    def __init__(self, name: str):
        """
        self.name - имя тикера
        self.tech_dict - словарь теханализа
        """
        self.name = name
        # Здесь можно менять общие настройки по умолчанию
        self.tech_dict = {
            "value": {"use": False, "has_periods": False, "need_graph_space": True},
            "sma": {"use": False, "has_periods": True, "periods": [], "need_graph_space": False},
            "ema": {"use": False, "has_periods": True, "periods": [], "need_graph_space": False}
        }
    
    async def correct_name(self):
        """
        Проверка имени тикера на наличие в множестве тикеров. Множество обновляется не чаще раза в день.
        Работает асинхронно: использует aiohttp для запросов и aiofiles для чтения/записи файлов.
        """
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        set_tickers_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_tickers.bin"
        # Чтение файла Info.json
        async with aiofiles.open(info_path, "r", encoding="utf-8") as f:
            info_str = await f.read()
        info = json.loads(info_str)
        
        last_check_str = info["last_day_check"]["ticker"]
        last_check = datetime.datetime.strptime(last_check_str, "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check:
            # Обновляем список тикеров
            set_tickers = set()
            url = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities.xml?iss.meta=off"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    content = await response.read()
            root = ET.fromstring(content)
            for data in root.findall("data"):
                if data.get("id") == "securities":
                    rows = data.find("rows")
                    for row in rows.findall("row"):
                        set_tickers.add(row.get("SECID"))
            # Сохраняем множество тикеров
            async with aiofiles.open(set_tickers_path, "wb") as f:
                await asyncio.get_running_loop().run_in_executor(None, pickle.dump, set_tickers, f)
            # Обновляем время последнего обновления
            info["last_day_check"]["ticker"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, "w", encoding="utf-8") as f:
                await f.write(json.dumps(info, indent=3, ensure_ascii=False))
        
        # Чтение множества тикеров
        async with aiofiles.open(set_tickers_path, "rb") as f:
            content = await f.read()
        set_tickers = pickle.loads(content)
        
        return self.name in set_tickers
    
    async def CurrentPrice(self):
        """
        Асинхронно возвращает текущую цену по этому тикеру.
        """
        url = f"https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/{self.name}.xml?iss.meta=off"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = ET.fromstring(content)
        for data in root.findall("data"):
            if data.get("id") == "marketdata":
                rows = data.find("rows")
                row = rows.find("row")
                return row.get("LAST")
        return None
    
    async def candles(self, candles_name: str, timeframe: str, start: str, end: str):
        """
        Асинхронно получает список свечей для этого тикера.
        candles_name - одна из: open, close, high, low, value, volume, begin, end.
        timeframe - таймфрейм (например, "1", "10", "60", "24", ...).
        start, end - строки с датой и временем в формате "ГГГГ-ММ-ДД ЧЧ:ММ:СС".
        """
        url = f"https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/{self.name}/candles.xml?iss.meta=off&interval={timeframe}&till={end}&from={start}"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = ET.fromstring(content)
        candles_elem = root.find("data")
        rows = candles_elem.find("rows")
        listcandles = []
        if candles_name in ["begin", "end"]:
            for row in rows.findall("row"):
                datetime_str = row.get(candles_name)
                dt = datetime.datetime(
                    int(datetime_str[0:4]),
                    int(datetime_str[5:7]),
                    int(datetime_str[8:10]),
                    int(datetime_str[11:13]),
                    int(datetime_str[14:16]),
                    int(datetime_str[17:])
                )
                listcandles.append(dt)
        else:
            for row in rows.findall("row"):
                listcandles.append(float(row.get(candles_name)))
        return listcandles

    async def setattr_candles_dataframe(self, timeframe="24", start="", end=""):
        """
        Создаёт датафрейм свечей с соответствующим timeframe, start и end и помещает его в self.candles_dataframe.
        """
        opens = await self.candles("open", timeframe, start, end)
        closes = await self.candles("close", timeframe, start, end)
        highs = await self.candles("high", timeframe, start, end)
        lows = await self.candles("low", timeframe, start, end)
        values = await self.candles("value", timeframe, start, end)
        begins = await self.candles("begin", timeframe, start, end)
        
        candles_dataframe = pd.DataFrame({
            "open": opens,
            "close": closes,
            "high": highs,
            "low": lows,
            "value": values,
            "begin": begins
        })
        setattr(self, "candles_dataframe", candles_dataframe)
    
    async def graphic(self, timeframe="24", start="", end=""):
        """
        Асинхронно создаёт график свечного анализа с техническим анализом.
        timeframe - таймфрейм.
        start, end - начало и конец периода ("ГГГГ-ММ-ДД ЧЧ:ММ:СС").
        """
        await self.setattr_candles_dataframe(timeframe, start, end)
        df = self.candles_dataframe
        # Разделяем свечи на повышающие (up) и понижающие (down)
        up = df[df.close >= df.open]
        down = df[df.close < df.open]
        self.up = up
        self.down = down

        # Определяем ширину свечей в зависимости от таймфрейма
        if timeframe == "1":  # минута
            width_big = 1/24/60
        elif timeframe == "10":  # 10 минут
            width_big = 1/24/6
        elif timeframe == "60":  # час
            width_big = 1/24
        elif timeframe == "24":  # день
            width_big = 1
        elif timeframe == "7":  # неделя
            width_big = 7
        elif timeframe == "31":  # месяц
            width_big = 30
        elif timeframe == "4":  # 4 месяца
            width_big = 90
        else:
            width_big = 0
        width_small = width_big / 10
        self.width_big = width_big

        # Подсчёт числа дополнительных графиков требуемых для инструментов теханализа
        number_of_additional_graphics = 0
        for tech in self.tech_dict:
            if self.tech_dict[tech]["use"] and self.tech_dict[tech]["need_graph_space"]:
                number_of_additional_graphics += 1
        
        if number_of_additional_graphics != 0:
            height_ratios = [10 - number_of_additional_graphics] + [1] * number_of_additional_graphics
            fig, axs = plt.subplots(nrows=1 + number_of_additional_graphics, ncols=1, sharex=True, figsize=(12, 8), 
                                    gridspec_kw={'height_ratios': height_ratios})
            plt.suptitle(self.name, fontsize=15)
            axs[0].grid(True)
            # Рисуем свечи для up
            axs[0].bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
            axs[0].bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
            axs[0].bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
            # Рисуем свечи для down
            axs[0].bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
            axs[0].bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
            axs[0].bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")
            # Добавляем инструменты теханализа
            add_plot_idx = 0
            for tech in self.tech_dict:
                if self.tech_dict[tech]["use"]:
                    tech_func = getattr(self, tech)
                    if not self.tech_dict[tech]["need_graph_space"]:
                        tech_func(axs[0])
                    else:
                        add_plot_idx += 1
                        axs[add_plot_idx].grid(True)
                        tech_func(axs[add_plot_idx])
        else:
            fig = plt.figure(figsize=(12, 8))
            ax = fig.add_subplot(111)
            ax.grid(True)
            # Рисуем свечи для up
            ax.bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
            ax.bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
            ax.bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
            # Рисуем свечи для down
            ax.bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
            ax.bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
            ax.bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")
            # Добавляем инструменты теханализа, не требующие отдельного графика
            for tech in self.tech_dict:
                if self.tech_dict[tech]["use"]:
                    tech_func = getattr(self, tech)
                    tech_func(ax)
        
        output_path = r"D:\Python files\!MoexApiBot\graphic.png"
        fig.savefig(output_path)
        # Открываем сохранённое изображение для возвращения (синхронно, так как размер файла невелик)
        return open(output_path, "rb")
    
    def sma(self, ax):
        """
        Рассчитывает и отображает SMA для заданных периодов.
        """
        for period in self.tech_dict["sma"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                sma_list = []
                sma_list.append(sum(self.candles_dataframe.close[0:period]) / period)
                for i in range(period, len(self.candles_dataframe.begin)):
                    sma_list.append(sma_list[i - period] + (self.candles_dataframe.close[i] - self.candles_dataframe.close[i - period]) / period)
                ax.plot(self.candles_dataframe.begin[period - 1:], sma_list, label=f"SMA {period}")
        ax.legend(fontsize=8)
    
    def ema(self, ax):
        """
        Рассчитывает и отображает EMA для заданных периодов.
        """
        for period in self.tech_dict["ema"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                ema_list = []
                ema_list.append(sum(self.candles_dataframe.close[0:period]) / period)
                for i in range(period, len(self.candles_dataframe.begin)):
                    ema_list.append(((period - 1) * ema_list[i - period] + 2 * self.candles_dataframe.close[i]) / (period + 1))
                ax.plot(self.candles_dataframe.begin[period - 1:], ema_list, label=f"EMA {period}")
        ax.legend(fontsize=8)
    
    def value(self, ax):
        """
        Отображает bar график объёма (value).
        """
        ax.bar(x=self.up.begin, height=self.up.value, width=self.width_big, color="green")
        ax.bar(x=self.down.begin, height=self.down.value, width=self.width_big, color="red")
        ax.set_title("Value", fontsize=7)

# Пример использования:

async def main():
    # Создаем объект тикера
    beb = ticker("SBER")
    
    # Проверяем корректность имени тикера
    is_valid = await beb.correct_name()
    if not is_valid:
        print("Тикер не найден!")
        return
    
    # Получаем текущую цену
    current_price = await beb.CurrentPrice()
    print("Текущая цена:", current_price)
    
    # Настраиваем использование SMA, EMA и Value
    beb.tech_dict["sma"]["use"] = True
    beb.tech_dict["sma"]["periods"] = [20, 10]
    beb.tech_dict["ema"]["use"] = True
    beb.tech_dict["ema"]["periods"] = [150, 250]
    beb.tech_dict["value"]["use"] = True
    
    # Создаем график за указанный период
    graphic_file = await beb.graphic("24", "2024-01-01", "2024-05-01")
    # Сохраняем график в отдельном файле или делаем с ним что-то необходимое
    out_path = r"D:\Python files\!MoexApiBot\graphic_output.png"
    with open(out_path, "wb") as f:
        f.write(graphic_file.read())
    print("График сохранён по адресу:", out_path)

if __name__ == "__main__":
    asyncio.run(main())