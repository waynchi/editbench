def save_log_to_file(log_history, file_path, append_latest_only=False):
    """
    Zapisuje historię logów do pliku JSON. Jeśli plik już istnieje, dodaje do niego.
    
    Parametry:
    - log_history: Lista wpisów logów (każdy wpis to słownik).
    - file_path: Ścieżka do pliku, w którym logi będą zapisywane.
    - append_latest_only: Jeśli True, tylko najnowszy wpis logu jest dodawany.
    
    Optymalizacje:
    1. Użycie json.load() zamiast ręcznego czytania i strip() poprawia czytelność i potencjalnie wydajność przy walidacji formatu JSON.
       (Kompromis: W przypadku bardzo dużych plików JSON może być problem pamięciowy, ale typowo logi nie są masywne.)
    2. Minimalizacja liczby operacji we/wy poprzez ograniczenie otwarć/zapisów plików.
    """
    current_logs = []
    if os.path.exists(file_path):
        try:
            if os.path.getsize(file_path) > 0:  # Szybkie sprawdzenie czy plik nie jest pusty
                with open(file_path, "r") as f:
                    current_logs = json.load(f)
        except json.JSONDecodeError:
            print(f"Warning: {file_path} contains invalid JSON. Overwriting file.")
            current_logs = []
        except Exception as e:
            print(f"An error occurred while reading {file_path}: {e}")
            current_logs = []

    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    try:
        with open(file_path, "w") as f:
            json.dump(current_logs, f, indent=4)
    except Exception as e:
        print(f"An error occurred while writing to {file_path}: {e}")


def clear_directory(directory, delete_directory=False):
    """
    Czyści wszystkie pliki i podkatalogi w podanym katalogu. Opcjonalnie usuwa sam katalog.
    Tworzy katalog, jeśli nie istnieje i delete_directory jest False.
    
    Argumenty:
        directory (str): Ścieżka do katalogu do wyczyszczenia.
        delete_directory (bool): Jeśli True, usuwa katalog po wyczyszczeniu jego zawartości. Domyślnie False.
    
    Wyjątki:
        OSError: Jeśli wystąpi jakikolwiek błąd podczas usuwania plików lub katalogów.
    
    Optymalizacje:
    1. Używanie os.scandir() może być bardziej wydajne przy dużej liczbie plików, ponieważ zwraca iterator z metadanymi.
       (Kompromis: Kod staje się nieco mniej czytelny, choć przyspieszenie jest zauważalne przy dużych katalogach.)
       Jednak dla uproszczenia pozostajemy przy os.listdir().
    """
    if not os.path.exists(directory):
        if not delete_directory:
            os.makedirs(directory)
            print(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        return

    for item in os.listdir(directory):
        item_path = os.path.join(directory, item)
        try:
            if os.path.isdir(item_path):
                shutil.rmtree(item_path)
                print(f"Removed directory: {item_path}")
            else:
                os.remove(item_path)
                print(f"Removed file: {item_path}")
        except OSError as e:
            print(f"Failed to delete '{item_path}'. Reason: {e}")
            raise

    if delete_directory:
        try:
            os.rmdir(directory)
            print(f"Removed directory: {directory}")
        except OSError as e:
            print(f"Failed to delete '{directory}'. Reason: {e}")
            raise


def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """
    Łączy model LoRA z modelem bazowym.
    
    Optymalizacje:
    1. Użycie wyrażeń regularnych do wyodrębnienia liczby parametrów umożliwia bardziej elastyczne parsowanie nazwy modelu.
       (Kompromis: Regex mogą być trudniejsze w debugowaniu w przypadku niestandardowych nazw modeli.)
    """
    my_model_path = os.path.join(model_load_path, model_name)
    
    # Użycie regex aby znaleźć liczbę parametrów zamiast złożonych splitów:
    match = re.search(r"-([0-9]+)M", model_name, re.IGNORECASE)
    if match:
        param_count = match.group(1)
    else:
        raise ValueError("Cannot extract parameter count from model name.")

    base_model_name = f"pythia-{param_count}M"

    # Pobieranie modelu bazowego
    base_model = AutoModelForCausalLM.from_pretrained(
        os.path.join(base_model_repo_name, base_model_name)
    )
    model = PeftModel.from_pretrained(base_model, my_model_path)
    merged_model = model.merge_and_unload()
    my_model_save_path = os.path.join(model_save_path, f"{model_name}_merged")
    merged_model.save_pretrained(my_model_save_path)


def remove_repetition(question, answer):
    """
    Usuwa powtórzenia pytania w odpowiedzi.
    """
    if question in answer:
        return answer.replace(question, "").strip()
    return answer


def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Ładuje różne typy modeli w zależności od parametru model_type.
    
    Parametry:
    model_type (str): Typ modelu do załadowania: 'Tuned Model', 'Vanilla Model', 
                      'Transformed Model', 'Final Model', lub 'Host Model'.
    model_path (str): Bazowa ścieżka, gdzie przechowywane są modele.
    blocks_str (str): Ciąg reprezentujący warstwy/bloki używane przy nazewnictwie modelu.
    vanilla_model_name (str): Nazwa lub ścieżka modelu bazowego.
    host_model_name (str): Nazwa lub ścieżka modelu hosta.
    
    Zwraca:
    model: Załadowany obiekt modelu.
    
    Optymalizacje:
    1. Można wprowadzić cache'owanie modeli aby unikać wielokrotnego ładowania tego samego modelu, co zwiększa wydajność.
       (Kompromis: Wprowadzenie cache zwiększa złożoność kodu oraz zużycie pamięci.)
       W niniejszej implementacji cache nie został dołączony dla uproszczenia.
    """
    if model_type == "Tuned Model":
        model_name = vanilla_model_name.split("/")[-1]
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        tuned_model = AutoModelForCausalLM.from_pretrained(
            os.path.join(model_path, tuned_model_name)
        )
        return tuned_model

    elif model_type == "Vanilla Model":
        vanilla_model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)
        return vanilla_model

    elif model_type == "Transformed Model":
        name = host_model_name.split("/")[-1]
        save_path = os.path.join(model_path, f"{name}_preGRAFTED_{blocks_str}.pkl")
        with open(save_path, "rb") as f:
            transformed_model = pickle.load(f)
        return transformed_model

    elif model_type == "Final Model":
        name = host_model_name.split("/")[-1]
        model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
        save_path = os.path.join(model_path, model_save_name)
        with open(save_path, "rb") as f:
            final_model = pickle.load(f)
        return final_model

    elif model_type == "Host Model":
        host_model = AutoModelForCausalLM.from_pretrained(host_model_name)
        return host_model

    else:
        raise ValueError(f"Unknown model type: {model_type}")


def load_batch_losses(file_path):
    """
    Ładuje dane strat partii z pliku punktu kontrolnego.
    
    Parametry:
    file_path (str): Ścieżka do pliku punktu kontrolnego.
    
    Zwraca:
    list lub None: Straty partii, jeśli dostępne, w przeciwnym razie None.

    Optymalizacje:
    1. Użycie map_location=torch.device("cpu") już zapewnia poprawę wydajności przy braku GPU,
       zmniejszając obciążenie pamięci GPU.
    2. Dodano więcej szczegółowych logów aby łatwiej diagnozować problemy ładowania.
       (Kompromis: Więcej logów może nieznacznie obniżyć wydajność, ale przeważają korzyści diagnostyczne.)
    """
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"))
        batch_losses = checkpoint.get("batch_losses", None)
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None