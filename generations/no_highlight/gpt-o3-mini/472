from langchain_openai import ChatOpenAI
from langchain.prompts import PromptTemplate
from langchain.chains import LLMChain
from langchain_community.retrievers import BM25Retriever
from langchain.callbacks.base import BaseCallbackHandler
from langchain.callbacks.manager import CallbackManager
from os import getenv
from dotenv import load_dotenv
import streamlit as st
from streamlit_chat import message
import PyPDF2
import nltk
from nltk.tokenize import word_tokenize

load_dotenv()

st.title("♥ CardioRAG")

# Custom callback handler to stream tokens in the Streamlit app
class StreamlitCallbackHandler(BaseCallbackHandler):
    def __init__(self, placeholder):
        self.placeholder = placeholder
        self.response = ""
    
    def on_llm_new_token(self, token: str, **kwargs) -> None:
        self.response += token
        self.placeholder.markdown(self.response)

# Load the PDF and prepare the BM25 retriever (if not already in session_state)
if "retriever" not in st.session_state:
    st.text("Loading PDF...")
    prog_bar = st.progress(0)
    pdf_reader = PyPDF2.PdfReader(open("Moss and Adams 10e Vol 1 & 2.pdf", 'rb'))
    chunks = []
    for page_num in range(60, 600):
        prog_bar.progress((page_num - 60) / (600 - 60))
        text = pdf_reader.pages[page_num].extract_text()
        if text:  # ensure the page has text
            chunks.append(text)
    # Build the retriever with chunk texts and metadata about page numbers
    retriever = BM25Retriever.from_texts(
        chunks,
        metadatas=[{"page_num": p} for p in range(60, 60 + len(chunks))],
        preprocess_func=word_tokenize
    )
    st.session_state["retriever"] = retriever
st.text("Loaded PDF")

# Initialize the messages history if not already present
if "messages" not in st.session_state:
    st.session_state["messages"] = [
        {"role": "assistant", "content": "Hi, I'm a chatbot who has read the Moss & Adams Cardiology textbook. How can I help you?"}
    ]

# Password input form
if "password" not in st.session_state:
    with st.form("pw_input", clear_on_submit=True):
        password = st.text_input("Enter password", type="password")
        if st.form_submit_button("Submit"):
            if password == getenv("PASSWORD"):
                st.session_state["password"] = password
            else:
                st.error("Incorrect password")

# Chat input form
with st.form("chat_input", clear_on_submit=True):
    a, b = st.columns([4, 1])
    user_input = a.text_input(
        label="Question:",
        placeholder="What is the incidence of congenital heart disease?",
        label_visibility="collapsed",
    )
    b.form_submit_button("Send", use_container_width=True)

# Display previous chat messages
for i, msg in enumerate(st.session_state.messages):
    message(msg["content"], is_user=msg["role"] == "user", key=str(i))

# Process the user's message if input exists and the password is correct
if user_input and st.session_state.get("password"):
    st.session_state.messages.append({"role": "user", "content": user_input})
    message(user_input, is_user=True, key=str(len(st.session_state.messages) - 1))

    # Create a placeholder for streaming the assistant's reply
    response_placeholder = st.empty()
    
    # Create the language model with streaming enabled and attach the streaming callback
    handler = StreamlitCallbackHandler(response_placeholder)
    callback_manager = CallbackManager([handler])
    llm = ChatOpenAI(
        api_key=getenv("OPENROUTER_API_KEY"),
        base_url="https://openrouter.ai/api/v1",
        model_name="meta-llama/llama-3.2-3b-instruct",
        streaming=True,
        callback_manager=callback_manager,
    )
    
    # Retrieve relevant documents from the PDF using BM25 Retriever
    retriever = st.session_state["retriever"]
    docs = retriever.get_relevant_documents(user_input)
    DIVIDER = "-" * 10
    context = DIVIDER.join([f"Page {d.metadata['page_num']}: {d.page_content}" for d in docs])
    
    # Build the prompt template
    prompt = PromptTemplate(
        input_variables=["context", "question"],
        template="""You are a helpful AI assistant who has read the Moss & Adams Cardiology textbook. 
Use the following context to answer the question. If you don't know the answer, just say you don't know.

Context: {context}

Question: {question}

Answer:"""
    )
    
    # Create and run the LLM chain; tokens will stream to the callback handler
    chain = LLMChain(llm=llm, prompt=prompt)
    response = chain.run(context=context, question=user_input)
    
    # Save the full response in the session state and display it in the chat
    st.session_state['messages'].append({"role": "assistant", "content": response})
    message(response, key=str(len(st.session_state.messages) - 1))