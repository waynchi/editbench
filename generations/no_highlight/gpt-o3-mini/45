class Graph:
    def __init__(self):
        self.adjacency_list = {}

    def add_vertex(self, vertex):
        if vertex not in self.adjacency_list:
            self.adjacency_list[vertex] = []

    def add_edge(self, vertex1, vertex2):
        if vertex1 in self.adjacency_list and vertex2 in self.adjacency_list:
            # Add each vertex to the other's list if not already connected
            if vertex2 not in self.adjacency_list[vertex1]:
                self.adjacency_list[vertex1].append(vertex2)
            if vertex1 not in self.adjacency_list[vertex2]:
                self.adjacency_list[vertex2].append(vertex1)

    def __str__(self):
        return str(self.adjacency_list)

    def dfs(self, start_vertex, visited=None):
        """
        Depth-first Search from start_vertex.
        """
        if visited is None:
            visited = set()
        visited.add(start_vertex)
        print(start_vertex, end=' ')
        for neighbor in self.adjacency_list[start_vertex]:
            if neighbor not in visited:
                self.dfs(neighbor, visited)

    def bfs(self, start_vertex):
        """
        Breadth-first Search from start_vertex.
        """
        visited = set()
        queue = [start_vertex]
        visited.add(start_vertex)
        while queue:
            vertex = queue.pop(0)
            print(vertex, end=' ')
            for neighbor in self.adjacency_list[vertex]:
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append(neighbor)

if __name__ == '__main__':
    import unittest

    class TestGraph(unittest.TestCase):
        def setUp(self):
            self.graph = Graph()

        def test_add_vertex(self):
            self.graph.add_vertex('A')
            self.assertEqual(self.graph.adjacency_list, {'A': []})
            self.graph.add_vertex('B')
            self.assertEqual(self.graph.adjacency_list, {'A': [], 'B': []})
            # Adding a duplicate vertex should not modify the graph
            self.graph.add_vertex('A')
            self.assertEqual(self.graph.adjacency_list, {'A': [], 'B': []})

        def test_add_edge(self):
            self.graph.add_vertex('A')
            self.graph.add_vertex('B')
            self.graph.add_edge('A', 'B')
            self.assertEqual(self.graph.adjacency_list, {'A': ['B'], 'B': ['A']})
            # Adding an edge with non-existent vertex should not modify the graph
            self.graph.add_edge('A', 'C')
            self.assertEqual(self.graph.adjacency_list, {'A': ['B'], 'B': ['A']})
            # Both vertices do not exist scenario
            self.graph.add_edge('D', 'E')
            self.assertEqual(self.graph.adjacency_list, {'A': ['B'], 'B': ['A']})

        def test_dfs(self):
            self.graph.add_vertex('A')
            self.graph.add_vertex('B')
            self.graph.add_vertex('C')
            self.graph.add_edge('A', 'B')
            self.graph.add_edge('A', 'C')
            self.graph.add_edge('B', 'C')
            # Capture the DFS output
            import io
            from contextlib import redirect_stdout
            f = io.StringIO()
            with redirect_stdout(f):
                self.graph.dfs('A')
            output = f.getvalue().strip()
            # Check that "A" is printed first and all vertices appear in the result.
            self.assertTrue(output.startswith("A"))
            for vertex in ['A', 'B', 'C']:
                self.assertIn(vertex, output)

        def test_bfs(self):
            self.graph.add_vertex('A')
            self.graph.add_vertex('B')
            self.graph.add_vertex('C')
            self.graph.add_edge('A', 'B')
            self.graph.add_edge('A', 'C')
            self.graph.add_edge('B', 'C')
            # Capture the BFS output
            import io
            from contextlib import redirect_stdout
            f = io.StringIO()
            with redirect_stdout(f):
                self.graph.bfs('A')
            output = f.getvalue().strip()
            # Given the structure, BFS should print "A B C"
            self.assertEqual(output, "A B C")

    # Example usage outside of unit testing:
    g = Graph()
    g.add_vertex('A')
    g.add_vertex('B')
    g.add_vertex('C')
    g.add_edge('A', 'B')
    g.add_edge('A', 'C')
    g.add_edge('B', 'C')
    print("Graph adjacency list:", g)
    print("\nDFS starting from vertex 'A':")
    g.dfs('A')
    print("\n\nBFS starting from vertex 'A':")
    g.bfs('A')
    print("\n")
    
    unittest.main()