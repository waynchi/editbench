import pandas as pd

def create_column(df):
    # Initialize the 'Frequency' column with NaN or a default value
    df['Frequency'] = pd.NA
    
    # For rows where 'EventId' contains 'E16', set 'Frequency' to 117
    df.loc[df['EventId'].astype(str).str.contains('E16', na=False), 'Frequency'] = 117
    
    return df

if __name__ == '__main__':
    # Example usage
    data = {
        'EventId': ['E16', 'A12', 'E1600', 'B55', 'None', 'E16-XYZ']
    }
    df = pd.DataFrame(data)
    modified_df = create_column(df)
    print(modified_df)