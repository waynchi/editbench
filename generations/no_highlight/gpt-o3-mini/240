def is_prime(n):
    """
    Проверяет, является ли число n простым.
    
    Возвращает True, если n является простым числом, и False в противном случае.
    """
    # Проверка, что входное значение является целым числом
    if not isinstance(n, int):
        raise ValueError("Входное значение должно быть целым числом.")
    
    # Числа меньше или равные 1 не являются простыми
    if n <= 1:
        return False
    
    # 2 является простым числом
    if n == 2:
        return True
    
    # Отсекаем четные числа
    if n % 2 == 0:
        return False
    
    # Проверяем делители от 3 до квадратного корня из n с шагом 2 (только нечетные делители)
    i = 3
    while i * i <= n:
        if n % i == 0:
            return False
        i += 2
    return True

# Пример использования функции is_prime
if __name__ == "__main__":
    test_numbers = [0, 1, 2, 3, 16, 17, 18, 19, 20, 23]
    for number in test_numbers:
        print(f"{number} is prime? {is_prime(number)}")