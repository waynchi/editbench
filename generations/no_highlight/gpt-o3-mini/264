#!/usr/bin/env python3
"""
Числа, которые могут быть выражены как сумма четырех ненулевых квадратов

Этот скрипт находит все натуральные числа (до заданного ограничения), которые можно
представить в виде суммы четырех квадратов ненулевых целых чисел.
"""

import math

def numbers_as_sum_of_four_nonzero_squares(max_limit):
    """
    Находит все числа <= max_limit, которые можно представить в виде суммы четырех квадратов
    ненулевых целых чисел (т.е. 1^2, 2^2, 3^2, ...).
    
    Аргументы:
        max_limit (int): верхняя граница для чисел.
    
    Возвращает:
        sorted list: список подходящих чисел, отсортированных по возрастанию.
    """
    possible_numbers = set()
    
    # Наименьшее число, которое можем получить - 1^2+1^2+1^2+1^2 = 4.
    if max_limit < 4:
        return []
    
    # Определяем максимальное значение для квадратного корня, которое может участвовать.
    # Поскольку a^2, b^2, c^2, d^2 >= 1, максимальное значение для a (и аналогично для b, c, d)
    # можно ограничить так, что 4 * (a^2) <= max_limit, а значит a <= sqrt(max_limit/4).
    max_value = int(math.sqrt(max_limit / 4)) + 1

    # Перебор значений для четырех переменных a, b, c, d (начиная с 1, т.к. ноль не допускается).
    for a in range(1, max_value + 1):
        a2 = a * a
        for b in range(1, max_value + 1):
            b2 = b * b
            for c in range(1, max_value + 1):
                c2 = c * c
                for d in range(1, max_value + 1):
                    s = a2 + b2 + c2 + d * d
                    if s <= max_limit:
                        possible_numbers.add(s)
                    else:
                        # Так как d увеличивается, дальше сумма будет только расти.
                        break
    return sorted(possible_numbers)

def main():
    # Получаем от пользователя верхнюю границу max_limit.
    try:
        max_limit = int(input("Введите верхнюю границу (натуральное число >= 4): "))
        if max_limit < 4:
            print("Верхняя граница должна быть не меньше 4.")
            return
    except ValueError:
        print("Ошибка: введите корректное натуральное число.")
        return
    
    numbers = numbers_as_sum_of_four_nonzero_squares(max_limit)
    
    if not numbers:
        print("Нет чисел, удовлетворяющих условию в данном диапазоне.")
    else:
        print(f"Числа, которые могут быть выражены как сумма четырех ненулевых квадратов (<= {max_limit}):")
        print(numbers)

if __name__ == "__main__":
    main()