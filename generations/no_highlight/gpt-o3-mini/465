import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-8, max_iter=1000):
    """
    Función que implementa el método de gradientes conjugados para resolver el sistema Ax = b.
    
    Entradas:
      A       : Matriz simétrica definida positiva (numpy.ndarray).
      b       : Vector de términos independientes (numpy.ndarray).
      x0      : Aproximación inicial para la solución (numpy.ndarray). Si no se proporciona, se utiliza un vector de ceros.
      tol     : Tolerancia para el criterio de parada basado en la norma del residuo.
      max_iter: Número máximo de iteraciones permitidas.
    
    Salida:
      x       : Aproximación de la solución del sistema.
      i       : Número de iteraciones realizadas.
    """
    n = b.shape[0]
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    r = b - A @ x
    p = r.copy()
    rs_old = np.dot(r, r)
    
    for i in range(1, max_iter+1):
        Ap = A @ p
        alpha = rs_old / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        
        rs_new = np.dot(r, r)
        if np.sqrt(rs_new) < tol:
            # Se alcanza la convergencia.
            return x, i
        beta = rs_new / rs_old
        p = r + beta * p
        rs_old = rs_new

    return x, max_iter

if __name__ == "__main__":
    # Ejemplo de uso:
    # Definimos una matriz simétrica definida positiva A y un vector b.
    A = np.array([[4, 1], [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # Llamamos a la función de gradientes conjugados.
    x_sol, iterations = conjugate_gradient(A, b, tol=1e-8, max_iter=1000)
    
    print("La solución aproximada es:")
    print(x_sol)
    print(f"Número de iteraciones: {iterations}")
    
    # Verificar la solución:
    print("Verificación (Ax):")
    print(np.dot(A, x_sol))
    print("Vector b:")
    print(b)