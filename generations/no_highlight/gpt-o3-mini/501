import numpy as np

def fit_line(x, y, increase_factor=1.5):
    """
    Ajusta una línea recta a un conjunto de datos y aumenta el valor
    de la desviación máxima obtenida en el ajuste.

    Parámetros:
      x: array de valores en X.
      y: array de valores en Y.
      increase_factor: factor por el cual se aumenta la desviación máxima (valor por defecto 1.5).

    Retorna:
      slope: pendiente de la línea ajustada.
      intercept: intersección de la línea ajustada.
      max_deviation: desviación máxima aumentada del ajuste.
    """
    # Calcular el valor medio de x e y
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # Calcular la desviación de x e y
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # Calcular el producto de las desviaciones
    xy_dev = x_dev * y_dev
    
    # Calcular el cuadrado de la desviación de x
    x_dev_squared = x_dev ** 2
    
    # Calcular la pendiente y la intersección
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean
    
    # Calcular los residuos y la desviación máxima
    y_fit = slope * x + intercept
    max_deviation = np.max(np.abs(y - y_fit))
    max_deviation *= increase_factor  # Aumentar el valor de la desviación máxima
    
    return slope, intercept, max_deviation

def fit_quadratic(x, y, increase_factor=1.5):
    """
    Ajusta una curva cuadrática a un arreglo de datos y aumenta el valor
    de la desviación máxima obtenida en el ajuste.

    Parámetros:
      x: array de valores en X.
      y: array de valores en Y.
      increase_factor: factor por el cual se aumenta la desviación máxima (valor por defecto 1.5).

    Retorna:
      coeffs: coeficientes del polinomio cuadrático [a, b, c] tal que
              y = a*x^2 + b*x + c.
      max_deviation: desviación máxima aumentada del ajuste.
    """
    # Crear la matriz de Vandermonde para un polinomio de grado 2
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # Resolver el sistema usando mínimos cuadrados
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    # Calcular los valores ajustados y la desviación máxima
    y_fit = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    max_deviation = np.max(np.abs(y - y_fit))
    max_deviation *= increase_factor  # Aumentar el valor de la desviación máxima
    
    return coeffs, max_deviation