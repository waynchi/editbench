import aiohttp
import aiofiles
import asyncio
import xml.etree.ElementTree as ET
import matplotlib.pyplot as plt
import pandas as pd
import datetime
import pickle
import json

class ticker:
    """
    Stock ticker and everything related to it, through MoexApi (Asynchronous Version)
    
    Required libraries:
      aiohttp
      aiofiles
      xml.etree.ElementTree
      matplotlib.pyplot as plt
      pandas
      datetime
      pickle
      json
      asyncio
    """
    def __init__(self, name: str):
        """
        self.name - ticker name
        self.tech_dict - technical analysis dictionary
        """
        self.name = name
        self.tech_dict = {"value": {"use": False, "has_periods": False, "need_graph_space": True},
                          "sma": {"use": False, "has_periods": True, "periods": [], "need_graph_space": False},
                          "ema": {"use": False, "has_periods": True, "periods": [], "need_graph_space": False}
                         }
    
    # Helper methods to perform pickle operations in a thread
    @staticmethod
    def _load_pickle(path):
        with open(path, "rb") as f:
            return pickle.load(f)
    
    @staticmethod
    def _dump_pickle(obj, path):
        with open(path, "wb") as f:
            pickle.dump(obj, f)

    async def correct_name(self):
        """
        Checking the ticker name for presence in the set of tickers.
        The set is updated no more than once a day.
        """
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        tickers_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_tickers.bin"
        
        # Read the Info.json file asynchronously
        async with aiofiles.open(info_path, "r", encoding="utf-8") as f:
            info_content = await f.read()
        info = json.loads(info_content)
        last_check = datetime.datetime.strptime(info["last_day_check"]["ticker"], "%Y-%m-%d %H:%M:%S.%f")
        
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check:
            # Update the ticker set if the last update was over a day ago
            set_tickers = set()
            url = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities.xml?iss.meta=off"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    content = await response.read()
            root = ET.fromstring(content)
            for data in root.findall("data"):
                if data.get("id") == "securities":
                    rows = data.find("rows")
                    for row in rows.findall("row"):
                        set_tickers.add(row.get("SECID"))
            # Write the new set to the pickle file using a thread
            await asyncio.to_thread(self._dump_pickle, set_tickers, tickers_path)
            # Update the last update time in Info.json and write it back asynchronously
            info["last_day_check"]["ticker"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, "w", encoding="utf-8") as f:
                await f.write(json.dumps(info, indent=3, ensure_ascii=False))
        
        # Load the ticker set from file (using a thread)
        set_tickers = await asyncio.to_thread(self._load_pickle, tickers_path)
        return self.name in set_tickers

    async def CurrentPrice(self):
        """
        Current price for this ticker
        """
        url = "https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/" + self.name + ".xml?iss.meta=off"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = ET.fromstring(content)
        for data in root.findall("data"):
            if data.get("id") == "marketdata":
                rows = data.find("rows")
                row = rows.find("row")
                return row.get("LAST")
        return None

    async def candles(self, candles_name: str, timeframe: str, start: str, end: str):
        """
        List of candles for this ticker

        candles_name - necessary component of candles: open, close, high, low, value, volume, begin, end
        
        timeframe - timeframe: 1 - 1 min, 10 - 10 min, 60 - 1h, 24 - 1d, 7 - 1w, 31 - 1m, 4 - 4m
        
        start, end - start and end of the period, format YYYY-MM-DD HH:MM:SS
        """
        url = ("https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/" +
               self.name + f"/candles.xml?iss.meta=off&interval={timeframe}&till={end}&from={start}")
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = ET.fromstring(content)
        candles_elem = root.find("data")
        rows = candles_elem.find("rows")
        listcandles = []
        if candles_name in ["begin", "end"]:
            for row in rows.findall("row"):
                datetime_str = row.get(candles_name)
                # Parse the API datetime string manually
                dt = datetime.datetime(int(datetime_str[0:4]), int(datetime_str[5:7]), int(datetime_str[8:10]),
                                        int(datetime_str[11:13]), int(datetime_str[14:16]), int(datetime_str[17:]))
                listcandles.append(dt)
        else:
            for row in rows.findall("row"):
                listcandles.append(float(row.get(candles_name)))
        return listcandles

    async def setattr_candles_dataframe(self, timeframe="24", start="", end=""):
        """
        Creates a dataframe of candles with the corresponding timeframe, start, and end 
        and stores it in self.candles_dataframe.
        """
        open_vals = await self.candles("open", timeframe, start, end)
        close_vals = await self.candles("close", timeframe, start, end)
        high_vals = await self.candles("high", timeframe, start, end)
        low_vals = await self.candles("low", timeframe, start, end)
        value_vals = await self.candles("value", timeframe, start, end)
        begin_vals = await self.candles("begin", timeframe, start, end)
        candles_dataframe = pd.DataFrame({"open": open_vals,
                                          "close": close_vals,
                                          "high": high_vals,
                                          "low": low_vals,
                                          "value": value_vals,
                                          "begin": begin_vals})
        setattr(self, "candles_dataframe", candles_dataframe)

    async def graphic(self, timeframe="24", start="", end=""):
        """
        Returns an open candlestick price chart from the specified time.

        timeframe - timeframe: 1, 10, 60, 24, 7, 31, 4 (see candles method)
        start, end - period in format YYYY-MM-DD HH:MM:SS

        Technical analysis options (sma, ema, value) are used based on self.tech_dict.
        """
        await self.setattr_candles_dataframe(timeframe, start, end)
        # Create sub-dataframes for up and down candles
        up = self.candles_dataframe[self.candles_dataframe.close >= self.candles_dataframe.open]
        down = self.candles_dataframe[self.candles_dataframe.close < self.candles_dataframe.open]
        self.up = up
        self.down = down
        
        # Determine candle width based on timeframe
        if timeframe == "1":
            width_big = 1 / 24 / 60
        elif timeframe == "10":
            width_big = 1 / 24 / 6
        elif timeframe == "60":
            width_big = 1 / 24
        elif timeframe == "24":
            width_big = 1
        elif timeframe == "7":
            width_big = 7
        elif timeframe == "31":
            width_big = 30
        elif timeframe == "4":
            width_big = 90
        else:
            width_big = 0  # This should ideally not happen
        width_small = width_big / 10
        setattr(self, "width_big", width_big)
        
        # Count how many technical analysis tools require additional graph space.
        number_of_additional_graphics = 0
        for tech in self.tech_dict:
            if self.tech_dict[tech]["use"] and self.tech_dict[tech]["need_graph_space"]:
                number_of_additional_graphics += 1

        # Build the chart with the required additional subplots if needed.
        if number_of_additional_graphics != 0:
            height_ratios_list = [10 - number_of_additional_graphics] + [1] * number_of_additional_graphics
            fig, axs = plt.subplots(nrows=1 + number_of_additional_graphics, ncols=1, sharex=True, height_ratios=height_ratios_list)
            plt.suptitle(self.name, fontsize=15)
            axs[0].grid(True)
            # Plot up candles
            axs[0].bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
            axs[0].bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
            axs[0].bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
            # Plot down candles
            axs[0].bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
            axs[0].bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
            axs[0].bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")
            
            tech_index = 0
            for tech in self.tech_dict:
                if self.tech_dict[tech]["use"]:
                    tech_func = getattr(self, tech)
                    if not self.tech_dict[tech]["need_graph_space"]:
                        tech_func(axs[0])
                    else:
                        axs[tech_index + 1].grid(True)
                        tech_func(axs[tech_index + 1])
                        tech_index += 1
        else:
            fig = plt.figure()
            plt.title(self.name, fontsize=15)
            ax = fig.add_subplot()
            ax.grid(True)
            # Plot up candles
            ax.bar(x=up.begin, height=up.close - up.open, width=width_big, bottom=up.open, color="green")
            ax.bar(x=up.begin, height=up.high - up.close, width=width_small, bottom=up.close, color="green")
            ax.bar(x=up.begin, height=up.open - up.low, width=width_small, bottom=up.low, color="green")
            # Plot down candles
            ax.bar(x=down.begin, height=down.open - down.close, width=width_big, bottom=down.close, color="red")
            ax.bar(x=down.begin, height=down.high - down.open, width=width_small, bottom=down.open, color="red")
            ax.bar(x=down.begin, height=down.close - down.low, width=width_small, bottom=down.low, color="red")
            for tech in self.tech_dict:
                if self.tech_dict[tech]["use"]:
                    tech_func = getattr(self, tech)
                    tech_func(ax)
        
        # Save the figure as an image file (synchronously)
        fig.savefig(r"D:\Python files\!MoexApiBot\graphic.png")
        # Read the image file asynchronously and return its binary content
        async with aiofiles.open(r"D:\Python files\!MoexApiBot\graphic.png", "rb") as f:
            graphic_bytes = await f.read()
        return graphic_bytes

    def sma(self, ax):
        """
        Simple Moving Average technical analysis tool.
        Plots the SMA for all specified periods in self.tech_dict["sma"]["periods"].
        """
        for period in self.tech_dict["sma"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                sma_list = []
                sma_list.append(sum(self.candles_dataframe.close[0: period]) / period)
                for i in range(period, len(self.candles_dataframe.begin)):
                    sma_list.append(sma_list[i - period] + (self.candles_dataframe.close[i] - self.candles_dataframe.close[i - period]) / period)
                ax.plot(self.candles_dataframe.begin[period - 1:], sma_list)

    def ema(self, ax):
        """
        Exponential Moving Average technical analysis tool.
        Plots the EMA for all specified periods in self.tech_dict["ema"]["periods"].
        """
        for period in self.tech_dict["ema"]["periods"]:
            if period <= len(self.candles_dataframe.begin):
                ema_list = []
                ema_list.append(sum(self.candles_dataframe.close[0: period]) / period)
                for i in range(period, len(self.candles_dataframe.begin)):
                    ema_list.append(((period - 1) * ema_list[i - period] + 2 * self.candles_dataframe.close[i]) / (period + 1))
                ax.plot(self.candles_dataframe.begin[period - 1:], ema_list)

    def value(self, ax):
        """
        Plots the 'value' technical analysis as a bar chart.
        """
        ax.bar(x=self.up.begin, height=self.up.value, width=self.width_big, color="green")
        ax.bar(x=self.down.begin, height=self.down.value, width=self.width_big, color="red")
        ax.set_title("Value", fontsize=7)

