class Token:
    start: int
    end: int

class IntegerToken(Token):
    value: int

    def is_digit(input: str, start_pos) -> bool:
        '''Returns True if the input at start_pos is a valid digit, otherwise returns False'''
        return input[start_pos].isdigit()
    
    def is_int(input: str, start_pos) -> int:
        max_pos = len(input)
        current_pos = start_pos
        digit_found = False

        while current_pos < max_pos:
            if not IntegerToken.is_digit(input, current_pos):
                break
            digit_found = True
            current_pos += 1

        if not digit_found:
            raise ValueError("Not an integer")
        return current_pos

