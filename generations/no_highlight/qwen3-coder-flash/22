# [2379] Minimum Recolors to Get K Consecutive Black Blocks
#

# @lc code=start
class Solution:
    def minimumRecolors(self, blocks: str, k: int) -> int:
        # Sliding window approach
        # Find the window of size k with minimum number of 'W's
        # This will be the minimum operations needed
        
        min_operations = k  # Initialize with maximum possible operations
        window_w_count = 0
        
        # Count W's in the first window
        for i in range(k):
            if blocks[i] == 'W':
                window_w_count += 1
        
        min_operations = min(min_operations, window_w_count)
        
        # Slide the window through the rest of the string
        for i in range(1, len(blocks) - k + 1):
            # Remove the leftmost element of previous window
            if blocks[i - 1] == 'W':
                window_w_count -= 1
            
            # Add the rightmost element of current window
            if blocks[i + k - 1] == 'W':
                window_w_count += 1
            
            min_operations = min(min_operations, window_w_count)
        
        return min_operations
        
# @lc code=end