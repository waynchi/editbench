from main13 import knn, mlp
import pandas as pd
import numpy as np

# Create empty DataFrame to store results
np_df = pd.DataFrame(index=range(10, 200, 10), columns=[1, 2, 3])

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        my_df = pd.DataFrame({
            "Pclass": [pclass]*3,
            "Name": [24]*3,
            "Sex": [0]*3, 
            "Age": [19]*3,
            "SibSp": [0]*3,
            "Parch": [0]*3,
            "Fare": [fare]*3,
            "Embarked": ["S", "Q", "C"]
        })
        my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
        
        # Fix the mapping for one-hot encoded columns
        my_df["Embarked_S"] = my_df["Embarked_S"].map({True: 1, False: 0})
        my_df["Embarked_C"] = my_df["Embarked_C"].map({True: 1, False: 0})
        my_df["Embarked_Q"] = my_df["Embarked_Q"].map({True: 1, False: 0})

        # Make predictions and store them
        knn_pred = knn.predict(my_df)
        mlp_pred = mlp.predict(my_df)
        
        # Store predictions in the DataFrame using .loc
        np_df.loc[fare, pclass] = {"knn": knn_pred, "mlp": mlp_pred}

print(np_df)