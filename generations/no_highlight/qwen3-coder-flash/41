from pyspark.sql import SparkSession
from pyspark.sql.functions import col
import requests
import json

# Crear una sesión Spark
spark = SparkSession.builder.appName("EscrituraParquetADL2").getOrCreate()

# Primero analizamos los datos provenientes de la API
# Reemplaza esta URL con la URL real de tu API
api_url = "https://api.ejemplo.com/datos"  # Cambiar por la URL real

try:
    # Hacer la llamada a la API
    response = requests.get(api_url)
    response.raise_for_status()  # Lanza una excepción para códigos de error
    
    # Procesar los datos de la API
    api_data = response.json()
    
    # Analizar la estructura de los datos
    print("Estructura de los datos de la API:")
    print(json.dumps(api_data, indent=2, default=str))
    
    # Si los datos son una lista de diccionarios, usamos directamente los datos
    # Si no, deberás adaptar según la estructura real de tu API
    if isinstance(api_data, list):
        data = api_data
    else:
        # Si la respuesta tiene una estructura como {"data": [...]}
        # Ajusta según la estructura real de tu API
        data = api_data.get('data', [api_data])
        
    print(f"\nNúmero de registros obtenidos: {len(data)}")
    
    if data:
        print("\nEjemplo de primer registro:")
        print(json.dumps(data[0], indent=2, default=str))
        
        # Verificar las claves del primer registro para entender la estructura
        print(f"\nClaves del registro: {list(data[0].keys())}")
    
except requests.exceptions.RequestException as e:
    print(f"Error al obtener datos de la API: {e}")
    # Fallback a datos de ejemplo si hay error
    data = [
        {"id": 1, "nombre": "Juan", "edad": 30},
        {"id": 2, "nombre": "Ana", "edad": 25},
        {"id": 3, "nombre": "Pedro", "edad": 40}
    ]
    print("Usando datos de fallback")

# Crear un DataFrame a partir de los datos
df = spark.createDataFrame(data)

# Mostrar información básica del DataFrame
print("\nInformación del DataFrame:")
df.printSchema()
print(f"\nCantidad de registros: {df.count()}")

# Mostrar primeras filas para ver los datos
print("\nPrimeras filas del DataFrame:")
df.show(5)

# Configurar la conexión a ADL2 usando la identidad de Microsoft ID
# No es necesario proporcionar credenciales explícitamente en un notebook de Synapse
# Spark utilizará la identidad administrada del notebook para autenticarse.

# Especificar la ruta al contenedor y la carpeta en ADL2
container_name = "<your_container_name>"  # Reemplazar con el nombre de tu contenedor
folder_path = "<your_folder_path>"  # Reemplazar con la ruta a la carpeta dentro del contenedor
adl2_path = f"abfss://{container_name}@<your_storage_account_name>.dfs.core.windows.net/{folder_path}"

# Escribir el DataFrame en formato parquet en ADL2
df.coalesce(1).write.mode("overwrite").parquet(adl2_path)

# Opcional: leer el archivo parquet para verificar
df_leido = spark.read.parquet(adl2_path)
print("\nVerificación - Datos leídos desde ADL2:")
df_leido.show()

# Detener la sesión Spark
spark.stop()