def construir_diccionario_jerarquico(posts_generator):
    """
    Construye un diccionario jerárquico con los posts y sus respuestas
    """
    diccionario_jerarquico = {}
    
    for i, post in enumerate(posts_generator):
        post_author = post['author']
        post_permlink = post['permlink']
        post_replies = post['children']
        
        # Crear entrada para el post
        diccionario_jerarquico[f"{post_author}/{post_permlink}"] = {
            "post": {
                "author": post_author,
                "permlink": post_permlink,
                "replies_count": post_replies
            },
            "replies": {}
        }
        
        # Procesar las respuestas si hay suficientes
        if post_replies > n_respuestas_minimas:
            comment = Comment(authorperm=f"{post_author}/{post_permlink}")
            post_replies_list = comment.get_replies()
            
            # Extraer información de las respuestas
            for reply in post_replies_list:
                reply_author = reply['author']
                reply_permlink = reply['permlink']
                reply_body = reply['body']
                
                # Agregar respuesta al diccionario jerárquico
                diccionario_jerarquico[f"{post_author}/{post_permlink}"]["replies"][f"{reply_author}/{reply_permlink}"] = {
                    "author": reply_author,
                    "permlink": reply_permlink,
                    "body": reply_body
                }
    
    return diccionario_jerarquico

