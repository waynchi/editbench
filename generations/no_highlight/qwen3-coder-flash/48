import requests


def registerKey(key: str, user: str):
    print(f'chave: {key}\nnome: {user}')
    try:
        response = requests.post(f'http://127.0.0.1:5000/register', json={'key': key, 'user': user})

        if response.status_code == 200:
            try:
                response_data = response.json()
                if response_data.get('valid'):
                    return True
            except ValueError:
                # If response is not JSON, check if it's valid based on other criteria
                return True

        return False

    except requests.RequestException as e:
        print(f"Erro de conexão: {e}")
        return False