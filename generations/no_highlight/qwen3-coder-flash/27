from langchain_ollama.chat_models import ChatOllama
from langchain_core.prompts import PromptTemplate
import json

# Load SHAP values from JSON file
with open("Vuori_Final_Approval_2024_09_24.json", "r") as file:
    shap_values_json = json.load(file).get("shap_values")

# Load system prompt from file
with open("system.prompt", "r") as file:
    sys_prompt = file.read().strip()

# Create the prompt template
prompt_template = PromptTemplate.from_template(
    "{shap_values}\n\n"
)

# Format the prompt with SHAP values
formatted_prompt = prompt_template.format(shap_values=shap_values_json)

# Initialize the ChatOllama model
chat_model = ChatOllama(
    model="llama3.2",
    temperature=0.7,
    base_url="http://localhost:11434"
)

# Prepare messages for the chat
messages = [
    ("system", sys_prompt),
    ("human", formatted_prompt),
]

# Get response from the model
response = chat_model.invoke(messages)
print(response.content)