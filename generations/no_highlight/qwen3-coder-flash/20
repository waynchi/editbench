import numpy as np

INPUT_FILE_PATH = './input.txt'
# INPUT_FILE_PATH = './example_in.txt'

def main():
    lines = parse_input_file()
    
    # Parse input into two lists
    list_1 = []
    list_2 = []
    
    for line in lines:
        if line.strip():  # Skip empty lines
            parts = line.split()
            if len(parts) >= 2:
                list_1.append(int(parts[0]))
                list_2.append(int(parts[1]))
    
    # Sort both lists
    sorted_list_1 = sorted(list_1)
    sorted_list_2 = sorted(list_2)
    
    # Calculate total distance using sorted lists
    total_distance = sum(abs(a - b) for a, b in zip(sorted_list_1, sorted_list_2))
    
    print(f"Total distance: {total_distance}")

def parse_input_file():
    """Parse input file and return lines as list"""
    try:
        with open(INPUT_FILE_PATH, 'r') as f:
            lines = f.read().splitlines()  # Use splitlines() to handle different line endings
        return lines
    except FileNotFoundError:
        print(f"Error: File '{INPUT_FILE_PATH}' not found.")
        return []
    except Exception as e:
        print(f"Error reading file: {e}")
        return []

if __name__ == "__main__":
    main()