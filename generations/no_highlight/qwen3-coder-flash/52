from main13 import knn, mlp
import pandas as pd

# Создаем список всех комбинаций параметров
pclasses = [1, 2, 3]
fares = range(10, 200, 10)
embarked_options = ["S", "Q", "C"]

# Запускаем циклы для всех комбинаций параметров
for pclass in pclasses:
    for fare in fares:
        for embarked in embarked_options:
            # Создаем DataFrame с нужными значениями
            my_df = pd.DataFrame({
                "Pclass": [pclass],
                "Name": [24],
                "Sex": [0], 
                "Age": [19],
                "SibSp": [0],
                "Parch": [0],
                "Fare": [fare],
                "Embarked": [embarked]
            })
            
            # Применяем one-hot encoding для столбца Embarked
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
            
            # Убеждаемся, что все колонки Embarked присутствуют
            for emb in ["Embarked_S", "Embarked_C", "Embarked_Q"]:
                if emb not in my_df.columns:
                    my_df[emb] = 0
            
            # Преобразуем булевые значения в числовые
            my_df["Embarked_S"] = my_df["Embarked_S"].astype(int)
            my_df["Embarked_C"] = my_df["Embarked_C"].astype(int)
            my_df["Embarked_Q"] = my_df["Embarked_Q"].astype(int)
            
            # Делаем предсказания
            try:
                knn_pred = knn.predict(my_df)
                mlp_pred = mlp.predict(my_df)
                
                print(f"""-------------------------------------------------------
Параметры: класс {pclass}, плата {fare}, embarked {embarked}
По knn: {knn_pred}
По mlp: {mlp_pred}""")
            except Exception as e:
                print(f"Ошибка при обработке параметров {pclass}, {fare}, {embarked}: {e}")