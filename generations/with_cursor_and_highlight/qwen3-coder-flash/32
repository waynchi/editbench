def construir_diccionario_jerarquico(posts_generator):
    """
    Construye un diccionario jerárquico de posts y sus replies
    """
    diccionario_jerarquico = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_replies = post['children']
        
        # Creamos la estructura del post
        post_key = f"{post_author}/{post_permlink}"
        diccionario_jerarquico[post_key] = {
            'author': post_author,
            'permlink': post_permlink,
            'replies': {}
        }
        
        if post_replies > n_respuestas_minimas:
            comment = Comment(authorperm=f"{post_author}/{post_permlink}")
            replies_list = comment.get_replies()
            
            # Añadimos los replies al diccionario jerárquico
            for reply in replies_list:
                reply_author = reply['author']
                reply_permlink = reply['permlink']
                reply_body = reply['body']
                
                # Solo procesamos si no es el autor propio ni estábaneado
                if not is_own_author(reply_author) and not is_banned(reply_author):
                    # Almacenamos los datos del reply
                    diccionario_jerarquico[post_key]['replies'][reply_permlink] = {
                        'author': reply_author,
                        'body': reply_body,
                        'is_count_me': procesar(reply_body)
                    }
    
    return diccionario_jerarquico

