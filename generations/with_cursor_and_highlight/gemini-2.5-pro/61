# Напиши get_task_list для получения списка имен *.xml файлов из папки settings['taskPath']. 
# В первой строке каждого файла опционально записана строка : <!-- comment -->
# Ответ представь в формате списка объектов {fileName, comment, file_date_str}
@eel.expose
def get_task_list(settings):
    path = settings.get('taskPath')
    if not path or not os.path.isdir(path):
        print(f"Ошибка: Путь к задачам '{path}' не является действительным каталогом или не указан.")
        return []

    task_list = []
    try:
        # Get a list of all .xml files in the directory
        xml_files = [f for f in os.listdir(path) if f.endswith('.xml')]
        
        for file_name in xml_files:
            full_path = os.path.join(path, file_name)
            comment = ""
            file_date_str = ""

            try:
                # Get the file's modification date and format it as a string
                mod_time = os.path.getmtime(full_path)
                file_date_str = datetime.fromtimestamp(mod_time).strftime('%d.%m.%Y %H:%M')

                # Read the first line to find an optional comment
                with open(full_path, 'r', encoding='utf-8') as f:
                    first_line = f.readline().strip()
                    # Use a regular expression to extract the comment from <!-- comment -->
                    match = re.match(r'<!--\s*(.*?)\s*-->', first_line)
                    if match:
                        comment = match.group(1).strip()
            
            except Exception as e:
                print(f"Ошибка при обработке файла '{file_name}': {e}")

            # Add the object to the list
            task_list.append({
                "fileName": file_name,
                "comment": comment,
                "file_date_str": file_date_str
            })
            
        return task_list
    except Exception as e:
        print(f"Ошибка при получении списка задач из '{path}': {e}")
        return []


