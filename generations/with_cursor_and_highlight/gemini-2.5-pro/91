import os
# import hashlib
# import base64

project_name = "CheckerKMV"


def createLicense(secretKey: str) -> None:
    # The error is that you are trying to write a string (str) to a file
    # opened in binary write mode ('wb'), which expects bytes.
    # The string must be encoded to bytes before writing.

    # Path to the project folder in %APPDATA%
    appdata_path = os.path.join(os.environ["APPDATA"], project_name)

    # More robustly create the directory if it doesn't exist
    os.makedirs(appdata_path, exist_ok=True)

    with open(os.path.join(appdata_path, "license.dat"), "wb") as f:
        # Encode the string to bytes using UTF-8 before writing
        f.write(secretKey.encode("utf-8"))
