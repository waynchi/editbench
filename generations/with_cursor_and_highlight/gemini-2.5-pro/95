import random
import logging
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.common.exceptions import NoSuchElementException, WebDriverException, StaleElementReferenceException
import time

class SearchModule:
    def __init__(self, driver, config):
        self.driver = driver
        self.config = config
        self.search_engine = config.get('Search', 'search_engine')
        self.queries = [q.strip() for q in config.get('Search', 'queries').split(',')]
        self.random_query = config.getboolean('Search', 'random_query')

    def perform_search(self):
        try:
            if not self.queries:
                logging.warning("Query list is empty. Skipping search.")
                return
            query = random.choice(self.queries) if self.random_query else self.queries[0]
            logging.info(f"Performing search with query: {query}")

            search_engine_lower = self.search_engine.lower()
            if search_engine_lower == 'google':
                self.driver.get("https://www.google.com")
                search_box = self.driver.find_element(By.NAME, "q")
            elif search_engine_lower == 'yandex':
                self.driver.get("https://ya.ru")
                search_box = self.driver.find_element(By.CSS_SELECTOR, 'input[placeholder="Найдётся всё"]')
            elif search_engine_lower == 'bing':
                self.driver.get("https://www.bing.com")
                search_box = self.driver.find_element(By.NAME, "q")
            else:
                logging.error(f"Unsupported search engine: {self.search_engine}")
                return

            search_box.send_keys(query + Keys.RETURN)
            time.sleep(random.uniform(2, 4))  # Ожидание загрузки результатов
        except NoSuchElementException:
            logging.error(f"Could not find the search box element for {self.search_engine}. The site's layout may have changed.")
        except WebDriverException as e:
            logging.error(f"A WebDriver error occurred during the search: {e}")
        except Exception as e:
            logging.error(f"An unexpected error occurred during perform_search: {e}")

    def navigate_random_link(self):
        logging.info("Navigating to a random search result link.")
        try:
            search_engine_lower = self.search_engine.lower()
            if search_engine_lower == 'google':
                links = self.driver.find_elements(By.CSS_SELECTOR, 'div.yuRUbf > a')
            elif search_engine_lower == 'yandex':
                links = self.driver.find_elements(By.CSS_SELECTOR, 'a.link')
            elif search_engine_lower == 'bing':
                links = self.driver.find_elements(By.CSS_SELECTOR, 'li.b_algo h2 a')
            else:
                logging.error(f"Unsupported search engine for navigation: {self.search_engine}")
                return

            if not links:
                logging.warning("No links found on the search results page.")
                return

            random_link = random.choice(links)
            href = random_link.get_attribute('href')
            
            if not href:
                logging.warning("Found a link element with no href attribute. Skipping.")
                return

            logging.info(f"Navigating to: {href}")
            self.driver.get(href)
            time.sleep(random.uniform(3, 6))  # Ожидание загрузки страницы
        except StaleElementReferenceException:
            logging.warning("A link on the results page became stale. Skipping navigation for this search.")
        except WebDriverException as e:
            logging.error(f"A WebDriver error occurred while navigating to a result link: {e}")
        except Exception as e:
            logging.error(f"An unexpected error occurred during navigate_random_link: {e}")