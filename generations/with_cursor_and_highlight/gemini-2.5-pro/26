import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-5, max_iter=1000):
    """
    Решает систему линейных уравнений Ax = b с помощью метода сопряжённых градиентов.

    Метод применим только для симметричных положительно-определённых матриц A.

    Аргументы:
    A : np.ndarray
        Симметричная положительно-определённая матрица коэффициентов (n x n).
    b : np.ndarray
        Вектор правой части (размер n).
    x0 : np.ndarray, optional
        Начальное приближение для решения. Если None, используется нулевой вектор.
    tol : float, optional
        Допустимая погрешność для нормы невязки, используется как критерий остановки.
    max_iter : int, optional
        Максимальное количество итераций.

    Возвращает:
    x : np.ndarray
        Приближенное решение системы.
    """
    n = len(b)

    # Инициализация начального приближения
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    # Начальные значения
    r = b - A @ x  # Невязка (residual)
    p = r.copy()   # Направление поиска (search direction)
    rs_old = np.dot(r, r)

    if np.sqrt(rs_old) < tol:
        print("Начальное приближение уже удовлетворяет условию сходимости.")
        return x

    for i in range(max_iter):
        Ap = A @ p
        alpha = rs_old / np.dot(p, Ap)

        # Обновление решения и невязки
        x = x + alpha * p
        r = r - alpha * Ap

        rs_new = np.dot(r, r)

        # Проверка сходимости
        if np a.sqrt(rs_new) < tol:
            # print(f"Сходимость достигнута на итерации {i+1}.")
            break

        # Обновление направления поиска
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new
    else: # Этот блок выполняется, если цикл завершился без 'break'
        print(f"Решение не сошлось за {max_iter} итераций.")

    return x

# Пример использования:
if __name__ == '__main__':
    # Создадим симметричную положительно-определённую матрицу A
    A = np.array([[4.0, 1.0],
                  [1.0, 3.0]])

    # Создадим вектор b
    b = np.array([1.0, 2.0])

    # Начальное приближение (можно не указывать)
    x0 = np.array([0.0, 0.0])

    # Найдём точное решение для сравнения
    try:
        x_exact = np.linalg.solve(A, b)
        print(f"Точное решение (numpy.linalg.solve): {x_exact}")
    except np.linalg.LinAlgError as e:
        print(f"Не удалось найти точное решение: {e}")

    # Решим систему с помощью метода сопряжённых градиентов
    x_cg = conjugate_gradient(A, b, x0=x0)
    print(f"Решение методом сопряжённых градиентов: {x_cg}")

    # Проверим невязку для полученного решения
    residual_norm = np.linalg.norm(A @ x_cg - b)
    print(f"Норма невязки ||Ax - b||: {residual_norm}")