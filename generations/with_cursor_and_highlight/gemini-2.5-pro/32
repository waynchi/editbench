def crear_diccionario_jerarquico(posts):
    """
    Crea un diccionario jerárquico a partir de una lista de posts.
    La clave principal es el authorperm del post.
    El valor es una lista de los comentarios que cumplen las condiciones.
    """
    estructura_posts = {}
    X = 0
    for post in posts:
        X += 1
        # print(f"Procesando post {X}...", end='\r')
        post_author = post['author']
        post_permlink = post['permlink']
        post_authorperm = f"{post_author}/{post_permlink}"
        
        # Procesar solo si el post tiene un número mínimo de respuestas
        if post['children'] > n_respuestas_minimas:
            try:
                comment = Comment(authorperm=post_authorperm)
                post_replies = comment.get_replies()
            except Exception as e:
                # En caso de error al obtener replies (p.e. post no encontrado), saltar al siguiente.
                continue

            respuestas_validas = []
            ya_he_respondido = False
            for reply in post_replies:
                author_reply = reply['author']
                
                # Si encuentro mi propio comentario, dejo de procesar este post
                if is_own_author(author_reply):
                    ya_he_respondido = True
                    break
                
                # Ignorar comentarios de usuarios baneados
                if is_banned(author_reply):
                    continue
                
                # Si el comentario cumple la condición, lo añado a la lista
                if procesar(reply['body']):
                    # Se guarda el comentario como un diccionario para facilitar el manejo
                    respuestas_validas.append(reply.json)

            # Si no he respondido y encontré respuestas válidas, las guardo en la estructura
            if not ya_he_respondido and respuestas_validas:
                estructura_posts[post_authorperm] = respuestas_validas
                
    # print("\n") # Salto de línea para la siguiente impresión
    return estructura_posts

