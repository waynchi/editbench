from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd # Assuming pandas is used for the DataFrame

def cluster_data(features_transformed, cluster_definitions, n_clusters=2, clustering_method='kmeans'):
    """
    Выполняет кластеризацию данных независимо для указанных наборов столбцов.

    Args:
        features_transformed (pandas.DataFrame): Преобразованный DataFrame с параметрами.
        cluster_definitions (dict): Словарь, где ключи - это имена новых столбцов для меток кластеров,
                                    а значения - списки или кортежи имен столбцов,
                                    по которым будет проводиться кластеризация.
                                    Пример: {'cluster_A': ('col1', 'col2'), 'cluster_B': ('col3',)}
        n_clusters (int): Количество кластеров. Применяется для каждой группы кластеризации.
        clustering_method (str): Метод кластеризации ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame с добавленными столбцами меток кластеров или None в случае ошибки.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    result_df = features_transformed.copy()

    for cluster_name, columns in cluster_definitions.items():
        print(f"\n--- Кластеризация для '{cluster_name}' по столбцам: {list(columns)} ---")

        # Проверка наличия всех необходимых столбцов
        columns = list(columns)
        missing_cols = [col for col in columns if col not in result_df.columns]
        if missing_cols:
            print(f"Ошибка: отсутствуют столбцы {missing_cols}. Эта кластеризация пропускается.")
            continue

        features_for_clustering = result_df[columns]

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_for_clustering)

            # Оценка качества кластеризации (например, с помощью коэффициента силуэта)
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_for_clustering, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта (требуется более 1 кластера).")

            result_df[cluster_name] = cluster_labels
            print(f"Метки кластеров добавлены в столбец '{cluster_name}'.")

        else:
            print(f"Неподдерживаемый метод кластеризации: '{clustering_method}'.")
            continue

    print("\nВсе операции кластеризации завершены.")
    return result_df

# Выполнение кластеризации (после этапа 5 и до этапа 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Определяем, для каких наборов столбцов мы хотим провести кластеризацию.
    # Ключ - имя нового столбца с кластерами.
    # Значение - кортеж столбцов для этой кластеризации.
    # Пример ниже пытается автоматически найти числовые столбцы.
    # Замените его на ваш собственный словарь с нужными столбцами.
    numerical_cols = features_transformed.select_dtypes(include=np.number).columns.tolist()
    
    cluster_definitions = {}
    if len(numerical_cols) >= 3:
        # Пример: кластеризация по первым двум числовым столбцам и отдельно по третьему
        print(f"Пример определения кластеров: cluster_pair по ({numerical_cols[0]}, {numerical_cols[1]}) и cluster_single по ({numerical_cols[2]},)")
        cluster_definitions = {
            'cluster_pair': (numerical_cols[0], numerical_cols[1]), 
            'cluster_single': (numerical_cols[2],)                 
        }
    elif len(numerical_cols) >= 2:
        print(f"Пример определения кластеров: cluster по ({numerical_cols[0]}, {numerical_cols[1]})")
        cluster_definitions = {
            'cluster': (numerical_cols[0], numerical_cols[1])
        }
    
    if cluster_definitions:
        n_clusters = 3  # Количество кластеров (подберите оптимальное значение)
        features_transformed = cluster_data(features_transformed, cluster_definitions, n_clusters)

        # Визуализация результатов для каждого выполненного набора кластеризации
        for cluster_name, columns in cluster_definitions.items():
            if cluster_name not in features_transformed.columns:
                continue # Пропускаем, если кластеризация для этой группы не удалась

            if len(columns) >= 2:
                plt.figure(figsize=(8, 6))
                plt.scatter(features_transformed[columns[0]], features_transformed[columns[1]], c=features_transformed[cluster_name], cmap='viridis')
                plt.xlabel(columns[0])
                plt.ylabel(columns[1])
                plt.title(f'Результаты кластеризации для "{cluster_name}"')
                plt.colorbar(label='Номер кластера')
                plt.show()
            else:
                 print(f"Визуализация для кластера '{cluster_name}' (на основе <2 признаков) не отображается на 2D-графике.")
    else:
        print("Недостаточно числовых признаков для автоматического определения групп кластеризации. Задайте `cluster_definitions` вручную.")

else:
    print("Сначала выполните этап 5 (Преобразование данных).")