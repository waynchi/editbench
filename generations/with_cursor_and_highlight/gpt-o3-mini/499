from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data(features_transformed, clustering_columns, n_clusters=2, clustering_method='kmeans'):
    """Realiza la agrupación de datos de manera independiente para cada conjunto de columnas especificado.

    Args:
        features_transformed (pandas.DataFrame): DataFrame transformado con parámetros.
        clustering_columns (dict): Diccionario donde cada clave es el nombre de la nueva columna 
            para las etiquetas del clúster y el valor es una tupla con los nombres de las columnas 
            que se usarán para esa agrupación.
        n_clusters (int): Número de clústeres.
        clustering_method (str): Método de agrupación ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame con las columnas de etiquetas de clústeres añadidas.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    for new_col_name, cols in clustering_columns.items():
        features_subset = features_transformed[list(cols)].copy()

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)

            if len(np.unique(cluster_labels)) > 1:  # Verificar que no se asigne todo a un único clúster
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров en '{new_col_name}': {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера en '{new_col_name}' (все точки в одном кластере).")
        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        features_transformed[new_col_name] = cluster_labels
        print(f"Кластеризация выполнена para '{new_col_name}'. Метки кластеров añadidas.")

    return features_transformed

# Ejecución de la clusterización (después de la etapa 5 y antes de la etapa 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Definición de grupos de columnas: la clave es el nombre de la nueva columna con las etiquetas,
    # y el valor es una tupla con los nombres de las columnas a usar para esa agrupación.
    cluster_groups = {
        'Cluster1': ('columna1', 'columna2'),
        'Cluster2': ('columna3',)
    }
    n_clusters = 3  # Cantidad de clústeres (seleccione el valor óptimo)
    features_transformed = cluster_data(features_transformed, cluster_groups, n_clusters)
    
    # Visualización de los clústeres para cada conjunto de columnas
    for group_name, cols in cluster_groups.items():
        group_data = features_transformed[list(cols)]
        numerical_features = group_data.select_dtypes(include=np.number)
        if numerical_features.shape[1] >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1],
                        c=features_transformed[group_name], cmap='viridis')
            plt.xlabel(numerical_features.columns[0])
            plt.ylabel(numerical_features.columns[1])
            plt.title(f'Результаты кластеризации: {group_name}')
            plt.colorbar(label='Номер кластера')
            plt.show()
        else:
            print(f"Недостаточно числовых признаков para visualizar el clúster '{group_name}'.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")