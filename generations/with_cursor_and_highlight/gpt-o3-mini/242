# Написать бинарный поиск

def binary_search(arr, target):
    left = 0
    right = len(arr) - 1
    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return -1

if __name__ == '__main__':
    # Пример использования:
    sorted_list = [1, 3, 5, 7, 9, 11]
    target = 7
    result = binary_search(sorted_list, target)
    if result != -1:
        print("Найден элемент на индексе:", result)
    else:
        print("Элемент не найден")