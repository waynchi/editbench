plik = open("dane_obrazki.txt")
maxbitybledne = 0
bityBledne = list()
def czyPoprawny(obrazek): # 图像包含字符串列表，可以使用位运算符
                            # 图像[i][j]
    for wiersz in obrazek[:-1]: # 不计算最后一行，那是奇偶校验位
        if wiersz[:-1].count('1') % 2 != int(wiersz[-1]):
            return False
    for i in range(20): # i = 0,1,2,3,4,5,6,7..19
        kolumna = ""
        for j in range(21):  # j = 0,1,2,3,4,5,..20
            kolumna += obrazek[j][i]
        if kolumna[:-1].count('1') % 2 != int(kolumna[-1]):
            return False
    return True

def czyNaprawialny(obrazek):
    bityKolBleden = 0
    bityWierBledne = 0
    for wiersz in obrazek[:-1]: # 不计算最后一行，那是校验位
        if wiersz[:-1].count('1') % 2 != int(wiersz[-1]):
            bityWierBledne += 1
    for i in range(20): # i = 0,1,2,3,4,5,6,7..19
        kolumna = ""
        for j in range(21):  # j = 0,1,2,3,4,5,..20
            kolumna += obrazek[j][i]
        if kolumna[:-1].count('1') % 2 != int(kolumna[-1]):
           bityKolBleden += 1
    global maxbitybledne
    if maxbitybledne < (bityKolBleden + bityWierBledne):
        maxbitybledne = bityKolBleden + bityWierBledne
    bityBledne.append(bityKolBleden + bityWierBledne)

    if bityWierBledne > 1:
        return False
    if bityKolBleden > 1:
        return False

    return True

def napraw(obrazek):
    """输入是一个文本文件，其中包含编码为像素的黑白图像数据。
    0 - 白色像素 1 - 黑色像素。
    每行和每列的末尾都有一个奇偶校验位。如果行（或列）的1的数量是偶数，则奇偶校验位为0；如果是奇数，则为1。
    例如：0 1 1 0 1 1 
    错误的位需要更改为相反的：
      1 1 1 0 1 0
      1 1 1 1 1 1
      0 1 1 0 0 0
      1 1 0 1 1 0
      1 1 0 0 0 
    - 列的奇偶校验位
          ^
    |- 行的奇偶校验位
    编写一个函数来查找损坏的图像并修复它们。
    即这是一个可修复的图像（最多只有一个行的奇偶校验位和一个列的奇偶校验位不正确），
    然后修复这些图像，结果应包含错误的（可修复的）图像和修复后的图像。
    """
    # 将原始图像复制为不可变的字符串列表（用作返回错误的图像）
    oryginal = obrazek.copy()
    # 转换为可变的二维列表
    image_matrix = [list(wiersz) for wiersz in obrazek]

    faulty_row = None
    faulty_col = None

    # 检查每一行（不包括最后一行）是否存在错误
    for idx in range(20):
        row = image_matrix[idx]
        data_bits = row[:20]
        expected_parity = str(data_bits.count('1') % 2)
        if expected_parity != row[20]:
            faulty_row = idx
            break

    # 检查每一列（前20列）是否存在错误
    for i in range(20):
        # 构造该列的字符串
        col_bits = [image_matrix[j][i] for j in range(21)]
        data_bits = col_bits[:-1]  # 前20个为图像数据
        expected_parity = str(data_bits.count('1') % 2)
        if expected_parity != col_bits[-1]:
            faulty_col = i
            break

    # 根据错误情况进行修复
    if faulty_row is not None and faulty_col is not None:
        # 同时有行和列错误，错误位在数据中：将交叉的那个像素翻转
        current = image_matrix[faulty_row][faulty_col]
        image_matrix[faulty_row][faulty_col] = '0' if current == '1' else '1'
    elif faulty_row is not None:
        # 只有行错误，则修正该行的奇偶校验位（最后一个字符）
        data_bits = image_matrix[faulty_row][:20]
        correct_parity = str(data_bits.count('1') % 2)
        image_matrix[faulty_row][20] = correct_parity
    elif faulty_col is not None:
        # 只有列错误，则修正该列的奇偶校验位（最后一行中对应列）
        data_bits = [image_matrix[j][faulty_col] for j in range(20)]
        correct_parity = str(data_bits.count('1') % 2)
        image_matrix[20][faulty_col] = correct_parity

    # 将修复后的二维列表转换回字符串列表
    naprawiony = [''.join(wiersz) for wiersz in image_matrix]
    
    # wynik包含原始错误图像和修复后的图像
    wynik = [oryginal, naprawiony]
    return wynik

poprawne = 0
naprawialne = 0
obrazek = list()
for linia in plik:
    wiersz = linia.strip() # 去掉空白字符，例如回车
   # wiersz = wiersz[:-1]  # 仅包含图像数据，不包括奇偶校验位，现在读取整行数据
    obrazek.append(wiersz)
    if len(obrazek) == 21: # 我们有21行，即整个图像连同奇偶校验位行一起
        if czyPoprawny(obrazek):
            poprawne += 1
        elif czyNaprawialny(obrazek):
            naprawialne += 1
            naprawiony = napraw(obrazek)


    if len(obrazek) == 22:  # 在第22行之后清理图像以读取下一个图像的行
        obrazek = list()

print(poprawne, naprawialne, 200 - poprawne - naprawialne)
print(maxbitybledne, max(bityBledne))