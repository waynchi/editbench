function createTurnState(allyStates, foeStates) {
  // 根据哪个小组仍有可以行动的单位来确定当前回合
  // 此实现会根据 allyStates 和 foeStates 中各单位的 hasActed 状态动态决定当前回合
  let turnNumber = 1;

  function getCurrentTurn() {
    const playerAvailable = allyStates.some(unit => !unit.hasActed);
    const cpuAvailable = foeStates.some(unit => !unit.hasActed);

    if (playerAvailable && !cpuAvailable) return "player";
    if (cpuAvailable && !playerAvailable) return "cpu";
    if (playerAvailable && cpuAvailable) {
      // 如果双方都有单位可行动，则默认优先玩家回合
      return "player";
    }
    return null;
  }

  function getTurnNumber() {
    return turnNumber;
  }

  function nextTurn() {
    if (getCurrentTurn() === "player") {
      // 结束玩家回合：标记所有玩家单位已行动，并重置 CPU 单位的行动状态
      allyStates.forEach(unit => unit.hasActed = true);
      foeStates.forEach(unit => unit.hasActed = false);
      cpuTurn();
    } else if (getCurrentTurn() === "cpu") {
      // 结束 CPU 回合：标记所有 CPU 单位已行动，并重置玩家单位的行动状态
      foeStates.forEach(unit => unit.hasActed = true);
      allyStates.forEach(unit => unit.hasActed = false);
      turnNumber++; // 仅在玩家回合后增加回合数
    }
  }

  function cpuTurn() {
    // 示例 CPU 行为（请用您实际的 AI 逻辑替换）
    for (const cpuUnit of foeStates) {
      if (!cpuUnit.hasActed) { // 检查该单位在此回合中是否已经行动
        // 执行 CPU 动作（例如移动、攻击等）
        // ...在这里编写您的 CPU AI 逻辑...
        cpuUnit.hasActed = true; // 标记该单位已行动
      }
    }
    // 当所有 CPU 单位都已行动（或选择不行动）后自动结束回合，切换回玩家回合
    nextTurn();
  }

  return {
    getCurrentTurn,
    getTurnNumber,
    nextTurn
  };
}

export { createTurnState };