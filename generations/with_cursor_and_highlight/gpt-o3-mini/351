import numpy as np

INPUT_FILE_PATH = './input.txt'
INPUT_FILE_PATH = './example_in.txt'

def main():
    lines = parse_input_file()
    print("Raw input lines:", lines)
    # Remove any empty lines to avoid issues during processing
    lines = [line for line in lines if line.strip()]
    # Split each line on exactly three spaces and then convert the values to integers
    try:
        splitted = [line.split("   ") for line in lines]
        # Ensure each line has exactly two values and convert them
        data = np.array([[int(val.strip()) for val in line] for line in splitted])
    except ValueError as e:
        print("Error processing the input data:", e)
        return
    
    if data.shape[1] != 2:
        print("Expected exactly two columns in the input data, found", data.shape[1])
        return

    # Extract the two columns
    col1, col2 = data[:, 0], data[:, 1]
    # Instead of repeatedly finding and removing the minimum, sort both arrays.
    sorted_1 = np.sort(col1)
    sorted_2 = np.sort(col2)
    # Compute pairwise absolute differences and sum them up.
    total_distance = np.sum(np.abs(sorted_1 - sorted_2))
    print("Total distance:", total_distance)

def parse_input_file():
    with open(INPUT_FILE_PATH, 'r') as f:
        lines = f.read().split("\n")
    return lines

if __name__ == "__main__":
    main()