import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, maxiter=None):
    """
    Решает систему линейных уравнений Ax = b методом сопряжённых градиентов.
    
    Параметры:
      A : ndarray
          Симметричная положительно определённая матрица коэффициентов.
      b : ndarray
          Вектор правой части.
      x0 : ndarray, optional
          Начальное приближение решения (по умолчанию нулевой вектор).
      tol : float, optional
          Допустимая точность (по умолчанию 1e-6).
      maxiter : int, optional
          Максимальное число итераций (по умолчанию 2*n, где n — размерность задачи).
    
    Возвращает:
      x : ndarray
          Приблизительное решение системы.
    """
    n = len(b)
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    if maxiter is None:
        maxiter = 2 * n  # разумное начальное значение для числа итераций

    r = b - A.dot(x)
    p = r.copy()
    rsold = np.dot(r, r)

    for i in range(maxiter):
        Ap = A.dot(p)
        alpha = rsold / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rsnew = np.dot(r, r)
        
        if np.sqrt(rsnew) < tol:
            break
        
        p = r + (rsnew / rsold) * p
        rsold = rsnew

    return x

if __name__ == '__main__':
    # Пример использования:
    # Создадим симметричную положительно определённую матрицу A и вектор b
    n = 5
    # Для того чтобы A была симметричной и положительно определённой,
    # создадим случайную матрицу и умножим её на собственную транспонированную
    A = np.random.rand(n, n)
    A = np.dot(A, A.T)
    b = np.random.rand(n)
    
    # Решаем систему методом сопряжённых градиентов
    x = conjugate_gradient(A, b)
    print("Найденное решение x:", x)
    
    # Проверка: вычисляем норму невязки
    residual = np.linalg.norm(b - A.dot(x))
    print("Норма невязки:", residual)