import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self):  # Usuwamy parametr flattened_size i ustalamy rozmiar wejścia jako 32x32
        super().__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.flatten = nn.Flatten()
        # Zakładamy, że obraz wejściowy ma rozmiar 32x32.
        # Po pierwszej warstwie conv i maxpool: (32-3+1)=30 -> floor(30/2)=15
        # Po drugiej warstwie conv i maxpool: (15-3+1)=13 -> floor(13/2)=6
        # Zatem rozmiar spłaszczonego tensora wynosi 64 * 6 * 6 = 2304.
        self.fc1 = nn.Sequential(
            nn.Linear(64 * 6 * 6, 512),
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x