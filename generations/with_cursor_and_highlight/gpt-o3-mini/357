import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-8, max_iter=None):
    """
    Rozwiązuje układ liniowy Ax = b metodą sprzężonych gradientów.
    
    Parametry:
    A       -- macierz współczynników (numpy.ndarray), powinna być symetryczna 
               i dodatnio określona.
    b       -- wektor prawej strony.
    x0      -- przybliżenie początkowe (domyślnie: wektor zerowy).
    tol     -- tolerancja błędu (domyślnie: 1e-8).
    max_iter-- maksymalna liczba iteracji (domyślnie: rozmiar wektora b).
    
    Zwraca:
    x       -- przybliżone rozwiązanie układu Ax = b.
    """
    n = b.shape[0]
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    if max_iter is None:
        max_iter = n

    r = b - np.dot(A, x)
    p = r.copy()
    rs_old = np.dot(r, r)

    for i in range(max_iter):
        Ap = np.dot(A, p)
        alpha = rs_old / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rs_new = np.dot(r, r)
        if np.sqrt(rs_new) < tol:
            break
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new

    return x

if __name__ == "__main__":
    # Przykładowe dane testowe
    A = np.array([[4, 1], [1, 3]])
    b = np.array([1, 2])
    x = conjugate_gradient(A, b)
    print("Rozwiązanie:", x)