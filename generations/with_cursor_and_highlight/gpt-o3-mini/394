from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data(features_transformed, cluster_features_dict, n_clusters=2, clustering_method='kmeans'):
    """Wykonuje klasteryzację danych osobno dla różnych zestawów kolumn.

Args:
    features_transformed (pandas.DataFrame): Przekształcony DataFrame z parametrami.
    cluster_features_dict (dict): Słownik, w którym klucze określają nazwę nowej kolumny z etykietami, a wartości to krotki/listy zawierające nazwy kolumn, na podstawie których wykonywana jest klasteryzacja.
    n_clusters (int): Liczba klastrów.
    clustering_method (str): Metoda klasteryzacji ('kmeans').

Returns:
    pandas.DataFrame: DataFrame z dodanymi kolumnami etykiet klastrów."""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    # Klasteryzacja wykonywana niezależnie dla każdego zestawu kolumn
    for cluster_feature_name, cols in cluster_features_dict.items():
        features_subset = features_transformed[list(cols)].copy()
        print(f"Rozpoczynam klasteryzację dla zestawu kolumn: {cols} (nowa kolumna: '{cluster_feature_name}')")
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)
            
            # Ocena jakości klasteryzacji (na przykład za pomocą współczynnika sylwetki)
            if len(set(cluster_labels)) > 1:  # Sprawdzenie przypadku, gdy wszystkie punkty są przypisane do jednego klastra
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров w zestawie {cols}: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера w zestawie {cols} (все точки в одном кластере).")
        else:
            print("Неподдерживаемый метод кластеризации dla zestawu kolumn: ", cols)
            continue

        features_transformed[cluster_feature_name] = cluster_labels
        print(f"Кластеризация wykonana. Метки кластеров dodane w kolumnie '{cluster_feature_name}'.")
        
    return features_transformed

# Wykonywanie klasteryzacji (po etapie 5 i przed etapом 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Definiujemy zestawy kolumn do klasteryzacji: klucz = nazwa nowej kolumny, wartość = krotka/lista kolumn do użycia
    cluster_features_dict = {
        'Klaster1': ('kolumna1', 'kolumna2'),
        'Klaster2': ('kolumna3',)
    }
    n_clusters = 3  # Liczba klastrów (dobierz optymalną wartość)
    features_transformed = cluster_data(features_transformed, cluster_features_dict, n_clusters)
    
    # Wizualizacja klastrów - dla każdego wyniku klasteryzacji wykonujemy oddzielny wykres
    numerical_features = features_transformed.select_dtypes(include='number')
    if numerical_features.shape[1] >= 2:
        for cluster_feature_name in cluster_features_dict.keys():
            plt.figure(figsize=(8, 6))
            plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1],
                        c=features_transformed[cluster_feature_name], cmap='viridis')
            plt.xlabel(numerical_features.columns[0])
            plt.ylabel(numerical_features.columns[1])
            plt.title(f'Результаты кластеризации - {cluster_feature_name}')
            plt.colorbar(label='Номер кластера')
            plt.show()
    else:
        print("Недостаточно числовых признаков для визуализации кластеров na płaszczyźnie.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")