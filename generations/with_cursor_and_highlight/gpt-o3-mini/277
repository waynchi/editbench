class Computer:
	def __init__(self):
		self.stocks = []
		self.strategies = []
		# Количество симуляций для каждой свечи, настраиваемо
		self.num_simulations = 5

	def add_stock(self, stock):
		if not isinstance(stock, Stock):
			exit("ERR: called 'add_stock' on type: "+str(type(stock)))
		self.stocks.append(stock)
	
	def add_strategy(self, strategy):
		if not isinstance(strategy, Strategy):
			exit("ERR: called 'add_strategy' on type: "+str(type(strategy)))
		self.strategies.append(strategy)

	def run(self):
		# поместить акции в стратегии
		for strategy in self.strategies:
			j = 1
			for stock in self.stocks:
				strategy.stocks = [stock]
				print(f"stock #{j}/{len(self.stocks)}")
				j += 1

				# запускать каждый день на стратегиях с симуляцией свечей
				for i in range(len(stock)):
					# Сохраняем оригинальную свечу
					original_row = stock.data.iloc[i].copy()
					# Получаем индекс текущей свечи, чтобы обновлять данные корректно
					row_index = stock.data.index[i]
					# Прогоняем симуляции n раз для каждой свечи
					for sim in range(self.num_simulations):
						# Генерируем случайные вариации для high, low, close и volume
						simulated = original_row.copy()
						high_variation = random.uniform(-0.02, 0.02)
						low_variation = random.uniform(-0.02, 0.02)
						close_variation = random.uniform(-0.02, 0.02)
						volume_variation = random.uniform(-0.05, 0.05)
						
						simulated['high'] = original_row['high'] * (1 + high_variation)
						simulated['low'] = original_row['low'] * (1 + low_variation)
						# Гарантируем, что low не превышает high
						if simulated['low'] > simulated['high']:
							simulated['low'], simulated['high'] = simulated['high'], simulated['low']
						simulated['close'] = original_row['close'] * (1 + close_variation)
						simulated['volume'] = original_row['volume'] * (1 + volume_variation)

						# Обновляем данные акции для текущей свечи симуляцией
						stock.data.loc[row_index] = simulated

						# Вызываем стратегию и анализаторы для симулированных данных
						strategy.set_attr("i", i)
						strategy.next(i)
						for analyzer in strategy.analyzers:
							analyzer.next(i)
					
					# После симуляций возвращаем оригинальные значения свечи
					stock.data.loc[row_index] = original_row

					# Если текущая свеча последняя, закрываем все открытые сделки
					if i == len(stock)-1:
						for strat in self.strategies:
							while len(strat.open_trades) > 0:
								trade = strat.open_trades[0]
								strat.sell(trade.stock, trade.num, trade.stock.get(i)["close"])

		# избавиться от стратегий
		for strategy in self.strategies:
			strategy.stocks = []
