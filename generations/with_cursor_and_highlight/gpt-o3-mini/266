        "title": title,
        "body": body,
    }

q = Query()
d = Discussions()

# HIGHLIGHTED SECTION MODIFIED:
posts_generator = d.get_discussions("created", q, limit=6000)
hierarchy = {}  # This dictionary will hold posts and their hierarchical replies
X = 0

for post in posts_generator:
    post_author = post['author']
    post_permlink = post['permlink']
    replies_count = post['children']
    X += 1
    current_post_key = f"{post_author}/{post_permlink}"
    # Initialize with the post details and an empty list for replies
    hierarchy[current_post_key] = {"post": post, "replies": []}
    cnt = 0

    if replies_count > n_respuestas_minimas:
        comment = Comment(authorperm=f"{post_author}/{post_permlink}")
        post_replies = comment.get_replies()
        
        for reply in post_replies:
            author = reply['author']
            text = reply['body']
            if is_own_author(author):
                # Переоценить комментарий
                continue
            if is_banned(author):
                continue
            if procesar(text):
                cnt += 1
                hierarchy[current_post_key]["replies"].append(reply)
                
    if cnt > 3:
        print("Iterador:", X)
        # Print the last reply that met the criteria (if any)
        if hierarchy[current_post_key]["replies"]:
            last_reply = hierarchy[current_post_key]["replies"][-1]
            print(last_reply['author'], '/', last_reply['permlink'])
            
