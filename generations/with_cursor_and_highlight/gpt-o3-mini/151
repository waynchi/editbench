import numpy as np

INPUT_FILE_PATH = './input.txt'
INPUT_FILE_PATH = './example_in.txt'

def main():
    lines = parse_input_file()
    print(lines)
    # Process each non-empty line and split by three spaces
    cols = [l.split("   ") for l in lines if l.strip()]
    cols = np.array(cols).T.astype(int)
    # Instead of iteratively finding and popping minimums,
    # sort the two lists so that the minimal differences can be computed pairwise.
    list_1 = sorted(list(cols[0]))
    list_2 = sorted(list(cols[1]))

    all_dists = [abs(a - b) for a, b in zip(list_1, list_2)]
    print(sum(all_dists))

def parse_input_file():
    with open(INPUT_FILE_PATH, 'r') as f:
        lines = f.read().split("\n")
    return lines

if __name__ == "__main__":
    main()