import pandas as pd
import statsmodels.api as sm

data = {
    'Brand': ['A'] * len(brand_A) + ['B'] * len(brand_B) + ['C'] * len(brand_C),
    'Cost': all_data
}

df = pd.DataFrame(data)

# Преобразование категориальной переменной Brand в дамми-переменные (Python-стиль)
X = pd.get_dummies(df['Brand'], drop_first=True)
X = sm.add_constant(X)
y = df['Cost']

# Построение модели OLS (Python-стиль) и выполнение анализа ANOVA
model = sm.OLS(y, X).fit()
anova_table = sm.stats.anova_lm(model, typ=2)

# Вывести таблицу ANOVA
print(anova_table)