from dataclasses import dataclass


@dataclass
class Card:
    celular: str
    operadora: str
    valor: str
    email: str
    nome: str
    cpf: str
    card: str
    mes: str
    ano: str
    cvv: str
    token: str
    bin: str
    dadosbin: str
    senha: str

    def __repr__(self):
        return (f"Card(celular='{self.celular}', operadora='{self.operadora}', "
                f"valor='{self.valor}', email='{self.email}', "
                f"nome='{self.nome}', cpf='{self.cpf}', card='{self.card}', "
                f"mes='{self.mes}', ano='{self.ano}', cvv='{self.cvv}', "
                f"token='{self.token}', bin='{self.bin}', dadosbin='{self.dadosbin}', "
                f"senha='{self.senha}')")