# Carpeta con todas las fotos / carpeta con fotos para entrenamiento
TRAIN_DIR = os.path.join(DATA_PATH, "train")
# Leemos los nombres de los directorios, que son el tipo de eclipse
ECLIPSE_LIST = {i: name for i, name in enumerate(os.listdir(TRAIN_DIR))}


# Carpeta con fotos para validación
VAL_DIR = os.path.join(DATA_PATH, "val")
os.makedirs(VAL_DIR, exist_ok=True)

# Carpeta con fotos para prueba
TEST_DIR = os.path.join(DATA_PATH, "test")


# Proporción de imágenes en la validación
VAL_FRAC = 0.3

from sklearn.model_selection import train_test_split

# Creamos un directorio con el conjunto de validación para cada tipo de eclipse.
for eclipse in ECLIPSE_LIST.values():
    eclipse_train_dir = os.path.join(TRAIN_DIR, eclipse)
    eclipse_val_dir = os.path.join(VAL_DIR, eclipse)
    os.makedirs(eclipse_val_dir, exist_ok=True)

    # Leemos el conjunto de imágenes.
    images_filename = sorted(os.listdir(eclipse_train_dir))
    
    # Dividimos las imágenes del conjunto de entrenamiento en nuevos conjuntos train y val
    train_imgs, val_imgs = train_test_split(
        images_filename, test_size=VAL_FRAC, random_state=42, shuffle=True
    )
    
    print(f'{eclipse} | train images = {len(train_imgs)} | val images = {len(val_imgs)}')
    
    # Guardamos el conjunto de validación: movemos las imágenes de train a val
    for image_filename in val_imgs:
        source = os.path.join(eclipse_train_dir, image_filename)
        destination = os.path.join(eclipse_val_dir, image_filename)
        shutil.copy(source, destination)
        os.remove(source)