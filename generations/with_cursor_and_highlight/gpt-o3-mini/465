def conjugate_gradient(A, b, x0=None, tol=1e-10, max_iter=1000):
    """
    Método de gradientes conjugados para resolver sistemas lineales de la forma Ax = b.
    A debe ser una matriz simétrica y definida positiva.

    Args:
        A (numpy.ndarray): Matriz de coeficientes de tamaño (n, n).
        b (numpy.ndarray): Vector de términos constants de tamaño (n,).
        x0 (numpy.ndarray): Estimación inicial; si es None, se usa un vector cero.
        tol (float): Tolerancia para el criterio de convergencia.
        max_iter (int): Número máximo de iteraciones.

    Returns:
        x (numpy.ndarray): Aproximación a la solución del sistema.
        i (int): Número de iteraciones realizadas.
    """
    import numpy as np

    n = len(b)
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    r = b - A.dot(x)
    p = r.copy()
    rs_old = np.dot(r, r)

    for i in range(max_iter):
        Ap = A.dot(p)
        alpha = rs_old / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rs_new = np.dot(r, r)
        if np.sqrt(rs_new) < tol:
            return x, i + 1
        beta = rs_new / rs_old
        p = r + beta * p
        rs_old = rs_new

    return x, max_iter

if __name__ == '__main__':
    import numpy as np

    # Ejemplo de uso:
    # Definimos una matriz simétrica y definida positiva y un vector b.
    A = np.array([[4, 1], [1, 3]])
    b = np.array([1, 2])
    x, num_iter = conjugate_gradient(A, b)

    print("Solución:", x)
    print("Número de iteraciones:", num_iter)