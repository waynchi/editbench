from flask import Flask, render_template_string
from datetime import datetime

app = Flask(__name__)

@app.route("/")
def index():
    now = datetime.now()
    formatted_time = now.strftime("%Y-%m-%d %H:%M:%S")
    return render_template_string("<h1>Текущая дата и время: {{ time }}</h1>", time=formatted_time)

if __name__ == '__main__':
    app.run(debug=True)