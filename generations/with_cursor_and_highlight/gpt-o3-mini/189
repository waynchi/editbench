import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self, input_shape):  # 使用 input_shape 而不是 flattened_size 作为输入
        super().__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.flatten = nn.Flatten()
        
        # 自动计算扁平化后的大小
        with torch.no_grad():
            dummy_input = torch.zeros(1, *input_shape)
            dummy_out = self.conv2(self.conv1(dummy_input))
            flattened_size = dummy_out.view(1, -1).size(1)

        self.fc1 = nn.Sequential(
            nn.Linear(flattened_size, 512),  # 使用自动计算得到的 flattened_size
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x