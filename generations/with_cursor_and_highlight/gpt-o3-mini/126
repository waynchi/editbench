from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data(features_transformed, cluster_feature, n_clusters=2, clustering_method='kmeans'):
    """Performs data clustering.

Args:
    features_transformed (pandas.DataFrame): Transformed DataFrame with parameters.
    cluster_feature (str or dict): If str, it's the name of the column where cluster labels will be recorded.
                                   If dict, keys are the new column names and values are tuples/lists of column names 
                                   on which to perform clustering independently.
    n_clusters (int): Number of clusters.
    clustering_method (str): Clustering method ('kmeans').

Returns:
    pandas.DataFrame: DataFrame with added column(s) of cluster labels.
    
Note:
    When cluster_feature is a dict, clustering is performed independently for each set of specified columns.
    For example, if cluster_feature = {'Cluster1': ('column1', 'column2'), 'Cluster2': ('column3',)},
    clustering runs separately on the features ['column1', 'column2'] and on ['column3'], with the resulting labels
    stored in respective new columns 'Cluster1' and 'Cluster2'.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()

    # Check if clustering is to be performed on multiple sets of columns
    if isinstance(cluster_feature, dict):
        for new_column, cols in cluster_feature.items():
            subset = features_for_clustering[list(cols)]
            if clustering_method == 'kmeans':
                model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
                cluster_labels = model.fit_predict(subset)

                # Evaluation of clustering quality (e.g., using the silhouette coefficient)
                if len(set(cluster_labels)) > 1:  # Check for the case when all points are assigned to one cluster
                    silhouette_avg = silhouette_score(subset, cluster_labels)
                    print(f"Коэффициент силуэта для {n_clusters} кластеров для '{new_column}': {silhouette_avg:.4f}")
                else:
                    print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера для '{new_column}' (все точки в одном кластере).")
            else:
                print("Неподдерживаемый метод кластеризации.")
                return None

            features_transformed[new_column] = cluster_labels
        print("Кластеризация выполнена. Метки кластеров добавлены в указанные столбцы.")
        return features_transformed

    else:
        # Original behavior if a single cluster_feature column name is provided
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_for_clustering)
            
            # Evaluation of clustering quality (e.g., using the silhouette coefficient)
            if len(set(cluster_labels)) > 1:  # Check for the case when all points are assigned to one cluster
                silhouette_avg = silhouette_score(features_for_clustering, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера (все точки в одном кластере).")
        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        features_transformed[cluster_feature] = cluster_labels
        print(f"Кластеризация выполнена. Метки кластеров добавлены в столбец '{cluster_feature}'.")
        return features_transformed

# Clustering execution (after step 5 and before step 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # You can use either a single column name (string) or a mapping (dict) for independent clustering.
    # For independent clustering on different sets of columns, uncomment and modify the dictionary below:
    # cluster_feature_mapping = {
    #     'Cluster1': ('column1', 'column2'),
    #     'Cluster2': ('column3',)
    # }
    #
    # Example using the new dictionary mapping:
    # n_clusters = 3  # Number of clusters (select the optimal value)
    # features_transformed = cluster_data(features_transformed, cluster_feature_mapping, n_clusters)
    
    # Example using the original single clustering on all features:
    cluster_feature_name = 'cluster'  # Column name for cluster labels
    n_clusters = 3  # Number of clusters (select the optimal value)
    features_transformed = cluster_data(features_transformed, cluster_feature_name, n_clusters)
    
    # Visualization of clusters (example for the case when there are 2 numerical features)
    numerical_features = features_transformed.select_dtypes(include='number')
    if numerical_features.shape[1] >= 2:
        import matplotlib.pyplot as plt  # Ensure matplotlib is imported
        plt.figure(figsize=(8, 6))
        plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], c=features_transformed[cluster_feature_name], cmap='viridis')
        plt.xlabel(numerical_features.columns[0])
        plt.ylabel(numerical_features.columns[1])
        plt.title('Результаты кластеризации')
        plt.colorbar(label='Номер кластера')
        plt.show()
    else:
        print("Недостаточно числовых признаков для визуализации кластеров на плоскости.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")