import pygame
import math

# Inicializar Pygame
pygame.init()

# Configurar pantalla
screen_width = 800
screen_height = 600
screen = pygame.display.set_mode((screen_width, screen_height))
pygame.display.set_caption('Basic Screen')

# Bucle principal
