from langchain_ollama import ChatOllama
from langchain_core.prompts.chat import ChatPromptTemplate
import json

# Inicializar el modelo ChatOllama
chat_model = ChatOllama(model="llama3.2", base_url="http://localhost:11434")

# Cargar valores SHAP desde archivo JSON
with open("Vuori_Final_Approval_2024_09_24.json", "r") as file:
    # Accede directamente a la clave "shap_values" para evitar posibles valores None
    data = json.load(file)
    shap_values_json = data["shap_values"]

# Cargar el mensaje del sistema desde el archivo
with open("system.prompt", "r") as file:
    sys_prompt = file.read().strip()

# Preparar los mensajes usando un diccionario para reemplazar la variable {user_input}
template = ChatPromptTemplate([
    ("system", sys_prompt),
    ("human", "{user_input}"),
])

# Generar la respuesta: se pasa un diccionario con la llave 'user_input'
formatted_prompt = template.invoke({"user_input": json.dumps(shap_values_json)})

# Invocar el modelo con el prompt formateado
response = chat_model.invoke(formatted_prompt)

# Imprimir la respuesta
print(response)