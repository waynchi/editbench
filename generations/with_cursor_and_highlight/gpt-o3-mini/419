json"""
    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """Asynchroniczna metoda sprawdzająca nazwę waluty w zbiorze walut.
           Zbiór jest aktualizowany nie częściej niż raz dziennie."""
        import aiofiles
        import aiohttp

        # Asynchronicznie otwieramy plik z informacjami
        async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\Info.json", "r", encoding="utf-8") as info_file:
            info_data = await info_file.read()
        info = json.loads(info_data)
        
        # Sprawdzamy, czy minął co najmniej jeden dzień od ostatniej aktualizacji
        last_check = datetime.datetime.strptime(info["last_day_check"]["valute"], "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check:
            # Jeśli więcej niż 1 dzień, to aktualizujemy zbiór walut
            set_valutes = set()
            url = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    content = await response.read()
            root = xml.etree.ElementTree.fromstring(content)
            for Valute in root.findall("Valute"):
                CharCode = Valute.find("CharCode")
                set_valutes.add(CharCode.text)
            # Asynchroniczny zapis zbioru do pliku binarnego
            async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin", "wb") as bin_file:
                await bin_file.write(pickle.dumps(set_valutes))
            # Aktualizujemy czas ostatniej aktualizacji
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\Info.json", "w", encoding="utf-8") as info_file:
                await info_file.write(json.dumps(info, indent=3, ensure_ascii=False))
                
        # Asynchroniczny odczyt zbioru walut
        async with aiofiles.open(r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin", "rb") as bin_file:
            bin_content = await bin_file.read()
        set_valutes = pickle.loads(bin_content)
        if self.name in set_valutes:
            return True
        else:
            return False

    async def CurrentExchangeRate(self):
        '''Asynchroniczna metoda pobierająca bieżący kurs wymiany waluty na rubla'''
        import aiohttp
        url = "http://www.cbr.ru/scripts/XML_daily.asp"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = xml.etree.ElementTree.fromstring(content)
        for Valute in root.findall("Valute"):
            for CharCode in Valute.findall("CharCode"):
                if CharCode.text == self.name:
                    return Valute.find("VunitRate").text