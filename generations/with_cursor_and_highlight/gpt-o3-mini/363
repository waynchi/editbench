def build_hierarchy(discussions_obj, query_obj):
    posts_generator = discussions_obj.get_discussions("created", query_obj, limit=6000)
    hierarchy = {}
    X = 0
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_replies_count = post['children']
        X += 1
        if post_replies_count > n_respuestas_minimas:
            comment_obj = Comment(authorperm=f"{post_author}/{post_permlink}")
            post_replies_list = comment_obj.get_replies()
            cnt = 0
            valid_replies = []
            for reply in post_replies_list:
                author = reply['author']
                text = reply['body']
                if is_own_author(author):
                    # Jeśli autor jest własny, pomijamy dalsze przetwarzanie tego komentarza
                    continue
                if is_banned(author):
                    continue
                if procesar(text):
                    cnt += 1
                    valid_replies.append(reply)
            if cnt > 3:
                hierarchy[f"{post_author}/{post_permlink}"] = {
                    "post": post,
                    "valid_replies": valid_replies
                }
    return hierarchy

hierarchy_dict = build_hierarchy(d, q)

