# Escribe get_task_list para obtener la lista de nombres de archivos *.xml de la carpeta settings['taskPath'].
# En la primera línea de cada archivo opcionalmente se escribe la cadena: <!-- comment -->
# Presenta la respuesta en formato de lista de objetos {fileName, comment, file_date_str}
@eel.expose
def get_task_list(settings):
    import datetime
    path = settings['taskPath']
    result_list = []
    try:
        # Obtener lista de todos los archivos .xml en el directorio
        for file_name in os.listdir(path):
            if file_name.endswith('.xml'):
                full_path = os.path.join(path, file_name)
                comment = ""
                try:
                    with open(full_path, 'r', encoding='utf-8') as f:
                        first_line = f.readline().strip()
                        # Extraer comentario si existe en el formato <!-- comment -->
                        match = re.match(r'<!--\s*(.*?)\s*-->', first_line)
                        if match:
                            comment = match.group(1)
                except Exception as e:
                    print(f"Error al leer el archivo {file_name}: {e}")
                # Obtener la fecha de modificación del archivo en formato legible
                try:
                    mtime = os.path.getmtime(full_path)
                    file_date_str = datetime.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S")
                except Exception as e:
                    print(f"Error obteniendo la fecha de {file_name}: {e}")
                    file_date_str = ""
                result_list.append({
                    "fileName": file_name,
                    "comment": comment,
                    "file_date_str": file_date_str
                })
        return result_list
    except Exception as e:
        print(f"Error getting task list: {e}")
        return []


