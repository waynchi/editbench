from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np

def cluster_data(features_transformed, cluster_config, n_clusters=2, clustering_method='kmeans'):
    """执行数据聚类。

参数：
    features_transformed (pandas.DataFrame): 转换后的包含参数的DataFrame。
    cluster_config (dict or str): 聚类配置。如果是字典，格式为{新列名: [特征列列表]}；
                                 如果是字符串，表示单个聚类结果的列名。
    n_clusters (int or dict): 聚类数量。如果是字典，格式为{新列名: 聚类数}；
                              如果是整数，用于所有聚类。
    clustering_method (str or dict): 聚类方法。如果是字典，格式为{新列名: 方法}；
                                    如果是字符串，用于所有聚类。

返回：
    pandas.DataFrame: 添加了聚类标签列的DataFrame。"""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()
    result_df = features_transformed.copy()

    # 处理单个聚类的情况（向后兼容）
    if isinstance(cluster_config, str):
        cluster_config = {cluster_config: features_for_clustering.columns.tolist()}
    
    # 处理n_clusters参数
    if isinstance(n_clusters, int):
        n_clusters_dict = {k: n_clusters for k in cluster_config.keys()}
    else:
        n_clusters_dict = n_clusters
    
    # 处理clustering_method参数
    if isinstance(clustering_method, str):
        clustering_method_dict = {k: clustering_method for k in cluster_config.keys()}
    else:
        clustering_method_dict = clustering_method

    for cluster_name, feature_columns in cluster_config.items():
        # 提取当前聚类所需的特征列
        current_features = features_for_clustering[feature_columns]
        
        if clustering_method_dict[cluster_name] == 'kmeans':
            model = KMeans(n_clusters=n_clusters_dict[cluster_name], random_state=42, n_init=10)
            cluster_labels = model.fit_predict(current_features)
            
            # 评估聚类质量（例如，使用轮廓系数）
            if len(np.unique(cluster_labels)) > 1: # 检查所有点都分配到一个簇的情况
                silhouette_avg = silhouette_score(current_features, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters_dict[cluster_name]} кластеров ({cluster_name}): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters_dict[cluster_name]} кластера ({cluster_name}) - все точки в одном кластере.")

        else:
            print(f"Неподдерживаемый метод кластеризации для {cluster_name}: {clustering_method_dict[cluster_name]}")
            continue

        result_df[cluster_name] = cluster_labels
        print(f"Кластеризация '{cluster_name}' выполнена. Метки кластеров добавлены в столбец '{cluster_name}'.")

    return result_df

# 执行聚类（在步骤5之后和步骤6之前）
if 'features_transformed' in locals() and features_transformed is not None:
    # 示例配置：对不同的列集进行独立聚类
    cluster_config = {
        'cluster_features1': ['feature1', 'feature2'],  # 对前两列进行聚类
        'cluster_feature3': ['feature3']  # 对第三列进行聚类
    }
    n_clusters_config = {
        'cluster_features1': 3,  # 第一个聚类的簇数
        'cluster_feature3': 2    # 第二个聚类的簇数
    }
    features_transformed = cluster_data(features_transformed, cluster_config, n_clusters_config)
    
    # 可视化聚类（当有两个数值特征时的示例）
    numerical_features = features_transformed.select_dtypes(include=np.number)
