from pyspark.sql import SparkSession
from pyspark.sql.functions import col

# 创建一个Spark会话
spark = SparkSession.builder.appName("EscrituraParquetADL2").getOrCreate()

# 示例数据（用你的真实数据替换）
# 从API获取数据并进行初步分析
# 这里假设API返回JSON格式数据，需要根据实际情况调整
api_data = spark.read.option("multiline", "true").json("path_to_api_response.json")  # 或者使用适当的API连接器

# 数据探索和分析
print("Schema de los datos:")
api_data.printSchema()

print("Primeras 10 filas:")
api_data.show(10)

print("Conteo de registros:", api_data.count())

print("Estadísticas descriptivas:")
api_data.describe().show()

# 检查 valores nulos
print("Valores nulos por columna:")
for column in api_data.columns:
    null_count = api_data.filter(col(column).isNull()).count()
    print(f"{column}: {null_count} valores nulos")

# 配置与ADL2的连接使用Microsoft ID身份
# 在Synapse的笔记本中不需要显式提供凭据
# Spark将使用notebook的托管身份进行身份验证。

# 指定ADL2中容器和文件夹的路径
container_name = "<your_container_name>"  # 用你的容器名称替换
folder_path = "<your_folder_path>"  # 替换为容器内文件夹的路径
adl2_path = f"abfss://{container_name}@{<your_storage_account_name>}.dfs.core.windows.net/{folder_path}"

# 将DataFrame以parquet格式写入ADL2
api_data.write.parquet(adl2_path, mode="overwrite")

# 可选：读取parquet文件进行验证
df_leido = spark.read.parquet(adl2_path)
df_leido.show()

# 停止 Spark 会话
spark.stop()