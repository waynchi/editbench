def sum_of_four_squares(n):
    """
    Encontra quatro números inteiros não nulos cujos quadrados somam n.
    Retorna uma lista de quatro inteiros não nulos se existir, caso contrário retorna None.
    """
    # Verifica se n é muito pequeno (mínimo é 4 pois são quatro quadrados não nulos)
    if n < 4:
        return None
    
    # Tenta encontrar quatro números cujos quadrados somam n
    for a in range(1, int(n**0.5) + 1):
        for b in range(a, int(n**0.5) + 1):
            for c in range(b, int(n**0.5) + 1):
                d_squared = n - (a*a + b*b + c*c)
                if d_squared < 1:
                    continue
                d = int(d_squared**0.5)
                if d*d == d_squared and d >= c and d >= 1:
                    return [a, b, c, d]
    
    return None

def main():
    """
    Programa principal que encontra números que podem ser expressos como soma de quatro quadrados não nulos.
    """
    print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
    print("Número\tQuadrados")
    print("-" * 30)
    
    count = 0
    for n in range(4, 101):  # Verifica números de 4 a 100
        result = sum_of_four_squares(n)
        if result is not None:
            a, b, c, d = result
            count += 1
            print(f"{n}\t{a}² + {b}² + {c}² + {d}² = {a*a} + {b*b} + {c*c} + {d*d}")
    
    print(f"\nTotal de números encontrados: {count}")

if __name__ == "__main__":
    main()