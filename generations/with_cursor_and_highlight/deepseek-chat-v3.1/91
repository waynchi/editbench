import os
# import hashlib
# import base64

project_name = "CheckerKMV"


def createLicense(secretKey: str) -> None:
    # Caminho para a pasta do projeto em %appdata%/Local
    appdata_path = os.path.join(os.environ["APPDATA"], project_name)

    if not os.path.exists(appdata_path):
        os.makedirs(appdata_path)

    with open(os.path.join(appdata_path, "license.dat"), "wb") as f:
        # Convert the string key to bytes before writing
        f.write(secretKey.encode('utf-8'))

The issue was that you were trying to concatenate a bytes literal `b""` with a string `secretKey`, which causes a TypeError. The solution is to properly encode the string to bytes using the `.encode('utf-8')` method.