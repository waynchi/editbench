def sum_of_four_squares(n):
    """
    Find all representations of n as the sum of four non-zero squares.
    Returns a list of tuples (a, b, c, d) where a² + b² + c² + d² = n
    and 1 <= a <= b <= c <= d.
    """
    solutions = []
    max_val = int(n**0.5) + 1
    
    for a in range(1, max_val):
        for b in range(a, max_val):
            for c in range(b, max_val):
                remaining = n - a*a - b*b - c*c
                if remaining <= 0:
                    break
                
                d = int(remaining**0.5)
                if d < c:  # Ensure d >= c to maintain ordering
                    continue
                    
                if d*d == remaining:
                    solutions.append((a, b, c, d))
    
    return solutions

def main():
    n = int(input("Enter a positive integer: "))
    if n <= 0:
        print("Please enter a positive integer.")
        return
    
    solutions = sum_of_four_squares(n)
    
    if solutions:
        print(f"Representations of {n} as sum of four non-zero squares:")
        for sol in solutions:
            print(f"{n} = {sol[0]}² + {sol[1]}² + {sol[2]}² + {sol[3]}²")
        print(f"Total representations found: {len(solutions)}")
    else:
        print(f"{n} cannot be expressed as the sum of four non-zero squares")

if __name__ == "__main__":
    main()