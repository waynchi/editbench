import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=None):
    """
    使用共轭梯度法求解线性方程组 Ax = b
    
    参数:
    A: 对称正定矩阵 (n x n)
    b: 右侧向量 (n)
    x0: 初始猜测解 (默认为零向量)
    tol: 收敛容差
    max_iter: 最大迭代次数 (默认为n)
    
    返回:
    x: 解向量
    converged: 是否收敛
    iterations: 实际迭代次数
    residuals: 残差历史
    """
    n = len(b)
    
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    if max_iter is None:
        max_iter = n
    
    r = b - A @ x  # 初始残差
    p = r.copy()   # 初始搜索方向
    rs_old = r @ r
    
    residuals = [np.sqrt(rs_old)]
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rs_old / (p @ Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rs_new = r @ r
        
        residuals.append(np.sqrt(rs_new))
        
        if np.sqrt(rs_new) < tol:
            return x, True, i + 1, residuals
        
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new
    
    return x, False, max_iter, residuals

def preconditioned_conjugate_gradient(A, b, M, x0=None, tol=1e-6, max_iter=None):
    """
    使用预处理共轭梯度法求解线性方程组 Ax = b
    
    参数:
    A: 对称正定矩阵 (n x n)
    b: 右侧向量 (n)
    M: 预处理矩阵 (近似A的逆)
    x0: 初始猜测解 (默认为零向量)
    tol: 收敛容差
    max_iter: 最大迭代次数 (默认为n)
    
    返回:
    x: 解向量
    converged: 是否收敛
    iterations: 实际迭代次数
    residuals: 残差历史
    """
    n = len(b)
    
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    if max_iter is None:
        max_iter = n
    
    r = b - A @ x
    z = M @ r  # 预处理残差
    p = z.copy()
    rz_old = r @ z
    
    residuals = [np.sqrt(r @ r)]
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rz_old / (p @ Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        
        residual_norm = np.sqrt(r @ r)
        residuals.append(residual_norm)
        
        if residual_norm < tol:
            return x, True, i + 1, residuals
        
        z = M @ r
        rz_new = r @ z
        p = z + (rz_new / rz_old) * p
        rz_old = rz_new
    
    return x, False, max_iter, residuals