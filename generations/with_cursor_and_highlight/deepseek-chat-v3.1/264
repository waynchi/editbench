def sum_of_four_squares(n):
    """
    Проверяет, можно ли представить число n в виде суммы четырех ненулевых квадратов.
    Возвращает True если возможно, иначе False.
    """
    # Перебираем все возможные комбинации четырех ненулевых квадратов
    for a in range(1, int(n**0.5) + 1):
        for b in range(1, int(n**0.5) + 1):
            for c in range(1, int(n**0.5) + 1):
                for d in range(1, int(n**0.5) + 1):
                    if a*a + b*b + c*c + d*d == n:
                        return True
    return False

# Находим все числа до 100, которые можно представить как сумму четырех ненулевых квадратов
numbers = []
for i in range(1, 101):
    if sum_of_four_squares(i):
        numbers.append(i)

print("Числа, которые могут быть выражены как сумма четырех ненулевых квадратов:")
print(numbers)