import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=None):
    """
    Solve the linear system Ax = b using the Conjugate Gradient method.
    
    Parameters:
    -----------
    A : 2D array
        Symmetric positive definite matrix
    b : 1D array
        Right-hand side vector
    x0 : 1D array, optional
        Initial guess (default: zero vector)
    tol : float, optional
        Tolerance for convergence (default: 1e-6)
    max_iter : int, optional
        Maximum number of iterations (default: len(b))
    
    Returns:
    --------
    x : 1D array
        Solution vector
    converged : bool
        Whether the method converged
    num_iter : int
        Number of iterations performed
    """
    n = len(b)
    if max_iter is None:
        max_iter = n
    
    # Initialize
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    r = b - A.dot(x)
    p = r.copy()
    rs_old = r.dot(r)
    
    for i in range(max_iter):
        Ap = A.dot(p)
        alpha = rs_old / p.dot(Ap)
        x += alpha * p
        r -= alpha * Ap
        rs_new = r.dot(r)
        
        # Check convergence
        if np.sqrt(rs_new) < tol:
            return x, True, i + 1
            
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new
    
    return x, False, max_iter