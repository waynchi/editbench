def sum_of_four_squares(n):
    """
    Znajduje wszystkie sposoby wyrażenia liczby n jako sumy czterech niezerowych kwadratów.
    Zwraca listę krotek (a, b, c, d) takich, że a² + b² + c² + d² = n, gdzie a, b, c, d > 0.
    """
    results = []
    max_val = int(n**0.5) + 1
    
    for a in range(1, max_val):
        for b in range(a, max_val):
            for c in range(b, max_val):
                remaining = n - a*a - b*b - c*c
                if remaining <= 0:
                    continue
                d = int(remaining**0.5)
                if d >= c and d*d == remaining:
                    results.append((a, b, c, d))
    
    return results

def main():
    n = int(input("Podaj liczbę naturalną: "))
    if n < 4:
        print("Liczba musi być co najmniej 4")
        return
    
    representations = sum_of_four_squares(n)
    
    if not representations:
        print(f"Liczby {n} nie można wyrazić jako sumy czterech niezerowych kwadratów")
    else:
        print(f"Sposoby wyrażenia liczby {n} jako sumy czterech niezerowych kwadratów:")
        for a, b, c, d in representations:
            print(f"{n} = {a}² + {b}² + {c}² + {d}² = {a*a} + {b*b} + {c*c} + {d*d}")

if __name__ == "__main__":
    main()