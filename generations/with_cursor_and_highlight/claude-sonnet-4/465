import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=1000):
    """
    Resuelve el sistema lineal Ax = b usando el método de gradientes conjugados.
    
    Parámetros:
    A: matriz simétrica y definida positiva (n x n)
    b: vector del lado derecho (n x 1)
    x0: estimación inicial (opcional, por defecto vector de ceros)
    tol: tolerancia para la convergencia
    max_iter: número máximo de iteraciones
    
    Retorna:
    x: solución del sistema
    residual_norm: norma del residual final
    iterations: número de iteraciones realizadas
    """
    
    n = len(b)
    
    # Inicialización
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    # Calcular residual inicial
    r = b - A @ x
    p = r.copy()
    rsold = r @ r
    
    for i in range(max_iter):
        # Calcular Ap
        Ap = A @ p
        
        # Calcular alpha
        alpha = rsold / (p @ Ap)
        
        # Actualizar x
        x = x + alpha * p
        
        # Actualizar residual
        r = r - alpha * Ap
        
        # Verificar convergencia
        rsnew = r @ r
        if np.sqrt(rsnew) < tol:
            return x, np.sqrt(rsnew), i + 1
        
        # Calcular beta
        beta = rsnew / rsold
        
        # Actualizar dirección de búsqueda
        p = r + beta * p
        
        # Actualizar rsold
        rsold = rsnew
    
    return x, np.sqrt(rsnew), max_iter

# Ejemplo de uso
if __name__ == "__main__":
    # Crear un sistema de prueba
    A = np.array([[4, 1], [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # Resolver usando gradientes conjugados
    x, residual, iterations = conjugate_gradient(A, b)
    
    print(f"Solución: {x}")
    print(f"Residual final: {residual}")
    print(f"Iteraciones: {iterations}")
    print(f"Verificación Ax = {A @ x}")