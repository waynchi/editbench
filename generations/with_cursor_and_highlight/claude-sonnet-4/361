def can_express_as_sum_of_four_nonzero_squares(n):
    """
    Sprawdza, czy liczba n może być wyrażona jako suma czterech niezerowych kwadratów.
    """
    # Generujemy kwadraty do sprawdzenia (ograniczamy do sqrt(n))
    max_val = int(n**0.5) + 1
    squares = [i*i for i in range(1, max_val)]
    
    # Sprawdzamy wszystkie kombinacje czterech kwadratów
    for a in squares:
        if a >= n:
            break
        for b in squares:
            if a + b >= n:
                break
            for c in squares:
                if a + b + c >= n:
                    break
                d_squared = n - a - b - c
                if d_squared > 0:
                    d = int(d_squared**0.5)
                    if d*d == d_squared:
                        return True, (int(a**0.5), int(b**0.5), int(c**0.5), d)
    
    return False, None

def find_numbers_expressible_as_four_nonzero_squares(limit):
    """
    Znajduje wszystkie liczby do 'limit', które można wyrazić jako sumę czterech niezerowych kwadratów.
    """
    results = []
    
    for n in range(4, limit + 1):  # Minimalna suma to 1²+1²+1²+1² = 4
        can_express, representation = can_express_as_sum_of_four_nonzero_squares(n)
        if can_express:
            results.append((n, representation))
    
    return results

# Przykład użycia
if __name__ == "__main__":
    limit = 50
    numbers = find_numbers_expressible_as_four_nonzero_squares(limit)
    
    print(f"Liczby do {limit}, które można wyrazić jako sumę czterech niezerowych kwadratów:")
    for number, (a, b, c, d) in numbers:
        print(f"{number} = {a}² + {b}² + {c}² + {d}² = {a*a} + {b*b} + {c*c} + {d*d}")