import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=1000):
    """
    Metoda sprzężonych gradientów do rozwiązywania układu równań Ax = b
    
    Parametry:
    A - macierz współczynników (musi być symetryczna i dodatnio określona)
    b - wektor prawej strony
    x0 - wektor początkowy (domyślnie wektor zerowy)
    tol - tolerancja błędu
    max_iter - maksymalna liczba iteracji
    
    Zwraca:
    x - rozwiązanie układu równań
    iterations - liczba wykonanych iteracji
    """
    
    n = len(b)
    
    # Inicjalizacja wektora początkowego
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    # Obliczenie początkowego residuum
    r = b - A @ x
    p = r.copy()
    
    rsold = r @ r
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rsold / (p @ Ap)
        
        x = x + alpha * p
        r = r - alpha * Ap
        
        rsnew = r @ r
        
        # Sprawdzenie kryterium zbieżności
        if np.sqrt(rsnew) < tol:
            return x, i + 1
        
        beta = rsnew / rsold
        p = r + beta * p
        
        rsold = rsnew
    
    return x, max_iter

# Przykład użycia
if __name__ == "__main__":
    # Przykładowy układ równań
    A = np.array([[4, 1], [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    solution, iterations = conjugate_gradient(A, b)
    print(f"Rozwiązanie: {solution}")
    print(f"Liczba iteracji: {iterations}")
    print(f"Sprawdzenie: A @ x = {A @ solution}")