import numpy as np

INPUT_FILE_PATH = './input.txt'
INPUT_FILE_PATH = './example_in.txt'

def main():
    lines = parse_input_file()
    # 对每一行进行迭代：
    # 打印(l)
    
    # Filter out empty lines and convert each line to a list of characters
    lines = [line for line in lines if line.strip()]
    char_lists = [list(line) for line in lines]
    
    grid = np.array(char_lists)
    print(grid)
    str_to_match = "XMAS"
    count = 0
    
    # Check if grid is empty or has no shape
    if grid.size == 0 or len(grid.shape) < 2:
        print(f"Found {count} occurrences of {str_to_match}")
        return
    
    # 水平检查
    for row in grid:
        row_str = ''.join(row)
        count += row_str.count(str_to_match)
        count += row_str[::-1].count(str_to_match)  # Check reverse

    # 垂直检查
    for col in range(grid.shape[1]):
        col_str = ''.join(grid[:,col])
        count += col_str.count(str_to_match)
        count += col_str[::-1].count(str_to_match)  # Check reverse

    # 检查对角线（从左上到右下）
    for i in range(-(grid.shape[0]-1), grid.shape[1]):
        diag = np.diagonal(grid, offset=i)
        diag_str = ''.join(diag)
        count += diag_str.count(str_to_match)
        count += diag_str[::-1].count(str_to_match)  # Check reverse

    # 检查对角线（从右上到左下）
    flipped_grid = np.fliplr(grid)
    for i in range(-(grid.shape[0]-1), grid.shape[1]):
        diag = np.diagonal(flipped_grid, offset=i)
        diag_str = ''.join(diag)
        count += diag_str.count(str_to_match)
        count += diag_str[::-1].count(str_to_match)  # Check reverse

    print(f"Found {count} occurrences of {str_to_match}")

def parse_input_file():
    with open(INPUT_FILE_PATH, 'r') as f:
        lines = f.read().split("\n")
    return lines

if __name__ == "__main__":
    main()