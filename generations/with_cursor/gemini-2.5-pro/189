import torch.nn as nn

class SimpleConvNet1(nn.Module):
    # 修复后的版本不再需要外部传入 flattened_size。
    # 模型现在是自包含的，它假设一个固定的输入尺寸（例如 32x32）
    # 来计算全连接层的输入维度。
    def __init__(self):
        super().__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.flatten = nn.Flatten()
        
        # 基于一个假定的32x32输入图像，计算展平后的大小：
        # 输入: (N, 3, 32, 32)
        # 经过 conv1 和 maxpool: (N, 32, 15, 15)
        # 经过 conv2 和 maxpool: (N, 64, 6, 6)
        # 展平后的大小 = 64 * 6 * 6 = 2304
        self.fc1 = nn.Sequential(
            nn.Linear(2304, 512),  # 使用计算出的固定大小
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x