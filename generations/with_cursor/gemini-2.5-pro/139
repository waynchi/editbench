import math

def find_sums_of_four_nonzero_squares(limit):
    """
    Finds all numbers up to a given limit that can be expressed as the sum of four non-zero squares.
    This is an efficient implementation that generates sums from squares instead of decomposing each number.
    
    Returns a dictionary where keys are the numbers and values are a tuple (a, b, c, d)
    representing one such sum n = a^2 + b^2 + c^2 + d^2.
    """
    results = {}
    # To avoid permutations and improve efficiency, we enforce 1 <= a <= b <= c <= d
    # and calculate tighter loop bounds.
    limit_a = int(math.sqrt(limit / 4)) + 1
    for a in range(1, limit_a):
        a2 = a * a
        
        limit_b = int(math.sqrt((limit - a2) / 3)) + 1
        for b in range(a, limit_b):
            b2 = b * b
            
            limit_c = int(math.sqrt((limit - a2 - b2) / 2)) + 1
            for c in range(b, limit_c):
                c2 = c * c
                
                remaining_for_d2 = limit - a2 - b2 - c2
                if remaining_for_d2 <= 0:
                    continue
                
                d = int(math.sqrt(remaining_for_d2))
                # We only need to check this one value for d, but ensure d >= c
                if d >= c:
                    d2 = d * d
                    n = a2 + b2 + c2 + d2
                    # We only store the first decomposition found for each number n.
                    if n not in results:
                        results[n] = (a, b, c, d)
                        
    return results

# Main execution block
try:
    # The user instruction is in Chinese, so we make the UI consistent.
    limit = int(input("请输入上限: "))
    
    # The smallest sum of four non-zero squares is 1^2+1^2+1^2+1^2 = 4
    if limit < 4:
        print("没有找到符合条件的数字 (最小为 4)。")
    else:
        sums_found = find_sums_of_four_nonzero_squares(limit)
        
        # Sort the numbers for a clean, ordered output
        sorted_nums = sorted(sums_found.keys())
        
        print("\n可以表示为四个非零平方和的数字：")
        if not sorted_nums:
            print("在指定范围内没有找到符合条件的数字。")
        else:
            for num in sorted_nums:
                a, b, c, d = sums_found[num]
                print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")

except ValueError:
    print("无效输入，请输入一个整数。")