import pandas as pd
# Предполагается, что файл main13.py существует и содержит обученные модели knn и mlp.
# Если возникает ошибка ImportError, необходимо создать этот файл и загрузить/обучить в нем модели.
# Например, main13.py может выглядеть так:
#
# import joblib
# knn = joblib.load('knn_model.pkl')
# mlp = joblib.load('mlp_model.pkl')
#
from main13 import knn, mlp

# Модели, скорее всего, были обучены на определенном наборе столбцов в определенном порядке.
# Крайне важно воспроизвести эту структуру для предсказания.
# Предположим, что это столбцы из обучающих данных после обработки.
# Исходный столбец 'Embarked' заменяется на столбцы one-hot кодирования.
TRAINING_COLUMNS = [
    'Pclass', 'Name', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare',
    'Embarked_C', 'Embarked_Q', 'Embarked_S'
]

# Определяем все возможные категории для 'Embarked', чтобы get_dummies работал корректно
embarked_categories = ["S", "Q", "C"]

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in embarked_categories:
            # 1. Создаем словарь с данными для одного предсказания.
            # Значения должны быть в списках, чтобы создать DataFrame из одной строки.
            data = {
                "Pclass": [pclass],
                "Name": [24],
                "Sex": [0],
                "Age": [19],
                "SibSp": [0],
                "Parch": [0],
                "Fare": [fare],
                "Embarked": [embarked]
            }
            my_df = pd.DataFrame(data)

            # 2. Корректно выполняем one-hot кодирование.
            # Преобразование 'Embarked' в категориальный тип сообщает pandas обо всех
            # возможных категориях. Таким образом, get_dummies создаст столбцы для всех
            # категорий, даже для тех, которых нет в текущей строке.
            my_df['Embarked'] = pd.Categorical(my_df['Embarked'], categories=embarked_categories)
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked", dtype=int)

            # 3. Гарантируем, что DataFrame имеет те же столбцы и в том же порядке,
            # что и данные для обучения. reindex добавит недостающие столбцы (заполнив их 0)
            # и упорядочит их правильно. Это предотвращает ошибки несоответствия признаков.
            prediction_df = my_df.reindex(columns=TRAINING_COLUMNS, fill_value=0)

            # 4. Делаем предсказания.
            # Метод .predict() возвращает массив, поэтому мы берем первый элемент [0].
            knn_prediction = knn.predict(prediction_df)[0]
            mlp_prediction = mlp.predict(prediction_df)[0]

            print(f"""-------------------------------------------------------
                  Параметры: класс {pclass}, плата {fare}, embarked {embarked}
                  По knn: {knn_prediction}
                  По mlp: {mlp_prediction}""")