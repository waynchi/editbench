import math

def find_four_squares_sums(limit):
    """
    Finds all numbers up to a limit that can be expressed as the sum of four
    non-zero squares, and returns one such decomposition for each number.

    This is done by generating sums of four non-zero squares directly, which is
    more efficient than testing each number up to the limit.
    The result is a dictionary mapping each number to a tuple of its four square roots.
    """
    results = {}
    # To avoid duplicate permutations (e.g., 1,1,2,3 vs 3,2,1,1), we enforce a >= b >= c >= d.
    # The loops start from 1 to ensure all squares are non-zero.

    max_val = int(math.sqrt(limit))

    for a in range(1, max_val + 1):
        a2 = a * a
        # Optimization: if a^2 + 1^2 + 1^2 + 1^2 is already over the limit, we can stop.
        if a2 + 3 > limit:
            break
        for b in range(1, a + 1):
            b2 = b * b
            sum_ab = a2 + b2
            # Optimization: if a^2 + b^2 + 1^2 + 1^2 is over the limit, try next 'b'.
            if sum_ab + 2 > limit:
                break
            for c in range(1, b + 1):
                c2 = c * c
                sum_abc = sum_ab + c2
                # Optimization: if a^2 + b^2 + c^2 + 1^2 is over the limit, try next 'c'.
                if sum_abc + 1 > limit:
                    break
                for d in range(1, c + 1):
                    d2 = d * d
                    n = sum_abc + d2

                    if n > limit:
                        break

                    # If we haven't found a decomposition for n yet, store this one.
                    if n not in results:
                        results[n] = (a, b, c, d)
    return results

def main():
    """
    Main function to get user input and print the results.
    This version corrects the bugs and inefficiencies of the original code.
    """
    try:
        # Using Portuguese as in the original code for user interaction.
        limit_str = input("Digite o limite superior: ")
        limit = int(limit_str)

        if limit < 4:
            # The smallest sum of four non-zero squares is 1^2+1^2+1^2+1^2 = 4.
            print("\nNenhum número abaixo de 4 pode ser expresso como a soma de quatro quadrados não nulos.")
        else:
            sums_found = find_four_squares_sums(limit)

            print("\nNúmeros que podem ser expressos como a soma de quatro quadrados não nulos:")

            if not sums_found:
                print(f"Nenhum número encontrado até o limite de {limit}.")
            else:
                # Sort the results by the number 'n' for ordered printing.
                for num in sorted(sums_found.keys()):
                    a, b, c, d = sums_found[num]
                    print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")

    except ValueError:
        print("Entrada inválida. Por favor, digite um número inteiro.")

if __name__ == "__main__":
    main()