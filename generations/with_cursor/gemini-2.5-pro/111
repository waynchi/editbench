# env: pyAI

import os
from openai import OpenAI
import json

def save_conversation(conversation_history, filename="conversation_history.json"):
    """Saves the conversation history to a JSON file."""
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(conversation_history, f, ensure_ascii=False, indent=4)
    print(f"\nConversation saved to {filename}.")


def load_conversation(filename="conversation_history.json"):
    """Loads a conversation history from a JSON file."""
    try:
        with open(filename, "r", encoding="utf-8") as f:
            content = f.read()
            if not content:
                print(f"Warning: {filename} is empty. Starting a new conversation.")
                return None
            conversation_history = json.loads(content)
        print(f"Conversation history from {filename} loaded successfully.")
        return conversation_history
    except FileNotFoundError:
        print(f"No saved conversation history found for {filename}.")
        return None
    except json.JSONDecodeError:
        print(f"Error decoding JSON from {filename}. File may be corrupt. Starting a new conversation.")
        return None


# --- Client Setup ---
# It's better practice to get the API key from an environment variable.
api_key = os.environ.get("OPENAI_API_KEY", "XXXXXXXXXXXXXXXXXXXXXXXXXXXX")
if api_key == "XXXXXXXXXXXXXXXXXXXXXXXXXXXX":
    print("Warning: Using a placeholder API key. For this to work, please set the OPENAI_API_KEY environment variable.")

endpoint = "https://models.inference.ai.azure.com"
model_name = "gpt-4o"

client = OpenAI(
    base_url=endpoint,
    api_key=api_key,
)

# --- Conversation Loading Logic ---
conversation_history = []
save_filename = "conversation_history.json"  # Default save filename

load_history_choice = input("Do you want to load a conversation history? (yes/no): ").strip().lower()

if load_history_choice == "yes":
    history_files = [f for f in os.listdir() if f.endswith(".json")]
    if history_files:
        print("\nAvailable conversation history files:")
        for i, file in enumerate(history_files, 1):
            print(f"{i}. {file}")
        
        try:
            choice_str = input(f"Enter the number of the file to load (1-{len(history_files)}): ")
            choice_idx = int(choice_str) - 1
            if 0 <= choice_idx < len(history_files):
                filename_to_load = history_files[choice_idx]
                loaded_history = load_conversation(filename_to_load)
                if loaded_history:
                    conversation_history = loaded_history
                    save_filename = filename_to_load  # Set to save back to the loaded file
            else:
                print("Invalid number. Starting a new conversation.")
        except (ValueError, IndexError):
            print("Invalid input. Starting a new conversation.")
    else:
        print("No conversation history files found. Starting a new conversation.")

# If after attempting to load, the history is still empty, initialize a new one.
if not conversation_history:
    print("Initializing new conversation history.")
    conversation_history = [
        {
            "role": "system",
            "content": "You are a helpful assistant.",
        }
    ]
    # If we are starting a brand new chat, ask for a filename
    if load_history_choice != 'yes':
        new_filename = input("Enter filename for this new conversation (e.g., chat1.json, press Enter for default): ").strip()
        if new_filename:
            if not new_filename.endswith('.json'):
                new_filename += '.json'
            save_filename = new_filename

# --- Main Conversation Loop ---
print("\nStarting chat. Type 'exit' or 'quit' to end the conversation.")
while True:
    user_input = input("User: ")
    if user_input.lower() in ["exit", "quit"]:
        print("Exiting the conversation.")
        break

    conversation_history.append({
        "role": "user",
        "content": user_input
    })

    try:
        response = client.chat.completions.create(
            messages=conversation_history,
            temperature=1.0,
            top_p=1.0,
            max_tokens=4086,
            model=model_name
        )

        # The response message is an object, not a dict. Use .model_dump() to get a serializable dictionary.
        assistant_message = response.choices[0].message.model_dump()
        conversation_history.append(assistant_message)
        print("GPT:", assistant_message['content'])

    except Exception as e:
        print(f"An error occurred: {e}")
        # Remove the user's last message so they can try again without it being saved on error
        conversation_history.pop()
        print("There was an error with the API call. Please try your message again.")


# Save the conversation history at the end if there's more than the system prompt
if len(conversation_history) > 1:
    save_conversation(conversation_history, save_filename)
else:
    print("No conversation to save.")