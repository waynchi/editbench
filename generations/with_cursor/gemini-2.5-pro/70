from main13 import knn, mlp
import pandas as pd

# Initialize the results DataFrame *before* the loops.
# The dtype must be 'object' to store complex data like dictionaries in the cells.
# This, along with moving the initialization out of the loop, fixes the error.
np_df = pd.DataFrame(index=range(10, 200, 10), columns=[1, 2, 3], dtype=object)

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
            # Create a sample DataFrame for prediction. It has 3 rows to test
            # the three different 'Embarked' possibilities.
            my_df = pd.DataFrame({
                "Pclass": [pclass]*3,
                "Name": [24]*3,
                "Sex": [0]*3, 
                "Age": [19]*3,
                "SibSp": [0]*3,
                "Parch": [0]*3,
                "Fare": [fare]*3,
                "Embarked": ["S", "Q", "C"]
            })
            
            # A more efficient way to do one-hot encoding to integers (0 or 1)
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked", dtype=int)

            # Ensure all possible 'Embarked' columns exist, in case the sample data changes.
            for col in ['Embarked_S', 'Embarked_C', 'Embarked_Q']:
                if col not in my_df.columns:
                    my_df[col] = 0

            # Make predictions. Each call returns an array of 3 predictions, one for each row.
            knn_predictions = knn.predict(my_df)
            mlp_predictions = mlp.predict(my_df)
            
            # Assign the dictionary of prediction arrays to the specific cell.
            # This now works because np_df has dtype=object.
            np_df.loc[fare, pclass] = {"knn": knn_predictions, "mlp": mlp_predictions}

print(np_df)