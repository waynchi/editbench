import requests
import json

def interact_with_local_llm(prompt, base_url="http://localhost:11434"):
    """
    Interact with a local LLM using the Ollama API, handling a streaming response.

    The original code failed because it tried to parse a streaming response
    (multiple JSON objects separated by newlines) as a single JSON object.
    This implementation corrects that by iterating through the streaming response
    line by line, parsing each JSON object, and concatenating the results.

    :param prompt: The input prompt for the LLM.
    :param base_url: The base URL of the Ollama API.
    :return: The complete response from the LLM as a single string, or None on error.
    """
    endpoint = f"{base_url}/api/generate"
    
    # Payload for the Ollama API. 'stream' is set to True to handle the response
    # as a stream of JSON objects. The 'max_tokens' parameter has been corrected
    # to 'num_predict' and placed inside the 'options' dictionary.
    payload = {
        "model": "llama3.2:latest",  # Replace with your model name
        "prompt": prompt,
        "stream": True,
        "options": {
            "num_predict": 2048  # Adjust as needed
        }
    }
    headers = {
        "Content-Type": "application/json"
    }
    
    response_parts = []
    try:
        # Make the request with stream=True to handle the response as a stream
        with requests.post(endpoint, json=payload, headers=headers, stream=True) as response:
            response.raise_for_status()
            
            # Iterate over the response line by line
            for line in response.iter_lines():
                if line:
                    # Each line is a JSON object, decode it
                    chunk = json.loads(line.decode('utf-8'))
                    # Append the 'response' part to our list of parts
                    response_parts.append(chunk.get('response', ''))
                    
                    # The 'done' key is True in the final chunk
                    if chunk.get('done', False):
                        break
        
        # Join all the parts to form the complete response
        return "".join(response_parts)
        
    except (requests.exceptions.RequestException, json.JSONDecodeError) as e:
        print(f"An error occurred: {e}")
        return None

# Example usage
if __name__ == "__main__":
    prompt = "Hello, how are you?"
    response = interact_with_local_llm(prompt)
    if response:
        print(f"LLM Response: {response}")
    else:
        print("Failed to get a response from the LLM.")