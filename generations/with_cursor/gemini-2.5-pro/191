@eel.expose
def get_task_list(settings):
    """
    从文件夹 settings['taskPath'] 中获取 *.xml 文件的名称列表。
    每个文件的第一行可选地记录一行：<!-- comment -->
    将答案表示为对象列表的格式 {fileName, comment, file_date_str}
    """
    path = settings.get('taskPath')
    if not path or not os.path.isdir(path):
        print(f"错误：任务路径 '{path}' 不是一个有效的目录。")
        return []

    tasks = []
    try:
        for filename in os.listdir(path):
            if filename.endswith('.xml'):
                file_path = os.path.join(path, filename)
                if not os.path.isfile(file_path):
                    continue

                comment = ''
                file_date_str = ''
                try:
                    # 获取文件修改日期
                    mtime = os.path.getmtime(file_path)
                    file_date_str = datetime.fromtimestamp(mtime).strftime('%Y-%m-%d %H:%M:%S')

                    # 读取第一行以获取注释
                    with open(file_path, 'r', encoding='utf-8') as f:
                        first_line = f.readline().strip()
                        match = re.match(r'<!--\s*(.*?)\s*-->', first_line)
                        if match:
                            comment = match.group(1)
                except Exception as e:
                    print(f"处理文件 {filename} 时出错: {e}")

                tasks.append({
                    'fileName': filename,
                    'comment': comment,
                    'file_date_str': file_date_str
                })
        # 按日期降序排序，最新的在前
        tasks.sort(key=lambda x: x['file_date_str'], reverse=True)
        return tasks
    except FileNotFoundError:
        print(f"错误：找不到目录 '{path}'")
        return []
    except Exception as e:
        print(f"获取任务列表时出错: {e}")
        return []


