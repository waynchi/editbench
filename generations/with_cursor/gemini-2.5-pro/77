import { useState, useEffect, useCallback, useMemo } from 'react';

// Helper to create the initial date range, keeping logic outside the component
const getInitialDateRange = () => {
  const endDate = new Date();
  const startDate = new Date();
  startDate.setFullYear(startDate.getFullYear() - 1);
  return { startDate, endDate };
};

/**
 * An optimized custom hook to fetch and manage dashboard data.
 *
 * Optimizations include:
 * - Granular state management with multiple `useState` hooks for clarity and performance.
 * - Decoupled data fetching from client-side calculations.
 * - Efficient derived state calculation with `useMemo` for `healthData`.
 * - Optimized `healthData` algorithm (O(N+M) vs O(N*M)).
 * - More stable `actions` object identity to prevent unnecessary consumer re-renders.
 * - A flatter, more ergonomic return signature.
 */
function useDashboardData(user) {
  // 1. State Management: Split into logical, independent pieces.
  const [customerData, setCustomerData] = useState({ summary: null, customers: [] });
  const [stripeApiKey, setStripeApiKey] = useState("");
  const [dateRange, setDateRange] = useState(getInitialDateRange());
  const [error, setError] = useState(null);

  // Separate loading states for better control and insight.
  const [isDataLoading, setIsDataLoading] = useState(false);
  const [isWebsiteChecking, setIsWebsiteChecking] = useState(false);

  // 2. Data Fetching Effects: Self-contained and with clearly defined dependencies.
  useEffect(() => {
    if (!user?.id) return;

    const loadSettings = async () => {
      try {
        const response = await fetch("/api/db/churnary_user_settings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            query: "SELECT stripe_api_key FROM `user_settings` WHERE `user_id` = ? LIMIT 1",
            values: [user.id],
          }),
        });
        
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const settings = await response.json();
        setStripeApiKey(settings[0]?.stripe_api_key || "");
      } catch (err) {
        setError("Failed to load user settings");
      }
    };

    loadSettings();
  }, [user?.id]);

  useEffect(() => {
    if (!user?.id || !stripeApiKey) return;

    const loadData = async () => {
      setIsDataLoading(true);
      setError(null);
      try {
        const response = await fetch("/api/stripe-customer-summary", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: user.id }),
        });

        if (!response.ok) throw new Error("Failed to fetch customer summary");
        const summary = await response.json();
        if (summary.error) throw new Error(summary.error);

        setCustomerData({
          summary,
          customers: summary.customers, // Keep original list for re-checking websites
        });
      } catch (err) {
        setError(err.message);
      } finally {
        setIsDataLoading(false);
      }
    };

    loadData();
  }, [user?.id, stripeApiKey]);

  // 3. Derived State: Efficiently calculate `healthData` only when its sources change.
  const healthData = useMemo(() => {
    const customers = customerData.summary?.customers;
    if (!customers || customers.length === 0) return [];

    // O(C) pass: Group customers by month for efficient lookup.
    const customerCountsByMonth = new Map();
    for (const customer of customers) {
      const customerDate = new Date(customer.created);
      const monthYear = `${customerDate.toLocaleString("default", { month: "short" })} ${customerDate.getFullYear()}`;
      
      if (!customerCountsByMonth.has(monthYear)) {
        customerCountsByMonth.set(monthYear, { healthy: 0, warning: 0, critical: 0 });
      }
      const counts = customerCountsByMonth.get(monthYear);
      
      if (customer.status === "active") counts.healthy++;
      else if (customer.status === "churned") counts.warning++;
      else if (customer.status === "delinquent") counts.critical++;
    }

    // O(M) pass: Generate the final data structure for the selected date range.
    const result = [];
    const currentDate = new Date(dateRange.startDate);
    currentDate.setDate(1); // Normalize to start of the month to avoid day-of-month issues.
    const endDate = new Date(dateRange.endDate);

    while (currentDate <= endDate) {
      const month = currentDate.toLocaleString("default", { month: "short" });
      const year = currentDate.getFullYear();
      const monthYear = `${month} ${year}`;
      
      const counts = customerCountsByMonth.get(monthYear) || { healthy: 0, warning: 0, critical: 0 };
      result.push({ monthYear, ...counts });
      
      currentDate.setMonth(currentDate.getMonth() + 1);
    }

    return result;
  }, [customerData.summary, dateRange]);

  // 4. Actions: Use useCallback for stable function identities.
  const checkWebsites = useCallback(async () => {
    if (!customerData.customers?.length) return;
    
    setIsWebsiteChecking(true);
    setError(null);
    try {
      const updatedCustomers = await Promise.all(
        customerData.customers.map(async (customer) => {
          const response = await fetch("/api/website-churn-detector", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ websiteUrl: customer.website }),
          });
          const health = await response.json();
          return { ...customer, health, status: health.status === "active" ? "active" : "churned" };
        })
      );

      const newSummary = {
        ...customerData.summary,
        customers: updatedCustomers,
        active: updatedCustomers.filter(c => c.status === "active").length,
        churned: updatedCustomers.filter(c => c.status === "churned").length,
      };

      setCustomerData(prev => ({ ...prev, summary: newSummary }));
    } catch (err) {
      setError("Failed to check websites. Please try again.");
    } finally {
      setIsWebsiteChecking(false);
    }
  }, [customerData.customers, customerData.summary]);

  const setDateRangeAction = useCallback((range) => {
    if (range.startDate > range.endDate) {
      setError("Start date cannot be after end date");
      return;
    }
    setError(null);
    setDateRange(range);
  }, []);

  const clearError = useCallback(() => {
    setError(null);
  }, []);

  // Memoize the actions object itself for a more stable identity.
  const actions = useMemo(() => ({
    checkWebsites,
    setDateRange: setDateRangeAction,
    clearError,
  }), [checkWebsites, setDateRangeAction, clearError]);

  // 5. Return Value: A flattened, ergonomic API for the consumer.
  return { 
    // Data
    customerData: customerData.summary,
    healthData,
    dateRange,
    stripeApiKey,
    error,
    // Status
    isLoading: isDataLoading || isWebsiteChecking,
    isCheckingWebsites: isWebsiteChecking,
    // Actions
    actions,
  };
}

export default useDashboardData;