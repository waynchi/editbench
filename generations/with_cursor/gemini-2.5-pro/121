def create_matrix(rows: int, cols: int, fill_value=0) -> list:
    """
    Creates a matrix of size rows x cols, filled with fill_value.
    Parameters:
    rows (int): number of rows.
    cols (int): number of columns.
    fill_value (any type): value to fill the matrix.
    Returns:
    list: matrix as a list of lists.
    """
    return [[fill_value for _ in range(cols)] for _ in range(rows)]


def add_matrices(matrix_a: list, matrix_b: list) -> list:
    """
    Adds two matrices of the same size.
    Parameters:
    matrix_a (list): first matrix.
    matrix_b (list): second matrix.
    Returns:
    list: result of matrix addition.
    """
    # Assuming matrices have the same dimensions as per the task description
    rows = len(matrix_a)
    cols = len(matrix_a[0])
    
    result = [[matrix_a[i][j] + matrix_b[i][j] for j in range(cols)] for i in range(rows)]
    return result


def scalar_multiply(matrix: list, scalar: float) -> list:
    """
    Multiplies all elements of a matrix by a scalar.
    Parameters:
    matrix (list): original matrix.
    scalar (float): number by which matrix elements are multiplied.
    Returns:
    list: result of matrix scalar multiplication.
    """
    return [[element * scalar for element in row] for row in matrix]


def multiply_matrices(matrix_a: list, matrix_b: list) -> list:
    """
    Multiplies two matrices.
    Parameters:
    matrix_a (list): first matrix.
    matrix_b (list): second matrix.
    Returns:
    list: result of matrix multiplication.
    """
    # Get dimensions
    rows_a = len(matrix_a)
    cols_a = len(matrix_a[0])
    rows_b = len(matrix_b)
    cols_b = len(matrix_b[0])

    # Assuming valid dimensions for multiplication (cols_a == rows_b)
    # The result matrix will have dimensions rows_a x cols_b
    result = create_matrix(rows_a, cols_b)

    # Perform multiplication
    for i in range(rows_a):
        for j in range(cols_b):
            for k in range(cols_a):  # or range(rows_b)
                result[i][j] += matrix_a[i][k] * matrix_b[k][j]
    
    return result


def transpose_matrix(matrix: list) -> list:
    """
    Transposes a matrix.
    Parameters:
    matrix (list): original matrix.
    Returns:
    list: transposed matrix.
    """
    if not matrix:
        return []
    
    rows = len(matrix)
    cols = len(matrix[0])
    
    # Create a new matrix with swapped dimensions
    transposed = create_matrix(cols, rows)
    
    for i in range(rows):
        for j in range(cols):
            transposed[j][i] = matrix[i][j]
            
    return transposed


def determinant_3x3(matrix: list) -> float:
    """
    Calculates the determinant of a 3x3 matrix.
    Parameters:
    matrix (list): original 3x3 matrix.
    Returns:
    float: determinant of the matrix.
    """
    # Assuming the matrix is 3x3 as per the function name and task description
    a11 = matrix[0][0]
    a12 = matrix[0][1]
    a13 = matrix[0][2]
    a21 = matrix[1][0]
    a22 = matrix[1][1]
    a23 = matrix[1][2]
    a31 = matrix[2][0]
    a32 = matrix[2][1]
    a33 = matrix[2][2]

    det = (a11 * (a22 * a33 - a23 * a32) -
           a12 * (a21 * a33 - a23 * a31) +
           a13 * (a21 * a32 - a22 * a31))
           
    return float(det)