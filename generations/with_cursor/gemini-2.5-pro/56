# The original implementation was replaced with a corrected and vectorized version
# to fix a ValueError and improve performance.

# Нужно ускорить и переписать функцию medcouple
def medcouple(data):
    """
    Computes the medcouple, a robust measure of skewness.
    This implementation is a vectorized version which is faster than a naive loop-based approach.
    It fixes a ValueError that occurred in the previous vectorization attempt.
    """
    data = np.sort(data)
    median = np.median(data)

    # Split data into values less than or equal to the median, and greater than or equal to the median.
    left = data[data <= median]
    right = data[data >= median]

    # The original helper functions `h` and `special_h` were not vectorized,
    # causing a ValueError when called with numpy arrays.
    # The functions below are vectorized to handle array inputs correctly.

    # Vectorized kernel function h(xi, xj)
    def h_vec(xi, xj):
        numerator = (xj - median) - (median - xi)
        denominator = xj - xi
        # Use np.where to handle the case where xi == xj, preventing division by zero.
        return np.where(denominator != 0, numerator / denominator, 0)

    # Vectorized special kernel for cases with repeated medians
    def special_h_vec(i, j, k):
        # This vectorizes the original special_h logic:
        # if i + j - 1 < k: return -1
        # elif i + j - 1 == k: return 0
        # else: return 1
        # This logic can be concisely expressed using np.sign.
        return np.sign(i + j - (k + 1))

    # Count of repeated median values
    k = np.sum(data == median)

    # Use numpy broadcasting to create all pairs (xi, xj) from left and right arrays
    xi, xj = np.meshgrid(left, right, indexing='ij')

    if k > 1:
        # If there are repeated median values, a special kernel is needed for pairs of medians.
        # Create corresponding index pairs (i, j)
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        i, j = np.meshgrid(left_indices, right_indices, indexing='ij')

        # Calculate the h_matrix using np.where and the vectorized helpers.
        # The condition selects pairs where both values are the median,
        # and applies the special kernel to them.
        h_matrix = np.where(
            (xi == median) & (xj == median),
            special_h_vec(i, j, k),
            h_vec(xi, xj)
        )
    else:
        # No repeated medians, so no need for special handling
        h_matrix = h_vec(xi, xj)

    # The medcouple is the median of all h values.
    # np.median automatically flattens the array.
    return np.median(h_matrix)


def adjusted_boxplot_bounds(data):
    """
    Вычисляет границы adjusted boxplot с учетом skewness-adjusted fences.
    """
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """
    Нормализация с использованием adjusted boxplot.
    """
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

