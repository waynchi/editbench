import random
import string
from beem.discussions import Discussions, Query
from beem.comment import Comment

# --- Configuration ---
n_respuestas_minimas = 5
BOT_AUTHOR = 'subidu'
list_banned = []

# --- Helper Functions ---

def procesar(texto: str) -> bool:
    """Checks if the text contains the target phrase."""
    return "count me " in texto.lower()

def is_own_author(autor: str) -> bool:
    """Checks if the author is the bot itself."""
    return autor == BOT_AUTHOR

def is_banned(autor: str) -> bool:
    """Checks if the author is in the banned list."""
    return autor in list_banned

def generar_permlink_unico() -> str:
    """Generates a unique permlink for a new comment."""
    return "".join(random.choices(string.ascii_lowercase + string.digits, k=10))

def preparar_comentario(parent_author: str, parent_permlink: str, permlink: str, title: str = '', author: str = BOT_AUTHOR, body: str = 'Count me in ^^ @subidu') -> dict:
    """Prepares the dictionary for a new comment."""
    return {
        "parent_author": parent_author,
        "parent_permlink": parent_permlink,
        "author": author,
        "permlink": permlink,
        "title": title,
        "body": body,
    }

# --- New Function to Create Hierarchical Dictionary ---

def create_hierarchical_dict(posts_iterator) -> dict:
    """
    Creates a hierarchical dictionary from a post iterator.
    The structure is:
    {
        "post_author/permlink": {
            "post_data": <Comment object for the post>,
            "replies": {
                "reply_author/permlink": <Comment object for the reply>,
                ...
            }
        },
        ...
    }
    """
    hierarchical_data = {}
    print("Building hierarchical dictionary from posts...")
    for post in posts_iterator:
        post_authorperm = post.authorperm
        
        # Initialize the entry for the post
        hierarchical_data[post_authorperm] = {
            'post_data': post,
            'replies': {}
        }
        
        # If the post has children, fetch the full reply objects
        if post.get('children', 0) > 0:
            try:
                # get_replies() fetches all comments for the post
                replies = post.get_replies()
                for reply in replies:
                    reply_authorperm = reply.authorperm
                    hierarchical_data[post_authorperm]['replies'][reply_authorperm] = reply
            except Exception as e:
                print(f"Error fetching replies for {post_authorperm}: {e}")
                
    print("Finished building dictionary.")
    return hierarchical_data

# --- Main Execution Logic ---

# Setup beem components
q = Query()
