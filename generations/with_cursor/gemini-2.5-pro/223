import numpy as np
from typing import Dict, Tuple
from simulator.model.bidder import _Bidder
from simulator.simulation.modules import History
from simulator.model.traffic import Traffic


class Mystique(_Bidder):
    """
    Mystique bidder implements a PID-like controller to adjust bids.

    It aims to follow a target spending curve derived from historical traffic
    patterns, adjusting the bid based on the current spending error (proportional
    term) and the rate of spending error (derivative term). Bids are only
    updated periodically to dampen oscillations.
    """
    default_params = {
        'traffic_path': '../data/traffic_share.csv',
        'PF0': 300,      # Initial bid price
        'C_MAX': 50,     # Max correction factor
        'C_MIN': 5,      # Min correction factor
        'E_MAX': 10,     # Max spend error for scaling correction
        'E_GMC': 10      # Max gradient error for scaling correction
    }

    def __init__(self, params: dict = None):
        """
        Initializes the Mystique bidder.

        Args:
            params (dict, optional): A dictionary of parameters to override
                                     the defaults. Defaults to None.
        """
        super().__init__()

        self.count = 0
        params = params or {}

        self.traffic = Traffic(path=params.get(
            "traffic_path", self.default_params['traffic_path']
        ))
        self.initial_bid = params.get('PF0', self.default_params['PF0'])
        self.C_MAX = params.get('C_MAX', self.default_params['C_MAX'])
        self.C_MIN = params.get('C_MIN', self.default_params['C_MIN'])
        self.E_MAX = params.get('E_MAX', self.default_params['E_MAX'])
        self.E_GMC = params.get('E_GMC', self.default_params['E_GMC'])

        self.balance_previous = np.array([])
        self.bid_previous = np.array([])
        self.timestamp_previous = np.array([])

    def _update_history(self, balance: float, timestamp: int, bid: float):
        """Appends the latest bidding round data to the history arrays."""
        self.balance_previous = np.pad(
            self.balance_previous, pad_width=[0, 1], constant_values=balance
        )
        self.timestamp_previous = np.pad(
            self.timestamp_previous, pad_width=[0, 1], constant_values=timestamp
        )
        self.bid_previous = np.pad(
            self.bid_previous, pad_width=[0, 1], constant_values=bid
        )

    def _get_initial_day_balance(self, campaign_start_time: int,
                                 day_of_campaign: int,
                                 initial_campaign_balance: float,
                                 current_hour: int) -> float:
        """
        Determines the starting balance for the current day.
        """
        if day_of_campaign == 0:
            return initial_campaign_balance

        # Get the hour of the day for each previous timestamp.
        hour_previous = [(t - campaign_start_time) // 3600 % 24
                         for t in self.timestamp_previous]

        # Heuristic: If the last recorded hour is greater than the current
        # hour, a day change just occurred. The last balance is the new day's
        # initial balance.
        if hour_previous[-1] > current_hour:
            return self.balance_previous[-1]

        # Search backwards for the last time the hour reset (e.g., 23 -> 0),
        # which indicates the start of a new day. Limit search to recent
        # history for efficiency.
        for i in range(len(hour_previous) - 2,
                       max(-1, len(hour_previous) - 13), -1):
            if hour_previous[i + 1] < hour_previous[i]:
                return self.balance_previous[i + 1]

        # Fallback: If no day change is found in recent history, assume the
        # last known balance is the most reasonable starting point.
        return self.balance_previous[-1]

    def _calculate_gradient_error(self, current_balance: float,
                                  current_time: int,
                                  target_spend_cumulative: np.ndarray,
                                  current_hour: int) -> float:
        """
        Calculates the error in the rate of spending (derivative term).
        """
        if current_hour == 0:
            return 0.0

        time_delta = current_time - self.timestamp_previous[-1]
        if time_delta <= 0:
            return 0.0

        # Desired rate of spending for the current hour.
        desired_gradient = (target_spend_cumulative[current_hour] -
                            target_spend_cumulative[current_hour - 1]) / 3600

        # Actual rate of spending since the last bid.
        real_gradient = (self.balance_previous[-1] - current_balance) / time_delta

        return real_gradient - desired_gradient

    def _calculate_weights(self, spend_error: float,
                           gradient_spend_error: float) -> Tuple[float, float]:
        """
        Calculates dynamic weights for the proportional and derivative terms.
        """
        if gradient_spend_error == 0:
            tau = 1_000_000  # A large number to represent infinity
        else:
            # tau estimates the time to correct the spend_error at the
            # current gradient_spend_error rate.
            tau = -spend_error / gradient_spend_error

        if tau < 0:
            # If errors are compounding, use equal weights.
            ws = 0.5  # Weight for spend_error (proportional term)
            wg = 0.5  # Weight for gradient_spend_error (derivative term)
        else:
            # If errors are opposing, give more weight to the term that
            # will take longer to self-correct.
            ws = min(0.9, 0.2 * tau)
            wg = 1 - ws
        return ws, wg

    def place_bid(self, bidding_input_params: Dict[str, any],
                  history: History) -> float:
        """
        Calculates and places a bid for an ad impression.

        Args:
            bidding_input_params: A dictionary of parameters for the current
                bidding opportunity.
            history: An object providing access to historical bidding data
                (unused, as this bidder maintains its own history).

        Returns:
            The calculated bid price.
        """
        self.count += 1
        start = bidding_input_params['campaign_start_time']
        end = bidding_input_params['campaign_end_time']
        initial_balance = bidding_input_params['initial_balance']
        balance = bidding_input_params['balance']
        curr_time = bidding_input_params['curr_time']
        region_id = bidding_input_params['region_id']

        # On the first call, place the initial default bid.
        if not self.bid_previous.size:
            bid = float(self.initial_bid)
            self._update_history(balance, curr_time, bid)
            return bid

        # --- Time and Budget Calculation ---
        campaign_duration_days = (end - start) // (3600 * 24)
        day_quote = (initial_balance / campaign_duration_days
                     if campaign_duration_days > 0 else initial_balance)

        day_of_campaign = (curr_time - start) // (3600 * 24)
        hour_of_day = (curr_time - start) // 3600 % 24

        # --- Target Spending Curve ---
        # Calculate the expected traffic distribution for a 24-hour period.
        first_day_start = start
        hours_of_day = np.arange(first_day_start,
                                 first_day_start + 3600 * 24, 3600)
        traffic_per_hour = np.array([
            self.traffic.get_traffic_share(region_id, h, h + 3600)
            for h in hours_of_day
        ])
        total_daily_traffic = traffic_per_hour.sum()

        # Normalize to get hourly traffic share.
        traffic_share = (traffic_per_hour / total_daily_traffic
                         if total_daily_traffic > 0
                         else np.zeros_like(traffic_per_hour))

        # Cumulative spending target for the day.
        target_spend_cumulative = day_quote * np.cumsum(traffic_share)

        # --- Determine Initial Balance for the Current Day ---
        initial_day_balance = self._get_initial_day_balance(
            start, day_of_campaign, initial_balance, hour_of_day
        )

        # --- Bidding Logic ---
        # 1. Coarse adjustment: If daily spending limit is exceeded, reduce bid.
        if initial_day_balance - balance >= day_quote:
            if self.count % 3 == 1:
                bid = 0.95 * self.bid_previous[-1]
            else:
                bid = self.bid_previous[-1]
            self._update_history(balance, curr_time, bid)
            return bid

        # 2. Fine adjustment: Use a PID-like controller.
        # Proportional term: Error between actual spend and target spend.
        spend_error = (initial_day_balance - balance -
                       target_spend_cumulative[hour_of_day])

        # Derivative term: Error in the rate of spending.
        gradient_spend_error = self._calculate_gradient_error(
            balance, curr_time, target_spend_cumulative, hour_of_day
        )

        # Dynamically adjust weights for P and D terms.
        ws, wg = self._calculate_weights(spend_error, gradient_spend_error)

        # Calculate the magnitude of the bid correction.
        spend_error_c = min(self.C_MAX,
                            self.C_MAX * abs(spend_error) / self.E_MAX)
        gradient_spend_error_i = min(1, abs(gradient_spend_error))
        gradient_spend_error_c = max(
            self.C_MIN,
            self.C_MAX * gradient_spend_error_i / self.E_GMC
        )

        # Calculate the potential new bid based on errors.
        bid_adjustment = (ws * spend_error_c * np.sign(spend_error) +
                          wg * gradient_spend_error_c * np.sign(
                              gradient_spend_error))
        potential_bid = self.bid_previous[-1] - bid_adjustment

        # Only apply the adjustment every 3rd call to dampen oscillations.
        if self.count % 3 == 1:
            bid = potential_bid
        else:
            bid = self.bid_previous[-1]

        self._update_history(balance, curr_time, bid)
        return bid