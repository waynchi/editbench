import os
# 导入 hashlib
import hashlib
# 导入 base64
import base64

project_name = "CheckerKMV"


def createLicense(secretKey: str) -> None:
    """
    创建许可证文件。
    此版本将使用 hashlib 对密钥进行哈希处理，以增强安全性，
    然后使用 base64 编码后存入文件。
    """
    # 项目文件夹在 %appdata% 的路径
    appdata_path = os.path.join(os.environ["APPDATA"], project_name)

    if not os.path.exists(appdata_path):
        os.makedirs(appdata_path)

    # 1. 将字符串密钥编码为字节串
    secret_bytes = secretKey.encode('utf-8')

    # 2. 使用 SHA-256 算法对密钥进行哈希处理
    hashed_key = hashlib.sha256(secret_bytes).digest()

    # 3. 使用 Base64 对哈希结果进行编码，以便存储
    encoded_key = base64.b64encode(hashed_key)

    # 将处理后的密钥写入文件
    with open(os.path.join(appdata_path, "license.dat"), "wb") as f:
        f.write(encoded_key)