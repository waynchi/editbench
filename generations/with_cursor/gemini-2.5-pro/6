# env: pyAI

import os
from openai import OpenAI
import json

def save_conversation(history, filename="conversation_history.json"):
    """Saves the conversation history to a JSON file."""
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(history, f, ensure_ascii=False, indent=4)
    print(f"\nConversation saved to {filename}")


def load_conversation(filename="conversation_history.json"):
    """Loads a conversation history from a JSON file."""
    try:
        with open(filename, "r", encoding="utf-8") as f:
            conversation_history = json.load(f)
        print(f"Conversation history from {filename} loaded successfully.")
        return conversation_history
    except FileNotFoundError:
        print(f"No saved conversation history found for {filename}.")
        return None
    except json.JSONDecodeError:
        print(f"Error decoding JSON from {filename}. Starting a new conversation.")
        return None

def initialize_history():
    """Returns a new conversation history with the system prompt."""
    print("Initializing new conversation history.")
    return [
        {
            "role": "system",
            "content": "You are a helpful assistant.",
        }
    ]

# --- Configuration ---
endpoint = "https://models.inference.ai.azure.com"
model_name = "gpt-4o"

client = OpenAI(
    base_url=endpoint,
    api_key="XXXXXXXXXXXXXXXXXXXXXXXXXXXX",
)

# --- Load Conversation ---
conversation_history = []
history_filename = "conversation_history.json"  # Default save filename

# Ask the user if they want to load a conversation history
load_history = input("Do you want to load a conversation history? (yes/no): ").strip().lower()

if load_history == "yes":
    # Get all conversation history files in the current directory
    history_files = [f for f in os.listdir() if f.endswith(".json")]
    if history_files:
        print("Available conversation history files:")
        for i, file in enumerate(history_files, 1):
            print(f"{i}. {file}")
        
        try:
            choice_str = input("Enter the number of the conversation history file to load: ")
            choice = int(choice_str)
            if 1 <= choice <= len(history_files):
                chosen_file = history_files[choice - 1]
                loaded_history = load_conversation(chosen_file)
                if loaded_history is not None:
                    conversation_history = loaded_history
                    history_filename = chosen_file  # Set to save back to the same file
                else:
                    # load_conversation failed, start a new history
                    conversation_history = initialize_history()
            else:
                print("Invalid choice.")
                conversation_history = initialize_history()
        except ValueError:
            print("Invalid input.")
            conversation_history = initialize_history()
    else:
        print("No conversation history files found.")
        conversation_history = initialize_history()
else:
    # User chose not to load, so initialize a new history
    conversation_history = initialize_history()

# Failsafe in case something went wrong and history is empty
if not conversation_history:
    conversation_history = initialize_history()

# --- Main Conversation Loop ---
while True:
    user_input = input("User: ")
    if user_input.lower() in ["exit", "quit"]:
        print("Exiting the conversation.")
        break

    conversation_history.append({
        "role": "user",
        "content": user_input
    })

    try:
        response = client.chat.completions.create(
            messages=conversation_history,
            temperature=1.0,
            top_p=1.0,
            max_tokens=4086,
            model=model_name
        )

        # The response message is a Pydantic model object.
        # It must be converted to a dict for JSON serialization.
        assistant_message = response.choices[0].message.model_dump()
        conversation_history.append(assistant_message)
        print("GPT: ", assistant_message.get("content", "[No content received]"))

    except Exception as e:
        print(f"An error occurred: {e}")
        # Remove the last user message so they can try again without corrupting the history
        if conversation_history and conversation_history[-1].get("role") == "user":
            conversation_history.pop()
        print("Please try your last message again.")


# Save the conversation history at the end if it has more than the system prompt
if len(conversation_history) > 1:
    save_conversation(conversation_history, history_filename)
else:
    print("No new conversation to save.")