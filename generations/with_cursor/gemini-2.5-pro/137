# 编写二分查找
def binary_search(arr, target):
    """
    在已排序的列表中执行二分查找。

    参数:
    arr (list): 一个已排序的元素列表。
    target: 要查找的元素。

    返回:
    int: 如果找到目标，则返回目标的索引；否则返回 -1。
    """
    low = 0
    high = len(arr) - 1

    while low <= high:
        mid = (low + high) // 2
        guess = arr[mid]

        if guess == target:
            return mid
        elif guess < target:
            low = mid + 1
        else:
            high = mid - 1

    return -1

