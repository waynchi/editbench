from beem.discussions import Discussions, Query
from beem.comment import Comment
import random
import string

n_respuestas_minimas = 5
diccionario = {}

def procesar (texto: str):
    return "count me " in texto
def is_own_author (autor: str):
    # Corrected a bug here: used the parameter 'autor' instead of an undefined 'author'
    return autor == 'subidu'
def is_banned (autor: str):
    list_banned = []
    return autor in list_banned
def generar_permlink_unico () -> str:
    return "".join(random.choices(string.digits, k=10))
def procesar_replies (replies: Comment):
    pass
def preparar_comentario (parent_author: str, parent_permlink: str, permlink: str, title: str = '', author: str = 'subidu' , body: str = 'Count me in ^^ @subidu') -> dict[str:str]:
    return {
        "parent_author": parent_author,
        "parent_permlink": parent_permlink,
        "author": author,
        "permlink": permlink,
        "title": title,
        "body": body,
    }


q = Query()
d = Discussions()
posts_generator = d.get_discussions("created", q, limit=6000)
X = 0

for post in posts_generator:
    post_author = post['author']
    post_permlink = post['permlink']
    post_replies_count = post['children']
    cnt = 0
    X += 1
    
    # Create the hierarchical dictionary entry for the current post
    post_authorperm = f"{post_author}/{post_permlink}"
    diccionario[post_authorperm] = {
        "post_data": post.copy(),  # Store post data
        "replies": {}              # Initialize a dictionary for replies
    }

    if post_replies_count > n_respuestas_minimas:
        comment = Comment(authorperm=post_authorperm)
        post_replies_list = comment.get_replies()
        
        cnt = 0
        # Use a more descriptive variable name 'reply' instead of 'replies'
        for reply in post_replies_list:
            # Add the reply to the hierarchical dictionary under the current post
            reply_authorperm = f"{reply['author']}/{reply['permlink']}"
            diccionario[post_authorperm]['replies'][reply_authorperm] = reply.copy()
            
            author = reply['author']
            text = reply['body']
            if is_own_author(author):
                # 重新评估评论
                break
            if is_banned(author):
                break
            if procesar(text):
                cnt+= 1
    if cnt > 3:
        print("Iterador: ",X)
        # This will print the last reply processed in the loop for this post.
        # A check is added to prevent NameError if the loop was empty.
        if 'reply' in locals():
            print(reply['author'],'/',reply['permlink'])

