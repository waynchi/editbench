import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-5, max_iter=1000):
    """
    Решает систему линейных уравнений Ax = b методом сопряжённых градиентов.

    Метод применим для симметричных положительно-определённых матриц A.

    Аргументы:
        A (np.ndarray): Квадратная, симметричная, положительно-определённая матрица (n x n).
        b (np.ndarray): Вектор правой части (размер n).
        x0 (np.ndarray, optional): Начальное приближение для решения.
                                   Если None, используется нулевой вектор. По умолчанию None.
        tol (float, optional): Допустимая погрешность для остановки. Алгоритм
                               останавливается, когда L2-норма невязки становится
                               меньше этого значения. По умолчанию 1e-5.
        max_iter (int, optional): Максимальное количество итераций. По умолчанию 1000.

    Возвращает:
        tuple: Кортеж, содержащий:
            - np.ndarray: Вектор решения x.
            - int: Количество выполненных итераций.
    """
    n = A.shape[0]

    # Начальное приближение
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    # Начальные значения
    r = b - A @ x  # Вектор невязки (residual)
    p = r.copy()   # Вектор направления (search direction)
    rs_old = np.dot(r, r)

    # Если начальное приближение уже достаточно точное
    if np.sqrt(rs_old) < tol:
        return x, 0

    for i in range(max_iter):
        Ap = A @ p
        alpha = rs_old / np.dot(p, Ap)

        # Обновление решения и невязки
        x += alpha * p
        r -= alpha * Ap

        rs_new = np.dot(r, r)

        # Проверка на сходимость
        if np.sqrt(rs_new) < tol:
            # Возвращаем i+1, так как итерации нумеруются с 0
            return x, i + 1

        # Обновление направления поиска
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new

    print(f"Предупреждение: Метод сопряжённых градиентов не сошёлся за {max_iter} итераций.")
    return x, max_iter

if __name__ == '__main__':
    # --- Пример использования ---

    # 1. Создадим симметричную положительно-определённую матрицу A
    # (Собственные значения > 0)
    A = np.array([[4, 1, 0],
                  [1, 3, 1],
                  [0, 1, 2]], dtype=float)

    # 2. Создадим вектор b
    b = np.array([1, 2, 5], dtype=float)

    # 3. Точное решение для проверки
    exact_solution = np.linalg.solve(A, b)
    print(f"Точное решение (через np.linalg.solve): {exact_solution}\n")

    # 4. Запустим метод сопряжённых градиентов без начального приближения
    print("--- Запуск без начального приближения (x0 = 0) ---")
    solution, iterations = conjugate_gradient(A, b, tol=1e-9)

    print(f"Решение, полученное методом сопряжённых градиентов: {solution}")
    print(f"Количество итераций: {iterations}")
    print(f"Норма разницы с точным решением: {np.linalg.norm(solution - exact_solution):.2e}\n")

    # 5. Пример с начальным приближением
    print("--- Запуск с начальным приближением x0 = [1, 1, 1] ---")
    x0 = np.array([1.0, 1.0, 1.0])
    solution_x0, iterations_x0 = conjugate_gradient(A, b, x0=x0, tol=1e-9)

    print(f"Решение: {solution_x0}")
    print(f"Количество итераций: {iterations_x0}")
    print(f"Норма разницы с точным решением: {np.linalg.norm(solution_x0 - exact_solution):.2e}")