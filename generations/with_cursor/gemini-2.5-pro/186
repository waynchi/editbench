import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew

def medcouple(data):
    """
    Computes the medcouple, a robust measure of skewness.
    This implementation is vectorized for performance and fixes the ValueError
    by ensuring helper functions can handle array inputs.
    """
    data = np.sort(data)
    n = len(data)
    if n == 0:
        return np.nan
    median = np.median(data)

    # 将数据分为中位数的左侧和右侧
    # Split data into values less than or equal to the median, and greater than or equal to the median.
    left = data[data <= median]
    right = data[data >= median]

    # Vectorized kernel function h(xi, xj).
    # This function is designed to work with NumPy arrays xi and xj.
    def h(xi, xj):
        numerator = (xj - median) - (median - xi)
        denominator = xj - xi
        # Use np.divide to handle division by zero safely. When xi == xj, the result is 0.
        # This avoids the ValueError that occurs when using a standard 'if' on a numpy array.
        return np.divide(numerator, denominator, out=np.zeros_like(numerator, dtype=float), where=denominator != 0)

    # Vectorized special kernel function for repeated medians.
    # This function is also designed to work with NumPy arrays i and j.
    def special_h(i, j, k):
        # This is the vectorized equivalent of the original if/elif/else structure using np.sign.
        # This also avoids the ValueError.
        return np.sign((i + j - 1) - k)

    # 重复中位数的计数 (Count of repeated medians)
    k = len(data[data == median])

    # 使用numpy广播以提高效率 (Use numpy broadcasting for efficiency)
    if k > 1:
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        
        # Create grids of values and indices
        xi, xj = np.meshgrid(left, right, indexing='ij')
        i, j = np.meshgrid(left_indices, right_indices, indexing='ij')
        
        # The original code had a ValueError because the helper functions h and special_h
        # were not vectorized. They used standard Python 'if' statements which cannot
        # handle boolean arrays. The new vectorized versions of h and special_h fix this.
        # np.where will now correctly select elements from the pre-computed result arrays.
        h_matrix = np.where(
            (xi == median) & (xj == median),
            special_h(i, j, k),
            h(xi, xj)
        )
    else:
        # If there are no (or one) repeated medians, the special case is not needed.
        xi, xj = np.meshgrid(left, right, indexing='ij')
        h_matrix = h(xi, xj)

    # 将矩阵展平并计算h值的中位数 (Flatten the matrix and compute the median of h-values)
    return np.median(h_matrix.flatten())

def adjusted_boxplot_bounds(data):
    """计算调整后的箱线图边界，考虑偏度调整的围栏。"""
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """使用调整后的箱线图进行归一化。"""
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

