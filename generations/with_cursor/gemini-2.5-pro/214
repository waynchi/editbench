async def check_answer(chat_id, text_command):
    """
    Checks the user's answer against the correct one for the current question.
    It cleans both the user's input and the correct answer by removing non-alphabetic characters
    before comparison.
    """
    # 从text_command中删除所有非字母符号。
    user_answer_cleaned = ''.join(filter(str.isalpha, text_command)).lower()

    if not user_answer_cleaned:
        return # Ignore empty answers

    if chat_id not in all_chats or all_chats[chat_id].cur_question == -1:
        return # No active game in this chat

    q = all_chats[chat_id].questions[all_chats[chat_id].cur_question]
    
    # Clean the main answer
    correct_answer_cleaned = ''.join(filter(str.isalpha, q.answer)).lower()

    is_correct = (user_answer_cleaned == correct_answer_cleaned)

    # Check alternative answers ("zachet") if the main one didn't match
    if not is_correct and q.zachet:
        # Assuming zachet is a comma-separated string
        zachet_list = q.zachet.split(',')
        for zachet_item in zachet_list:
            cleaned_zachet = ''.join(filter(str.isalpha, zachet_item.strip())).lower()
            if user_answer_cleaned == cleaned_zachet:
                is_correct = True
                break
    
    if is_correct:
        await bot.send_message(chat_id, "Правильно!")
    else:
        await bot.send_message(chat_id, "Неправильно.")


async def process_command(chat_id, text_command):
    """Processes user commands and answer attempts."""
    if text_command.startswith('/load '):
        pack_num_str = text_command.split(' ', 1)[1]
        if pack_num_str.isdigit():
            num_pack = int(pack_num_str)
            await load_pack(chat_id, num_pack)
        else:
            await bot.send_message(chat_id, "Неверный номер пакета. Используйте: /load <число>")
    # Any other message that doesn't start with '/' is treated as a potential answer
    elif not text_command.startswith('/'):
        if chat_id in all_chats and all_chats[chat_id].cur_question != -1:
            await check_answer(chat_id, text_command)
    # Other commands or messages are ignored silently.
            

@dp.message()
async def echo_handler(message: Message) -> None:
    """
    Handler will process incoming text messages as commands or answers.
    """
    # We only process text messages
    if message.text:
        await process_command(message.chat.id, message.text)


async def main() -> None:
    # 用默认的机器人属性初始化 Bot 实例，这些属性将传递给所有 API 调用
    # bot = Bot(token=TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))

    # 以及运行事件分发

    dp.include_router(start_router)
    await dp.start_polling(bot)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, stream=sys.stdout)
    asyncio.run(main())