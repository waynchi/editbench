def is_prime(n):
    """
    检查一个数是否为质数
    如果 n 是质数，则返回 True，否则返回 False。
    """
    if n < 2:  # 小于2的数不是质数
        return False
    if n == 2:  # 2是质数
        return True
    if n % 2 == 0:  # 偶数除了2之外均不是质数
        return False
    # 检查从3到sqrt(n)之间的奇数
    i = 3
    while i * i <= n:
        if n % i == 0:
            return False
        i += 2
    return True