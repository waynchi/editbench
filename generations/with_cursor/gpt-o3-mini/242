def binary_search(arr, target):
    """
    Реализует бинарный поиск в отсортированном списке.
    :param arr: отсортированный список элементов
    :param target: искомый элемент
    :return: индекс найденного элемента или -1 если элемент не найден
    """
    left = 0
    right = len(arr) - 1

    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1

    return -1


# Пример использования:
if __name__ == '__main__':
    sorted_list = [1, 3, 5, 7, 9, 11, 13]
    target = 7
    result = binary_search(sorted_list, target)
    if result != -1:
        print(f"Элемент {target} найден по индексу {result}.")
    else:
        print(f"Элемент {target} не найден в списке.")