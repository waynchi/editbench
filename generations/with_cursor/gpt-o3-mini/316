import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image
import numpy as np
import os

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406],
                                 std=[0.229, 0.224, 0.225])
        ])

    def create_unrelated_pairs(self, image_text_pairs):
        """Создает несвязанные пары изображение-текст, перемешивая текстовые описания."""
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """Создает семантически похожие текстовые пары, используя наборы данных парафраз."""
        dataset = load_dataset(dataset_name, split=f'train[:{self.sample_size}]')
        textual_pairs = []
        for item in dataset:
            if item.get('is_duplicate', 0) == 1:
                pair = (item.get('question1', ''), item.get('question2', ''))
                textual_pairs.append(pair)
        return textual_pairs[:self.sample_size]

    def create_visual_pairs(self, image_text_pairs):
        """Создает увеличенные пары изображений, сохраняя семантическое значение."""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])

        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                try:
                    augmented = augmentation_transforms(image)
                    visual_pairs.append((image, augmented))
                except Exception as e:
                    print(f"Ошибка при аугментации изображения: {e}")
        return visual_pairs

    def load_mscoco_dataset(self):
        """Загружает и предварительно обрабатывает набор данных MSCOCO с улучшенной фильтрацией."""
        dataset = load_dataset(
            "shunk031/MSCOCO",
            year=2014,
            coco_task="captions",
            split='train',
            streaming=True
        )
        dataset = dataset.take(self.sample_size)

        image_text_pairs = []
        for item in dataset:
            try:
                captions = item.get("captions", [])
                if not captions:
                    continue

                # Выбрать наиболее описательную подпись на основе длины
                best_caption = max(captions, key=lambda x: len(x))
                if len(best_caption.split()) < 5:
                    continue  # Пропустить слишком короткие подписи

                image = item.get("image", None)
                if image is None:
                    continue

                # Если image не является загруженным изображением, попробовать его загрузить вручную
                if not isinstance(image, Image.Image):
                    image = Image.open(image)

                image_text_pairs.append((image, best_caption))
            except FileNotFoundError as fnf_error:
                print(f"FileNotFoundError encountered, skipping item: {fnf_error}")
                continue
            except Exception as e:
                print(f"Unexpected error occurred: {e}")
                continue

        return image_text_pairs


def main():
    # Инициализация создателя набора данных
    creator = AlignmentDatasetCreator(sample_size=100)

    # Загрузить и создать наборы данных
    print("Загрузка набора данных MSCOCO...")
    image_text_pairs = creator.load_mscoco_dataset()

    print("Создание несвязанных пар...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)

    print("Создание текстовых пар...")
    textual_pairs = creator.create_textual_pairs()

    print("Создание визуальных пар...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)

    # Вывод примеров из каждого набора данных, если они существуют
    print("Примеры наборов данных:")
    if image_text_pairs:
        print(f"Пара изображение-текст: {image_text_pairs[0]}")
    if unrelated_pairs:
        print(f"Несвязанная пара: {unrelated_pairs[0]}")
    if textual_pairs:
        print(f"Текстовая пара: {textual_pairs[0]}")
    if visual_pairs:
        print(f"Пара изображений: {visual_pairs[0]}")

if __name__ == "__main__":
    main()