import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self, flattened_size):  # Используем flattened_size для определения размера входа в полносвязный слой
        super(SimpleConvNet1, self).__init__()
        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
        self.flatten = nn.Flatten()
        self.fc1 = nn.Sequential(
            nn.Linear(flattened_size, 512),
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x

if __name__ == "__main__":
    # Пример входных данных: пакет изображений с размером 32x32 и 3 каналами.
    # После двух сверток с kernel_size = 3 и операций MaxPool2d(kernel_size = 2)
    # размер изображения уменьшается. Для расчета flattened_size:
    # Первый свертка: (32 - 3 + 1) = 30, затем MaxPool2d -> 30 // 2 = 15.
    # Второй свертка: (15 - 3 + 1) = 13, затем MaxPool2d -> 13 // 2 = 6.
    # Итоговый размер выхода: (batch, 64, 6, 6) и flattened_size = 64 * 6 * 6 = 2304.
    
    flattened_size = 2304
    model = SimpleConvNet1(flattened_size=flattened_size)
    
    # Создаем тестовый входной тензор: 1 изображение размером 32x32 с 3 цветными каналами
    test_input = torch.randn(1, 3, 32, 32)
    output = model(test_input)
    print("Output shape:", output.shape)