import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image, ImageFile
import numpy as np
import os

# Enable loading of truncated images
ImageFile.LOAD_TRUNCATED_IMAGES = True

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                                 std=[0.229, 0.224, 0.225])
        ])

    def create_unrelated_pairs(self, image_text_pairs):
        """
        Creates image-text pairs that are unrelated by shuffling the text descriptions.
        """
        images, texts = zip(*image_text_pairs)
        shuffled_texts = list(texts)
        random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """
        Creates pairs of semantically similar texts based on a paraphrase dataset.
        """
        dataset = load_dataset(dataset_name, split=f'train[:{self.sample_size}]')
        textual_pairs = []
        for item in dataset:
            # Check if the pair of questions is a duplicate
            if item.get('is_duplicate', 0) == 1:
                pair = (item['question1'], item['question2'])
                textual_pairs.append(pair)
        return textual_pairs[:self.sample_size]

    def create_visual_pairs(self, image_text_pairs):
        """
        Creates augmented image pairs while retaining the semantic meaning.
        """
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                augmented = augmentation_transforms(image)
                visual_pairs.append((image, augmented))
        return visual_pairs

    def load_mscoco_dataset(self):
        """
        Loads and preprocesses the MSCOCO dataset with improved filtering and error handling.
        If an image file is missing (FileNotFoundError), that sample is skipped.
        """
        try:
            dataset = load_dataset(
                "shunk031/MSCOCO",
                year=2014,
                coco_task="captions",
                split='train',
                streaming=True
            )
        except Exception as e:
            print("Error loading MSCOCO dataset:", e)
            return []

        dataset = dataset.take(self.sample_size)
        image_text_pairs = []
        for idx, item in enumerate(dataset):
            try:
                # Select the most descriptive caption based on length
                best_caption = max(item["captions"], key=len)
                if len(best_caption.split()) >= 5:  # Filter out overly short captions
                    # Attempt to load the image.
                    # If the image cannot be loaded due to missing file or other I/O issues, it will be skipped.
                    image = item["image"]
                    # Optionally, you could apply a transformation here:
                    image = self.transform(image)
                    image_text_pairs.append((image, best_caption))
            except FileNotFoundError as fnf_error:
                print(f"FileNotFoundError for item {idx}: {fnf_error}. Skipping this sample.")
            except Exception as ex:
                print(f"An error occurred for item {idx}: {ex}. Skipping this sample.")
        return image_text_pairs

def main():
    # Initialize the dataset creator with a smaller sample for demonstration
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # Load and create datasets
    print("Loading MSCOCO dataset...")
    image_text_pairs = creator.load_mscoco_dataset()
    if not image_text_pairs:
        print("No image-text pairs were loaded. Exiting.")
        return
    
    print("Creating unrelated pairs...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Creating textual pairs...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Creating visual pairs...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # Print a sample from each dataset
    print("Dataset Samples:")
    print("Image-Text Pair Sample:")
    print(image_text_pairs[0])
    
    print("\nUnrelated Pair Sample:")
    print(unrelated_pairs[0])
    
    if textual_pairs:
        print("\nTextual Pair Sample:")
        print(textual_pairs[0])
    else:
        print("\nNo textual pairs were created.")
    
    if visual_pairs:
        print("\nVisual Pair Sample:")
        print(visual_pairs[0])
    else:
        print("\nNo visual pairs were created.")

if __name__ == "__main__":
    main()