import numpy as np

def fit_line(x, y):
    """
    求数组拟合直线的函数
    """
    # 计算x和y的平均值
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # 计算x和y的偏差
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # 计算x和y的偏差的乘积
    xy_dev = x_dev * y_dev
    
    # 计算x的偏差的平方
    x_dev_squared = x_dev ** 2
    
    # 计算直线的斜率和截距
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean
    
    return slope, intercept

def fit_quadratic(x, y):
    """
    求数组二次曲线拟合的函数
    """
    # 创建Vandermonde矩阵，列分别为x^2, x, 和1
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # 使用最小二乘法求解系数
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    return coeffs

def calculate_max_deviation(y_true, y_pred):
    """
    求最大偏差值的函数
    输入：
        y_true：原始数据数组
        y_pred：拟合后预测的数据数组
    返回：
        最大的绝对偏差值
    """
    return np.max(np.abs(y_true - y_pred))

def max_deviation_line(x, y):
    """
    计算数组在线性拟合后的最大偏差值
    """
    slope, intercept = fit_line(x, y)
    # 计算拟合直线对应的y值
    y_pred = slope * x + intercept
    # 计算并返回最大偏差值
    return calculate_max_deviation(y, y_pred)

def max_deviation_quadratic(x, y):
    """
    计算数组在二次曲线拟合后的最大偏差值
    """
    coeffs = fit_quadratic(x, y)
    # 计算拟合二次曲线对应的y值：y = ax^2 + bx + c
    y_pred = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    # 计算并返回最大偏差值
    return calculate_max_deviation(y, y_pred)