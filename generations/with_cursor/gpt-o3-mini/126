import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data_by_columns(features_transformed, clusters_definition, n_clusters=2, clustering_method='kmeans'):
    """
    Performs clustering independently on specified sets of columns.

    Args:
        features_transformed (pandas.DataFrame): Transformed DataFrame with parameters.
        clusters_definition (dict): Dictionary where keys are names for the new cluster columns
                                    and values are tuples (or lists) of column names on which clustering will be performed.
        n_clusters (int): Number of clusters.
        clustering_method (str): Clustering method; currently only 'kmeans' is supported.

    Returns:
        pandas.DataFrame: DataFrame with added cluster label columns for each key in clusters_definition.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    # For each clustering definition, perform clustering on the specified subset of columns.
    for cluster_key, columns in clusters_definition.items():
        # Check that all specified columns exist in the DataFrame
        missing_cols = [col for col in columns if col not in features_transformed.columns]
        if missing_cols:
            print(f"Колонки {missing_cols} для '{cluster_key}' не найдены в DataFrame. Пропуск этого набора.")
            continue

        features_subset = features_transformed[list(columns)].copy()

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)
            
            # Evaluation of clustering quality using silhouette coefficient.
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров ({cluster_key}): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера ({cluster_key}) (все точки в одном кластере).")
        else:
            print(f"Неподдерживаемый метод кластеризации для '{cluster_key}'.")
            continue

        # Add the found cluster labels to the original DataFrame with the key name.
        features_transformed[cluster_key] = cluster_labels
        print(f"Кластеризация выполнена для '{cluster_key}'. Метки кластеров добавлены в столбец '{cluster_key}'.")
    
    return features_transformed

# Clustering execution (after step 5 and before step 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Define the clustering configuration dictionary.
    # For example: Cluster1 is based on column1 and column2, Cluster2 is based on column3.
    clusters_definition = {
        "Cluster1": ("column1", "column2"),
        "Cluster2": ("column3",)
    }
    # n_clusters can be adjusted as desired
    n_clusters = 3
    features_transformed = cluster_data_by_columns(features_transformed, clusters_definition, n_clusters)

    # Visualization of clusters for each clustering group (only if there are at least 2 columns in the group)
    for cluster_key, cols in clusters_definition.items():
        if len(cols) >= 2:
            # Check if both columns are numeric for plotting
            if (pd.api.types.is_numeric_dtype(features_transformed[cols[0]]) and
                pd.api.types.is_numeric_dtype(features_transformed[cols[1]])):
                
                plt.figure(figsize=(8, 6))
                scatter = plt.scatter(features_transformed[cols[0]], features_transformed[cols[1]], 
                                      c=features_transformed[cluster_key], cmap='viridis')
                plt.xlabel(cols[0])
                plt.ylabel(cols[1])
                plt.title(f'Результаты кластеризации: {cluster_key}')
                plt.colorbar(scatter, label='Номер кластера')
                plt.show()
            else:
                print(f"Невозможно визуализировать кластеризацию для '{cluster_key}' из-за нечисловых данных.")
        else:
            print(f"Для визуализации кластеризации требуется не менее 2 признаков. Группа '{cluster_key}' содержит {len(cols)} признак(ов).")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")