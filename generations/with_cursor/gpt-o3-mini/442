# generar un módulo de medio sumador de verilog con python

# código verilog actualizado con más señales de entrada (agregamos "enable")
verilog_code = """
module half_adder(a, b, enable, c, sum, carry);
    input a, b, enable;
    output c, sum, carry;
    // Si enable está activo, realiza la operación; de lo contrario, los resultados son 0.
    assign c = enable ? (a ^ b) : 0;
    assign sum = enable ? (a & b) : 0;
    assign carry = enable ? (a & b) : 0;
endmodule
"""

