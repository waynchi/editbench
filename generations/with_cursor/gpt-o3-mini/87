import tkinter as tk
import random

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        # Choose a random speed: either -2 or 2 for both directions
        self.dx = random.choice([-2, 2])
        self.dy = random.choice([-2, 2])
        # Choose a random color for the square
        self.color = random.choice(["blue", "red", "green", "yellow", "purple", "orange"])
        self.square = canvas.create_rectangle(
            x, y, x + size, y + size, fill=self.color, outline=self.color)

    def move(self):
        self.x += self.dx
        self.y += self.dy
        self.canvas.move(self.square, self.dx, self.dy)
        
        # Get current canvas dimensions
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()
        
        # If the square touches or passes any boundary, remove it and possibly split it
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            self.canvas.delete(self.square)
            # Split into two new squares if the square is big enough
            if self.size > 10:
                new_size = self.size / 2
                # Place the new squares relative to the current position
                squares.append(Square(
                    self.canvas,
                    new_size,
                    self.x,
                    self.y))
                squares.append(Square(
                    self.canvas,
                    new_size,
                    self.x + new_size,
                    self.y + new_size))
            return False
        return True

def update():
    global squares
    # Update movement of all squares; removed ones are filtered out
    squares = [square for square in squares if square.move()]
    root.after(20, update)  # Schedule next update in 20ms

# Main application window
root = tk.Tk()
root.title("Colored Splitting Squares")

# Create and pack the canvas
canvas = tk.Canvas(root, width=600, height=600, bg="white")
canvas.pack(expand=True, fill="both")

# Create the initial square
squares = [Square(canvas, 100, 250, 250)]

# Start the animation loop
update()
root.mainloop()