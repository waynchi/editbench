class Token:
    start: int
    end: int

class IntegerToken(Token):
    value: int

    @staticmethod
    def is_digit(input_str: str, pos: int) -> bool:
        '''Verifica si el carácter en la posición pos es un dígito usando el método incorporado isdigit'''
        return input_str[pos].isdigit()
    
    @staticmethod
    def is_int(input_str: str, start_pos: int) -> int:
        '''Devuelve la posición final del token si la entrada es un token de entero válido, de lo contrario lanza una aserción'''
        max_pos = len(input_str)
        current_pos = start_pos
        digit_found = False

        while current_pos < max_pos and input_str[current_pos].isdigit():
            digit_found = True
            current_pos += 1

        assert digit_found, "Not an integer"
        return current_pos

if __name__=="__main__":
    print(IntegerToken.is_int("1234", 0))
    print(IntegerToken.is_int("a123", 0))