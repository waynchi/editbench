import os

project_name = "CheckerKMV"

def createLicense(secretKey: str) -> None:
    # Ścieżka do folderu projektu w %appdata%
    appdata_path = os.path.join(os.environ["APPDATA"], project_name)

    if not os.path.exists(appdata_path):
        os.makedirs(appdata_path)

    # Upewniamy się, że secretKey jest zakodowanym ciągiem bajtów,
    # ponieważ otwieramy plik w trybie binarnym ("wb")
    secretKey_bytes = secretKey.encode("utf-8")

    with open(os.path.join(appdata_path, "license.dat"), "wb") as f:
        f.write(secretKey_bytes)

# Przykładowe użycie funkcji createLicense
if __name__ == "__main__":
    # Zamień "MY_SECRET_KEY" na właściwy klucz
    createLicense("MY_SECRET_KEY")