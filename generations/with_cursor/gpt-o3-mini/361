import math

def find_numbers_as_sum_of_four_nonzero_squares(limit):
    """
    Zwraca posortowaną listę liczb mniejszych lub równych limit,
    które mogą być wyrażone jako suma czterech niezerowych kwadratów.
    """
    results = set()
    # Maksymalny składnik taki, że jego kwadrat nie przekracza limitu
    max_term = int(math.sqrt(limit))
    for a in range(1, max_term + 1):
        a2 = a * a
        for b in range(1, max_term + 1):
            b2 = b * b
            for c in range(1, max_term + 1):
                c2 = c * c
                for d in range(1, max_term + 1):
                    s = a2 + b2 + c2 + d * d
                    if s <= limit:
                        results.add(s)
    return sorted(results)

def main():
    try:
        limit = int(input("Podaj górną granicę (liczba całkowita >= 4): "))
    except ValueError:
        print("Podana wartość nie jest liczbą całkowitą.")
        return

    if limit < 4:
        print("Podaj liczbę większą lub równą 4.")
        return

    liczby = find_numbers_as_sum_of_four_nonzero_squares(limit)
    print("Liczby, które można wyrazić jako sumę czterech niezerowych kwadratów:")
    for num in liczby:
        print(num)

if __name__ == "__main__":
    main()