import math

def is_sum_of_four_nonzero_squares(n):
    # Для n меньше 4 нельзя получить сумму четырех ненулевых квадратов,
    # так как минимальное значение = 1^2 + 1^2 + 1^2 + 1^2 = 4.
    if n < 4:
        return None
    max_val = int(math.sqrt(n))
    for a in range(1, max_val + 1):
        for b in range(1, max_val + 1):
            for c in range(1, max_val + 1):
                for d in range(1, max_val + 1):
                    if a*a + b*b + c*c + d*d == n:
                        return a, b, c, d
    return None

def find_four_nonzero_squares_sums(limit):
    """Находит числа до заданного предела, которые могут быть выражены как сумма четырех ненулевых квадратов."""
    results = []
    for n in range(1, limit + 1):
        result = is_sum_of_four_nonzero_squares(n)
        if result:
            results.append(n)
    return results

if __name__ == "__main__":
    limit = int(input("Digite o limite superior: "))
    sums_found = find_four_nonzero_squares_sums(limit)
    print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
    for num in sums_found:
        result = is_sum_of_four_nonzero_squares(num)
        a, b, c, d = result
        print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")