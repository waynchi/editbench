import time
import torch
import numpy as np
from torch.utils.data import DataLoader
from transformers import TrainerCallback, default_data_collator

# Определите класс FactualAccuracyCallbackBETTER (как указано)
class FactualAccuracyCallbackBETTER(TrainerCallback):
    """Обратный вызов для оценки и логирования фактической точности модели во время обучения."""

    def __init__(
        self, model, tokenizer, dataset, batch_size, verbose=False, output_format=False
    ):
        super().__init__()
        self.model = model
        self.tokenizer = tokenizer
        self.n_samp = len(dataset)
        self.verbose = verbose
        self.output_format = output_format

        tokenized_questions = dataset.map(
            lambda examples: tokenizer(
                examples["question"],
                padding="max_length",
                truncation=True,
                max_length=512,
            ),
            batched=True,
        )
        self.batched_tokenized_questions = DataLoader(
            tokenized_questions,
            batch_size=batch_size,
            shuffle=False,
            collate_fn=default_data_collator,
        )
        self.batched_expected_answers = DataLoader(
            dataset['answer'], batch_size=batch_size, shuffle=False
        )

    def on_log(self, args, state, control, model=None, **kwargs):
        """Вызывается после записи последних логов."""
        if model is not None:
            self.model = model
        elif self.model is None:
            return

        if not state.is_local_process_zero:
            return

        start_time = time.time()
        try:
            with torch.no_grad():
                results = factual_score_dataloader(
                    model=self.model,
                    tokenizer=self.tokenizer,
                    batched_tokenized_questions=self.batched_tokenized_questions,
                    expected_answers=self.batched_expected_answers,
                    output_format=self.output_format,
                )
                if self.output_format:
                    factual_accuracy_avg, format_hard_avg, format_soft_avg = results
                    avg_to_log = {
                        "factual_accuracy": factual_accuracy_avg,
                        "format_hard": format_hard_avg,
                        "format_soft": format_soft_avg,
                    }
                else:
                    factual_accuracy_avg = results
                    avg_to_log = {"factual_accuracy": factual_accuracy_avg}

                if len(state.log_history) > 0:
                    state.log_history[-1].update(avg_to_log)
        except Exception as e:
            print(f"Error during factual accuracy evaluation: {e}")
        finally:
            time_taken = time.time() - start_time
            if self.verbose:
                print(f"[TIME] {time_taken:.2f} seconds: Model evaluated on FactualAccuracy.")


def check_answer_factual(output_str, expected_answer):
    # Пример реализации проверки фактической точности. 
    # Возвращает 1, если ответ содержит ожидаемый ответ, иначе 0.
    return 1 if expected_answer.strip().lower() in output_str.strip().lower() else 0


def check_answer_format(output_str, hard=True):
    # Пример реализации проверки формата ответа.
    # Если hard=True, проверяется строгое соответствие, иначе допускается мягкая проверка.
    if hard:
        # Строгая проверка: например, ответ должен начинаться с заглавной буквы и заканчиваться точкой.
        return 1 if output_str and output_str[0].isupper() and output_str.strip().endswith('.') else 0
    else:
        # Мягкая проверка: например, ответ должен быть не пустым.
        return 1 if bool(output_str.strip()) else 0


def factual_score_dataloader(
    model,
    tokenizer,
    batched_tokenized_questions,
    expected_answers,
    max_new_tokens=32,
    output_format=False,
    random_state=42,
    device=None,
    verbose=False,
):
    """
    Evaluate the factual accuracy of answers from a language model,
    computing cumulative (sliding) averages rather than storing batch outputs.

    Args:
        model: The language model.
        tokenizer: The tokenizer.
        batched_tokenized_questions: DataLoader with tokenized questions.
        expected_answers: DataLoader with expected answers.
        max_new_tokens: Maximum number of new tokens to generate.
        output_format: Whether to check output format.
        random_state: Random seed for sampling.
        device: Device to run on (defaults to CUDA if available, else CPU).
        verbose: If True, prints additional information.

    Returns:
        If output_format is False:
            A single float representing the cumulative factual accuracy.
        If output_format is True:
            A tuple of three floats: (factual_accuracy, format_hard_avg, format_soft_avg)
    """
    if device is None:
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = model.to(device)

    total_fact_sum = 0.0
    total_count = 0

    if output_format:
        total_format_hard_sum = 0.0
        total_format_soft_sum = 0.0
        total_format_count = 0

    for batch, expected_batch in zip(batched_tokenized_questions, expected_answers):
        # Move only required keys: "input_ids" and "attention_mask" to the device
        batch = {k: v.to(device) for k, v in batch.items() if k in ["input_ids", "attention_mask"]}

        with torch.no_grad():
            outputs = model.generate(
                **batch,
                max_new_tokens=max_new_tokens,
                pad_token_id=tokenizer.pad_token_id,
            )
            input_shape = batch["input_ids"].shape[-1]
            output_strings = tokenizer.batch_decode(
                outputs[:, input_shape:], skip_special_tokens=True
            )

            # Compute factual accuracy for each answer in the batch using list comprehension.
            new_factuals = [
                check_answer_factual(output_str, expected_answer)
                for output_str, expected_answer in zip(output_strings, expected_batch)
            ]
            batch_count = len(new_factuals)
            total_fact_sum += sum(new_factuals)
            total_count += batch_count

            if output_format:
                new_format_hard = [
                    check_answer_format(output_str, hard=True) for output_str in output_strings
                ]
                new_format_soft = [
                    check_answer_format(output_str, hard=False) for output_str in output_strings
                ]
                total_format_hard_sum += sum(new_format_hard)
                total_format_soft_sum += sum(new_format_soft)
                total_format_count += batch_count

    factual_accuracy_avg = total_fact_sum / total_count if total_count > 0 else 0.0

    if output_format:
        format_hard_avg = total_format_hard_sum / total_format_count if total_format_count > 0 else 0.0
        format_soft_avg = total_format_soft_sum / total_format_count if total_format_count > 0 else 0.0
        return factual_accuracy_avg, format_hard_avg, format_soft_avg
    else:
        return factual_accuracy_avg