import math

class Value:
    """Przechowuje pojedynczą wartość skalarną i jej gradient."""

    def __init__(self, data, _children=(), _op=''):
        self.data = data
        self.grad = 0
        # Wewnętrzne zmienne używane do konstrukcji grafu autograd
        self._backward = lambda: None
        self._prev = set(_children)
        self._op = _op  # operacja, która wygenerowała ten węzeł, dla graphviz / debugowania / itp.

    def __add__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data + other.data, (self, other), '+')
        def _backward():
            self.grad += out.grad
            other.grad += out.grad
        out._backward = _backward
        return out

    def __mul__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data * other.data, (self, other), '*')
        def _backward():
            self.grad += other.data * out.grad
            other.grad += self.data * out.grad
        out._backward = _backward
        return out

    def __pow__(self, other):
        # Tylko potęgi int/float są obsługiwane
        assert isinstance(other, (int, float)), "only supporting int/float powers for now"
        out = Value(self.data**other, (self,), f'**{other}')
        def _backward():
            self.grad += (other * self.data**(other-1)) * out.grad
        out._backward = _backward
        return out

    def exp(self):
        """Funkcja wykładnicza f(x)=exp(x)."""
        out = Value(math.exp(self.data), (self,), "exp")
        def _backward():
            self.grad += math.exp(self.data) * out.grad
        out._backward = _backward
        return out

    def log(self):
        out = Value(math.log(self.data), (self,), f'log({self.data})')
        def _backward():
            self.grad += (1 / self.data) * out.grad
        out._backward = _backward       
        return out

    def relu(self):
        assert isinstance(self.data, (int, float)), "only supporting int/float for now"
        out = Value(0 if self.data < 0 else self.data, (self,), 'ReLU')
        def _backward():
            self.grad += (out.data > 0) * out.grad
        out._backward = _backward
        return out

    def backward(self):
        # Uporządkować topologicznie wszystkie węzły w grafie
        topo = []
        visited = set()
        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for child in v._prev:
                    build_topo(child)
                topo.append(v)
        build_topo(self)
        # Ustawić gradient początkowy
        self.grad = 1
        for v in reversed(topo):
            v._backward()

    def __neg__(self):  # -self
        return self * -1

    def __gt__(self, other):
        return self.data > other.data

    def __radd__(self, other):  # other + self
        return self + other

    def __sub__(self, other):  # self - other
        return self + (-other)

    def __rsub__(self, other):  # other - self
        return other + (-self)

    def __rmul__(self, other):  # other * self
        return self * other

    def __truediv__(self, other):  # self / other
        return self * (other ** -1)

    def __rtruediv__(self, other):  # other / self
        return other * (self ** -1)

    def __repr__(self):
        return f"Value(data={self.data}, grad={self.grad})"

def softmax(xs):
    """
    Oblicza funkcję softmax dla listy wartości skalarnych (wrapped in Value) i umożliwia różniczkowanie.
    
    Softmax: s_i = exp(x_i - m) / sum_j exp(x_j - m), gdzie m = max_i(x_i)
    Odejmowanie maksimum zwiększa stabilność numeryczną.
    
    Parametry:
      xs - lista obiektów Value
      
    Zwraca:
      Lista obiektów Value reprezentujących wartości softmax, które są częścią grafu obliczeniowego.
    """
    # Użyj maksimum z xs dla stabilności numerycznej.
    max_val = max(xs, key=lambda v: v.data)
    exp_values = [(x - max_val).exp() for x in xs]
    
    # Sumujemy wszystkie wykładniki używając operacji dodawania Value.
    total = Value(0)
    for e in exp_values:
        total = total + e

    # Obliczamy softmax: s_i = e^x_i / total
    softmax_values = [e / total for e in exp_values]
    
    # Dzięki temu, że wszystkie operacje (odejmowanie, exp, dodawanie, dzielenie)
    # są zbudowane i łańcuch reguły jest ustawiony, gradienty przeliczają się poprawnie.
    return softmax_values