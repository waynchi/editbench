import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data_independent(features_transformed, clusters_spec, n_clusters=2, clustering_method='kmeans'):
    """
    Realiza la agrupación de datos de manera independiente para cada conjunto de columnas especificado.

    Args:
        features_transformed (pandas.DataFrame): DataFrame transformado con parámetros.
        clusters_spec (dict): Diccionario donde las claves son los nombres de las nuevas columnas 
                              que contendrán las etiquetas de clústeres y los valores son tuplas/listas 
                              con los nombres de las columnas a usar para la clusterización.
                              Ejemplo: {'Cluster1': ('columna1', 'columna2'), 'Cluster2': ('columna3',)}
        n_clusters (int): Número de clústeres a usar en cada agrupación.
        clustering_method (str): Método de agrupación (actualmente soportado: 'kmeans').

    Returns:
        pandas.DataFrame: DataFrame con las columnas de etiquetas de clústeres añadidas.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    for cluster_col_name, cols in clusters_spec.items():
        print(f"\nRealizando clusterización para '{cluster_col_name}' usando columnas: {cols}")
        
        # Extraer subset de datos para esta clusterización
        try:
            features_subset = features_transformed.loc[:, list(cols)]
        except KeyError as e:
            print(f"Error: Una o más columnas especificadas en {cols} no existen en el DataFrame. {e}")
            continue

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)
            
            # Evaluar la calidad de la agrupación usando el coeficiente de silueta
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта для '{cluster_col_name}' con {n_clusters} clústeres: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта para '{cluster_col_name}' (todos los puntos en un solo clúster).")
        else:
            print("Неподдерживаемый метод кластеризации.")
            continue

        # Añadir las etiquetas al DataFrame original utilizando la clave del diccionario como nombre de columna
        features_transformed[cluster_col_name] = cluster_labels
        print(f"Clusterización para '{cluster_col_name}' completada. Etiquetas de clúster añadidas en la columna '{cluster_col_name}'.")
    
    return features_transformed


# Ejecución de la clusterización independiente (después del paso 5: transformación de datos)
if 'features_transformed' in globals() and features_transformed is not None:
    
    # Definir el diccionario de conjuntos de columnas y nombres de las columnas destino para la clusterización
    clusters_spec = {
        'Cluster1': ('columna1', 'columna2'),
        'Cluster2': ('columna3',)
    }
    
    n_clusters = 3  # Cantidad de clústeres (seleccione el valor óptimo)
    features_transformed = cluster_data_independent(features_transformed, clusters_spec, n_clusters)
    
    # Visualización de la clusterización para aquellos conjuntos de columnas con 2 características
    for cluster_col_name, cols in clusters_spec.items():
        if len(cols) == 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(
                features_transformed[cols[0]],
                features_transformed[cols[1]],
                c=features_transformed[cluster_col_name],
                cmap='viridis'
            )
            plt.xlabel(cols[0])
            plt.ylabel(cols[1])
            plt.title(f'Resultados de la clusterización: {cluster_col_name}')
            cbar = plt.colorbar()
            cbar.set_label('Número de clúster')
            plt.show()
        else:
            print(f"Visualización no disponible para '{cluster_col_name}' porque no se tienen 2 características numéricas.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")