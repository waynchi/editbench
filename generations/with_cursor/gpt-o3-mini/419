import asyncio
import aiohttp  # do asynchronicznych zapytań HTTP
import aiofiles  # do asynchronicznego odczytu i zapisu plików
import xml.etree.ElementTree  # do przetwarzania odpowiedzi XML z API
import matplotlib.pyplot as plt  # do tworzenia wykresów
import pandas as pd  # do tworzenia ramki danych i podziału wszystkich świec na dwa typy: zamknięcie i otwarcie
import datetime  # dla dat na osi X
import pickle  # do przechowywania zmiennych w pliku
import json

# klasa waluta
class valute():
    """Waluta i wszystko z nią związane, przez CBRF

Wymagane biblioteki:

aiohttp

aiofiles

xml.etree.ElementTree

matplotlib.pyplot jako plt

pandas jako pd

datetime

pickle

json"""
    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """Sprawdzanie nazwy waluty w zbiorze walut. Zbiór jest aktualizowany nie częściej niż raz dziennie."""
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        set_valutes_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin"

        # Odczytujemy informacje z pliku Info.json
        async with aiofiles.open(info_path, "r", encoding="utf-8") as f:
            info_text = await f.read()
        info = json.loads(info_text)

        # Sprawdzamy, czy minął co najmniej jeden dzień od ostatniej aktualizacji listy walut
        last_check = datetime.datetime.strptime(info["last_day_check"]["valute"], "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check:
            # Jeśli minął co najmniej jeden dzień, to pobieramy aktualne dane z API
            set_valutes = set()
            url = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    xml_content = await response.read()
            root = xml.etree.ElementTree.fromstring(xml_content)
            for Valute in root.findall("Valute"):
                CharCode = Valute.find("CharCode")
                if CharCode is not None and CharCode.text:
                    set_valutes.add(CharCode.text)
            # Zapisujemy zaktualizowany zbiór walut do pliku
            async with aiofiles.open(set_valutes_path, "wb") as f:
                await f.write(pickle.dumps(set_valutes))
            # Aktualizujemy datę ostatniej aktualizacji w pliku Info.json
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, "w", encoding="utf-8") as f:
                await f.write(json.dumps(info, indent=3, ensure_ascii=False))
        # Odczytujemy zbiór walut z pliku
        async with aiofiles.open(set_valutes_path, "rb") as f:
            data = await f.read()
        set_valutes = pickle.loads(data)
        # Sprawdzamy, czy podana waluta znajduje się w zbiorze
        return self.name in set_valutes

    async def CurrentExchangeRate(self):
        '''Bieżący kurs wymiany waluty na rubla'''
        url = "http://www.cbr.ru/scripts/XML_daily.asp"  # API Banku Centralnego Rosji
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                xml_content = await response.read()
        root = xml.etree.ElementTree.fromstring(xml_content)
        for Valute in root.findall("Valute"):
            CharCode = Valute.find("CharCode")
            if CharCode is not None and CharCode.text == self.name:
                # Zwracamy bieżący kurs wymiany; zakładamy, że element 'VunitRate' istnieje
                rate = Valute.find("VunitRate")
                if rate is not None:
                    return rate.text
        # Jeśli waluta nie została znaleziona, zwracamy None
        return None

# Przykładowe wywołanie metod asynchronicznych
if __name__ == "__main__":
    async def main():
        waluta = valute("USD")
        is_correct = await waluta.correct_name()
        if is_correct:
            rate = await waluta.CurrentExchangeRate()
            print(f"Kurs waluty {waluta.name}: {rate}")
        else:
            print(f"Waluta {waluta.name} nie została znaleziona w zbiorze.")

    asyncio.run(main())