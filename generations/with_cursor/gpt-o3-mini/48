import requests


def registerKey(key: str, user: str):
    print(f'chave: {key}\nnome: {user}')
    try:
        payload = {'key': key, 'user': user}
        # Performing a POST request with a JSON payload
        response = requests.post('http://127.0.0.1:5000/register', json=payload)

        # Attempt to raise an HTTPError for bad responses (4xx or 5xx)
        response.raise_for_status()

        # Parse JSON response
        data = response.json()
        if data.get('valid'):
            return True
        return False

    except requests.RequestException as e:
        print(f"Erro de conexão: {e}")
        return False