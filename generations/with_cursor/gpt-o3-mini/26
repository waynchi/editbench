import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-10, max_iter=1000):
    """
    Решает систему линейных уравнений Ax = b методом спряжённых градиентов.
    Функция предполагает, что матрица A симметрична и положительно определена.

    Параметры:
        A : numpy.ndarray
            Симметричная положительно определённая матрица коэффициентов.
        b : numpy.ndarray
            Вектор правых частей.
        x0 : numpy.ndarray, опционально
            Начальное приближение решения. Если не задано, используется нулевой вектор.
        tol : float, опционально
            Точность, при которой итерация прекращается.
        max_iter : int, опционально
            Максимальное количество итераций.

    Возвращает:
        x : numpy.ndarray
            Приблизительное решение системы Ax = b.
        i : int
            Количество совершённых итераций.
    """
    n = b.shape[0]
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    r = b - A @ x
    p = r.copy()
    rs_old = np.dot(r, r)

    for i in range(max_iter):
        Ap = A @ p
        alpha = rs_old / np.dot(p, Ap)
        x += alpha * p
        r -= alpha * Ap
        rs_new = np.dot(r, r)
        if np.sqrt(rs_new) < tol:
            print(f"Решение найдено за {i+1} итераций с точностью {tol}.")
            return x, i+1
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new

    print("Достигнуто максимальное количество итераций.")
    return x, max_iter

if __name__ == "__main__":
    # Пример использования функции conjugate_gradient
    # Определим симметричную положительно определённую матрицу A и вектор b

    # Матрица A (например, 3x3)
    A = np.array([[4, 1, 0],
                  [1, 3, -1],
                  [0, -1, 2]], dtype=float)

    # Вектор b
    b = np.array([1, 2, 0], dtype=float)

    # Начальное приближение (опционально)
    x0 = np.zeros_like(b)

    # Решение с использованием метода спряжённых градиентов
    x, iterations = conjugate_gradient(A, b, x0, tol=1e-8, max_iter=1000)

    print("Приблизительное решение:", x)
    print("Количество итераций:", iterations)