import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data(features_transformed, clustering_specs, n_clusters=2, clustering_method='kmeans'):
    """
    对指定列集分别执行聚类。

    参数：
        features_transformed (pandas.DataFrame): 转换后的包含参数的DataFrame。
        clustering_specs (dict): 聚类规格字典，键为输出聚类标签的列名，值为用于聚类的列名列表或元组。
            例如: {'cluster1': ('col1', 'col2'), 'cluster2': ('col3',)}
        n_clusters (int): 聚类数量。
        clustering_method (str): 聚类方法，目前仅支持 'kmeans'。

    返回：
        pandas.DataFrame: 对于每个聚类规格，添加了聚类标签列的DataFrame。
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    # 对于字典中的每一项，对指定的列数据进行聚类
    for cluster_label_col, feature_cols in clustering_specs.items():
        # 检查所有指定的列是否存在于DataFrame中
        for col in feature_cols:
            if col not in features_transformed.columns:
                print(f"列 '{col}' 不存在于 DataFrame 中。跳过聚类: {cluster_label_col}.")
                continue

        features_for_clustering = features_transformed[list(feature_cols)].copy()

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_for_clustering)

            # 评估聚类质量（例如，使用轮廓系数），前提是至少有两个簇
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_for_clustering, cluster_labels)
                print(f"Коэффициент силуэта для {cluster_label_col} ({n_clusters} кластеров): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {cluster_label_col} ({n_clusters} кластера: все точки в одном кластере).")
        else:
            print(f"Неподдерживаемый метод кластеризации для {cluster_label_col}.")
            continue

        # 将聚类标签存入新的列中，列名由字典的键指定
        features_transformed[cluster_label_col] = cluster_labels
        print(f"Кластеризация выполнена для '{cluster_label_col}'. Метки кластеров添加 в столбец '{cluster_label_col}'.")

    return features_transformed


# 假设 features_transformed 已经在之前的步骤中定义并转换（例如，通过数据预处理）
if 'features_transformed' in locals() and features_transformed is not None:
    # 定义用于独立聚类的列集字典：
    # 例如，'cluster1'使用'col1'和'col2'进行聚类，'cluster2'使用'col3'进行聚类
    clustering_specs = {
        'cluster1': ('col1', 'col2'),
        'cluster2': ('col3',)
    }
    n_clusters = 3  # 指定簇的数量
    features_transformed = cluster_data(features_transformed, clustering_specs, n_clusters)

    # 对于每一个聚类规格，尝试进行可视化（仅当使用的特征至少有两个数值特征时）
    for cluster_name, feature_cols in clustering_specs.items():
        features_for_vis = features_transformed[list(feature_cols)]
        if features_for_vis.shape[1] >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(features_for_vis.iloc[:, 0], features_for_vis.iloc[:, 1],
                        c=features_transformed[cluster_name], cmap='viridis')
            plt.xlabel(features_for_vis.columns[0])
            plt.ylabel(features_for_vis.columns[1])
            plt.title(f'Результаты кластеризации для {cluster_name}')
            plt.colorbar(label='Номер кластера')
            plt.show()
        else:
            print(f"Недостаточно числовых признаков для визуализации кластеров для '{cluster_name}' на плоскости.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")