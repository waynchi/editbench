import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew

def medcouple(data):
    # Sort the data and compute the median
    data = np.sort(data)
    median = np.median(data)

    # Split data into left (<= median) and right (>= median) parts
    left = data[data <= median]
    right = data[data >= median]

    # Vectorized kernel function h(xi, xj)
    def h(xi, xj):
        # For non-equal values use the formula; otherwise, return 0.
        # Using np.where to ensure vectorized evaluation.
        return np.where(xi != xj,
                        ((xj - median) - (median - xi)) / (xj - xi),
                        0)

    # Vectorized special kernel function for cases with duplicate medians.
    # i and j are index arrays from meshgrid.
    def special_h(i, j, k):
        sum_indices = i + j - 1
        return np.where(sum_indices < k, -1, np.where(sum_indices == k, 0, 1))

    # Count the number of data points equal to the median.
    k = np.sum(data == median)

    # Use numpy broadcasting to compute all h values efficiently.
    if k > 1:
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        xi, xj = np.meshgrid(left, right, indexing='ij')
        i, j = np.meshgrid(left_indices, right_indices, indexing='ij')
        condition = (xi == median) & (xj == median)
        h_matrix = np.where(condition, special_h(i, j, k), h(xi, xj))
    else:
        xi, xj = np.meshgrid(left, right, indexing='ij')
        h_matrix = h(xi, xj)

    # Return the median of the computed h values.
    return np.median(h_matrix.flatten())

def adjusted_boxplot_bounds(data):
    """Compute the adjusted boxplot bounds, taking skewness into account."""
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    mc = medcouple(data)

    if mc > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * mc) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * mc) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * mc) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * mc) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """Normalize the data using the adjusted boxplot bounds."""
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

# Generate synthetic data
np.random.seed(42)
data_normal = np.random.normal(loc=50, scale=10, size=10000)
data_skewed = np.random.exponential(scale=20, size=10000)
# Append some extreme values to make the distribution more skewed.
data_skewed = np.concatenate([data_skewed[5:], [200, 250, 300, -100, -50]])
data_with_outliers = np.concatenate([data_normal, [150, 160, 170]])

# Create DataFrame with different datasets
df = pd.DataFrame({
    "Normal": data_normal,
    "Skewed": data_skewed,
    # "With_Outliers": data_with_outliers[3:],  # Uncomment if needed
})

# Apply normalization using the adjusted boxplot method.
normalized_df = df.apply(normalize_column)

# Plot histograms before normalization
plt.figure(figsize=(16, 4), dpi=250)
bins = np.linspace(-5, 200, 206)
bin_width = bins[1] - bins[0]

for col in df.columns:
    hist, _ = np.histogram(df[col], bins=bins)
    bin_centers = (bins[:-1] + bins[1:]) / 2
    offset = bin_width / 4
    plt.bar(bin_centers - offset, hist, width=bin_width, align='center', alpha=0.2, label=f'{col}')
    plt.legend()
    plt.title("Histogram Before Normalization")
plt.xlim(-10, 200)
plt.show()

# Plot histograms after normalization
bins = np.linspace(-2, 2, 101)
bin_width = bins[1] - bins[0]

plt.figure(figsize=(16, 4), dpi=250)
for col in normalized_df.columns:
    hist, _ = np.histogram(normalized_df[col], bins=bins)
    bin_centers = (bins[:-1] + bins[1:]) / 2
    offset = bin_width / 2
    plt.bar(bin_centers - offset, hist, width=bin_width, align='center', label=f'{col}', alpha=0.2)
    plt.legend()
    plt.title("Histogram After Normalization")
plt.show()