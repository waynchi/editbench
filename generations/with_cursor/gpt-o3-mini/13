import requests
import json

def interact_with_local_llm(prompt, base_url="http://localhost:11434"):
    """
    Interact with a local LLM using the Ollama API.

    :param prompt: The input prompt for the LLM.
    :param base_url: The base URL of the Ollama API.
    :return: The response from the LLM, or None if an error occurs.
    """
    endpoint = f"{base_url}/api/generate"
    payload = {
        "model": "llama3.2:latest",  # Replace with your model name if needed
        "prompt": prompt,
        "max_tokens": 2048  # Adjust as needed
    }
    headers = {
        "Content-Type": "application/json"
    }
    
    try:
        response = requests.post(endpoint, json=payload, headers=headers)
        response.raise_for_status()
        
        # Try to decode JSON response, handling potential extra data errors.
        try:
            data = response.json()
        except json.JSONDecodeError as json_err:
            # Attempt to fix the error by extracting the first valid JSON object.
            # The error "Extra data: line 2 column 1 (char 101)" indicates there may be more than one JSON object.
            raw_text = response.text.strip()
            decoder = json.JSONDecoder()
            try:
                data, idx = decoder.raw_decode(raw_text)
            except json.JSONDecodeError as inner_err:
                print(f"JSON decoding failed: {inner_err}")
                return None
        return data.get('response', '')
    except requests.exceptions.RequestException as req_err:
        print(f"Request error occurred: {req_err}")
        return None

# Example usage
if __name__ == "__main__":
    prompt = "Hello, how are you?"
    response = interact_with_local_llm(prompt)
    if response:
        print(f"LLM Response: {response}")
    else:
        print("An error occurred: Extra data: line 2 column 1 (char 101)")