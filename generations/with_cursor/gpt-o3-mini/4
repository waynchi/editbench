from flask import Flask
from datetime import datetime

app = Flask(__name__)

@app.route('/')
def show_datetime():
    now = datetime.now()
    formatted_datetime = now.strftime("%Y-%m-%d %H:%M:%S")
    return f"""
    <html>
        <head>
            <title>Current Date and Time</title>
        </head>
        <body>
            <h1>Current Date and Time</h1>
            <p>{formatted_datetime}</p>
        </body>
    </html>
    """

if __name__ == "__main__":
    app.run(debug=True)