from pathlib import Path
import shutil

target_folder = 'F:/Maverick/desktop/Windows/temp/'

def get_content_delivery_path():
    """Pobierz ścieżkę Windows Content Delivery"""
    packages_path = Path('C:/Users/admin/AppData/Local/Packages/')
    matched = packages_path.glob('*Microsoft.Windows.ContentDeliveryManager*')
    if result := next(matched, None):
        suffix = 'LocalState/Assets/'
        return result / suffix
    else:
        raise Exception('ContentDeliveryManager Not Found')

def jpeg(source_folder, target_folder):
    """
    Kopiuj pliki z folderu źródłowego do folderu docelowego
    i dodaj sufiks .jpeg do nazwy pliku.
    """
    target_path = Path(target_folder)
    target_path.mkdir(parents=True, exist_ok=True)
    
    for file in source_folder.iterdir():
        if file.is_file():
            # Tworzymy nową nazwę pliku dodając sufiks .jpeg
            new_file = target_path / (file.name + '.jpeg')
            shutil.copy2(file, new_file)
            print(f"Copied {file} to {new_file}")

if __name__ == '__main__':
    source_folder = get_content_delivery_path()
    print(f"Windows Content Delivery path: {source_folder}")
    jpeg(source_folder, target_folder)