import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-10, max_iter=None):
    """
    Rozwiązuje układ równań Ax = b metodą sprzężonych gradientów.
    
    Parametry:
      A : numpy.ndarray
          Macierz współczynników (musi być symetryczna i dodatnio określona).
      b : numpy.ndarray
          Wektor wyrazów wolnych.
      x0 : numpy.ndarray, opcjonalnie
          Początkowe przybliżenie rozwiązania. Domyślnie zerowy wektor.
      tol : float, opcjonalnie
          Tolerancja, przy której iteracja zostanie przerwana.
      max_iter : int, opcjonalnie
          Maksymalna liczba iteracji. Domyślnie liczba równoważna rozmiarowi b.
    
    Zwraca:
      x : numpy.ndarray
          Przybliżone rozwiązanie układu równań.
      i : int
          Liczba wykonanych iteracji.
    """
    n = b.shape[0]
    
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()
    
    if max_iter is None:
        max_iter = n
    
    r = b - A @ x                  # początkowy residuum
    p = r.copy()                   # początkowy kierunek przeszukiwania
    rsold = np.dot(r, r)
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rsold / np.dot(p, Ap)
        x += alpha * p           # aktualizacja rozwiązania
        r -= alpha * Ap          # aktualizacja residuum
        
        rsnew = np.dot(r, r)
        if np.sqrt(rsnew) < tol:
            print(f"Zbieżność osiągnięta po {i+1} iteracjach.")
            break
        
        p = r + (rsnew / rsold) * p  # kierunek sprzężony
        rsold = rsnew
        
    return x, i+1

if __name__ == "__main__":
    # Przykładowy układ: Symetryczna dodatnio określona macierz A.
    A = np.array([[4, 1],
                  [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # Rozwiązanie przy użyciu metody sprzężonych gradientów
    x, iterations = conjugate_gradient(A, b)
    
    print("Przybliżone rozwiązanie x =", x)
    print("Liczba iteracji =", iterations)
    
    # Weryfikacja: rozwiązanie układu Ax = b
    residual = np.linalg.norm(b - A @ x)
    print("Norma residuum =", residual)