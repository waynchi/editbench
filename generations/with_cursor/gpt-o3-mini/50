class Token:
    start: int
    end: int

class IntegerToken(Token):
    value: int

    @staticmethod
    def is_digit(input_str: str, pos: int) -> bool:
        '''Returns True if the character at the given position is a digit, otherwise False'''
        return input_str[pos].isdigit()

def is_int(input_str: str, start_pos: int) -> int:
    max_pos = len(input_str)
    current_pos = start_pos
    digit_found = False

    while current_pos < max_pos:
        if not IntegerToken.is_digit(input_str, current_pos):
            break
        digit_found = True
        current_pos += 1

    assert digit_found, "Not an integer"
    return current_pos

if __name__=="__main__":
    print(is_int("1234", 0))
    try:
        print(is_int("a123", 0))
    except AssertionError as e:
        print(e)