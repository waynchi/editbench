from flask import Flask
from datetime import datetime

app = Flask(__name__)

@app.route('/')
def index():
    now = datetime.now()
    formatted_datetime = now.strftime("%Y-%m-%d %H:%M:%S")
    return f"<h1>Текущие дата и время</h1><p>{formatted_datetime}</p>"

if __name__ == '__main__':
    app.run(debug=True)