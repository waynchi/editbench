def is_sum_of_four_nonzero_squares(n):
    """
    Sprawdza, czy liczba n można zapisać jako sumę czterech niezerowych kwadratów.
    Jeśli tak, zwraca krotkę (a, b, c, d) takich, że:
      n = a^2 + b^2 + c^2 + d^2
    W przeciwnym wypadku zwraca None.

    Liczymy tylko dla a, b, c, d >= 1 (żadne nie zerowe).
    """
    # Najmniejsza liczba, którą można uzyskać jako sumę czterech kwadratów niezerowych, to 1^2+1^2+1^2+1^2 = 4.
    if n < 4:
        return None

    # Maksymalna wartość liczby, której kwadrat może być użyty,
    # ponieważ dla n = a^2 + ... + d^2, każda z tych wartości musi spełniać a^2 <= n.
    max_val = int(n ** 0.5) + 1

    for a in range(1, max_val):
        a2 = a * a
        if a2 > n:
            break
        for b in range(1, max_val):
            b2 = b * b
            if a2 + b2 > n:
                break
            for c in range(1, max_val):
                c2 = c * c
                if a2 + b2 + c2 > n:
                    break
                for d in range(1, max_val):
                    total = a2 + b2 + c2 + d * d
                    if total == n:
                        return (a, b, c, d)
                    elif total > n:
                        break
    return None

def find_four_nonzero_squares_sums(limit):
    """
    Znajduje wszystkie liczby od 1 do limit, które można wyrazić jako sumę czterech niezerowych kwadratów.
    """
    results = []
    for n in range(1, limit + 1):
        result = is_sum_of_four_nonzero_squares(n)
        if result is not None:
            results.append(n)
    return results

# Przykład użycia:
if __name__ == "__main__":
    try:
        limit = int(input("Digite o limite superior: "))
    except ValueError:
        print("Proszę wprowadzić prawidłową liczbę całkowitą.")
    else:
        sums_found = find_four_nonzero_squares_sums(limit)
        print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
        for num in sums_found:
            result = is_sum_of_four_nonzero_squares(num)
            if result:
                a, b, c, d = result
                print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")