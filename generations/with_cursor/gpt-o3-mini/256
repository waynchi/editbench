from pathlib import Path
import shutil

target_folder = 'F:/Maverick/desktop/Windows/temp/'

def get_content_delivery_path():
    """Получить путь доставки контента Windows"""
    path = Path('C:/Users/admin/AppData/Local/Packages/')
    matched = path.glob('*Microsoft.Windows.ContentDeliveryManager*')
    if result := next(matched, None):
        suffix = 'LocalState/Assets/'
        return result / suffix
    else:
        raise Exception('ContentDeliveryManager Not Found')
    

def jpeg(source_folder, target_folder):
    """Копировать файлы из исходной папки в целевую папку и добавить суффикс .jpeg"""
    source_folder = Path(source_folder)
    target_folder = Path(target_folder)
    # Создаем целевую папку, если она не существует
    target_folder.mkdir(parents=True, exist_ok=True)
    
    # Проходим по всем файлам в исходной папке
    for file in source_folder.iterdir():
        if file.is_file():
            # Формируем имя файла с добавлением суффикса .jpeg
            new_file_name = file.name + ".jpeg"
            destination = target_folder / new_file_name
            
            # Копируем файл в целевую папку с новым именем
            shutil.copy2(file, destination)
            print(f"File {file.name} copied to {destination}")

if __name__ == '__main__':
    source_folder = get_content_delivery_path()
    print(f"Windows Content Delivery path: {source_folder}")
    
    # Выполняем копирование файлов с добавлением суффикса .jpeg
    jpeg(source_folder, target_folder)