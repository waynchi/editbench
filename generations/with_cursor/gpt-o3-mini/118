def build_reply_tree(author: str, permlink: str) -> list:
    """
    Recursively builds a hierarchical list of replies starting from the given comment.
    Each reply is represented as a dictionary with its details and nested replies.
    """
    try:
        comment_instance = Comment(authorperm=f"{author}/{permlink}")
        replies = comment_instance.get_replies()
    except Exception as e:
        # In case of any error fetching replies, return empty list
        return []

    tree = []
    for reply in replies:
        reply_author = reply.get('author')
        reply_permlink = reply.get('permlink')
        reply_body = reply.get('body', '')
        
        # Build the subtree for the current reply
        subtree = build_reply_tree(reply_author, reply_permlink)
        
        tree.append({
            "author": reply_author,
            "permlink": reply_permlink,
            "body": reply_body,
            "replies": subtree
        })
    
    return tree

def build_hierarchical_dict() -> dict:
    """
    Creates a hierarchical dictionary structure for posts and their replies.
    The dictionary keys are of format "author/permlink" for each post and
    each value contains post details and a list of nested replies.
    """
    hierarchical_dict = {}
    q = Query()
    d = Discussions()
    
    # Fetch posts from discussions. Adjust limit as needed.
    posts_generator = d.get_discussions("created", q, limit=6000)
    
    for post in posts_generator:
        post_author = post.get('author')
        post_permlink = post.get('permlink')
        post_body = post.get('body', '')
        identifier = f"{post_author}/{post_permlink}"
        
        # Create the reply tree for the post.
        replies_tree = build_reply_tree(post_author, post_permlink)
        
        hierarchical_dict[identifier] = {
            "author": post_author,
            "permlink": post_permlink,
            "body": post_body,
            "replies": replies_tree
        }
        
    return hierarchical_dict

