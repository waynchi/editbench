import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew

def medcouple(data):
    data = np.sort(data)
    n = len(data)
    median = np.median(data)

    # Разделить данные на левую и правую части относительно медианы
    left = data[data <= median]
    right = data[data >= median]
    k = np.sum(data == median)  # Количество повторяющихся медианных значений

    # Создаем сетку для левой и правой частей
    xi, xj = np.meshgrid(left, right, indexing='ij')

    # Вычисляем значение h для всех пар (xi, xj) с учетом деления на xj - xi,
    # устанавливая 0 там, где знаменатель равен 0 (например, когда xi == xj)
    h_matrix = np.divide(xi + xj - 2 * median,
                         xj - xi,
                         out=np.zeros_like(xi, dtype=float),
                         where=(xj != xi))

    # Если медиана повторяется более одного раза, применяем специальное ядро для (xi, xj)
    if k > 1:
        # Создаем индексы для левой и правой частей
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        i_grid, j_grid = np.meshgrid(left_indices, right_indices, indexing='ij')

        # Маска для пар, где и xi и xj равны медиане
        median_mask = (xi == median) & (xj == median)
        
        # Векторизованное специальное ядро:
        # Если (i+j-1) < k -> -1, если == k -> 0, если > k -> 1
        special_vals = np.where(i_grid + j_grid - 1 < k,
                                -1,
                                np.where(i_grid + j_grid - 1 == k, 0, 1))
        # Присваиваем специальные значения там, где обе части равны медиане
        h_matrix[median_mask] = special_vals[median_mask]

    # Возвращаем медиану всех значений h
    return np.median(h_matrix.flatten())

def adjusted_boxplot_bounds(data):
    """Вычисляет границы скорректированного boxplot с учетом skewness-adjusted fences."""
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """Нормализация с использованием скорректированного ящичного графика."""
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print("Lower fence:", lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

