from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt

def cluster_data(features_transformed, clustering_groups, n_clusters=2, clustering_method='kmeans'):
    """
    Wykonuje klasteryzację danych dla wskazanych zestawów kolumn niezależnie.

    Args:
        features_transformed (pandas.DataFrame): Przekształcony DataFrame z parametrami.
        clustering_groups (dict): Słownik, w którym klucze określają nazwy nowych kolumn z etykietami,
                                  a wartości to krotki lub listy nazw kolumn, na podstawie których wykonujemy klasteryzację.
                                  Na przykład: {"Klaster1": ("kolumna1", "kolumna2"), "Klaster2": ("kolumna3",)}
        n_clusters (int): Liczba klastrów dla każdego zestawu kolumn.
        clustering_method (str): Metoda klasteryzacji ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame z dodanymi kolumnami etykiet klastrów.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    for cluster_feature_name, columns in clustering_groups.items():
        # Sprawdzenie, czy wszystkie wskazane kolumny istnieją w DataFrame
        if not set(columns).issubset(features_transformed.columns):
            print(f"Kolumny {columns} nie znajdują się w DataFrame.")
            continue

        # Wybieramy podzbiór kolumn do klasteryzacji
        features_subset = features_transformed[list(columns)].copy()

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)

            # Ocena jakości klasteryzacji (za pomocą współczynnika sylwetki)
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта dla {n_clusters} кластеров na zestawie {columns}: {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта dla {n_clusters} кластера na zestawie {columns}.")
        else:
            print("Неподдерживаемый метод кластеризации.")
            continue

        # Dodajemy wyniki klasteryzacji jako nową kolumnę o nazwie odpowiadającej kluczowi słownika
        features_transformed[cluster_feature_name] = cluster_labels
        print(f"Кластеризация wykonana. Metki klastrów dodane w kolumnie '{cluster_feature_name}' dla zestawu {columns}.")

    return features_transformed

# Przykład wykonania klasteryzacji (po etapie 5 i przed etapem 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Definicja grup klasteryzacyjnych: klucz to nazwa nowej kolumny z etykietami,
    # a wartość to krotka lub lista kolumn, na których podstawie wykonana zostanie klasteryzacja.
    clustering_groups = {
        'Klaster1': ('kolumna1', 'kolumna2'),
        'Klaster2': ('kolumna3',)
    }
    n_clusters = 3  # Liczba klastrów dla każdego zestawu
    features_transformed = cluster_data(features_transformed, clustering_groups, n_clusters)

    # Wizualizacja klastrów – przykładowo, jeśli mamy co najmniej 2 cechy numeryczne,
    # wizualizujemy wyniki klasteryzacji dla pierwszej zdefiniowanej grupy.
    numerical_features = features_transformed.select_dtypes(include=np.number)
    if numerical_features.shape[1] >= 2:
        plt.figure(figsize=(8, 6))
        # Wykorzystujemy pierwszą grupę z clustering_groups do kolorowania punktów
        primary_cluster_label = features_transformed[list(clustering_groups.keys())[0]]
        plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], 
                    c=primary_cluster_label, cmap='viridis')
        plt.xlabel(numerical_features.columns[0])
        plt.ylabel(numerical_features.columns[1])
        plt.title('Результаты кластеризации (dla pierwszej grupy klastrowej)')
        plt.colorbar(label='Номер кластера')
        plt.show()
    else:
        print("Недостаточно числовых признаков для визуализации кластеров на плоскости.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")