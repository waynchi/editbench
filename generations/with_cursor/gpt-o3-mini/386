def save_log_to_file(log_history, file_path, append_latest_only=False):
    """
    Zapisuje historię logów do pliku JSON. Jeśli plik już istnieje, dodaje do niego.

    Parametry:
    - log_history: Lista wpisów logów (każdy wpis to słownik).
    - file_path: Ścieżka do pliku, w którym logi będą zapisywane.
    - append_latest_only: Jeśli True, tylko najnowszy wpis logu jest dodawany.

    Optymalizacje:
    1. Użycie os.path.getsize(file_path) do sprawdzenia, czy plik nie jest pusty, przed odczytem.
       Poprawia to wydajność przez ominięcie odczytu pustego pliku.
       Kompromis: Dodanie dodatkowej operacji stat() może być zbędne przy małych plikach.
    """
    current_logs = []

    if os.path.exists(file_path):
        try:
            # Szybkie sprawdzenie wielkości pliku, aby uniknąć niepotrzebnego deserializowania pustych danych
            if os.path.getsize(file_path) > 0:
                with open(file_path, "r") as f:
                    current_logs = json.load(f)
            else:
                current_logs = []
        except json.JSONDecodeError:
            logging.warning(f"{file_path} contains invalid JSON. Overwriting file.")
            current_logs = []
        except Exception as e:
            logging.error(f"An error occurred while reading {file_path}: {e}")
            current_logs = []
    else:
        # Jeśli katalog pliku nie istnieje, upewnij się że katalog docelowy istnieje
        os.makedirs(os.path.dirname(file_path), exist_ok=True)

    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    try:
        with open(file_path, "w") as f:
            json.dump(current_logs, f, indent=4)
    except Exception as e:
        logging.error(f"An error occurred while writing to {file_path}: {e}")


def clear_directory(directory, delete_directory=False):
    """
    Czyści wszystkie pliki i podkatalogi w podanym katalogu. Opcjonalnie usuwa sam katalog.
    Tworzy katalog, jeśli nie istnieje i delete_directory jest False.

    Argumenty:
        directory (str): Ścieżka do katalogu do wyczyszczenia.
        delete_directory (bool): Jeśli True, usuwa katalog po wyczyszczeniu jego zawartości.
                                 Domyślnie False.

    Wyjątki:
        OSError: Jeśli wystąpi jakikolwiek błąd podczas usuwania plików lub katalogów.
                 Dostarcza szczegóły dotyczące niepowodzenia.

    Optymalizacje:
    1. Użycie os.scandir zamiast os.listdir do iteracji,
       co może poprawić wydajność przy dużej liczbie plików.
       Kompromis: Os.scandir jest dostępny od Pythona 3.5 wzwyż.
    """
    if not os.path.exists(directory):
        if not delete_directory:
            os.makedirs(directory)
            logging.info(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        return

    with os.scandir(directory) as it:
        for entry in it:
            item_path = os.path.join(directory, entry.name)
            try:
                if entry.is_dir(follow_symlinks=False):
                    shutil.rmtree(item_path)
                    logging.info(f"Removed directory: {item_path}")
                else:
                    os.remove(item_path)
                    logging.info(f"Removed file: {item_path}")
            except OSError as e:
                logging.error(f"Failed to delete '{item_path}'. Reason: {e}")
                raise

    if delete_directory:
        try:
            os.rmdir(directory)
            logging.info(f"Removed directory: {directory}")
        except OSError as e:
            logging.error(f"Failed to delete '{directory}'. Reason: {e}")
            raise


def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """
    Merges a LoRA model with its corresponding base model and saves the merged model.

    Optymalizacje:
    1. Uniknięcie wielokrotnego wywoływania przetwarzania łańcucha znaków przez wstępne obliczenie param_count.
       Zapewnia to, że logika parsowania model_name jest wykonywana tylko raz.
       Kompromis: Niewielka zmiana w przejrzystości kodu, ale może pomóc przy większych modelach.
    """
    my_model_path = os.path.join(model_load_path, model_name)
    param_count = model_name.lower().split("m")[0].split("-")[1]
    base_model_name = f"pythia-{param_count}M"

    base_model = AutoModelForCausalLM.from_pretrained(
        os.path.join(base_model_repo_name, base_model_name)
    )
    model = PeftModel.from_pretrained(base_model, my_model_path)
    merged_model = model.merge_and_unload()
    my_model_save_path = os.path.join(model_save_path, f"{model_name}_merged")
    merged_model.save_pretrained(my_model_save_path)


def remove_repetition(question, answer):
    """
    Usuwa powtórzenia pytania z odpowiedzi, zakładając, że pytanie pojawia się na początku odpowiedzi.
    """
    if question in answer:
        return answer.replace(question, "").strip()
    return answer


def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Loads different types of models based on the model_type parameter.

    Parameters:
    model_type (str): The type of model to load. One of 'Tuned Model', 'Vanilla Model',
                      'Transformed Model', 'Final Model', or 'Host Model'.
    model_path (str): The base path where models are stored.
    blocks_str (str): A string representing the layers or blocks used in model naming.
    vanilla_model_name (str): The name or path of the vanilla (base) model.
    host_model_name (str): The name or path of the host model.

    Returns:
    model: The loaded model object.

    Raises:
    ValueError: If an unknown model_type is provided or required parameters are missing.
    IOError: If loading the model fails.

    Optymalizacje:
    1. Rozważ użycie słownika mapującego typ modelu na funkcję ładowania modelu,
       aby uniknąć długiej sekwencji if-elif. Poprawia to czytelność i potencjalnie ułatwia rozszerzenia.
       Kompromis: Dodaje dodatkową abstrakcję, która może być zbędna przy małej liczbie typów modeli.
    """
    if model_type == "Tuned Model":
        model_name = vanilla_model_name.split("/")[-1]
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        tuned_model = AutoModelForCausalLM.from_pretrained(
            os.path.join(model_path, tuned_model_name)
        )
        return tuned_model

    elif model_type == "Vanilla Model":
        vanilla_model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)
        return vanilla_model

    elif model_type == "Transformed Model":
        name = host_model_name.split("/")[-1]
        save_path = os.path.join(model_path, f"{name}_preGRAFTED_{blocks_str}.pkl")
        with open(save_path, "rb") as f:
            transformed_model = pickle.load(f)
        return transformed_model

    elif model_type == "Final Model":
        name = host_model_name.split("/")[-1]
        model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
        save_path = os.path.join(model_path, model_save_name)
        with open(save_path, "rb") as f:
            final_model = pickle.load(f)
        return final_model

    elif model_type == "Host Model":
        host_model = AutoModelForCausalLM.from_pretrained(host_model_name)
        return host_model

    else:
        raise ValueError(f"Unknown model type: {model_type}")


def load_batch_losses(file_path):
    """
    Ładuje dane strat partii z pliku punktu kontrolnego.

    Parametry:
    file_path (str): Ścieżka do pliku punktu kontrolnego.

    Zwraca:
    list lub None: Straty partii, jeśli dostępne, w przeciwnym razie None.

    Optymalizacje:
    1. Dodanie logowania sukcesu lub błędu umożliwia szybsze debugowanie i uruchomienie analizy wydajności.
       Kompromis: Użycie map_location ustawionego na CPU może wydłużyć czas ładowania przy modelach zoptymalizowanych pod GPU.
    """
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"))
        batch_losses = checkpoint.get("batch_losses", None)
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None