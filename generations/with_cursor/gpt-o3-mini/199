from main13 import knn, mlp
import pandas as pd

# Create the result DataFrame beforehand with dtype=object so it can store dictionaries.
results_df = pd.DataFrame(index=range(10, 200, 10), columns=[1, 2, 3], dtype=object)

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        my_df = pd.DataFrame({
            "Pclass": [pclass] * 3,
            "Name": [24] * 3,
            "Sex": [0] * 3, 
            "Age": [19] * 3,
            "SibSp": [0] * 3,
            "Parch": [0] * 3,
            "Fare": [fare] * 3,
            "Embarked": ["S", "Q", "C"]
        })
        # One-hot encode the 'Embarked' column.
        my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
        
        # Map boolean values to integers (some one-hot encode implementations might return booleans)
        my_df["Embarked_S"] = my_df["Embarked_S"].map({True: 1, False: 0})
        my_df["Embarked_C"] = my_df["Embarked_C"].map({True: 1, False: 0})
        my_df["Embarked_Q"] = my_df["Embarked_Q"].map({True: 1, False: 0})
        
        # Obtain predictions from both models.
        knn_prediction = knn.predict(my_df)
        mlp_prediction = mlp.predict(my_df)
        
        # Assign the dictionary of predictions to the corresponding cell.
        results_df.at[fare, pclass] = {"knn": knn_prediction, "mlp": mlp_prediction}

print(results_df)