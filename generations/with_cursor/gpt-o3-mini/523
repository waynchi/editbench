import tkinter as tk
import random

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        self.dx = random.choice([-2, 2])
        self.dy = random.choice([-2, 2])
        # Elegir un color aleatorio para que los cuadrados sean fáciles de distinguir
        self.color = random.choice(["blue", "red", "green", "orange", "purple", "magenta"])
        self.square = canvas.create_rectangle(x, y, x + size, y + size, fill=self.color, outline="black")

    def move(self):
        self.x += self.dx
        self.y += self.dy
        self.canvas.move(self.square, self.dx, self.dy)
        
        # Obtener dimensiones actuales del lienzo
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()
        
        # Si el cuadrado choca con alguno de los bordes, se elimina y se generan nuevos cuadrados
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            self.canvas.delete(self.square)
            if self.size > 10:
                new_size = self.size / 2
                # Se crean dos nuevos cuadrados en posiciones cercanas al centro
                squares.append(Square(self.canvas, new_size, 
                                        canvas_width/2 - new_size - 10, 
                                        canvas_height/2 - new_size - 10))
                squares.append(Square(self.canvas, new_size, 
                                        canvas_width/2 + 10, 
                                        canvas_height/2 + 10))
            return False
        return True

def update():
    global squares
    # Mueve todos los cuadrados y elimina aquellos que llegan a chocar con los límites
    squares = [square for square in squares if square.move()]
    root.after(20, update)  # Actualizar cada 20ms

# Crear la ventana principal
root = tk.Tk()
root.title("Splitting Colored Squares")

# Crear el lienzo y asegurar que tenga las dimensiones indicadas
canvas = tk.Canvas(root, width=600, height=600, bg="white")
canvas.pack(expand=True, fill="both")
root.update()  # Actualiza para que el lienzo tenga dimensiones correctas

# Crear el cuadrado inicial
squares = [Square(canvas, 100, 250, 250)]

# Iniciar la animación
update()

# Iniciar el bucle principal de la aplicación
root.mainloop()