import numpy as np
from matplotlib import pyplot as plt
from scipy.stats import lognorm
from scipy.optimize import minimize
from scipy.integrate import quad
import pandas as pd
from tqdm import tqdm
from typing import Dict, List, Tuple
import json
import seaborn as sns


class ModelRouter:
    def __init__(
        self,
        models: List[str],
        lambda_latency: float = 1.0,
        lambda_rarity: float = 1.0,
        lambda_ambiguity: float = 1.0,
    ):
        self.models = models
        self.n_models = len(models)
        self.model_to_idx = {model: idx for idx, model in enumerate(models)}
        self.lambda_latency = lambda_latency
        self.lambda_rarity = lambda_rarity
        self.lambda_ambiguity = lambda_ambiguity

        # Initialize pair count and theta parameters
        self.n_pairs = (self.n_models * (self.n_models - 1)) // 2
        self.theta = np.zeros(self.n_pairs)

        # Cache for battle statistics and latency parameters
        self.battle_counts = None
        self.battle_preferences = None
        self.latency_params = None
        self.latencies = None
        self.normalized_latencies = None

    def _softmax_function(self, theta: np.ndarray, temp: float = 1.0) -> np.ndarray:
        """Convert parameters to probabilities using temperature-scaled softmax."""
        exp_theta = np.exp(theta / temp)
        return exp_theta / np.sum(exp_theta)

    def _pair_to_index(self, i: int, j: int) -> int:
        """Convert a pair of model indices to a flat index."""
        if i > j:
            i, j = j, i
        return i * (self.n_models - 1) - (i * (i - 1)) // 2 + (j - i - 1)

    def _index_to_pair(self, idx: int) -> Tuple[int, int]:
        """Convert flat index back to a pair of model indices."""
        i = 0
        while idx >= self.n_models - i - 1:
            idx -= self.n_models - i - 1
            i += 1
        j = i + idx + 1
        return i, j

    def fit_latency_parameters(self, completions_df: pd.DataFrame):
        """Fit log-normal distribution parameters for latencies of each model."""
        self.latency_params = {}
        for model in self.models:
            model_latencies = completions_df[completions_df["model"] == model]["latency"]
            model_latencies = model_latencies[np.isfinite(model_latencies)]
            if len(model_latencies) > 0:
                shape, loc, scale = lognorm.fit(model_latencies, floc=0)
                mu = np.log(scale)
                sigma = shape
                self.latency_params[model] = (mu, sigma)
            else:
                print(f"Warning: No latency data for model {model}")
                self.latency_params[model] = (0, 1)
        print("Fitted latency parameters:")
        print(self.latency_params)

    def compute_battle_statistics(self, outcomes_df: pd.DataFrame):
        """Compute battle counts and preferences from outcomes data."""
        battle_counts = np.zeros((self.n_models, self.n_models))
        battle_preferences = np.zeros((self.n_models, self.n_models))

        for _, row in outcomes_df.iterrows():
            items = (
                json.loads(row["completionItems"])
                if isinstance(row["completionItems"], str)
                else row["completionItems"]
            )
            if len(items) < 2:
                continue

            # Process only the first two models
            model1, model2 = items[0]["model"], items[1]["model"]
            if model1 not in self.model_to_idx or model2 not in self.model_to_idx:
                continue

            i, j = self.model_to_idx[model1], self.model_to_idx[model2]
            battle_counts[i, j] += 1
            battle_counts[j, i] += 1

            if row.get("acceptedIndex") == 0:
                battle_preferences[i, j] += 1
                battle_preferences[j, i] -= 1
            elif row.get("acceptedIndex") == 1:
                battle_preferences[i, j] -= 1
                battle_preferences[j, i] += 1

        self.battle_counts = battle_counts
        self.battle_preferences = battle_preferences

    def compute_latency(self):
        """Compute expected maximum latencies between model pairs via numerical integration."""

        def max_latency_integrand(
            l: float, mu_i: float, sigma_i: float, mu_j: float, sigma_j: float
        ) -> float:
            f_i = lognorm.pdf(l, sigma_i, scale=np.exp(mu_i))
            F_j = lognorm.cdf(l, sigma_j, scale=np.exp(mu_j))
            f_j = lognorm.pdf(l, sigma_j, scale=np.exp(mu_j))
            F_i = lognorm.cdf(l, sigma_i, scale=np.exp(mu_i))
            return l * (f_i * F_j + F_i * f_j)

        total_latency = 0
        self.latencies = []
        for idx in range(self.n_pairs):
            i, j = self._index_to_pair(idx)
            mu_i, sigma_i = self.latency_params[self.models[i]]
            mu_j, sigma_j = self.latency_params[self.models[j]]
            expected_max, _ = quad(
                max_latency_integrand, 0, np.inf, args=(mu_i, sigma_i, mu_j, sigma_j)
            )
            self.latencies.append(expected_max)
        self.latencies = np.array(self.latencies)
        self.normalized_latencies = (self.latencies - np.min(self.latencies)) / (
            np.max(self.latencies) - np.min(self.latencies)
        )

    def compute_latency_objective(self, probs: np.ndarray) -> float:
        total_normalized_latency = sum(
            [probs[idx] * self.normalized_latencies[idx] for idx in range(self.n_pairs)]
        )
        return total_normalized_latency

    def compute_rarity_objective(self, probs: np.ndarray) -> float:
        """Compute the rarity objective function."""
        epsilon = 1.0
        total_rarity = 0
        for idx in range(self.n_pairs):
            i, j = self._index_to_pair(idx)
            count = self.battle_counts[i, j]
            rarity_score = 1.0 / (count + epsilon)
            total_rarity -= probs[idx] * rarity_score
        return total_rarity

    def compute_ambiguity_objective(self, probs: np.ndarray) -> float:
        """Compute the ambiguity objective function."""
        total_ambiguity = 0
        for idx in range(self.n_pairs):
            i, j = self._index_to_pair(idx)
            if self.battle_counts[i, j] > 0:
                avg_preference = self.battle_preferences[i, j] / self.battle_counts[i, j]
                ambiguity_score = 1.0 - abs(avg_preference)
                total_ambiguity -= probs[idx] * ambiguity_score
        return total_ambiguity

    def objective_function(self, theta: np.ndarray) -> float:
        """Combined objective function for optimization."""
        probs = np.exp(theta) / np.sum(np.exp(theta))
        latency_obj = self.compute_latency_objective(probs)
        rarity_obj = self.compute_rarity_objective(probs)
        ambiguity_obj = self.compute_ambiguity_objective(probs)
        total_obj = (
            self.lambda_latency * latency_obj
            + self.lambda_rarity * rarity_obj
            + self.lambda_ambiguity * ambiguity_obj
        )
        return total_obj

    def fit(self, max_iter: int = 1000):
        """Optimize the routing parameters using L-BFGS-B."""
        pbar = tqdm(total=max_iter, desc="Optimizing routing parameters")
        iter_count = [0]

        def objective_with_progress(x):
            iter_count[0] += 1
            pbar.update(1)
            # Uncomment the next line if you wish to see the softmax probabilities each iteration
            # print(self._softmax_function(self.theta))
            return self.objective_function(x)

        try:
            result = minimize(
                objective_with_progress,
                self.theta,
                method="L-BFGS-B",
                options={"maxiter": max_iter},
            )
            self.theta = result.x
            return result
        finally:
            pbar.close()

    def get_routing_probabilities(self, temp: float = 1.0) -> Dict[Tuple[str, str], float]:
        """Return optimized routing probabilities for each model pair."""
        probs = self._softmax_function(theta=self.theta, temp=temp)
        routing_probs = {}
        for idx in range(self.n_pairs):
            i, j = self._index_to_pair(idx)
            routing_probs[(self.models[i], self.models[j])] = probs[idx]
        return routing_probs

    def sample_model_pair(self) -> Tuple[str, str]:
        """Sample a model pair based on the current optimized routing distribution."""
        probs = self._softmax_function(theta=self.theta)
        idx = np.random.choice(self.n_pairs, p=probs)
        i, j = self._index_to_pair(idx)
        return self.models[i], self.models[j]

    def visualize_probability_matrix(self, temp: float = 1.0):
        """Plot the probability matrix for all model pairs."""
        prob_matrix = np.zeros((self.n_models, self.n_models))
        probs = self._softmax_function(theta=self.theta, temp=temp)
        for idx in range(self.n_pairs):
            i, j = self._index_to_pair(idx)
            prob_matrix[i, j] = probs[idx]
            prob_matrix[j, i] = probs[idx]
        plt.figure(figsize=(15, 12))
        sns.heatmap(
            prob_matrix,
            xticklabels=self.models,
            yticklabels=self.models,
            annot=True,
            fmt=".3f",
            cmap="YlOrRd",
        )
        plt.title("Model Pairing Probabilities")
        plt.xticks(rotation=45, ha="right")
        plt.yticks(rotation=0)
        plt.tight_layout()
        plt.show()
        return prob_matrix

    def print_probability_matrix(self, temp: float = 1.0, title: str = ""):
        """Print a formatted probability matrix."""
        print(title)
        probs = self._softmax_function(theta=self.theta, temp=temp)
        prob_matrix = np.zeros((self.n_models, self.n_models))
        for idx in range(self.n_pairs):
            i, j = self._index_to_pair(idx)
            prob_matrix[i, j] = probs[idx]
            prob_matrix[j, i] = probs[idx]
        print("\nProbability Matrix:")
        print("-" * 120)
        print(f"{'Model':30}", end="")
        for model in self.models:
            print(f"{model:>10}", end="")
        print("\n" + "-" * 120)
        for i, model1 in enumerate(self.models):
            print(f"{model1:30}", end="")
            for j, model2 in enumerate(self.models):
                if i == j:
                    print(f"{'---':>10}", end="")
                else:
                    print(f"{prob_matrix[i, j]:10.3f}", end="")
            print()
        print("-" * 120)
        return prob_matrix

    def calculate_expected_latency(self, temp: float = 1.0) -> float:
        """Compute the expected latency (in seconds) for the current routing probabilities."""
        if self.latency_params is None:
            raise ValueError("Latency parameters not fitted. Call fit_latency_parameters first.")
        probs = self._softmax_function(theta=self.theta, temp=temp)
        total_expected_latency = sum([probs[idx] * self.latencies[idx] for idx in range(self.n_pairs)])
        return total_expected_latency

    def print_expected_latencies(self, temperatures: List[float] = [1.0, 2.0, 5.0, 10.0]):
        """Print expected latencies for a list of temperature values."""
        print("\nExpected Latencies:")
        print("-" * 50)
        print(f"{'Temperature':>12} | {'Expected Latency (s)':>20}")
        print("-" * 50)
        for temp in temperatures:
            expected_latency = self.calculate_expected_latency(temp)
            print(f"{temp:12.1f} | {expected_latency:20.3f}")
        print("-" * 50)


def run_routing_optimization(
    completions_filepath: str,
    outcomes_filepath: str,
    output_folder: str,
    models: List[str] = None,
    lambda_latency: float = 0.1,
    lambda_rarity: float = 1.0,
    lambda_ambiguity: float = 1.0,
    max_iter: int = 1000,
) -> ModelRouter:
    """
    Run the complete routing optimization flow. This function can be called repeatedly.
    It loads the input data, fits latency parameters, computes battle statistics and latencies,
    performs the optimization for the given lambda parameters, saves the routing parameters, and
    outputs expected latencies and probability matrices.

    Arguments:
        completions_filepath (str): Path to the CSV file with completions data.
        outcomes_filepath (str): Path to the CSV file with outcomes data.
        output_folder (str): Directory where routing parameters files will be saved.
        models (List[str], optional): List of models. If None, a default list is used.
        lambda_latency (float): Weight for latency objective.
        lambda_rarity (float): Weight for rarity objective.
        lambda_ambiguity (float): Weight for ambiguity objective.
        max_iter (int): Maximum iterations for optimizer.

    Returns:
        ModelRouter: The ModelRouter instance with optimized parameters.
    """
    if models is None:
        models = [
            "gpt-4o-mini-2024-07-18",
            "codestral-2405",
            "llama-3.1-70b-instruct",
            "llama-3.1-405b-instruct",
            "gemini-1.5-flash-002",
            "gemini-1.5-pro-002",
            "claude-3-5-sonnet-20240620",
            "claude-3-5-sonnet-20241022",
            "qwen-2.5-coder-32b-instruct",
            "gpt-4o-2024-08-06",
        ]

    router = ModelRouter(
        models,
        lambda_latency=lambda_latency,
        lambda_rarity=lambda_rarity,
        lambda_ambiguity=lambda_ambiguity,
    )

    # Load dataframes
    completions_df = pd.read_csv(completions_filepath)
    outcomes_df = pd.read_csv(outcomes_filepath)

    # Fit latency parameters and compute latencies
    router.fit_latency_parameters(completions_df)
    router.compute_latency()
    # Compute battle statistics from outcomes
    router.compute_battle_statistics(outcomes_df)

    # Build filename for saving routing parameters for the given lambda combination
    filename = f"{output_folder}/routing_parameters_{lambda_latency}_{lambda_rarity}_{lambda_ambiguity}.json"

    # Try to load precomputed routing parameters
    try:
        with open(filename, "r") as f:
            routing_parameters = json.load(f)
            router.theta = np.array(routing_parameters["theta"])
            print(f"Loaded existing routing parameters from {filename}.")
    except FileNotFoundError:
        print(f"No existing parameters found for lambdas ({lambda_latency}, {lambda_rarity}, {lambda_ambiguity}). Running optimization...")
        result = router.fit(max_iter=max_iter)
        if result.success:
            print(f"Optimization successful for lambdas ({lambda_latency}, {lambda_rarity}, {lambda_ambiguity}).")
        else:
            print(f"Optimization failed: {result.message}")
        with open(filename, "w") as f:
            json.dump({"theta": router.theta.tolist()}, f)
        print(f"Routing parameters saved to {filename}.")

    # Optionally, print and visualize results
    router.print_probability_matrix(temp=1.0, title="Optimized Routing Probability Matrix")
    router.print_expected_latencies(temperatures=[1.0])
    # Uncomment the next line to display a heatmap of routing probabilities
    # router.visualize_probability_matrix(temp=1.0)

    return router


def main():
    # Define filepaths and output folder - adjust these paths as needed.
    completions_filepath = "completions_data.csv"
    outcomes_filepath = "outcomes_data.csv"
    output_folder = "routing_params"

    # Example: iterate over a grid of lambda values.
    lambda_latency_values = np.arange(0, 1, 0.1)
    lambda_rarity_values = np.arange(0, 1, 0.1)
    lambda_ambiguity_values = np.arange(0, 1, 0.1)

    for ll in lambda_latency_values:
        for lr in lambda_rarity_values:
            for la in lambda_ambiguity_values:
                print(f"\nProcessing lambda values: latency={ll}, rarity={lr}, ambiguity={la}")
                router = run_routing_optimization(
                    completions_filepath,
                    outcomes_filepath,
                    output_folder,
                    lambda_latency=ll,
                    lambda_rarity=lr,
                    lambda_ambiguity=la,
                    max_iter=500,
                )
                # The router instance now holds the optimized parameters for the current lambda combination.
                # You can call router.get_routing_probabilities(), router.sample_model_pair(), etc.
                # This function is designed to be called repeatedly.

if __name__ == "__main__":
    main()