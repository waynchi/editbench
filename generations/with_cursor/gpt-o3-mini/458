        elif czyNaprawialny(obrazek):
            naprawialne += 1
            naprawiony = napraw(obrazek)
            # Aquí se podría procesar o imprimir la imagen reparada si se desea.
    if len(obrazek) == 22:  # después de la línea 22, se reinicia para la siguiente imagen
        obrazek = list()

