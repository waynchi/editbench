import requests
from pyspark.sql import SparkSession
from pyspark.sql.functions import col

# 创建一个Spark会话
spark = SparkSession.builder.appName("EscrituraParquetADL2").getOrCreate()

# 从API获取数据
api_url = "http://example.com/api/data"  # 替换为实际的API地址
response = requests.get(api_url)
if response.status_code == 200:
    data = response.json()  # 假设API返回的是一个JSON数组或对象列表
else:
    raise Exception(f"API 获取数据失败, 状态码: {response.status_code}")

# 分析数据：显示前几条记录以了解数据结构
print("数据示例 (前5条):")
if isinstance(data, list):
    for record in data[:5]:
        print(record)
else:
    print(data)

# 根据获取的数据创建一个DataFrame
df = spark.createDataFrame(data)

# 展示DataFrame的架构以进一步分析
df.printSchema()

# 配置与ADL2的连接使用Microsoft ID身份
# 在Synapse的笔记本中不需要显式提供凭据
# Spark将使用notebook的托管身份进行身份验证。

# 指定ADL2中容器和文件夹的路径
container_name = "<your_container_name>"  # 用你的容器名称替换
folder_path = "<your_folder_path>"  # 替换为容器内文件夹的路径
storage_account_name = "<your_storage_account_name>"  # 替换为你的存储账户名称
adl2_path = f"abfss://{container_name}@{storage_account_name}.dfs.core.windows.net/{folder_path}"

# 将DataFrame以parquet格式写入ADL2
df.write.parquet(adl2_path, mode="overwrite")

# 可选：读取parquet文件进行验证
df_leido = spark.read.parquet(adl2_path)
df_leido.show()

# 停止 Spark 会话
spark.stop()