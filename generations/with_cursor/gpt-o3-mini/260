import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-10, max_iter=1000):
    """
    Решает систему линейных уравнений Ax = b с помощью метода сопряжённых градиентов.
    
    Параметры:
        A : numpy.ndarray
            Квадратная симметричная положительно определенная матрица.
        b : numpy.ndarray
            Правая часть системы.
        x0 : numpy.ndarray или None, по умолчанию None
            Начальное приближение (если None, используется нулевой вектор).
        tol : float, по умолчанию 1e-10
            Допустимая погрешность (точность) нормы остатка.
        max_iter : int, по умолчанию 1000
            Максимальное число итераций.
    
    Возвращает:
        x : numpy.ndarray
            Решение системы.
        info : dict
            Словарь с информацией о процессе сходимости:
                "iterations"  - число выполненных итераций,
                "residual"    - норма остатка,
                "converged"   - True, если достигнута сходимость, иначе False.
    """
    n = len(b)
    if x0 is None:
        x = np.zeros(n)
    else:
        x = np.array(x0, dtype=float)

    r = b - A @ x   # начальный остаток
    p = r.copy()    # начальное направление поиска
    rs_old = np.dot(r, r)

    for i in range(max_iter):
        Ap = A @ p
        alpha = rs_old / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rs_new = np.dot(r, r)
        
        if np.sqrt(rs_new) < tol:
            return x, {
                "iterations": i + 1,
                "residual": np.sqrt(rs_new),
                "converged": True
            }
        
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new

    return x, {
        "iterations": max_iter,
        "residual": np.sqrt(rs_old),
        "converged": False
    }

if __name__ == "__main__":
    # Пример использования функции для метода сопряжённых градиентов.
    A = np.array([[4, 1], [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    x0 = np.zeros(2)

    solution, info = conjugate_gradient(A, b, x0)
    print("Найденное решение x:", solution)
    print("Информация о сходимости:", info)