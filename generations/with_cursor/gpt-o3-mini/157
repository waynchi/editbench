import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-10, max_iter=None):
    """
    求解线性系统 Ax = b 的共轭梯度法实现，其中 A 必须是对称正定矩阵。

    参数:
    A : 2D numpy.array
        对称正定矩阵。
    b : 1D numpy.array
        右侧向量。
    x0 : 1D numpy.array, 可选
        初始猜测。如果为 None，则默认为全 0 向量。
    tol : float, 可选
        收敛容忍度。当残差的 2 范数小于该值时停止迭代。
    max_iter : int, 可选
        最大迭代次数。如果为 None，则默认设置为问题规模的大小。

    返回:
    x : 1D numpy.array
        Ax = b 的解向量。
    """
    n = len(b)
    if x0 is None:
        x0 = np.zeros(n)
    if max_iter is None:
        max_iter = n

    x = x0.copy()
    r = b - A.dot(x)
    p = r.copy()
    rs_old = np.dot(r, r)

    for i in range(max_iter):
        Ap = A.dot(p)
        alpha = rs_old / np.dot(p, Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        
        rs_new = np.dot(r, r)
        if np.sqrt(rs_new) < tol:
            print(f"Converged after {i+1} iterations.")
            break
        
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new

    return x

def main():
    # 示例: 使用 2x2 对称正定矩阵 A 和向量 b
    A = np.array([[4, 1],
                  [1, 3]], dtype=float)
    b = np.array([1, 2], dtype=float)
    
    # 调用共轭梯度法求解 Ax = b
    x = conjugate_gradient(A, b)
    
    print("解向量 x:", x)
    # 输出残差验证解的精度
    residual = b - A.dot(x)
    print("残差:", residual)
    
if __name__ == "__main__":
    main()