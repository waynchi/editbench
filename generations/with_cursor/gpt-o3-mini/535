from dataclasses import dataclass
import numpy as np
norm = np.random.normal

@dataclass
class NeuralNetwork:
    inp: int      # nodos de entrada (número de neuronas en la entrada)
    hid: int      # nodos ocultos (número de neuronas en la capa oculta)
    out: int      # nodos de salida (número de neuronas en la salida)
    lr: float     # tasa de aprendizaje (coeficiente de suavizado alfa)
    act: callable  # función de activación
    epo: int      # épocas (número de épocas de entrenamiento)

    def __post_init__(self):
        # Corrección: se utiliza 1/sqrt(número de nodos de entrada) para la desviación estándar
        self.wih = norm(0., 1.0 / np.sqrt(self.inp), (self.hid, self.inp))
        self.who = norm(0., 1.0 / np.sqrt(self.hid), (self.out, self.hid))

    def train(self, x, y):
        x = np.array(x, ndmin=2).T
        y = np.array(y, ndmin=2).T

        ho = self.act(self.wih @ x)  # salidas de la capa oculta
        fo = self.act(self.who @ ho) # salidas finales
        oe = y - fo                  # error de salida
        he = self.who.T @ oe         # error propagado a la capa oculta
        self.who += self.lr * (oe * fo * (1. - fo)) @ ho.T
        self.wih += self.lr * (he * ho * (1. - ho)) @ x.T

    def query(self, x):
        x = np.array(x, ndmin=2).T
        return self.act(self.who @ self.act(self.wih @ x))

    def fit(self, X, y):
        for e in range(self.epo):
            for i in range(len(y)):
                self.train(X[i], y[i])

    def predict(self, X):
        return np.array([np.argmax(self.query(x)) for x in X])

    def score(self, X, y):
        y_true = np.array([np.argmax(i) for i in y])
        predictions = self.predict(X)
        return (predictions == y_true).mean()