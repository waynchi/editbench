def is_sum_of_four_squares(n):
    """
    Verifica se n pode ser expresso como a soma de quatro quadrados não nulos.
    Retorna uma tupla (a, b, c, d) se encontrar uma representação com a, b, c e d diferentes de zero;
    caso contrário, retorna None.
    """
    # O menor valor que pode ser expresso como a soma de quatro quadrados não nulos é 4 (1^2+1^2+1^2+1^2).
    if n < 4:
        return None

    # O maior candidato para a, b, c e d, para que seus quadrados não excedam n, é a raiz inteira de n.
    max_value = int(n**0.5)
    for a in range(1, max_value + 1):
        for b in range(1, max_value + 1):
            for c in range(1, max_value + 1):
                for d in range(1, max_value + 1):
                    if a**2 + b**2 + c**2 + d**2 == n:
                        return a, b, c, d
    return None

def find_four_squares_sums(limit):
    """
    Encontra todos os números até o limite informado que podem ser expressos
    como a soma de quatro quadrados não nulos.
    """
    results = []
    # Começamos em 4, pois é o menor número válido (1^2+1^2+1^2+1^2 = 4)
    for n in range(4, limit + 1):
        representation = is_sum_of_four_squares(n)
        if representation is not None:
            results.append(n)
    return results

if __name__ == "__main__":
    try:
        limit = int(input("Digite o limite superior: "))
    except ValueError:
        print("Por favor, digite um número inteiro válido.")
        exit(1)

    sums_found = find_four_squares_sums(limit)
    print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
    for num in sums_found:
        rep = is_sum_of_four_squares(num)
        a, b, c, d = rep
        print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")