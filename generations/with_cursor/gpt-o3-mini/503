def factual_score_dataloader(
    model,
    tokenizer,
    batched_tokenized_questions,
    expected_answers,
    max_new_tokens=32,
    output_format=False,
    random_state=42,
    device=None,
    verbose=False,
):
    """
    Evaluate the factual accuracy of answers from a language model.

    Args:
        model: The language model.
        tokenizer: The tokenizer.
        batched_tokenized_questions: The tokenized evaluation dataset in batches.
        expected_answers: The expected answers (batched).
        max_new_tokens: Maximum number of new tokens to generate.
        output_format: Whether to check output format.
        random_state: Random seed for sampling.
        device: Device to run on (defaults to CUDA if available, else CPU).
        verbose: Whether to print verbose logs.

    Returns:
        If output_format is False:
            fact_results: List of factual accuracy moving averages per batch.
        Else:
            fact_results: List of factual accuracy moving averages per batch.
            format_hard_avg: The moving average metric for hard format checks.
            format_soft_avg: The moving average metric for soft format checks.
    """
    if device is None:
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = model.to(device)
    fact_results = []
    fact_mean = 0
    fact_count = 0

    # Inicializar variables para medias móviles si se requiere evaluar formato
    if output_format:
        running_format_hard_avg = 0.0
        running_format_soft_avg = 0.0
        format_count = 0

    for batch, expected_ans in zip(batched_tokenized_questions, expected_answers):
        batch = {k: v.to(device) for k, v in batch.items() if k in ["input_ids", "attention_mask"]}

        with torch.no_grad():
            outputs = model.generate(
                **batch,
                max_new_tokens=max_new_tokens,
                pad_token_id=tokenizer.pad_token_id,
            )
            # Decode las entradas y las respuestas generadas
            detokenized_inputs = tokenizer.batch_decode(
                batch["input_ids"], skip_special_tokens=True
            )
            generated_outputs = outputs[:, batch["input_ids"].shape[-1]:]
            output_strings = tokenizer.batch_decode(
                generated_outputs, skip_special_tokens=True
            )

            # Calcular la precisión factual usando la función check_answer_factual
            new_factual_results = [
                check_answer_factual(output_str, expected)
                for output_str, expected in zip(output_strings, expected_ans)
            ]
            # Actualizar la media móvil para la precisión factual
            batch_size_factual = len(new_factual_results)
            fact_mean = (fact_mean * fact_count + sum(new_factual_results)) / (fact_count + batch_size_factual)
            fact_count += batch_size_factual
            fact_results.append(fact_mean)

            if output_format:
                # Calcular las verificaciones de formato para cada ejemplo
                new_format_hard = [
                    check_answer_format(output_str, hard=True) for output_str in output_strings
                ]
                new_format_soft = [
                    check_answer_format(output_str, hard=False) for output_str in output_strings
                ]
                batch_size_format = len(new_format_hard)
                # Actualizar la media móvil para el formato duro y blando
                running_format_hard_avg = (
                    running_format_hard_avg * format_count + sum(new_format_hard)
                ) / (format_count + batch_size_format)
                running_format_soft_avg = (
                    running_format_soft_avg * format_count + sum(new_format_soft)
                ) / (format_count + batch_size_format)
                format_count += batch_size_format

    if output_format:
        return fact_results, running_format_hard_avg, running_format_soft_avg
    else:
        return fact_results