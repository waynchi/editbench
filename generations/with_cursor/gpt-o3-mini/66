from manim import *

class MaroAnimation(Scene):
    def construct(self):
        # Create the text
        text = Text("Maro", font_size=120)
        
        # Add a nice color gradient
        text.set_color_by_gradient(BLUE, PURPLE, PINK)
        
        # Write the text onto the scene over 2 seconds using a smooth rate function
        self.play(
            Write(text, run_time=2),
            rate_func=smooth
        )
        
        # Produce a gentle pulse animation by scaling the text up and back
        self.play(
            text.animate.scale(1.2),
            rate_func=there_and_back,
            run_time=1.5
        )
        
        # To animate multiple transformations (rotation and shift) on the same object concurrently,
        # combine them in an AnimationGroup.
        self.play(
            AnimationGroup(
                text.animate.rotate(PI/12),
                text.animate.shift(UP * 0.5)
            ),
            rate_func=ease_in_out_sine,
            run_time=1
        )
        
        # Hold the final frame for 2 seconds
        self.wait(2)