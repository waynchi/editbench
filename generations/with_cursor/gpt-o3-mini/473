import numpy as np

def linear_regression_gradient_descent(X: np.ndarray, y: np.ndarray, alpha: float, iterations: int) -> np.ndarray:
    # Aseguramos que y sea un vector columna para evitar problemas de difusión (broadcasting)
    if y.ndim == 1:
        y = y.reshape(-1, 1)
    
    m, n = X.shape
    theta = np.zeros((n, 1))

    for _ in range(iterations):
        # Calculamos el gradiente
        gradiente = (1/m) * X.T @ (X @ theta - y)
        theta -= alpha * gradiente

    # Redondeamos los valores de theta para mayor claridad
    return np.round(theta, 4)

print(
    linear_regression_gradient_descent(
        np.array([[1, 1], [1, 2], [1, 3]]),
        np.array([1, 2, 3]),
        0.01,
        1000
    )
)