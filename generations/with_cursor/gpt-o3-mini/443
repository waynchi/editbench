def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False
    return True

# Ejemplo de uso y pruebas
if __name__ == "__main__":
    numeros_a_probar = [0, 1, 2, 3, 4, 16, 17, 18, 19, 20]
    for numero in numeros_a_probar:
        resultado = "primo" if is_prime(numero) else "no primo"
        print(f"{numero} es {resultado}")