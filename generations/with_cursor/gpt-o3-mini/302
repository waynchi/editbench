import { messages } from "./messages.js";

$(document).ready(function() {
    const $loadingContainer = $('.container-loading');
    const $paymentSection   = $('.payment-section');
    const $userInfo         = $('.user-info');
    const $mainSection      = $('.main');
    const $loadingMessages  = $('#loading-messages');

    // Извлечь значения из localStorage
    const storedData = JSON.parse(localStorage.getItem('userData')) || {};
    const { userInfo, paymentInfo } = storedData;

    console.log('User Info:', userInfo);
    console.log('Payment Info:', paymentInfo);

    $('#generateTaxButton').on('click', function() {
        $mainSection.fadeOut(500, function() {
            // Небольшая задержка перед показом загрузочного экрана
            setTimeout(function() {
                $loadingContainer.css('display', 'flex');

                // Вычисляем суммарную задержку для всех сообщений
                let totalDelay = 0;
                messages.forEach(message => {
                    totalDelay += message.time;
                });
                console.log(`Общая задержка: ${totalDelay} мс`);

                // Показываем сообщения с накопительной задержкой
                let accumulatedDelay = 0;
                messages.forEach(message => {
                    accumulatedDelay += message.time;
                    setTimeout(function() {
                        $loadingMessages.text(message.text);
                        console.log(`Сообщение: "${message.text}" через ${accumulatedDelay} мс`);
                    }, accumulatedDelay);
                });

                // После всех сообщений показываем секцию оплаты и информацию о пользователе
                setTimeout(function() {
                    console.log('Переход к оплате');
                    $loadingContainer.hide();
                    $paymentSection.show();
                    $userInfo.show();
                }, accumulatedDelay + 500);
            }, 200);
        });
    });
});