def save_log_to_file(log_history, file_path, append_latest_only=False):
    """
    Optimized saving of log history by using json.load() instead of manual file string handling.
    
    Expected Improvement:
      - Eliminates the overhead of manually reading and stripping file content.
      - Leverages built-in JSON parsing for cleaner and potentially faster file reading.
    
    Trade-offs:
      - Reads the entire file into memory; if the log file is huge, memory consumption may increase.
    """
    current_logs = []
    if os.path.exists(file_path):
        try:
            with open(file_path, "r") as f:
                # Directly load JSON content, which is more robust and efficient.
                current_logs = json.load(f)
        except json.JSONDecodeError:
            print(f"Warning: {file_path} contains invalid JSON. Overwriting file.")
            current_logs = []
        except Exception as e:
            print(f"An error occurred while reading {file_path}: {e}")
            current_logs = []
    # Append logs based on the provided flag.
    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)
    try:
        with open(file_path, "w") as f:
            json.dump(current_logs, f, indent=4)
    except Exception as e:
        print(f"An error occurred while writing to {file_path}: {e}")


def clear_directory(directory, delete_directory=False):
    """
    Optimized clearing of a directory's contents by using os.scandir.
    
    Changes:
      - Uses os.scandir to iterate over directory entries.
    
    Expected Improvement:
      - os.scandir provides better performance on directories with many files or subdirectories 
        because it reduces system calls compared to os.listdir.
    
    Trade-offs:
      - os.scandir is available in Python 3.5+. This might cause compatibility issues with older Python releases.
    """
    if not os.path.exists(directory):
        if not delete_directory:
            os.makedirs(directory)
            print(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        return

    # Using os.scandir for optimized directory iteration
    with os.scandir(directory) as entries:
        for entry in entries:
            item_path = entry.path
            try:
                if entry.is_dir(follow_symlinks=False):
                    shutil.rmtree(item_path)
                    print(f"Removed directory: {item_path}")
                else:
                    os.remove(item_path)
                    print(f"Removed file: {item_path}")
            except OSError as e:
                print(f"Failed to delete '{item_path}'. Reason: {e}")
                raise

    if delete_directory:
        try:
            os.rmdir(directory)
            print(f"Removed directory: {directory}")
        except OSError as e:
            print(f"Failed to delete '{directory}'. Reason: {e}")
            raise


def merge_lora_model(
    model_name="pythia-31M",
    base_model_repo_name="EleutherAI/",
    model_load_path=MODEL_PATH,
    model_save_path=MODEL_PATH,
):
    """
    Merges a LoRA fine-tuned model with its base model.
    
    Note:
      - No significant performance changes can be made here because the bottleneck is in downloading 
        and loading large models.
    """
    my_model_path = os.path.join(model_load_path, model_name)
    param_count = model_name.lower().split("m")[0].split("-")[1]
    base_model_str = f"pythia-{param_count}M"

    base_model = AutoModelForCausalLM.from_pretrained(
        os.path.join(base_model_repo_name, base_model_str)
    )
    model = PeftModel.from_pretrained(base_model, my_model_path)
    merged_model = model.merge_and_unload()
    my_model_save_path = os.path.join(model_save_path, f"{model_name}_merged")
    merged_model.save_pretrained(my_model_save_path)


def remove_repetition(question, answer):
    """
    Removes repeated question parts from the answer.
    
    Expected Improvement:
      - Checks for the substring before calling replace, avoiding unnecessary operations.
    
    Trade-offs:
      - Minimal; this is a simple string manipulation.
    """
    if question in answer:
        return answer.replace(question, "").strip()
    return answer


def load_model(
    model_type,
    model_path=None,
    blocks_str=None,
    vanilla_model_name=None,
    host_model_name=None,
):
    """
    Loads models based on the given type.
    
    Note:
      - The performance is mostly dependent on the underlying libraries (e.g., transformers, pickle).
      - Additional caching could be implemented for models that are loaded multiple times.
    
    Expected Improvement:
      - Clear separation of different loading cases improves maintainability without sacrificing performance.
    
    Trade-offs:
      - Implementing caching would improve repeated access but add complexity and memory overhead.
    """
    if model_type == "Tuned Model":
        model_name = vanilla_model_name.split("/")[-1]
        tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
        tuned_model = AutoModelForCausalLM.from_pretrained(
            os.path.join(model_path, tuned_model_name)
        )
        return tuned_model

    elif model_type == "Vanilla Model":
        vanilla_model = AutoModelForCausalLM.from_pretrained(vanilla_model_name)
        return vanilla_model

    elif model_type == "Transformed Model":
        name = host_model_name.split("/")[-1]
        save_path = os.path.join(model_path, f"{name}_preGRAFTED_{blocks_str}.pkl")
        with open(save_path, "rb") as f:
            transformed_model = pickle.load(f)
        return transformed_model

    elif model_type == "Final Model":
        name = host_model_name.split("/")[-1]
        model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
        save_path = os.path.join(model_path, model_save_name)
        with open(save_path, "rb") as f:
            final_model = pickle.load(f)
        return final_model

    elif model_type == "Host Model":
        host_model = AutoModelForCausalLM.from_pretrained(host_model_name)
        return host_model

    else:
        raise ValueError(f"Unknown model type: {model_type}")


def load_batch_losses(file_path):
    """
    Loads batch losses from a checkpoint file with optimized error handling.
    
    Changes:
      - Maintains the use of torch.load with map_location for cross-device compatibility.
    
    Expected Improvement:
      - Improved robustness and maintainability due to standardized logging and error handling.
    
    Trade-offs:
      - Performance remains similar; this change focuses on clarity and debugging facilitation.
    """
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"))
        batch_losses = checkpoint.get("batch_losses", None)
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except (FileNotFoundError, IOError, RuntimeError) as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None