def factual_score_dataloader(
    model,
    tokenizer,
    batched_tokenized_questions,
    expected_answers,
    max_new_tokens=32,
    output_format=False,
    random_state=42,
    device=None,
    verbose=False,
):
    """
    Evaluate the factual accuracy of answers from a language model.

    Instead of storing all individual outputs for format checks, the function computes rolling means
    for factual accuracy and (optionally) for format checks.

    Args:
        model: The language model.
        tokenizer: The tokenizer.
        batched_tokenized_questions: DataLoader of tokenized questions.
        expected_answers: DataLoader of expected answers.
        max_new_tokens: Maximum number of new tokens to generate.
        output_format: Whether to check output format.
        random_state: Random seed for sampling.
        device: Device to run on (defaults to CUDA if available, else CPU).
        verbose: Whether to log additional information.

    Returns:
        If output_format is False:
            A single float: the rolling mean factual accuracy.
        If output_format is True:
            A tuple of three floats: (factual_accuracy, format_hard_mean, format_soft_mean)
    """

    if device is None:
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = model.to(device)

    fact_sum = 0
    count = 0
    if output_format:
        format_hard_sum = 0
        format_soft_sum = 0

    for batch, expected_ans in zip(batched_tokenized_questions, expected_answers):
        # Move only the required keys to the device
        batch = {k: v.to(device) for k, v in batch.items() if k in ["input_ids", "attention_mask"]}

        with torch.no_grad():
            outputs = model.generate(
                **batch,
                max_new_tokens=max_new_tokens,
                pad_token_id=tokenizer.pad_token_id
            )
            # Decode the input to determine where the generated tokens begin
            detokenized_inputs = tokenizer.batch_decode(batch["input_ids"], skip_special_tokens=True)
            # Compute the starting index for generated tokens for each sequence
            gen_start = batch["input_ids"].shape[-1]
            output_strings = tokenizer.batch_decode(
                outputs[:, gen_start:], skip_special_tokens=True
            )

            # Compute factual correctness for each output in the batch
            new_factual_results = [
                check_answer_factual(output_str, exp_ans)
                for output_str, exp_ans in zip(output_strings, expected_ans)
            ]
            fact_sum += sum(new_factual_results)
            count += len(new_factual_results)

            if output_format:
                new_format_hard = [
                    check_answer_format(output_str, hard=True)
                    for output_str in output_strings
                ]
                new_format_soft = [
                    check_answer_format(output_str, hard=False)
                    for output_str in output_strings
                ]
                format_hard_sum += sum(new_format_hard)
                format_soft_sum += sum(new_format_soft)

    final_fact_mean = fact_sum / count if count > 0 else 0
    if output_format:
        final_format_hard_mean = format_hard_sum / count if count > 0 else 0
        final_format_soft_mean = format_soft_sum / count if count > 0 else 0
        return final_fact_mean, final_format_hard_mean, final_format_soft_mean
    else:
        return final_fact_mean