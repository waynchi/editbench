from main13 import knn, mlp
import pandas as pd

def main():
    for pclass in [1, 2, 3]:
        for fare in range(10, 200, 10):
            for embarked in ["S", "Q", "C"]:
                # Create the DataFrame with one row of data
                data = {
                    "Pclass": [pclass],
                    "Name": [24],
                    "Sex": [0],
                    "Age": [19],
                    "SibSp": [0],
                    "Parch": [0],
                    "Fare": [fare],
                    "Embarked": [embarked]
                }
                my_df = pd.DataFrame(data)
                
                # Apply one-hot encoding to the 'Embarked' column
                my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
                
                # Ensure that all dummy columns exist, even if not generated by get_dummies
                for col in ["Embarked_S", "Embarked_C", "Embarked_Q"]:
                    if col not in my_df.columns:
                        my_df[col] = 0
                    else:
                        # Convert boolean values (if any) to integers
                        my_df[col] = my_df[col].map({True: 1, False: 0}) if my_df[col].dtype == bool else my_df[col]
                
                # Print parameters and predictions from both models
                print("-------------------------------------------------------")
                print(f"Parameters: Pclass={pclass}, Fare={fare}, Embarked={embarked}")
                print(f"Prediction by knn: {knn.predict(my_df)}")
                print(f"Prediction by mlp: {mlp.predict(my_df)}\n")

if __name__ == '__main__':
    main()