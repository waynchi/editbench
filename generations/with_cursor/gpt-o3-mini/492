import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew

def medcouple(data):
    data = np.sort(data)
    median = np.median(data)

    # Dividir los datos en izquierda y derecha de la mediana.
    left = data[data <= median]
    right = data[data >= median]
    
    # Crear mallas para todos los pares (xi, xj)
    xi, xj = np.meshgrid(left, right, indexing='ij')
    
    # Calcular el núcleo h para pares donde xi != xj.
    denom = xj - xi
    h_values = np.zeros_like(xi, dtype=float)
    nonzero_mask = denom != 0
    h_values[nonzero_mask] = ((xj[nonzero_mask] - median) - (median - xi[nonzero_mask])) / denom[nonzero_mask]
    # Para los casos en que xi == xj, dejamos h = 0 (tal como se define).

    # Si hay múltiples valores iguales a la mediana, se aplica un tratamiento especial.
    k = np.sum(data == median)  # Conteo de repeticiones de la mediana.
    if k > 1:
        # Generar índices para las observaciones en left y right.
        # Utilizamos índices 1-basados para reproducir la lógica de (i+j-1).
        left_indices = np.arange(1, len(left) + 1)
        right_indices = np.arange(1, len(right) + 1)
        I, J = np.meshgrid(left_indices, right_indices, indexing='ij')
        
        # Identificar las posiciones donde ambos xi y xj son iguales a la mediana.
        special_mask = (xi == median) & (xj == median)
        
        # Calcular el valor especial de h siguiendo la lógica:
        # - Si (i+j-1) < k, devolver -1.
        # - Si (i+j-1) == k, devolver 0.
        # - Si (i+j-1) > k, devolver 1.
        sum_indices = I + J - 1
        h_special = np.where(sum_indices < k, -1, np.where(sum_indices == k, 0, 1))
        
        # Asignar en el resultado final solo para las posiciones especiales.
        h_values[special_mask] = h_special[special_mask]
    
    # Retornar la mediana de todos los valores h calculados.
    return np.median(h_values)

def adjusted_boxplot_bounds(data):
    """Calcula los límites del diagrama de caja ajustado teniendo en cuenta las cercas ajustadas por asimetría."""
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """Normalización utilizando boxplot ajustado."""
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print("Lower fence:", lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

# Generación de datos
np.random.seed(42)
data_normal = np.random.normal(loc=50, scale=10, size=10000)
data_skewed = np.random.exponential(scale=20, size=10000)
data_skewed = np.concatenate([data_skewed[5:], [200, 250, 300, -100, -50]])
data_with_outliers = np.concatenate([data_normal, [150, 160, 170]])

# Normalización (se trabaja solo con las columnas creadas para este ejemplo)
df = pd.DataFrame({
    "Normal": data_normal,
    "Skewed": data_skewed,
    # "Con_Outliers": data_with_outliers[3:],  # Comentado para este ejemplo
})

normalized_df = df.apply(normalize_column)

# Gráfica del histograma de los datos originales
plt.figure(figsize=(16, 4), dpi=250)
bins = np.linspace(-5, 200, 206)
bin_width = bins[1] - bins[0]  # Ancho de un bin

for col in df.columns:
    hist, _ = np.histogram(df[col], bins=bins)
    # Posiciones de las barras para cada histograma
    bin_centers = (bins[:-1] + bins[1:]) / 2
    # Desplazamiento para cada conjunto de datos
    offset = bin_width / 4
    plt.bar(bin_centers - offset, hist, width=bin_width, align='center', alpha=0.2, label=f'{col}')
    plt.legend()
    plt.title("Histogram Before Normalization")
plt.xlim(-10, 200)
plt.show()

# Gráfica del histograma de los datos normalizados
bins = np.linspace(-2, 2, 101)
bin_width = bins[1] - bins[0]  # Ancho de un bin

plt.figure(figsize=(16, 4), dpi=250)
for col in normalized_df.columns:
    hist, _ = np.histogram(normalized_df[col], bins=bins)
    # Posiciones de las barras para cada histograma
    bin_centers = (bins[:-1] + bins[1:]) / 2
    # Desplazamiento para cada conjunto de datos
    offset = bin_width / 2
    plt.bar(bin_centers - offset, hist, width=bin_width, align='center', label=f'{col}', alpha=0.2)
    plt.legend()
    plt.title("Histogram After Normalization")
plt.show()