import numpy as np

def fit_line(x, y, deviation_factor=1.2):
    """
    Ajusta una línea recta a un conjunto de datos y aumenta el valor de la desviación máxima.

    Parámetros:
      x               : Array de valores independientes.
      y               : Array de valores dependientes.
      deviation_factor: Factor por el que se incrementa la desviación máxima (por defecto 1.2).

    Retorna:
      slope        : La pendiente de la línea.
      intercept    : La intersección de la línea.
      max_deviation: Máxima desviación (error absoluto máximo aumentado por el factor).
    """
    # Calcular el valor medio de x e y
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # Calcular la desviación de x e y respecto a sus medias
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # Calcular los productos y cuadrados de las desviaciones
    xy_dev = x_dev * y_dev
    x_dev_squared = x_dev ** 2
    
    # Calcular la pendiente (slope) y la intersección (intercept)
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean

    # Calcular la desviación absoluta de cada punto respecto a la línea ajustada
    y_fit = slope * x + intercept
    deviations = np.abs(y - y_fit)
    max_deviation = np.max(deviations) * deviation_factor  # Incrementar la desviación máxima
    
    return slope, intercept, max_deviation

def fit_quadratic(x, y, deviation_factor=1.2):
    """
    Ajusta una curva cuadrática a un conjunto de datos y aumenta el valor de la desviación máxima.

    Parámetros:
      x               : Array de valores independientes.
      y               : Array de valores dependientes.
      deviation_factor: Factor por el que se incrementa la desviación máxima (por defecto 1.2).

    Retorna:
      coeffs       : Coeficientes [a, b, c] de la curva cuadrática (a * x² + b * x + c).
      max_deviation: Máxima desviación (error absoluto máximo aumentado por el factor).
    """
    # Crear una matriz de Vandermonde para el ajuste de la curva cuadrática
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # Utilizar el método de mínimos cuadrados para obtener los coeficientes
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    # Calcular los valores ajustados usando la curva cuadrática
    y_fit = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    deviations = np.abs(y - y_fit)
    max_deviation = np.max(deviations) * deviation_factor  # Incrementar la desviación máxima
    
    return coeffs, max_deviation