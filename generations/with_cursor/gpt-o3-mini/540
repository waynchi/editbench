    # Mostrar el grafo
    print("Graph adjacency list:")
    print(graph)

    # Realizar DFS comenzando desde el vértice 'A'
    print("\nDFS starting from vertex 'A':")
    graph.dfs('A')

    # Realizar BFS comenzando desde el vértice 'A'
    print("\n\nBFS starting from vertex 'A':")
