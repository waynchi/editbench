# New function to build hierarchical dictionary of posts and replies
def build_replies_hierarchy(replies: list) -> list:
    """
    Recursively builds a hierarchy of replies.
    Each reply is represented as a dict with its details and nested replies.
    """
    hierarchy = []
    for reply in replies:
        reply_dict = {
            "author": reply.get('author'),
            "permlink": reply.get('permlink'),
            "body": reply.get('body'),
            "replies": []
        }
        # Check if the reply has nested replies (children > 0)
        if reply.get('children', 0) > 0:
            try:
                comment_obj = Comment(authorperm=f"{reply.get('author')}/{reply.get('permlink')}")
                nested_replies = comment_obj.get_replies()
                reply_dict["replies"] = build_replies_hierarchy(nested_replies)
            except Exception as e:
                # If there is an error fetching nested replies, leave it empty
                reply_dict["replies"] = []
        hierarchy.append(reply_dict)
    return hierarchy

def build_hierarchical_dict(posts_generator) -> dict:
    """
    Builds a hierarchical dictionary from the posts generator.
    The dictionary maps each post (by a unique key) to its details and a hierarchy of replies.
    """
    hierarchical_dict = {}
    post_counter = 0
    for post in posts_generator:
        post_counter += 1
        post_author = post['author']
        post_permlink = post['permlink']
        post_children_count = post.get('children', 0)
        # Create a key for the post using a combination of author and permlink
        post_key = f"{post_author}/{post_permlink}"
        
        # Get hierarchical replies if the post has enough children
        replies_hierarchy = []
        if post_children_count > n_respuestas_minimas:
            try:
                comment_obj = Comment(authorperm=post_key)
                replies = comment_obj.get_replies()
                replies_hierarchy = build_replies_hierarchy(replies)
            except Exception as e:
                replies_hierarchy = []
        
        hierarchical_dict[post_key] = {
            "post_number": post_counter,
            "author": post_author,
            "permlink": post_permlink,
            "body": post.get('body', ''),
            "replies": replies_hierarchy
        }
    return hierarchical_dict

