def find_four_nonzero_square_sums(limit):
    """
    Возвращает отсортированный список чисел, которые можно представить
    в виде суммы четырех ненулевых квадратов (т.е. квадратов чисел 1, 2, 3, ...),
    не превышающих заданный верхний предел.
    """
    results = set()
    # Определяем максимальное число, квадрат которого не превышает limit.
    # Заметим, что в сумме участвуют 4 квадрата, поэтому для перебора берем максимум, который гарантированно может участвовать.
    max_candidate = int(limit ** 0.5)
    
    # Проходим по всем комбинациям четырех чисел от 1 до max_candidate
    for i in range(1, max_candidate + 1):
        i2 = i * i
        # Если даже минимальная сумма с тремя единицами превысит limit, можно прервать дальнейший перебор на уровне i.
        if i2 + 1 + 1 + 1 > limit:
            break
        for j in range(1, max_candidate + 1):
            j2 = j * j
            if i2 + j2 + 1 + 1 > limit:
                break
            for k in range(1, max_candidate + 1):
                k2 = k * k
                if i2 + j2 + k2 + 1 > limit:
                    break
                for l in range(1, max_candidate + 1):
                    l2 = l * l
                    total = i2 + j2 + k2 + l2
                    if total > limit:
                        break
                    results.add(total)
    return sorted(results)

def main():
    try:
        limit_input = input("Введите верхнюю границу (целое число): ")
        limit = int(limit_input)
    except ValueError:
        print("Некорректный ввод. Пожалуйста, введите целое число.")
        return

    numbers = find_four_nonzero_square_sums(limit)
    print("Числа, которые могут быть выражены как сумма четырех ненулевых квадратов:")
    if numbers:
        # Выводим числа, разделенные запятыми
        print(", ".join(map(str, numbers)))
    else:
        print("Нет чисел, удовлетворяющих условию в заданном диапазоне.")

if __name__ == "__main__":
    main()