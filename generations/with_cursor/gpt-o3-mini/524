import aiohttp
import aiofiles
import asyncio
import xml.etree.ElementTree
import matplotlib.pyplot as plt
import pandas as pd
import datetime
import pickle
import json

def write_pickle(data, filepath):
    with open(filepath, "wb") as f:
        pickle.dump(data, f)

def read_pickle(filepath):
    with open(filepath, "rb") as f:
        return pickle.load(f)

class valute():
    """Moneda y todo lo relacionado con ella, a través del Banco Central de la Federación de Rusia

Se requieren bibliotecas:

aiohttp, aiofiles, asyncio,
xml.etree.ElementTree,
matplotlib.pyplot as plt,
pandas as pd,
datetime,
pickle,
json
    """
    def __init__(self, name):
        self.name = name

    async def correct_name(self):
        """Verificación del nombre de la moneda en el conjunto de monedas. El conjunto se actualiza no más de una vez al día"""
        info_filepath = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        set_valutes_filepath = r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin"
        
        # Leer el archivo Info.json de forma asíncrona
        async with aiofiles.open(info_filepath, mode="r", encoding="utf-8") as info_file:
            info_content = await info_file.read()
        info = json.loads(info_content)

        # Comprobar si se requiere actualizar la lista de monedas
        last_check_str = info["last_day_check"]["valute"]
        last_check_date = datetime.datetime.strptime(last_check_str, "%Y-%m-%d %H:%M:%S.%f")
        if datetime.datetime.now() - datetime.timedelta(days=1) > last_check_date:
            # Se requiere la actualización, consultar el API del Banco Central de Rusia
            url = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    content = await response.read()
            root = xml.etree.ElementTree.fromstring(content)
            set_valutes = set()
            for Valute in root.findall("Valute"):
                CharCode = Valute.find("CharCode")
                if CharCode is not None:
                    set_valutes.add(CharCode.text)
            # Escribir el conjunto de monedas usando pickle en un hilo separado
            await asyncio.to_thread(write_pickle, set_valutes, set_valutes_filepath)
            # Actualizar la fecha de la última verificación
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(info_filepath, mode="w", encoding="utf-8") as info_file_w:
                new_info = json.dumps(info, indent=3, ensure_ascii=False)
                await info_file_w.write(new_info)
        # Cargar el conjunto de monedas desde el archivo pickle
        set_valutes = await asyncio.to_thread(read_pickle, set_valutes_filepath)
        if self.name in set_valutes:
            return True
        else:
            return False

    async def CurrentExchangeRate(self):
        '''Tipo de cambio actual de la moneda al rublo'''
        url = "http://www.cbr.ru/scripts/XML_daily.asp"
        async with aiohttp.ClientSession() as session:
            async with session.get(url) as response:
                content = await response.read()
        root = xml.etree.ElementTree.fromstring(content)
        for Valute in root.findall("Valute"):
            for CharCode in Valute.findall("CharCode"):
                if CharCode.text == self.name:
                    vunit_rate_elem = Valute.find("VunitRate")
                    if vunit_rate_elem is not None:
                        return vunit_rate_elem.text
        return None