import pandas as pd

# Dummy model implementations so the code is runnable.
# In a real scenario, replace these with the actual knn and mlp objects.
class DummyKNN:
    def predict(self, X):
        # For demonstration, we'll return a dummy prediction.
        # In practice, this should call the actual model's predict method.
        return "KNN prediction"

class DummyMLP:
    def predict(self, X):
        # For demonstration, we'll return a dummy prediction.
        # In practice, this should call the actual model's predict method.
        return "MLP prediction"

# Instantiate the dummy models.
knn = DummyKNN()
mlp = DummyMLP()

# Iterate over parameters and build the DataFrame for prediction.
for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in ["S", "Q", "C"]:
            # Create the DataFrame with one row of data.
            my_df = pd.DataFrame({
                "Pclass": [pclass],
                "Name": [24],
                "Sex": [0],
                "Age": [19],
                "SibSp": [0],
                "Parch": [0],
                "Fare": [fare],
                "Embarked": [embarked]
            })
            
            # Apply one-hot encoding to the "Embarked" column.
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
            
            # Adjust the dummy coded columns to ensure they are in 0/1 format.
            # get_dummies normally produces 0/1 integers, so this mapping is precautionary.
            if "Embarked_S" in my_df.columns:
                my_df["Embarked_S"] = my_df["Embarked_S"].map({True: 1, False: 0})
            if "Embarked_C" in my_df.columns:
                my_df["Embarked_C"] = my_df["Embarked_C"].map({True: 1, False: 0})
            if "Embarked_Q" in my_df.columns:
                my_df["Embarked_Q"] = my_df["Embarked_Q"].map({True: 1, False: 0})
            
            print("-------------------------------------------------------")
            print(f"Параметры: класс {pclass}, плата {fare}, embarked {embarked}")
            print("По knn: ", knn.predict(my_df))
            print("По mlp: ", mlp.predict(my_df))