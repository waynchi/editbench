import requests


def registerKey(key: str, user: str):
    print(f'chave: {key}\nnome: {user}')
    try:
        # Se envia una solicitud POST en lugar de GET
        response = requests.post(
            'http://127.0.0.1:5000/register',
            json={'key': key, 'user': user}
        )

        # Se asume que el servidor devuelve un JSON con la clave "valid"
        if response.status_code == 200:
            data = response.json()
            if data.get('valid'):
                return True

        return False

    except requests.RequestException as e:
        print(f"Erro de conexão: {e}")
        return False