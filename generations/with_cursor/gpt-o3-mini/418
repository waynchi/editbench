import tkinter as tk
import random

def get_random_color():
    colors = ["red", "green", "blue", "yellow", "purple", "orange", "magenta", "cyan"]
    return random.choice(colors)

class Square:
    def __init__(self, canvas, size, x, y):
        self.canvas = canvas
        self.size = size
        self.x = x
        self.y = y
        self.dx = random.choice([-2, 2])
        self.dy = random.choice([-2, 2])
        self.color = get_random_color()
        self.square = canvas.create_rectangle(x, y, x + size, y + size, fill=self.color)

    def move(self):
        self.x += self.dx
        self.y += self.dy
        self.canvas.move(self.square, self.dx, self.dy)
        
        # Sprawdź granice
        canvas_width = self.canvas.winfo_width()
        canvas_height = self.canvas.winfo_height()
        
        if (self.x <= 0 or self.x + self.size >= canvas_width or 
            self.y <= 0 or self.y + self.size >= canvas_height):
            # Usuń bieżący kwadrat
            self.canvas.delete(self.square)
            # Utwórz dwa nowe kwadraty, jeśli rozmiar jest wystarczająco duży
            if self.size > 10:
                new_size = self.size / 2
                # Pozycjonujemy nowe kwadraty w centrum, aby były widoczne
                squares.append(Square(self.canvas, new_size, 
                                   canvas_width/2 - new_size*1.5, 
                                   canvas_height/2 - new_size*1.5))
                squares.append(Square(self.canvas, new_size, 
                                   canvas_width/2 + new_size*0.5, 
                                   canvas_height/2 + new_size*0.5))
            return False
        return True

def update():
    global squares
    # Przesuń wszystkie kwadraty i usuń te, które uderzają w granice
    squares = [square for square in squares if square.move()]
    root.after(20, update)  # Aktualizuj co 20 ms

# Utwórz główne okno
root = tk.Tk()
root.title("Kolorowe Poruszające się Kwadraty")

# Utwórz płótno
canvas = tk.Canvas(root, width=600, height=600, bg="white")
canvas.pack(expand=True, fill="both")

# Utwórz początkowy kwadrat
squares = [Square(canvas, 100, 250, 250)]

# Rozpocznij animację
update()

# Uruchom główną pętlę
root.mainloop()