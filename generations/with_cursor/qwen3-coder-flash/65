# 定义一个求数组拟合直线的函数def fit_line(x, y):
import numpy as np

def fit_line(x, y):
    """
    求数组拟合直线的函数
    """
    # 计算x和y的平均值
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # 计算x和y的偏差
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # 计算x和y的偏差的乘积
    xy_dev = x_dev * y_dev
    
    # 计算x的偏差的平方
    x_dev_squared = x_dev ** 2
    
    # 计算直线的斜率和截距
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean
    
    return slope, intercept

# 定义一个求xy数组二次曲线拟合的函数
def fit_quadratic(x, y):
    """
    求数组二次曲线拟合的函数
    """
    # 创建一个Vandermonde矩阵
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # 使用最小二乘法求解系数
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    return coeffs

# 定义一个求最大偏差值的函数
def max_deviation(x, y, func_type='linear', **kwargs):
    """
    求最大偏差值的函数
    :param x: x坐标数组
    :param y: y坐标数组
    :param func_type: 拟合函数类型 ('linear' 或 'quadratic')
    :param kwargs: 其他参数
    :return: 最大偏差值
    """
    if func_type == 'linear':
        slope, intercept = fit_line(x, y)
        # 计算拟合直线上的点
        y_fit = slope * x + intercept
    elif func_type == 'quadratic':
        coeffs = fit_quadratic(x, y)
        # 计算拟合二次曲线上的点
        y_fit = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    else:
        raise ValueError("func_type must be 'linear' or 'quadratic'")
    
    # 计算实际值与拟合值之间的偏差
    deviations = np.abs(y - y_fit)
    
    # 返回最大偏差值
    return np.max(deviations)