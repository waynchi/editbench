from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_config, n_clusters=2, clustering_method='kmeans'):
    """
    Выполняет кластеризацию данных для различных наборов столбцов.

    Args:
        features_transformed (pandas.DataFrame): Преобразованный DataFrame с параметрами.
        cluster_config (dict): Словарь с конфигурацией кластеризации.
                              Формат: {название_столбца_для_меток: (столбцы_для_кластеризации)}
        n_clusters (int): Количество кластеров.
        clustering_method (str): Метод кластеризации ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame с добавленными столбцами меток кластеров.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()

    for cluster_column, columns in cluster_config.items():
        # Проверяем, что указанные столбцы существуют
        missing_columns = [col for col in columns if col not in features_for_clustering.columns]
        if missing_columns:
            print(f"Ошибка: Не найдены столбцы {missing_columns} для кластеризации по {cluster_column}")
            continue
            
        # Выбираем только нужные столбцы для кластеризации
        data_for_clustering = features_for_clustering[columns]
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(data_for_clustering)
            
            # Оценка качества кластеризации (например, с помощью коэффициента силуэта)
            if len(np.unique(cluster_labels)) > 1: # Проверка на случай, когда все точки отнесены к одному кластеру
                silhouette_avg = silhouette_score(data_for_clustering, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров ({cluster_column}): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера ({cluster_column}) (все точки в одном кластере).")

        else:
            print(f"Неподдерживаемый метод кластеризации для {cluster_column}.")
            continue

        # Добавляем метки кластеров в исходный DataFrame
        features_for_clustering[cluster_column] = cluster_labels
        print(f"Кластеризация выполнена для {cluster_column}. Метки кластеров добавлены.")

    return features_for_clustering

# Выполнение кластеризации (после этапа 5 и до этапа 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Пример конфигурации кластеризации: 
    # {имя_нового_столбца: (столбцы_для_кластеризации)}
    cluster_config = {
        'cluster1': ['feature1', 'feature2'],  # Кластеризация для первых двух признаков
        'cluster2': ['feature3']              # Кластеризация для третьего признака
    }
    
    n_clusters = 3  # Количество кластеров (подберите оптимальное значение)
    features_transformed = cluster_data(features_transformed, cluster_config, n_clusters)
    
    # Визуализация кластеров для первого набора признаков
    if 'cluster1' in features_transformed.columns:
        numerical_features = features_transformed.select_dtypes(include=np.number)
        if numerical_features.shape[1] >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], 
                       c=features_transformed['cluster1'], cmap='viridis')
            plt.xlabel(numerical_features.columns[0])
            plt.ylabel(numerical_features.columns[1])
            plt.title('Результаты кластеризации (cluster1)')
            plt.colorbar(label='Номер кластера')
            plt.show()
        else:
            print("Недостаточно числовых признаков для визуализации кластеров на плоскости.")
    else:
        print("Столбец 'cluster1' не найден. Возможно, кластеризация не была выполнена.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")