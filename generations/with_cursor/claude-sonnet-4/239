# создать модуль полусумматора на Verilog с помощью Python

# код на verilog
verilog_code = """
module half_adder(a, b, c_in, enable, reset, c, sum, carry);
    input a, b, c_in, enable, reset;
    output c, sum, carry;
    assign c = enable ? (reset ? 1'b0 : (a ^ b ^ c_in)) : 1'b0;
    assign sum = enable ? (reset ? 1'b0 : (a & b)) : 1'b0;
    assign carry = enable ? (reset ? 1'b0 : ((a & b) | (c_in & (a ^ b)))) : 1'b0;
endmodule
"""

# имя модуля verilog
module_name = "half_adder"

# входные и выходные порты модуля verilog
input_ports = ["a", "b", "c_in", "enable", "reset"]
output_ports = ["c", "sum", "carry"]

# параметры модуля verilog
parameters = ["WIDTH"]

# значение параметров модуля verilog
parameter_values = ["8"]

# тело модуля verilog
module_body = """
    input a, b, c_in, enable, reset;
    output c, sum, carry;
    assign c = enable ? (reset ? 1'b0 : (a ^ b ^ c_in)) : 1'b0;
    assign sum = enable ? (reset ? 1'b0 : (a & b)) : 1'b0;
    assign carry = enable ? (reset ? 1'b0 : ((a & b) | (c_in & (a ^ b)))) : 1'b0;
endmodule
"""

# инстанцирование модуля verilog
module_instantiation = """
half_adder half_adder_inst(
    .a(a),
    .b(b),
    .c_in(c_in),
    .enable(enable),
    .reset(reset),
    .c(c),
    .sum(sum),
    .carry(carry)
);
"""