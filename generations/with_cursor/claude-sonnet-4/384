def init_database():
    """Initialize the settings database if it doesn't exist."""
    try:
        with sqlite3.connect(SETTINGS_DB) as conn:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS settings (
                    key TEXT PRIMARY KEY,
                    value TEXT NOT NULL
                )
            """)
            conn.commit()
        logger.debug("Database initialized successfully")
    except Exception as e:
        logger.error(f"Failed to initialize database: {e}")
        logger.debug(f"Database error traceback: {traceback.format_exc()}")
        raise

class SettingsManager:
    _instance = None
    _lock = threading.Lock()

    def __new__(cls):
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super().__new__(cls)
                    cls._instance._setup_pool()
        return cls._instance

    def _setup_pool(self):
        try:
            self._pool = sqlite3.connect(
                SETTINGS_DB,
                check_same_thread=False,
                timeout=30.0
            )
            with self._lock:
                self._pool.row_factory = sqlite3.Row
            
            # Inicjalizuj pamięć podręczną
            self._cache = {}
            logger.debug("Settings manager pool setup completed")
        except Exception as e:
            logger.error(f"Failed to setup settings pool: {e}")
            logger.debug(f"Pool setup error traceback: {traceback.format_exc()}")
            raise

    def get_cached(self, key: str) -> Any:
        try:
            with self._lock:
                if key in self._cache:
                    value, expires_at = self._cache[key]
                    if expires_at > time.time():
                        logger.debug(f"Cache hit for key: {key}")
                        return value
                    del self._cache[key]
                    logger.debug(f"Cache expired for key: {key}")
            return None
        except Exception as e:
            logger.error(f"Error getting cached value for {key}: {e}")
            logger.debug(f"Cache get error traceback: {traceback.format_exc()}")
            return None

    def set_cached(self, key: str, value: Any, ttl: int = 300):
        try:
            with self._lock:
                self._cache[key] = (value, time.time() + ttl)
            logger.debug(f"Cached value set for key: {key} with TTL: {ttl}")
        except Exception as e:
            logger.error(f"Error setting cached value for {key}: {e}")
            logger.debug(f"Cache set error traceback: {traceback.format_exc()}")

    def save_setting(self, key: str, value: Any):
        try:
            with self._lock:
                with self._pool:
                    self._pool.execute(
                        "INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)",
                        (key, json.dumps(value))
                    )
            logger.debug(f"Setting saved: {key} = {value}")
        except Exception as e:
            logger.error(f"Error saving setting {key}: {e}")
            logger.debug(f"Save setting error traceback: {traceback.format_exc()}")

    def load_setting(self, key: str, default: Any = None) -> Any:
        try:
            with self._lock:
                cursor = self._pool.execute(
                    "SELECT value FROM settings WHERE key = ?",
                    (key,)
                )
                result = cursor.fetchone()
                loaded_value = json.loads(result[0]) if result else default
                logger.debug(f"Setting loaded: {key} = {loaded_value}")
                return loaded_value
        except Exception as e:
            logger.error(f"Error loading setting {key}: {e}")
            logger.debug(f"Load setting error traceback: {traceback.format_exc()}")
            return default

    def close(self):
        try:
            with self._lock:
                if hasattr(self, '_pool'):
                    self._pool.close()
            logger.debug("Settings manager closed successfully")
        except Exception as e:
            logger.error(f"Error closing settings manager: {e}")
            logger.debug(f"Close error traceback: {traceback.format_exc()}")

class SecurityManager:
    def __init__(self):
        self.rate_limits = {}
        self.max_requests = 100
        self.time_window = 3600
        self._lock = threading.Lock()
        logger.debug("SecurityManager initialized")

    def check_rate_limit(self, key: str) -> bool:
        try:
            now = time.time()
            with self._lock:
                if key not in self.rate_limits:
                    self.rate_limits[key] = []
                self.rate_limits[key] = [t for t in self.rate_limits[key] if t > now - self.time_window]
                current_requests = len(self.rate_limits[key])
                
                if current_requests >= self.max_requests:
                    logger.warning(f"Rate limit exceeded for {key}: {current_requests}/{self.max_requests}")
                    return False
                    
                self.rate_limits[key].append(now)
                logger.debug(f"Rate limit check passed for {key}: {current_requests + 1}/{self.max_requests}")
            return True
        except Exception as e:
            logger.error(f"Error checking rate limit for {key}: {e}")
            logger.debug(f"Rate limit error traceback: {traceback.format_exc()}")
            return False

def rate_limited(func: Callable[..., Awaitable]):
    @wraps(func)
    async def wrapper(*args, **kwargs):
        try:
            if not SecurityManager().check_rate_limit(func.__name__):
                error_msg = f"Rate limit exceeded for {func.__name__}"
                logger.warning(error_msg)
                raise Exception(error_msg)
            logger.debug(f"Executing rate-limited function: {func.__name__}")
            return await func(*args, **kwargs)
        except Exception as e:
            logger.error(f"Error in rate-limited function {func.__name__}: {e}")
            logger.debug(f"Rate limited function error traceback: {traceback.format_exc()}")
            raise
    return wrapper

@asynccontextmanager
async def browser_session(config: "AgentConfig"):
    runner = None
    try:
        logger.debug("Creating browser session")
        runner = BrowserAgentRunner(config)
        logger.debug("Browser session created successfully")
        yield runner
    except Exception as e:
        logger.error(f"Error in browser session: {e}")
        logger.debug(f"Browser session error traceback: {traceback.format_exc()}")
        raise
    finally:
        if runner:
            try:
                await runner.cleanup()
                logger.debug("Browser session cleanup completed")
            except Exception as e:
                logger.error(f"Error during browser session cleanup: {e}")
                logger.debug(f"Browser session cleanup error traceback: {traceback.format_exc()}")

class BrowserAgentRunner:
    def __init__(self, config: "AgentConfig"):
        try:
            self.config = config
            self.playwright = None
            self.browser_context = None
            self.browser = None
            self.resource_manager = ResourceManager()
            self.security_manager = SecurityManager()
            self._start_time = time.time()
            logger.debug(f"BrowserAgentRunner initialized with config: {config}")
        except Exception as e:
            logger.error(f"Error initializing BrowserAgentRunner: {e}")
            logger.debug(f"BrowserAgentRunner init error traceback: {traceback.format_exc()}")
            raise

    @property
    def execution_time(self) -> float:
        return time.time() - self._start_time

    async def run(self):
        try:
            logger.info("Starting browser agent run")
            logger.debug(f"Config details: headless={self.config.headless}, window={self.config.window_w}x{self.config.window_h}")
            
            async with async_playwright() as p:
                logger.debug("Playwright context created")
                
                self.browser = await p.chromium.launch(headless=self.config.headless)
                logger.debug(f"Browser launched (headless={self.config.headless})")
                
                self.browser_context = await self.browser.new_context(
                    viewport={'width': self.config.window_w, 'height': self.config.window_h}
                )
                logger.debug(f"Browser context created with viewport {self.config.window_w}x{self.config.window_h}")
                
                page = await self.browser_context.new_page()
                logger.debug("New page created")
    
                # Przykładowe zadanie: Przejdź do podanego URL
                logger.info("Navigating to example.com")
                await page.goto("https://example.com")
                logger.debug("Navigation completed")
                
                # Wykonaj więcej działań tutaj w oparciu o zadanie
                page_title = await page.title()
                logger.debug(f"Page title: {page_title}")
                
                result = f"Task completed successfully. Page title: {page_title}"
                logger.info(f"Task completed: {result}")
                return result, "", "", ""
                
        except Exception as e:
            error_msg = f"Detailed error during run: {e}"
            logger.error(error_msg)
            logger.debug(f"Run error traceback: {traceback.format_exc()}")
            return "", error_msg, "", ""
        finally:
            try:
                await self.cleanup()
            except Exception as cleanup_error:
                logger.error(f"Error during final cleanup: {cleanup_error}")
                logger.debug(f"Final cleanup error traceback: {traceback.format_exc()}")

    async def cleanup(self):
        logger.debug("Starting browser session cleanup")
        cleanup_errors = []
        
        try:
            if self.browser_context:
                await self.browser_context.close()
                logger.debug("Browser context closed successfully")
                self.browser_context = None
        except Exception as e:
            error_msg = f"Error closing browser context: {e}"
            logger.error(error_msg)
            logger.debug(f"Browser context cleanup error traceback: {traceback.format_exc()}")
            cleanup_errors.append(error_msg)

        try:
            if self.browser:
                await self.browser.close()
                logger.debug("Browser closed successfully")
                self.browser = None
        except Exception as e:
            error_msg = f"Error closing browser: {e}"
            logger.error(error_msg)
            logger.debug(f"Browser cleanup error traceback: {traceback.format_exc()}")
            cleanup_errors.append(error_msg)

        try:
            await self.resource_manager.cleanup()
            logger.debug("Resource manager cleanup completed")
        except Exception as e:
            error_msg = f"Error during resource manager cleanup: {e}"
            logger.error(error_msg)
            logger.debug(f"Resource manager cleanup error traceback: {traceback.format_exc()}")
            cleanup_errors.append(error_msg)
            
        if cleanup_errors:
            logger.warning(f"Cleanup completed with {len(cleanup_errors)} errors")
        else:
            logger.debug("Cleanup completed successfully")

class ProcessManager:
    def __init__(self):
        self.processes = []
        self._lock = threading.Lock()
        logger.debug("ProcessManager initialized")

    async def start_task(self, task):
        try:
            with self._lock:
                logger.debug(f"Starting task: {task}")
                # Logika uruchamiania zadania
                pass
        except Exception as e:
            logger.error(f"Error starting task: {e}")
            logger.debug(f"Start task error traceback: {traceback.format_exc()}")

    async def stop_task(self):
        try:
            with self._lock:
                logger.debug("Stopping tasks")
                # Logika zatrzymywania zadań
                return "", ""
        except Exception as e:
            logger.error(f"Error stopping task: {e}")
            logger.debug(f"Stop task error traceback: {traceback.format_exc()}")
            return "", str(e)

    def cleanup(self):
        try:
            with self._lock:
                logger.debug("ProcessManager cleanup")
                # Logika czyszczenia po zadaniach
                pass
        except Exception as e:
            logger.error(f"Error during ProcessManager cleanup: {e}")
            logger.debug(f"ProcessManager cleanup error traceback: {traceback.format_exc()}")

