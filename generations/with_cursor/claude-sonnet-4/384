        try:
            self.theme = gr.themes.Soft()
            self.settings_manager = SettingsManager()
            self.process_manager = ProcessManager()
            self.security_manager = SecurityManager()
            logger.debug("GradioInterface initialized successfully")
        except Exception as e:
            logger.error(f"Error initializing GradioInterface: {e}")
            logger.debug(f"GradioInterface init error traceback: {traceback.format_exc()}")
            raise

    @rate_limited
    async def _run_with_manager(self, *args):
        try:
            logger.info("Starting _run_with_manager...")
            logger.debug(f"Arguments received: {len(args)} args")
            
            config = AgentConfig(*args)
            logger.debug(f"AgentConfig created: {config}")
            
            async with browser_session(config) as runner:
                logger.debug("Browser session established")
                final_result, errors, model_actions, model_thoughts = await runner.run()
                
                execution_time = runner.execution_time
                logger.info(f"Task completed in {execution_time:.2f} seconds")
                logger.debug(f"Returning values: result='{final_result}', errors='{errors}', actions='{model_actions}', thoughts='{model_thoughts}'")
                
                return final_result or "", errors or "", model_actions or "", model_thoughts or ""
                
        except Exception as e:
            error_msg = f"Error in _run_with_manager: {e}"
            logger.error(error_msg)
            logger.debug(f"_run_with_manager error traceback: {traceback.format_exc()}")
            return str(e), str(e), "", ""

    async def _stop_agent(self):
        try:
            logger.info("Stopping agent")
            result = await self.process_manager.stop_task()
            logger.debug("Agent stopped successfully")
            return result
        except Exception as e:
            error_msg = f"Error stopping agent: {e}"
            logger.error(error_msg)
            logger.debug(f"Stop agent error traceback: {traceback.format_exc()}")
            return str(e), str(e)

