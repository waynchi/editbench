class ResourceManager:
    def __init__(self):
        self.temp_files: List[Path] = []
        self.active_contexts: List[Union[None, Any]] = []
        self._lock = threading.Lock()
        logger.debug("ResourceManager initialized")

    async def cleanup(self) -> None:
        errors = []
        logger.debug("Starting ResourceManager cleanup")
        
        with self._lock:
            # Wyczyść konteksty
            for i, context in enumerate(self.active_contexts):
                if context:
                    try:
                        await context.close()
                        logger.debug(f"Context {i} closed successfully")
                    except Exception as e:
                        error_msg = f"Failed to close context {i}: {e}"
                        logger.error(error_msg)
                        logger.debug(f"Context {i} close error traceback: {traceback.format_exc()}")
                        errors.append(error_msg)

            # Usuń pliki tymczasowe
            for i, file in enumerate(self.temp_files):
                try:
                    if file.exists():
                        if file.is_file():
                            file.unlink(missing_ok=True)
                            logger.debug(f"Temp file {i} removed: {file}")
                        else:
                            shutil.rmtree(file, ignore_errors=True)
                            logger.debug(f"Temp directory {i} removed: {file}")
                except Exception as e:
                    error_msg = f"Failed to remove {file}: {e}"
                    logger.error(error_msg)
                    logger.debug(f"File removal error traceback: {traceback.format_exc()}")
                    errors.append(error_msg)

            # Wyczyść listy po sprzątaniu
            self.temp_files.clear()
            self.active_contexts.clear()
            
        if errors:
            error_summary = f"ResourceManager cleanup completed with {len(errors)} errors"
            logger.error(error_summary)
            logger.debug("Errors occurred during cleanup:\n" + "\n".join(errors))
            raise Exception("Errors occurred during cleanup:\n" + "\n".join(errors))
        else:
            logger.debug("ResourceManager cleanup completed successfully")

def setup_logging(log_path: Optional[str] = None) -> logging.Logger:
    try:
        logger = logging.getLogger("browser_agent")
        logger.setLevel(logging.DEBUG)  # Changed to DEBUG for more detailed logging

        if not logger.handlers:
            formatter = logging.Formatter(
                '%(asctime)s - %(name)s - %(levelname)s - %(funcName)s:%(lineno)d - %(message)s',
                datefmt='%Y-%m-%d %H:%M:%S'
            )

            console_handler = logging.StreamHandler()
            console_handler.setLevel(logging.INFO)
            console_handler.setFormatter(formatter)
            logger.addHandler(console_handler)

            if log_path:
                try:
                    file_handler = logging.FileHandler(log_path)
                    file_handler.setLevel(logging.DEBUG)
                    file_handler.setFormatter(formatter)
                    logger.addHandler(file_handler)
                    logger.debug(f"File logging enabled: {log_path}")
                except Exception as e:
                    logger.error(f"Failed to setup file logging: {e}")

        logger.debug("Logging setup completed")
        return logger
    except Exception as e:
        print(f"Critical error setting up logging: {e}")
        print(f"Traceback: {traceback.format_exc()}")
        raise

