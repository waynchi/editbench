def crear_diccionario_jerarquico(post, replies_list):
    """
    Crea un diccionario jerárquico para organizar posts y sus replies
    """
    post_key = f"{post['author']}/{post['permlink']}"
    
    diccionario_post = {
        'post_info': {
            'author': post['author'],
            'permlink': post['permlink'],
            'title': post.get('title', ''),
            'body': post.get('body', ''),
            'children_count': post['children']
        },
        'replies': {}
    }
    
    for reply in replies_list:
        reply_key = f"{reply['author']}/{reply['permlink']}"
        diccionario_post['replies'][reply_key] = {
            'author': reply['author'],
            'permlink': reply['permlink'],
            'body': reply['body'],
            'parent_author': reply.get('parent_author', ''),
            'parent_permlink': reply.get('parent_permlink', ''),
            'procesado': procesar(reply['body']),
            'es_autor_propio': is_own_author(reply['author']),
            'esta_baneado': is_banned(reply['author'])
        }
    
    return post_key, diccionario_post


