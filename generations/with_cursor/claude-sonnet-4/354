def search_words_by_length(length):
    """
    Searches for words with specified length and returns up to 10 random words.
    
    Args:
        length (int): Number of characters in the word
        
    Returns:
        list: List of words with the specified length (max 10 words)
    """
    if length in ENGLISH_WORDS:
        words = ENGLISH_WORDS[length]
        if len(words) <= 10:
            return words
        else:
            return random.sample(words, 10)
    else:
        return []

def main():
    """
    Main program function that handles user interaction.
    """
    print("=== ENGLISH DICTIONARY WORD SEARCH ===")
    print("This program searches for English words with a specific number of characters.")
    print("You can request words with N characters and get up to 10 results.")
    print("Type 'quit' to exit the program.\n")
    
    while True:
        try:
            user_input = input("Enter the number of characters (or 'quit' to exit): ").strip()
            
            if user_input.lower() == 'quit':
                print("Thank you for using the dictionary search program!")
                break
            
            length = int(user_input)
            
            if length <= 0:
                print("Please enter a positive number.\n")
                continue
            
            words = search_words_by_length(length)
            
            if words:
                print(f"\nFound {len(words)} word(s) with {length} character(s):")
                for i, word in enumerate(words, 1):
                    print(f"{i:2d}. {word}")
                print()
            else:
                print(f"Sorry, no words found with {length} character(s) in the dictionary.\n")
                
        except ValueError:
            print("Invalid input. Please enter a valid number or 'quit' to exit.\n")
        except KeyboardInterrupt:
            print("\n\nProgram interrupted. Goodbye!")
            break

if __name__ == "__main__":
    main()