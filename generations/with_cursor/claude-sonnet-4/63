from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_configs, n_clusters=2, clustering_method='kmeans'):
    """
    Выполняет кластеризацию данных для указанных наборов столбцов.

    Args:
        features_transformed (pandas.DataFrame): Преобразованный DataFrame с параметрами.
        cluster_configs (dict): Словарь вида {имя_кластера: (столбец1, столбец2, ...)}
        n_clusters (int or dict): Количество кластеров. Может быть числом (для всех) или словарем {имя_кластера: количество}
        clustering_method (str): Метод кластеризации ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame с добавленными столбцами меток кластеров.
    """
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()
    
    # Если n_clusters - число, создаем словарь для всех кластеров
    if isinstance(n_clusters, int):
        n_clusters_dict = {cluster_name: n_clusters for cluster_name in cluster_configs.keys()}
    else:
        n_clusters_dict = n_clusters

    for cluster_name, columns in cluster_configs.items():
        print(f"\nВыполняется кластеризация '{cluster_name}' для столбцов: {columns}")
        
        # Проверяем, что все столбцы существуют
        missing_columns = [col for col in columns if col not in features_for_clustering.columns]
        if missing_columns:
            print(f"Ошибка: столбцы {missing_columns} не найдены в данных. Пропускаем кластер '{cluster_name}'.")
            continue
        
        # Выбираем данные для кластеризации
        cluster_data_subset = features_for_clustering[list(columns)]
        
        # Проверяем на наличие NaN значений
        if cluster_data_subset.isnull().any().any():
            print(f"Предупреждение: найдены NaN значения в данных для '{cluster_name}'. Пропускаем строки с NaN.")
            cluster_data_subset = cluster_data_subset.dropna()
            if cluster_data_subset.empty:
                print(f"Ошибка: после удаления NaN не осталось данных для '{cluster_name}'.")
                continue
        
        n_clusters_current = n_clusters_dict.get(cluster_name, 2)
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters_current, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(cluster_data_subset)
            
            # Создаем полный массив меток (с NaN для пропущенных строк)
            full_labels = np.full(len(features_for_clustering), np.nan)
            full_labels[cluster_data_subset.index] = cluster_labels
            
            # Оценка качества кластеризации
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(cluster_data_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters_current} кластеров в '{cluster_name}': {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для '{cluster_name}' (все точки в одном кластере).")
        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        features_for_clustering[cluster_name] = full_labels
        print(f"Кластеризация '{cluster_name}' выполнена. Метки добавлены в столбец '{cluster_name}'.")

    return features_for_clustering

def visualize_clusters(features_transformed, cluster_configs):
    """
    Визуализирует результаты кластеризации для каждого набора столбцов.
    
    Args:
        features_transformed (pandas.DataFrame): DataFrame с результатами кластеризации.
        cluster_configs (dict): Словарь конфигураций кластеров.
    """
    for cluster_name, columns in cluster_configs.items():
        if cluster_name not in features_transformed.columns:
            print(f"Кластер '{cluster_name}' не найден в данных.")
            continue
            
        # Фильтруем данные без NaN в метках кластеров
        valid_data = features_transformed.dropna(subset=[cluster_name])
        
        if len(columns) >= 2:
            plt.figure(figsize=(8, 6))
            scatter = plt.scatter(valid_data[columns[0]], valid_data[columns[1]], 
                                c=valid_data[cluster_name], cmap='viridis', alpha=0.7)
            plt.xlabel(columns[0])
            plt.ylabel(columns[1])
            plt.title(f'Результаты кластеризации: {cluster_name}')
            plt.colorbar(scatter, label='Номер кластера')
            plt.show()
        elif len(columns) == 1:
            plt.figure(figsize=(8, 6))
            plt.hist([valid_data[valid_data[cluster_name] == cluster][columns[0]] 
                     for cluster in valid_data[cluster_name].unique()], 
                    alpha=0.7, label=[f'Кластер {int(c)}' for c in valid_data[cluster_name].unique()])
            plt.xlabel(columns[0])
            plt.ylabel('Частота')
            plt.title(f'Распределение по кластерам: {cluster_name}')
            plt.legend()
            plt.show()
        else:
            print(f"Нет столбцов для визуализации кластера '{cluster_name}'.")

# Выполнение кластеризации (после этапа 5 и до этапа 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Пример конфигурации кластеров
    cluster_configs = {
        'cluster_main': ('feature1', 'feature2'),  # Замените на реальные имена столбцов
        'cluster_secondary': ('feature3',)         # Замените на реальные имена столбцов
    }
    
    # Можно задать разное количество кластеров для каждого набора
    n_clusters_config = {
        'cluster_main': 3,
        'cluster_secondary': 2
    }
    
    features_transformed = cluster_data(features_transformed, cluster_configs, n_clusters_config)
    
    # Визуализация результатов
    if features_transformed is not None:
        visualize_clusters(features_transformed, cluster_configs)
else:
    print("Сначала выполните этап 5 (Преобразование данных).")