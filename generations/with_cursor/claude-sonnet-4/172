from pyspark.sql import SparkSession
from pyspark.sql.functions import col
import requests
import json

# 创建一个Spark会话
spark = SparkSession.builder.appName("EscrituraParquetADL2").getOrCreate()

# 从API获取数据
def fetch_data_from_api(api_url, headers=None):
    """
    从API获取数据
    """
    try:
        response = requests.get(api_url, headers=headers)
        response.raise_for_status()  # 检查HTTP错误
        return response.json()
    except requests.exceptions.RequestException as e:
        print(f"API请求错误: {e}")
        return None

# 配置API参数
api_url = "<your_api_endpoint>"  # 替换为你的API端点
api_headers = {
    "Authorization": "Bearer <your_token>",  # 如果需要认证
    "Content-Type": "application/json"
}

# 获取API数据
print("正在从API获取数据...")
api_data = fetch_data_from_api(api_url, api_headers)

if api_data is None:
    print("无法获取API数据，使用示例数据进行测试")
    # 示例数据作为备用
    data = [
        {"id": 1, "nombre": "Juan", "edad": 30},
        {"id": 2, "nombre": "Ana", "edad": 25},
        {"id": 3, "nombre": "Pedro", "edad": 40}
    ]
else:
    print("API数据获取成功，开始分析数据结构...")
    
    # 分析API数据结构
    print(f"数据类型: {type(api_data)}")
    
    if isinstance(api_data, dict):
        print("API返回字典格式数据")
        print(f"字典键: {list(api_data.keys())}")
        
        # 如果数据在某个键下（常见情况）
        if 'data' in api_data:
            data = api_data['data']
        elif 'results' in api_data:
            data = api_data['results']
        elif 'items' in api_data:
            data = api_data['items']
        else:
            # 如果整个字典就是数据
            data = [api_data]
            
    elif isinstance(api_data, list):
        print("API返回列表格式数据")
        data = api_data
    else:
        print(f"未知数据格式: {type(api_data)}")
        data = []
    
    # 分析数据样本
    if data and len(data) > 0:
        print(f"数据记录数: {len(data)}")
        print("第一条记录样本:")
        print(json.dumps(data[0], indent=2, ensure_ascii=False))
        
        # 分析字段结构
        if isinstance(data[0], dict):
            print(f"字段列表: {list(data[0].keys())}")
            print("字段类型分析:")
            for key, value in data[0].items():
                print(f"  {key}: {type(value).__name__} - 示例值: {value}")

# 从数据创建一个DataFrame
if data:
    df = spark.createDataFrame(data)
    
    print("\nDataFrame结构分析:")
    df.printSchema()
    
    print(f"\nDataFrame行数: {df.count()}")
    print("前5行数据预览:")
    df.show(5, truncate=False)
    
    print("\n数据统计信息:")
    df.describe().show()

    # 配置与ADL2的连接使用Microsoft ID身份
    # 在Synapse的笔记本中不需要显式提供凭据
    # Spark将使用notebook的托管身份进行身份验证。

    # 指定ADL2中容器和文件夹的路径
    container_name = "<your_container_name>"  # 用你的容器名称替换
    folder_path = "<your_folder_path>"  # 替换为容器内文件夹的路径
    adl2_path = f"abfss://{container_name}@{<your_storage_account_name>}.dfs.core.windows.net/{folder_path}"

    # 将DataFrame以parquet格式写入ADL2
    print(f"\n正在将数据写入ADL2: {adl2_path}")
    df.write.parquet(adl2_path, mode="overwrite")
    print("数据写入完成")

    # 可选：读取parquet文件进行验证
    print("\n验证写入的数据:")
    df_leido = spark.read.parquet(adl2_path)
    df_leido.show()
else:
    print("没有可用的数据进行处理")

# 停止 Spark 会话
spark.stop()