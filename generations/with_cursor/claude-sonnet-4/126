from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_configs, n_clusters=2, clustering_method='kmeans'):
    """Performs data clustering independently for specified column sets.

Args:
    features_transformed (pandas.DataFrame): Transformed DataFrame with parameters.
    cluster_configs (dict): Dictionary where keys are cluster column names and values are tuples of column names to cluster on.
                           Example: {'Cluster1': ('column1', 'column2'), 'Cluster2': ('column3',)}
    n_clusters (int): Number of clusters.
    clustering_method (str): Clustering method ('kmeans').

Returns:
    pandas.DataFrame: DataFrame with added columns of cluster labels."""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()
    
    for cluster_feature_name, columns_to_cluster in cluster_configs.items():
        # Validate that specified columns exist
        missing_columns = [col for col in columns_to_cluster if col not in features_for_clustering.columns]
        if missing_columns:
            print(f"Столбцы {missing_columns} не найдены в данных для кластера '{cluster_feature_name}'. Пропускаем.")
            continue
            
        # Extract data for current clustering task
        cluster_data_subset = features_for_clustering[list(columns_to_cluster)]
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(cluster_data_subset)
            
            # Evaluation of clustering quality (e.g., using the silhouette coefficient)
            if len(np.unique(cluster_labels)) > 1: # Check for the case when all points are assigned to one cluster
                silhouette_avg = silhouette_score(cluster_data_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров ({cluster_feature_name}): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера ({cluster_feature_name}) - все точки в одном кластере.")

        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        features_for_clustering[cluster_feature_name] = cluster_labels
        print(f"Кластеризация выполнена для столбцов {columns_to_cluster}. Метки кластеров добавлены в столбец '{cluster_feature_name}'.")
    
    return features_for_clustering

# Clustering execution (after step 5 and before step 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Define clustering configurations
    cluster_configs = {
        'cluster1': ('column1', 'column2'),  # Replace with actual column names
        'cluster2': ('column3',)             # Replace with actual column names
    }
    n_clusters = 3  # Number of clusters (select the optimal value)
    features_transformed = cluster_data(features_transformed, cluster_configs, n_clusters)
    
    # Visualization of clusters for each clustering configuration
    for cluster_feature_name, columns_to_cluster in cluster_configs.items():
        if cluster_feature_name in features_transformed.columns:
            cluster_data_subset = features_transformed[list(columns_to_cluster)]
            
            if len(columns_to_cluster) >= 2:
                plt.figure(figsize=(8, 6))
                plt.scatter(cluster_data_subset.iloc[:, 0], cluster_data_subset.iloc[:, 1], 
                           c=features_transformed[cluster_feature_name], cmap='viridis')
                plt.xlabel(columns_to_cluster[0])
                plt.ylabel(columns_to_cluster[1])
                plt.title(f'Результаты кластеризации - {cluster_feature_name}')
                plt.colorbar(label='Номер кластера')
                plt.show()
            elif len(columns_to_cluster) == 1:
                plt.figure(figsize=(8, 6))
                plt.hist([cluster_data_subset[cluster_data_subset.index[features_transformed[cluster_feature_name] == i]].iloc[:, 0] 
                         for i in range(n_clusters)], 
                        bins=20, alpha=0.7, label=[f'Кластер {i}' for i in range(n_clusters)])
                plt.xlabel(columns_to_cluster[0])
                plt.ylabel('Частота')
                plt.title(f'Результаты кластеризации - {cluster_feature_name}')
                plt.legend()
                plt.show()
            else:
                print(f"Нет столбцов для визуализации кластера '{cluster_feature_name}'.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")