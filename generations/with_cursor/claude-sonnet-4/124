import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self, input_height=32, input_width=32):  # Accept input dimensions
        super().__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.flatten = nn.Flatten()
        
        # Calculate flattened size automatically
        # After conv1: (H-3+1)/2 = (H-2)/2, (W-3+1)/2 = (W-2)/2
        # After conv2: ((H-2)/2-3+1)/2 = (H-8)/4, ((W-2)/2-3+1)/2 = (W-8)/4
        conv_output_height = (input_height - 8) // 4
        conv_output_width = (input_width - 8) // 4
        flattened_size = 64 * conv_output_height * conv_output_width
        
        self.fc1 = nn.Sequential(
            nn.Linear(flattened_size, 512),
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x