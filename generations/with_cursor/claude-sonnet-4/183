from main13 import knn, mlp
import pandas as pd

# Create a template DataFrame with all possible Embarked columns
template_columns = ["Pclass", "Name", "Sex", "Age", "SibSp", "Parch", "Fare", "Embarked_C", "Embarked_Q", "Embarked_S"]

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in ["S", "Q", "C"]:
            # Create base data
            data = {
                "Pclass": [pclass],
                "Name": [24],
                "Sex": [0],
                "Age": [19],
                "SibSp": [0],
                "Parch": [0],
                "Fare": [fare],
                "Embarked_C": [1 if embarked == "C" else 0],
                "Embarked_Q": [1 if embarked == "Q" else 0],
                "Embarked_S": [1 if embarked == "S" else 0]
            }
            
            my_df = pd.DataFrame(data)
            
            # Ensure all required columns are present in the correct order
            for col in template_columns:
                if col not in my_df.columns:
                    my_df[col] = 0
            
            my_df = my_df[template_columns]

            print(f"""-------------------------------------------------------
                  Параметры: класс {pclass}, плата {fare}, embarked {embarked}
                  По knn: {knn.predict(my_df)}
                  По mlp: {mlp.predict(my_df)}""")