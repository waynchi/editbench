from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt

def cluster_data(features_transformed, cluster_configs, n_clusters=2, clustering_method='kmeans'):
    """Realiza la agrupación de datos para conjuntos de columnas especificados.

Args:
    features_transformed (pandas.DataFrame): DataFrame transformado con parámetros.
    cluster_configs (dict): Diccionario donde las claves son nombres de columnas de clústeres 
                           y los valores son tuplas con nombres de columnas para agrupar.
                           Ejemplo: {'Cluster1': ('columna1', 'columna2'), 'Cluster2': ('columna3',)}
    n_clusters (int): Número de clústeres.
    clustering_method (str): Método de agrupación ('kmeans').

Returns:
    pandas.DataFrame: DataFrame con las columnas de etiquetas de clústeres añadidas."""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()
    
    # Iterar sobre cada configuración de clúster
    for cluster_feature_name, columns_to_cluster in cluster_configs.items():
        print(f"\nВыполняется кластеризация для столбцов: {columns_to_cluster}")
        print(f"Результаты будут сохранены в столбце: '{cluster_feature_name}'")
        
        # Verificar que las columnas existen en el DataFrame
        missing_columns = [col for col in columns_to_cluster if col not in features_for_clustering.columns]
        if missing_columns:
            print(f"Ошибка: столбцы {missing_columns} не найдены в данных. Пропускаем этот кластер.")
            continue
        
        # Seleccionar solo las columnas especificadas para este clúster
        cluster_data_subset = features_for_clustering[list(columns_to_cluster)]
        
        # Verificar que no hay valores NaN
        if cluster_data_subset.isnull().any().any():
            print(f"Предупреждение: найдены пропущенные значения в столбцах {columns_to_cluster}. Удаляем строки с пропусками.")
            cluster_data_subset = cluster_data_subset.dropna()
        
        if cluster_data_subset.empty:
            print(f"Ошибка: нет данных для кластеризации в столбцах {columns_to_cluster}")
            continue

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(cluster_data_subset)
            
            # Evaluación de la calidad de la agrupación
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(cluster_data_subset, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров ({cluster_feature_name}): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера ({cluster_feature_name}) - все точки в одном кластере.")

        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        # Asignar las etiquetas de clúster al DataFrame original
        # Si hubo eliminación de filas por NaN, necesitamos manejar los índices
        if len(cluster_labels) == len(features_for_clustering):
            features_for_clustering[cluster_feature_name] = cluster_labels
        else:
            # Crear una serie con NaN para todas las filas y luego asignar valores válidos
            cluster_series = np.full(len(features_for_clustering), np.nan)
            cluster_series[cluster_data_subset.index] = cluster_labels
            features_for_clustering[cluster_feature_name] = cluster_series
        
        print(f"Кластеризация выполнена для '{cluster_feature_name}'. Метки добавлены в столбец '{cluster_feature_name}'.")
        
        # Visualización para cada conjunto de clústeres
        if len(columns_to_cluster) >= 2:
            plt.figure(figsize=(8, 6))
            valid_indices = ~np.isnan(features_for_clustering[cluster_feature_name])
            plt.scatter(
                features_for_clustering.loc[valid_indices, columns_to_cluster[0]], 
                features_for_clustering.loc[valid_indices, columns_to_cluster[1]], 
                c=features_for_clustering.loc[valid_indices, cluster_feature_name], 
                cmap='viridis'
            )
            plt.xlabel(columns_to_cluster[0])
            plt.ylabel(columns_to_cluster[1])
            plt.title(f'Результаты кластеризации: {cluster_feature_name}')
            plt.colorbar(label='Номер кластера')
            plt.show()
        elif len(columns_to_cluster) == 1:
            plt.figure(figsize=(8, 6))
            valid_indices = ~np.isnan(features_for_clustering[cluster_feature_name])
            plt.hist([
                features_for_clustering.loc[
                    (valid_indices) & (features_for_clustering[cluster_feature_name] == i), 
                    columns_to_cluster[0]
                ] for i in range(n_clusters)
            ], alpha=0.7, label=[f'Кластер {i}' for i in range(n_clusters)])
            plt.xlabel(columns_to_cluster[0])
            plt.ylabel('Частота')
            plt.title(f'Распределение кластеров: {cluster_feature_name}')
            plt.legend()
            plt.show()

    return features_for_clustering

# Ejecución de la clusterización (después de la etapa 5 y antes de la etapa 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Configuración de clústeres: diccionario con nombres de columnas de clústeres y columnas a agrupar
    cluster_configs = {
        'Cluster1': ('columna1', 'columna2'),  # Clusterización usando columna1 y columna2
        'Cluster2': ('columna3',),             # Clusterización usando solo columna3
        # Agregar más configuraciones según sea necesario
    }
    
    n_clusters = 3  # Cantidad de clústeres (seleccione el valor óptimo)
    features_transformed = cluster_data(features_transformed, cluster_configs, n_clusters)
    
    if features_transformed is not None:
        print(f"\nКластеризация завершена. Добавлены столбцы: {list(cluster_configs.keys())}")
        print(f"Форма итогового DataFrame: {features_transformed.shape}")
    
else:
    print("Сначала выполните этап 5 (Преобразование данных).")