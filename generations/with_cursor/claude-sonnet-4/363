def utworz_hierarchiczny_slownik(post, replies_list):
    """
    Tworzy hierarchiczny słownik dla posta i jego odpowiedzi
    """
    post_key = f"{post['author']}/{post['permlink']}"
    
    hierarchiczny_slownik = {
        "post_info": {
            "author": post['author'],
            "permlink": post['permlink'],
            "title": post.get('title', ''),
            "body": post.get('body', ''),
            "children_count": post['children']
        },
        "replies": {}
    }
    
    for reply in replies_list:
        reply_key = f"{reply['author']}/{reply['permlink']}"
        hierarchiczny_slownik["replies"][reply_key] = {
            "author": reply['author'],
            "permlink": reply['permlink'],
            "body": reply['body'],
            "parent_author": reply.get('parent_author', ''),
            "parent_permlink": reply.get('parent_permlink', ''),
            "processed": procesar(reply['body']),
            "is_banned": is_banned(reply['author']),
            "is_own": is_own_author(reply['author'])
        }
    
    return post_key, hierarchiczny_slownik

