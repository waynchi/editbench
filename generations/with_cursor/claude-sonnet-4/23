def find_words_by_length(word_length, word_list):
    """
    Find all words in the dictionary that have the specified length.
    
    Args:
        word_length (int): The desired length of words
        word_list (list): List of words to search through
    
    Returns:
        list: List of words with the specified length
    """
    matching_words = [word for word in word_list if len(word) == word_length]
    return matching_words

def get_random_words(word_list, count=10):
    """
    Get a random selection of words from the list.
    
    Args:
        word_list (list): List of words to choose from
        count (int): Number of words to return (default: 10)
    
    Returns:
        list: Random selection of words
    """
    if len(word_list) <= count:
        return word_list
    return random.sample(word_list, count)

def main():
    """
    Main program function that handles user interaction.
    """
    print("Welcome to the English Dictionary Word Finder!")
    print("This program will find words with a specific number of characters.")
    print("-" * 60)
    
    while True:
        try:
            # Get user input
            user_input = input("\nEnter the number of characters you want (or 'quit' to exit): ")
            
            # Check if user wants to quit
            if user_input.lower() in ['quit', 'exit', 'q']:
                print("Thank you for using the Word Finder! Goodbye!")
                break
            
            # Convert input to integer
            n_characters = int(user_input)
            
            # Validate input
            if n_characters <= 0:
                print("Please enter a positive number.")
                continue
            
            # Find words with the specified length
            matching_words = find_words_by_length(n_characters, DICTIONARY)
            
            if not matching_words:
                print(f"Sorry, no words found with {n_characters} characters in our dictionary.")
                continue
            
            # Get up to 10 random words
            selected_words = get_random_words(matching_words, 10)
            
            # Display results
            print(f"\nFound {len(matching_words)} word(s) with {n_characters} character(s).")
            print(f"Here are {len(selected_words)} random word(s):")
            print("-" * 30)
            
            for i, word in enumerate(selected_words, 1):
                print(f"{i:2d}. {word}")
            
        except ValueError:
            print("Please enter a valid number or 'quit' to exit.")
        except KeyboardInterrupt:
            print("\n\nProgram interrupted. Goodbye!")
            break
        except Exception as e:
            print(f"An error occurred: {e}")

if __name__ == "__main__":
    main()