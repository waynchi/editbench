import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=1000):
    """
    Rozwiązuje układ równań liniowych Ax = b metodą sprzężonych gradientów.
    
    Parametry:
    A : array_like
        Macierz współczynników (musi być symetryczna i dodatnio określona)
    b : array_like
        Wektor prawej strony
    x0 : array_like, opcjonalny
        Przybliżenie początkowe (domyślnie wektor zerowy)
    tol : float, opcjonalny
        Tolerancja dla kryterium zbieżności (domyślnie 1e-6)
    max_iter : int, opcjonalny
        Maksymalna liczba iteracji (domyślnie 1000)
    
    Zwraca:
    x : ndarray
        Rozwiązanie układu równań
    iterations : int
        Liczba wykonanych iteracji
    residual_norm : float
        Norma końcowego residuum
    """
    
    # Konwersja do numpy arrays
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float)
    
    n = len(b)
    
    # Przybliżenie początkowe
    if x0 is None:
        x = np.zeros(n)
    else:
        x = np.array(x0, dtype=float)
    
    # Obliczenie początkowego residuum
    r = b - A @ x
    p = r.copy()
    
    # Początkowa norma residuum
    r_norm_sq = np.dot(r, r)
    
    for k in range(max_iter):
        # Sprawdzenie kryterium zbieżności
        if np.sqrt(r_norm_sq) < tol:
            return x, k, np.sqrt(r_norm_sq)
        
        # Obliczenie A*p
        Ap = A @ p
        
        # Obliczenie długości kroku alpha
        alpha = r_norm_sq / np.dot(p, Ap)
        
        # Aktualizacja rozwiązania
        x = x + alpha * p
        
        # Aktualizacja residuum
        r = r - alpha * Ap
        
        # Obliczenie nowej normy residuum
        r_norm_sq_new = np.dot(r, r)
        
        # Obliczenie współczynnika beta
        beta = r_norm_sq_new / r_norm_sq
        
        # Aktualizacja kierunku poszukiwań
        p = r + beta * p
        
        # Przygotowanie do następnej iteracji
        r_norm_sq = r_norm_sq_new
    
    # Jeśli nie osiągnięto zbieżności
    return x, max_iter, np.sqrt(r_norm_sq)


def preconditioned_conjugate_gradient(A, b, M=None, x0=None, tol=1e-6, max_iter=1000):
    """
    Rozwiązuje układ równań liniowych Ax = b metodą sprzężonych gradientów
    z prekondycjonowaniem.
    
    Parametry:
    A : array_like
        Macierz współczynników
    b : array_like
        Wektor prawej strony
    M : array_like, opcjonalny
        Macierz prekondycjonująca (domyślnie macierz jednostkowa)
    x0 : array_like, opcjonalny
        Przybliżenie początkowe
    tol : float, opcjonalny
        Tolerancja dla kryterium zbieżności
    max_iter : int, opcjonalny
        Maksymalna liczba iteracji
    
    Zwraca:
    x : ndarray
        Rozwiązanie układu równań
    iterations : int
        Liczba wykonanych iteracji
    residual_norm : float
        Norma końcowego residuum
    """
    
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float)
    n = len(b)
    
    if x0 is None:
        x = np.zeros(n)
    else:
        x = np.array(x0, dtype=float)
    
    if M is None:
        M = np.eye(n)
    else:
        M = np.array(M, dtype=float)
    
    # Początkowe residuum
    r = b - A @ x
    
    # Rozwiązanie M*z = r
    z = np.linalg.solve(M, r)
    p = z.copy()
    
    rz_dot = np.dot(r, z)
    
    for k in range(max_iter):
        if np.sqrt(np.dot(r, r)) < tol:
            return x, k, np.sqrt(np.dot(r, r))
        
        Ap = A @ p
        alpha = rz_dot / np.dot(p, Ap)
        
        x = x + alpha * p
        r = r - alpha * Ap
        
        z = np.linalg.solve(M, r)
        rz_dot_new = np.dot(r, z)
        
        beta = rz_dot_new / rz_dot
        p = z + beta * p
        
        rz_dot = rz_dot_new
    
    return x, max_iter, np.sqrt(np.dot(r, r))


# Przykład użycia
if __name__ == "__main__":
    # Przykładowy układ równań
    A = np.array([[4, 1, 0],
                  [1, 3, 1],
                  [0, 1, 2]], dtype=float)
    
    b = np.array([1, 2, 3], dtype=float)
    
    # Rozwiązanie metodą sprzężonych gradientów
    x, iterations, residual = conjugate_gradient(A, b)
    
    print("Rozwiązanie:", x)
    print("Liczba iteracji:", iterations)
    print("Norma residuum:", residual)
    print("Sprawdzenie A*x:", A @ x)
    print("Wektor b:", b)