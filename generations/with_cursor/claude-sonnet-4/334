# wygeneruj moduł półsumatora w verilog za pomocą pythona

# kod verilog
verilog_code = """
module half_adder(a, b, c_in, enable, reset, c, sum, carry);
    input a, b, c_in, enable, reset;
    output c, sum, carry;
    assign c = (enable & ~reset) ? (a ^ b ^ c_in) : 1'b0;
    assign sum = (enable & ~reset) ? ((a & b) | (a & c_in) | (b & c_in)) : 1'b0;
    assign carry = (enable & ~reset) ? ((a & b) | (a & c_in) | (b & c_in)) : 1'b0;
endmodule
"""

# nazwa modułu verilog
module_name = "half_adder"

# wejścia i wyjścia portów modułu verilog
input_ports = ["a", "b", "c_in", "enable", "reset"]
output_ports = ["c", "sum", "carry"]

# parametry modułu verilog
parameters = ["WIDTH"]

# wartość parametrów modułu verilog
parameter_values = ["8"]

# ciało modułu verilog
module_body = """
    input a, b, c_in, enable, reset;
    output c, sum, carry;
    assign c = (enable & ~reset) ? (a ^ b ^ c_in) : 1'b0;
    assign sum = (enable & ~reset) ? ((a & b) | (a & c_in) | (b & c_in)) : 1'b0;
    assign carry = (enable & ~reset) ? ((a & b) | (a & c_in) | (b & c_in)) : 1'b0;
endmodule
"""

# instancjowanie modułu verilog
module_instantiation = """
half_adder half_adder_inst(
    .a(a),
    .b(b),
    .c_in(c_in),
    .enable(enable),
    .reset(reset),
    .c(c),
    .sum(sum),
    .carry(carry)
);
"""