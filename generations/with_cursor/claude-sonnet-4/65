# 定义一个求数组拟合直线的函数def fit_line(x, y):
import numpy as np

def fit_line(x, y):
    """
    求数组拟合直线的函数
    """
    # 计算x和y的平均值
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    
    # 计算x和y的偏差
    x_dev = x - x_mean
    y_dev = y - y_mean
    
    # 计算x和y的偏差的乘积
    xy_dev = x_dev * y_dev
    
    # 计算x的偏差的平方
    x_dev_squared = x_dev ** 2
    
    # 计算直线的斜率和截距
    slope = np.sum(xy_dev) / np.sum(x_dev_squared)
    intercept = y_mean - slope * x_mean
    
    return slope, intercept

# 定义一个求xy    # 定义一个求xy数组二次曲线拟合的函数
def fit_quadratic(x, y):
    """
    求数组二次曲线拟合的函数
    """
    # 创建一个Vandermonde矩阵
    A = np.vstack([x**2, x, np.ones(len(x))]).T
    
    # 使用最小二乘法求解系数
    coeffs = np.linalg.lstsq(A, y, rcond=None)[0]
    
    return coeffs

def get_max_deviation(x, y, fit_type='linear', coeffs=None):
    """
    求拟合曲线与原始数据的最大偏差值
    
    参数:
    x: x坐标数组
    y: y坐标数组
    fit_type: 拟合类型，'linear'为直线拟合，'quadratic'为二次曲线拟合
    coeffs: 拟合系数，如果为None则自动计算
    
    返回:
    max_deviation: 最大偏差值
    """
    if coeffs is None:
        if fit_type == 'linear':
            slope, intercept = fit_line(x, y)
            y_fitted = slope * x + intercept
        elif fit_type == 'quadratic':
            coeffs = fit_quadratic(x, y)
            y_fitted = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
        else:
            raise ValueError("fit_type must be 'linear' or 'quadratic'")
    else:
        if fit_type == 'linear':
            y_fitted = coeffs[0] * x + coeffs[1]
        elif fit_type == 'quadratic':
            y_fitted = coeffs[0] * x**2 + coeffs[1] * x + coeffs[2]
    
    # 计算偏差
    deviations = np.abs(y - y_fitted)
    
    # 返回最大偏差值
    max_deviation = np.max(deviations)
    
    return max_deviation