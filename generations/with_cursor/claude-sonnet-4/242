# Написать бинарный поиск

def binary_search(arr, target):
    """
    Бинарный поиск элемента в отсортированном массиве
    
    Args:
        arr: отсортированный массив
        target: искомый элемент
    
    Returns:
        int: индекс элемента если найден, иначе -1
    """
    left = 0
    right = len(arr) - 1
    
    while left <= right:
        mid = (left + right) // 2
        
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    
    return -1