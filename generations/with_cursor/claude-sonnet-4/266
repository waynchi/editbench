def crear_diccionario_jerarquico(posts_generator, diccionario_global):
    """
    Создает иерархический словарь из posts_generator и их replies
    Структура: {post_id: {post_data, replies: {reply_id: reply_data}}}
    """
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_id = f"{post_author}/{post_permlink}"
        
        # Создаем запись для поста
        diccionario_global[post_id] = {
            'post_data': {
                'author': post_author,
                'permlink': post_permlink,
                'title': post.get('title', ''),
                'body': post.get('body', ''),
                'children_count': post['children']
            },
            'replies': {}
        }
        
        # Если у поста есть ответы, обрабатываем их
        if post['children'] > 0:
            try:
                comment = Comment(authorperm=post_id)
                post_replies = comment.get_replies()
                
                for reply in post_replies:
                    reply_author = reply['author']
                    reply_permlink = reply['permlink']
                    reply_id = f"{reply_author}/{reply_permlink}"
                    
                    diccionario_global[post_id]['replies'][reply_id] = {
                        'author': reply_author,
                        'permlink': reply_permlink,
                        'body': reply.get('body', ''),
                        'processed': procesar(reply.get('body', '')),
                        'is_own': is_own_author(reply_author),
                        'is_banned': is_banned(reply_author)
                    }
            except Exception as e:
                print(f"Error processing replies for {post_id}: {e}")
    
    return diccionario_global

