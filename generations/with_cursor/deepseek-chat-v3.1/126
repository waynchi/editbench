from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np
import matplotlib.pyplot as plt
from typing import Dict, Tuple, Union

def cluster_data(features_transformed, cluster_config: Dict[str, Tuple[str]], n_clusters=2, clustering_method='kmeans'):
    """Performs data clustering on specified column sets.

Args:
    features_transformed (pandas.DataFrame): Transformed DataFrame with parameters.
    cluster_config (Dict[str, Tuple[str]]): Dictionary where keys are new column names for cluster labels,
                                          and values are tuples of column names to use for clustering.
    n_clusters (int): Number of clusters.
    clustering_method (str): Clustering method ('kmeans').

Returns:
    pandas.DataFrame: DataFrame with added columns of cluster labels for each specified column set."""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()
    result_df = features_transformed.copy()

    for cluster_feature_name, columns_to_cluster in cluster_config.items():
        # Extract the specified columns for clustering
        clustering_data = features_for_clustering[list(columns_to_cluster)]
        
        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(clustering_data)
            
            # Evaluation of clustering quality (e.g., using the silhouette coefficient)
            if len(np.unique(cluster_labels)) > 1: # Check for the case when all points are assigned to one cluster
                silhouette_avg = silhouette_score(clustering_data, cluster_labels)
                print(f"Коэффициент силуэта для {n_clusters} кластеров ({cluster_feature_name}): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для {n_clusters} кластера ({cluster_feature_name}) - все точки в одном кластере.")

        else:
            print("Неподдерживаемый метод кластеризации.")
            return None

        result_df[cluster_feature_name] = cluster_labels
        print(f"Кластеризация выполнена для {columns_to_cluster}. Метки кластеров добавлены в столбец '{cluster_feature_name}'.")

    return result_df

# Clustering execution (after step 5 and before step 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Define which columns to cluster together and what to name the resulting cluster columns
    cluster_config = {
        'cluster_group1': ('column1', 'column2'),  # Cluster on column1 and column2, store results in 'cluster_group1'
        'cluster_group2': ('column3',)             # Cluster on column3, store results in 'cluster_group2'
    }
    
    n_clusters = 3  # Number of clusters (select the optimal value)
    features_transformed = cluster_data(features_transformed, cluster_config, n_clusters)
    
    # Visualization of clusters for each cluster group
    for cluster_feature_name, columns_to_cluster in cluster_config.items():
        numerical_features = features_transformed[list(columns_to_cluster)]
        if len(columns_to_cluster) >= 2:
            plt.figure(figsize=(8, 6))
            plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], 
                       c=features_transformed[cluster_feature_name], cmap='viridis')
            plt.xlabel(numerical_features.columns[0])
            plt.ylabel(numerical_features.columns[1])
            plt.title(f'Результаты кластеризации: {cluster_feature_name}')
            plt.colorbar(label='Номер кластера')
            plt.show()
        elif len(columns_to_cluster) == 1:
            print(f"Для кластера '{cluster_feature_name}' только один признак - визуализация на плоскости невозможна.")
        else:
            print(f"Недостаточно числовых признаков для визуализации кластеров '{cluster_feature_name}' на плоскости.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")