from main13 import knn, mlp
import pandas as pd

# Создаем список для хранения всех комбинаций параметров
results = []

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in ["S", "Q", "C"]:
            # Создаем DataFrame с правильными названиями колонок
            my_df = pd.DataFrame({
                "Pclass": [pclass],
                "Name": [24],
                "Sex": [0],
                "Age": [19],
                "SibSp": [0],
                "Parch": [0],
                "Fare": [fare],
                "Embarked": [embarked]
            })
            
            # Применяем one-hot encoding
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
            
            # Убеждаемся, что все нужные колонки присутствуют
            for col in ["Embarked_S", "Embarked_C", "Embarked_Q"]:
                if col not in my_df.columns:
                    my_df[col] = 0
            
            # Преобразуем булевы значения в числовые
            for col in ["Embarked_S", "Embarked_C", "Embarked_Q"]:
                my_df[col] = my_df[col].astype(int)
            
            # Получаем предсказания
            knn_pred = knn.predict(my_df)[0]
            mlp_pred = mlp.predict(my_df)[0]
            
            # Сохраняем результаты
            results.append({
                "Pclass": pclass,
                "Fare": fare,
                "Embarked": embarked,
                "KNN_Prediction": knn_pred,
                "MLP_Prediction": mlp_pred
            })
            
            print(f"""-------------------------------------------------------
Параметры: класс {pclass}, плата {fare}, embarked {embarked}
По knn: {knn_pred}
По mlp: {mlp_pred}""")

# Создаем DataFrame с результатами для дальнейшего анализа
results_df = pd.DataFrame(results)
print("\nСводка результатов:")
print(results_df.head())