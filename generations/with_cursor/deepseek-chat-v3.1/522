"""
Main entry point for the Audio Recorder and Transcriber application.
"""

import os
import sys
import logging
import tkinter as tk
import tkinterdnd2
import traceback

def setup_logging():
    """
    Set up logging configuration for the application.
    """
    log_format = '%(asctime)s - %(levelname)s - %(message)s'
    logging.basicConfig(
        level=logging.INFO,
        format=log_format,
        handlers=[
            logging.StreamHandler(),
            logging.FileHandler('app.log', encoding='utf-8')
        ]
    )

def get_resource_path():
    """
    Get the resource path that works for both development and PyInstaller.

    Returns:
        str: Path to resources directory
    """
    if getattr(sys, 'frozen', False):
        # Ejecutándose como ejecutable compilado
        return os.path.join(os.path.dirname(sys.executable), 'resources')
    else:
        # Ejecutando como script
        return os.path.join(os.path.dirname(os.path.abspath(__file__)), 'resources')

def check_resources():
    """
    Check if required resource files exist.

    Returns:
        bool: True if all required resources are present
    """
    required_files = ['sound.mp3', 'done.mp3', 'cancel.wav', 'help_text.txt']
    resource_dir = get_resource_path()
    
    # Verificar si cada archivo requerido existe
    missing_files = []
    for file in required_files:
        if not os.path.exists(os.path.join(resource_dir, file)):
            missing_files.append(file)
    
    # Si faltan archivos requeridos, devolver False
    if missing_files:
        logging.error(f"Missing resource files: {', '.join(missing_files)}")
        return False
    return True

def handle_uncaught_exception(exc_type, exc_value, exc_traceback):
    """
    Handle uncaught exceptions and log them properly.
    """
    if issubclass(exc_type, KeyboardInterrupt):
        # Call the default handler for KeyboardInterrupt
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    
    logging.error("Uncaught exception:", exc_info=(exc_type, exc_value, exc_traceback))
    
    # Mostrar mensaje de error al usuario
    try:
        error_msg = f"Se produjo un error inesperado:\n\n{str(exc_value)}\n\nPor favor, revise el archivo app.log para más detalles."
        tk.messagebox.showerror("Error", error_msg)
    except:
        # Fallback si no se puede mostrar el mensaje de error
        print(f"Error crítico: {exc_value}")

def main():
    """
    Main function to start the application.
    """
    try:
        # Configurar el manejador de excepciones no capturadas
        sys.excepthook = handle_uncaught_exception
        
        # Configurar el registro de eventos
        setup_logging()
        logging.info("Starting Audio Recorder and Transcriber application")

        # Verificar recursos
        if not check_resources():
            error_msg = "Required resource files are missing. Application cannot start."
            logging.error(error_msg)
            tk.messagebox.showerror("Error", error_msg)
            sys.exit(1)

        # Inicializar la ventana principal con soporte de arrastrar y soltar
        root = tkinterdnd2.TkinterDnD.Tk()
        
        # Importar aquí para evitar importaciones circulares
        try:
            from gui.main_window import AudioTranscriberApp
        except ImportError as e:
            logging.error(f"Failed to import GUI module: {e}")
            tk.messagebox.showerror("Error", f"No se pudo cargar la interfaz gráfica: {e}")
            sys.exit(1)
        
        # Crear la instancia de la aplicación
        try:
            app = AudioTranscriberApp(root)
        except Exception as e:
            logging.error(f"Failed to initialize application: {e}\n{traceback.format_exc()}")
            tk.messagebox.showerror("Error", f"Error al inicializar la aplicación: {e}")
            sys.exit(1)
        
        # Iniciar el bucle principal de eventos
        try:
            root.mainloop()
        except Exception as e:
            logging.error(f"Error during main loop execution: {e}\n{traceback.format_exc()}")
            raise
        
    except Exception as e:
        logging.error(f"Application startup error: {e}\n{traceback.format_exc()}")
        try:
            tk.messagebox.showerror("Error", f"Error al iniciar la aplicación: {e}")
        except:
            pass
        sys.exit(1)

if __name__ == "__main__":
    main()