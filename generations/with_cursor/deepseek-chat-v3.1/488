from main13 import knn, mlp
import pandas as pd

for pclass in [1, 2, 3]:
    for fare in range(10, 200, 10):
        for embarked in ["S", "Q", "C"]:
            # Crear DataFrame con los datos de entrada
            my_df = pd.DataFrame({"Pclass": [pclass],
                                "Name": [24],
                                "Sex": [0],
                                "Age": [19],
                                "SibSp": [0],
                                "Parch": [0],
                                "Fare": [fare],
                                "Embarked": [embarked]
                                })
            
            # Aplicar one-hot encoding a la columna Embarked
            my_df = pd.get_dummies(my_df, columns=["Embarked"], prefix="Embarked")
            
            # Asegurar que todas las columnas esperadas estén presentes
            expected_columns = ["Embarked_C", "Embarked_Q", "Embarked_S"]
            for col in expected_columns:
                if col not in my_df.columns:
                    my_df[col] = 0
            
            # Reordenar columnas para que coincidan con el entrenamiento
            my_df = my_df[["Pclass", "Name", "Sex", "Age", "SibSp", "Parch", "Fare", 
                          "Embarked_C", "Embarked_Q", "Embarked_S"]]
            
            print(f"""-------------------------------------------------------
                  Параметры: класс {pclass}, плата {fare}, embarked {embarked}
                  По knn: {knn.predict(my_df)[0]}
                  По mlp: {mlp.predict(my_df)[0]}""")