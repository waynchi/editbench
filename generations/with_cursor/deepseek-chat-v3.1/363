def crear_estructura_jerarquica(posts_generator):
    """Crea un diccionario jerárquico con posts y sus replies"""
    estructura = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_key = f"{post_author}/{post_permlink}"
        
        # Crear entrada principal para el post
        estructura[post_key] = {
            'post_data': dict(post),
            'replies': {}
        }
        
        # Obtener y procesar replies si existen
        if post['children'] > 0:
            try:
                comment = Comment(authorperm=post_key)
                post_replies = comment.get_replies()
                
                for reply in post_replies:
                    reply_author = reply['author']
                    reply_permlink = reply['permlink']
                    reply_key = f"{reply_author}/{reply_permlink}"
                    
                    # Añadir reply al diccionario de replies del post
                    estructura[post_key]['replies'][reply_key] = {
                        'reply_data': dict(reply),
                        'processed': procesar(reply['body']),
                        'own_author': is_own_author(reply_author),
                        'banned': is_banned(reply_author)
                    }
                    
            except Exception as e:
                print(f"Error procesando replies de {post_key}: {e}")
    
    return estructura


