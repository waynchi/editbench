import numpy as np

INPUT_FILE_PATH = './input.txt'
# INPUT_FILE_PATH = './example_in.txt'

def main():
    lines = parse_input_file()
    # Remove any empty lines
    lines = [line for line in lines if line]
    
    # Convert to numpy array
    grid = np.array([list(line) for line in lines])
    print(grid)
    
    str_to_match = "XMAS"
    count = 0
    
    # Check horizontal (left to right)
    for row in grid:
        row_str = ''.join(row)
        count += row_str.count(str_to_match)
        # Also check reverse (right to left)
        count += row_str[::-1].count(str_to_match)

    # Check vertical (top to bottom)
    for col in range(grid.shape[1]):
        col_str = ''.join(grid[:, col])
        count += col_str.count(str_to_match)
        # Also check reverse (bottom to top)
        count += col_str[::-1].count(str_to_match)

    # Check diagonals (top-left to bottom-right)
    for i in range(-(grid.shape[0]-1), grid.shape[1]):
        diag = np.diagonal(grid, offset=i)
        if len(diag) >= len(str_to_match):
            diag_str = ''.join(diag)
            count += diag_str.count(str_to_match)
            # Also check reverse
            count += diag_str[::-1].count(str_to_match)

    # Check diagonals (top-right to bottom-left)
    flipped_grid = np.fliplr(grid)
    for i in range(-(grid.shape[0]-1), grid.shape[1]):
        diag = np.diagonal(flipped_grid, offset=i)
        if len(diag) >= len(str_to_match):
            diag_str = ''.join(diag)
            count += diag_str.count(str_to_match)
            # Also check reverse
            count += diag_str[::-1].count(str_to_match)

    print(f"Found {count} occurrences of {str_to_match}")

def parse_input_file():
    with open(INPUT_FILE_PATH, 'r') as f:
        lines = f.read().split("\n")
    return lines

if __name__ == "__main__":
    main()