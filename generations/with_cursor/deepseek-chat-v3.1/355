    async def aiofiles_open(filepath, mode, encoding=None):
        if 'b' in mode:
            with open(filepath, mode) as f:
                return f.read() if 'r' in mode else None
        else:
            with open(filepath, mode, encoding=encoding) as f:
                return f.read() if 'r' in mode else None