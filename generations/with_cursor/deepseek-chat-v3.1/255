import numpy as np

INPUT_FILE_PATH = './input.txt'

def main():
    lines = parse_input_file()
    cols = [line.split() for line in lines if line.strip()]
    
    # Convert to numpy array and transpose
    cols_array = np.array(cols).astype(int)
    list_1 = cols_array[:, 0].tolist()
    list_2 = cols_array[:, 1].tolist()

    all_dists = []
    while list_1:
        # Find indices of minimum values
        argmin_1 = np.argmin(list_1)
        min_1 = list_1.pop(argmin_1)
        
        argmin_2 = np.argmin(list_2)
        min_2 = list_2.pop(argmin_2)
        
        dist = abs(min_1 - min_2)
        all_dists.append(dist)
    
    print(f"Total distance: {sum(all_dists)}")

def parse_input_file():
    try:
        with open(INPUT_FILE_PATH, 'r') as f:
            return [line.strip() for line in f.readlines() if line.strip()]
    except FileNotFoundError:
        print(f"Error: File '{INPUT_FILE_PATH}' not found")
        return []
    except Exception as e:
        print(f"Error reading file: {e}")
        return []

if __name__ == "__main__":
    main()