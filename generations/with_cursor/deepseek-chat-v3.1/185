def save_log_to_file(log_history: List[Dict[str, Any]], file_path: str, append_latest_only: bool = False) -> None:
    """将日志历史保存到JSON文件中。如果文件已存在，则追加到文件中。

参数：
- log_history：日志条目列表（每个条目是一个字典）。
- file_path：保存日志的文件路径。
- append_latest_only：如果为True，则仅追加最新的日志条目。"""
    
    # 如果文件存在，尝试加载现有日志
    current_logs = []
    if os.path.exists(file_path):
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                content = f.read().strip()
                if content:
                    current_logs = json.loads(content)
        except json.JSONDecodeError:
            logging.warning(f"{file_path} contains invalid JSON. Overwriting file.")
        except Exception as e:
            logging.error(f"Error reading {file_path}: {e}")
            return

    # 决定是附加整个日志历史记录还是仅附加最新条目
    if append_latest_only and log_history:
        current_logs.append(log_history[-1])
    else:
        current_logs.extend(log_history)

    # 保存更新后的日志历史记录
    try:
        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(current_logs, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logging.error(f"Error writing to {file_path}: {e}")


def clear_directory(directory: str, delete_directory: bool = False) -> None:
    """清除给定目录中的所有文件和子目录。可选择删除目录本身。如果目录不存在且 delete_directory 为 False，则创建目录。

参数：
    directory (str): 要清除的目录路径。
    delete_directory (bool): 如果为 True，则在清除内容后删除目录。默认为 False。

引发：
    OSError: 如果在文件或目录删除过程中发生任何错误。提供有关失败的详细信息。
示例：
    clear_directory('/path/to/my/directory')
    clear_directory('/path/to/my/directory', delete_directory=True)"""
    
    if not os.path.exists(directory):
        if not delete_directory:
            os.makedirs(directory, exist_ok=True)
            logging.info(f"Directory '{directory}' created.")
        else:
            raise ValueError("Directory does not exist and delete_directory is True. Cannot proceed.")
        return

    errors = []
    for item in os.listdir(directory):
        item_path = os.path.join(directory, item)
        try:
            if os.path.isdir(item_path):
                shutil.rmtree(item_path)
                logging.info(f"Removed directory: {item_path}")
            else:
                os.remove(item_path)
                logging.info(f"Removed file: {item_path}")
        except OSError as e:
            errors.append(f"Failed to delete '{item_path}': {e}")

    if errors:
        error_msg = "\n".join(errors)
        raise OSError(f"Errors occurred during directory cleanup:\n{error_msg}")

    if delete_directory:
        try:
            os.rmdir(directory)
            logging.info(f"Removed directory: {directory}")
        except OSError as e:
            raise OSError(f"Failed to delete '{directory}': {e}")


def merge_lora_model(
    model_name: str = "pythia-31M",
    base_model_repo_name: str = "EleutherAI/",
    model_load_path: str = MODEL_PATH,
    model_save_path: str = MODEL_PATH,
) -> None:
    """合并LoRA模型到基础模型"""
    
    my_model_path = os.path.join(model_load_path, model_name)
    param_count = model_name.lower().split("m")[0].split("-")[1]
    base_model_name = f"pythia-{param_count}M"

    # 使用缓存和更高效的内存管理
    base_model = AutoModelForCausalLM.from_pretrained(
        os.path.join(base_model_repo_name, base_model_name),
        torch_dtype=torch.float16,  # 使用半精度减少内存使用
        device_map="auto"  # 自动设备映射
    )
    
    model = PeftModel.from_pretrained(base_model, my_model_path)
    merged_model = model.merge_and_unload()
    
    my_model_save_path = os.path.join(model_save_path, f"{model_name}_merged")
    merged_model.save_pretrained(my_model_save_path)


def remove_repetition(question: str, answer: str) -> str:
    """移除答案中的问题重复部分"""
    return answer.replace(question, "").strip() if question in answer else answer


def load_model(
    model_type: str,
    model_path: Optional[str] = None,
    blocks_str: Optional[str] = None,
    vanilla_model_name: Optional[str] = None,
    host_model_name: Optional[str] = None,
) -> Any:
    """
    Loads different types of models based on the model_type parameter.

    Parameters:
    model_type (str): The type of model to load. One of 'Tuned Model', 'Vanilla Model',
                      'Transformed Model', 'Final Model', or 'Host Model'.
    model_path (str): The base path where models are stored.
    blocks_str (str): A string representing the layers or blocks used in model naming.
    vanilla_model_name (str): The name or path of the vanilla (base) model.
    host_model_name (str): The name or path of the host model.

    Returns:
    model: The loaded model object.

    Raises:
    ValueError: If an unknown model_type is provided or required parameters are missing.
    IOError: If loading the model fails.
    """
    
    # 参数验证
    required_params = {
        "Tuned Model": ["model_path", "blocks_str", "vanilla_model_name"],
        "Vanilla Model": ["vanilla_model_name"],
        "Transformed Model": ["model_path", "blocks_str", "host_model_name"],
        "Final Model": ["model_path", "blocks_str", "host_model_name"],
        "Host Model": ["host_model_name"]
    }
    
    if model_type not in required_params:
        raise ValueError(f"Unknown model type: {model_type}")
    
    missing_params = [param for param in required_params[model_type] 
                     if locals()[param] is None]
    if missing_params:
        raise ValueError(f"Missing required parameters for {model_type}: {missing_params}")

    try:
        if model_type == "Tuned Model":
            model_name = vanilla_model_name.split("/")[-1]
            tuned_model_name = f"{model_name}_trained_layers_{blocks_str}_merged"
            return AutoModelForCausalLM.from_pretrained(
                os.path.join(model_path, tuned_model_name),
                torch_dtype=torch.float16,
                device_map="auto"
            )

        elif model_type == "Vanilla Model":
            return AutoModelForCausalLM.from_pretrained(
                vanilla_model_name,
                torch_dtype=torch.float16,
                device_map="auto"
            )

        elif model_type == "Transformed Model":
            name = host_model_name.split("/")[-1]
            save_path = os.path.join(model_path, f"{name}_preGRAFTED_{blocks_str}.pkl")
            with open(save_path, "rb") as f:
                return pickle.load(f)

        elif model_type == "Final Model":
            name = host_model_name.split("/")[-1]
            model_save_name = f"{name}_GRAFTED_{blocks_str}.pkl"
            save_path = os.path.join(model_path, model_save_name)
            with open(save_path, "rb") as f:
                return pickle.load(f)
                
        elif model_type == "Host Model":
            return AutoModelForCausalLM.from_pretrained(
                host_model_name,
                torch_dtype=torch.float16,
                device_map="auto"
            )

    except Exception as e:
        raise IOError(f"Failed to load {model_type}: {e}")


def load_batch_losses(file_path: str) -> Optional[List[float]]:
    """从检查点文件加载批次损失数据。

参数：
file_path (str): 检查点文件的路径。

返回：
list 或 None: 如果可用则返回批次损失，否则返回 None。

日志：
如果加载失败，则记录错误信息。
"""
    try:
        checkpoint = torch.load(file_path, map_location=torch.device("cpu"), weights_only=True)
        batch_losses = checkpoint.get("batch_losses")
        if batch_losses is not None:
            logging.info(f"Batch losses loaded from {file_path}")
        else:
            logging.warning(f"No 'batch_losses' key found in checkpoint at {file_path}")
        return batch_losses
    except Exception as e:
        logging.error(f"Error loading checkpoint from {file_path}: {e}")
        return None