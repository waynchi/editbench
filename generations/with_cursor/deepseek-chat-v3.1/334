# wygeneruj moduł półsumatora w verilog za pomocą pythona

# kod verilog
verilog_code = """
module half_adder(a, b, c, d, e, sum, carry);
    input a, b, c, d, e;
    output sum, carry;
    wire temp1, temp2, temp3, temp4;
    
    assign temp1 = a ^ b;
    assign temp2 = temp1 ^ c;
    assign temp3 = temp2 ^ d;
    assign sum = temp3 ^ e;
    
    assign temp4 = (a & b) | (temp1 & c) | (temp2 & d) | (temp3 & e);
    assign carry = temp4;
endmodule
"""

# nazwa modułu verilog
module_name = "half_adder"

# wejścia i wyjścia portów modułu verilog
input_ports = ["a", "b", "c", "d", "e"]
output_ports = ["sum", "carry"]

# parametry modułu verilog
parameters = ["WIDTH"]

# wartość parametrów modułu verilog
parameter_values = ["8"]

# ciało modułu verilog
module_body = """
    input a, b, c, d, e;
    output sum, carry;
    wire temp1, temp2, temp3, temp4;
    
    assign temp1 = a ^ b;
    assign temp2 = temp1 ^ c;
    assign temp3 = temp2 ^ d;
    assign sum = temp3 ^ e;
    
    assign temp4 = (a & b) | (temp1 & c) | (temp2 & d) | (temp3 & e);
    assign carry = temp4;
endmodule
"""

# instancjowanie modułu verilog
module_instantiation = """
