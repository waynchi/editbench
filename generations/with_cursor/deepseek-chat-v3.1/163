        "title": title,
        "body": body,
    }


q = Query()
d = Discussions()
posts_generator = d.get_discussions("created", q, limit=6000)
X = 0

for post in posts_generator:
    post_author = post['author']
    post_permlink = post['permlink']
    post_replies = post['children']
    cnt = 0
    X += 1
    if post_replies > n_respuestas_minimas:
        comment = Comment(authorperm=f"{post_author}/{post_permlink}")
        post_replies :list = comment.get_replies()
        
        # Crear estructura jerárquica para este post
        post_hierarchy = {
            'post_author': post_author,
            'post_permlink': post_permlink,
            'replies': []
        }
        
        cnt = 0
        for reply in post_replies:
            author = reply['author']
            text = reply['body']
            if is_own_author(author):
                # 重新评估评论
                break
            if is_banned(author):
                break
            if procesar(text):
                cnt += 1
            
            # Añadir información de la respuesta al diccionario jerárquico
            reply_data = {
                'author': author,
                'permlink': reply['permlink'],
                'body': text,
                'children': []  # Para posibles respuestas anidadas
            }
            post_hierarchy['replies'].append(reply_data)
        
        # Añadir la estructura del post al diccionario principal
        diccionario[f"{post_author}/{post_permlink}"] = post_hierarchy
    
    if cnt > 3:
        print("Iterador: ",X)
