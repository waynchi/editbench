def create_hierarchical_dict(posts_generator):
    """
    Creates a hierarchical dictionary structure from posts and their replies.
    
    Structure:
    {
        post_author/post_permlink: {
            'post_data': {...},
            'replies': {
                reply_author/reply_permlink: {
                    'reply_data': {...},
                    'replies': {...}
                }
            }
        }
    }
    """
    hierarchical_dict = {}
    
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_key = f"{post_author}/{post_permlink}"
        
        # Add post to hierarchical dictionary
        hierarchical_dict[post_key] = {
            'post_data': dict(post),
            'replies': {}
        }
        
        # Process replies if they exist
        if post['children'] > 0:
            try:
                comment = Comment(authorperm=post_key)
                post_replies = comment.get_replies()
                
                for reply in post_replies:
                    reply_author = reply['author']
                    reply_permlink = reply['permlink']
                    reply_key = f"{reply_author}/{reply_permlink}"
                    
                    # Add reply to hierarchical structure
                    hierarchical_dict[post_key]['replies'][reply_key] = {
                        'reply_data': dict(reply),
                        'replies': {}
                    }
                    
                    # Recursively process nested replies if needed
                    if reply['children'] > 0:
                        nested_replies = Comment(authorperm=reply_key).get_replies()
                        for nested_reply in nested_replies:
                            nested_author = nested_reply['author']
                            nested_permlink = nested_reply['permlink']
                            nested_key = f"{nested_author}/{nested_permlink}"
                            
                            hierarchical_dict[post_key]['replies'][reply_key]['replies'][nested_key] = {
                                'reply_data': dict(nested_reply)
                            }
                            
            except Exception as e:
                print(f"Error processing replies for {post_key}: {e}")
    
    return hierarchical_dict


