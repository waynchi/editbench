def sum_of_four_squares(n):
    """
    Encontra todas as representações de um número como soma de quatro quadrados não nulos.
    Retorna uma lista de tuplas (a, b, c, d) onde a² + b² + c² + d² = n
    e 1 <= a <= b <= c <= d para evitar permutações duplicadas
    """
    results = []
    max_val = int(n**0.5) + 1
    
    for a in range(1, max_val):
        for b in range(a, max_val):
            for c in range(b, max_val):
                remaining = n - (a*a + b*b + c*c)
                if remaining < c*c:  # Otimização: não precisa continuar se remaining for muito pequeno
                    break
                if remaining <= 0:
                    continue
                
                d_squared = remaining
                d = int(d_squared**0.5)
                if d*d == d_squared and d >= c:
                    results.append((a, b, c, d))
    
    return results

def main():
    """
    Programa principal que encontra números que podem ser expressos como
    a soma de quatro quadrados não nulos e exibe suas representações
    """
    print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
    print("-" * 70)
    
    for num in range(1, 51):  # Verificando números de 1 a 50
        representations = sum_of_four_squares(num)
        if representations:
            print(f"{num}: {representations}")

if __name__ == "__main__":
    main()