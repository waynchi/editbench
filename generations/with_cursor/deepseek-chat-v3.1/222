from langchain_ollama import ChatOllama
from langchain_core.prompts.chat import ChatPromptTemplate
import json

def generate_shap_analysis_response(shap_values_file_path, system_prompt_file_path, model_config=None):
    """
    根据SHAP值生成分析响应的函数
    
    Args:
        shap_values_file_path (str): SHAP值JSON文件的路径
        system_prompt_file_path (str): 系统提示文件的路径
        model_config (dict, optional): 模型配置参数，包含以下键：
            - model (str): 模型名称，默认为"llama3.2"
            - base_url (str): 基础URL，默认为"http://localhost:11434"
            - client_kwargs (dict, optional): 客户端额外参数
    
    Returns:
        str: 模型的响应内容
    """
    # 设置默认模型配置
    if model_config is None:
        model_config = {
            "model": "llama3.2",
            "base_url": "http://localhost:11434"
        }
    
    # 初始化 ChatOllama 模型
    chat_model = ChatOllama(
        model=model_config.get("model", "llama3.2"),
        base_url=model_config.get("base_url", "http://localhost:11434"),
        client_kwargs=model_config.get("client_kwargs", {})
    )
    
    # 从 JSON 文件加载 SHAP 值
    with open(shap_values_file_path, "r") as file:
        shap_values_json = json.load(file).get("shap_values")
    
    # 从文件加载系统提示
    with open(system_prompt_file_path, "r") as file:
        sys_prompt = file.read().strip()
    
    # 准备消息模板
    prompt = ChatPromptTemplate(
        [
            ("system", sys_prompt),
            ("human", "{user_input}"),
        ]
    )
    
    # 准备用户输入
    user_input = json.dumps(shap_values_json)
    
    # 创建处理链
    chain = prompt | chat_model
    
    # 生成并返回响应
    response = chain.invoke(user_input)
    return response.content

# 使用示例
