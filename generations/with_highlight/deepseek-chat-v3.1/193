from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import numpy as np

def cluster_data(features_transformed, clustering_config, n_clusters=2, clustering_method='kmeans'):
    """执行数据聚类。

参数：
    features_transformed (pandas.DataFrame): 转换后的包含参数的DataFrame。
    clustering_config (dict or str): 聚类配置。如果是字典，格式为{新列名: [特征列列表]}；
                                     如果是字符串，表示单个聚类列名。
    n_clusters (int or dict): 聚类数量。如果是字典，格式为{新列名: 聚类数}；
                               如果是整数，用于所有聚类。
    clustering_method (str): 聚类方法（'kmeans'）。

返回：
    pandas.DataFrame: 添加了聚类标签列的DataFrame。"""
    if features_transformed is None:
        print("Сначала выполните преобразование данных (этап 5).")
        return None

    features_for_clustering = features_transformed.copy()
    result_df = features_transformed.copy()

    # 处理配置参数
    if isinstance(clustering_config, str):
        clustering_config = {clustering_config: features_for_clustering.columns.tolist()}
    
    if isinstance(n_clusters, int):
        n_clusters = {key: n_clusters for key in clustering_config.keys()}

    if clustering_method == 'kmeans':
        for cluster_name, feature_columns in clustering_config.items():
            # 选择特定特征子集进行聚类
            features_subset = features_for_clustering[feature_columns]
            
            # 获取该聚类的簇数
            k = n_clusters.get(cluster_name, 2)
            
            model = KMeans(n_clusters=k, random_state=42, n_init=10)
            cluster_labels = model.fit_predict(features_subset)
            
            # 评估聚类质量
            if len(np.unique(cluster_labels)) > 1:
                silhouette_avg = silhouette_score(features_subset, cluster_labels)
                print(f"Коэффициент силуэта для кластера '{cluster_name}' ({k} кластеров): {silhouette_avg:.4f}")
            else:
                print(f"Невозможно рассчитать коэффициент силуэта для кластера '{cluster_name}' (все точки в одном кластере).")

            # 添加聚类标签到结果DataFrame
            result_df[cluster_name] = cluster_labels
            print(f"Кластеризация '{cluster_name}' выполнена. Метки добавлены в столбец '{cluster_name}'.")

    else:
        print("Неподдерживаемый метод кластеризации.")
        return None

    return result_df

# 执行聚类（在步骤5之后和步骤6之前）
if 'features_transformed' in locals() and features_transformed is not None:
    # 配置多个独立的聚类
    clustering_config = {
        'cluster_features1': ['feature1', 'feature2'],  # 对前两列进行聚类
        'cluster_features2': ['feature3']               # 对第三列进行聚类
    }
    n_clusters = {
        'cluster_features1': 3,  # 第一个聚类的簇数
        'cluster_features2': 2   # 第二个聚类的簇数
    }
    
    features_transformed = cluster_data(features_transformed, clustering_config, n_clusters)
    
    # 可视化聚类（当有两个数值特征时的示例）
    # 这里可以选择显示哪个聚类结果
    cluster_feature_name = 'cluster_features1'  # 选择要可视化的聚类列
    numerical_features = features_transformed.select_dtypes(include=np.number)
    if numerical_features.shape[1] >= 2:
        plt.figure(figsize=(8, 6))
        plt.scatter(numerical_features.iloc[:, 0], numerical_features.iloc[:, 1], 
                   c=features_transformed[cluster_feature_name], cmap='viridis')
        plt.xlabel(numerical_features.columns[0])
        plt.ylabel(numerical_features.columns[1])
        plt.title(f'Результаты кластеризации ({cluster_feature_name})')
        plt.colorbar(label='Номер кластера')
        plt.show()
    else:
        print("Недостаточно числовых признаков для визуализации кластеров на плоскости.")
else:
    print("Сначала выполните этап 5 (Преобразование данных).")