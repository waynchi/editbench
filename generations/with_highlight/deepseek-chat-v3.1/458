def napraw(obrazek):
    # Encontrar fila con error
    wiersz_bledny = -1
    for i in range(20):
        wiersz = obrazek[i]
        if wiersz[:-1].count('1') % 2 != int(wiersz[-1]):
            wiersz_bledny = i
            break
    
    # Encontrar columna con error
    kolumna_bledna = -1
    for i in range(20):
        kolumna = ""
        for j in range(21):
            kolumna += obrazek[j][i]
        if kolumna[:-1].count('1') % 2 != int(kolumna[-1]):
            kolumna_bledna = i
            break
    
    # Crear copia del obrazek para reparar
    wynik = [list(wiersz) for wiersz in obrazek]
    
    # Reparar el bit de datos en la intersección
    if wiersz_bledny != -1 and kolumna_bledna != -1:
        # Cambiar el bit en la posición (wiersz_bledny, kolumna_bledna)
        current_bit = wynik[wiersz_bledny][kolumna_bledna]
        wynik[wiersz_bledny][kolumna_bledna] = '1' if current_bit == '0' else '0'
    
    # Convertir de vuelta a strings
    wynik = [''.join(wiersz) for wiersz in wynik]
    
    return wynik

