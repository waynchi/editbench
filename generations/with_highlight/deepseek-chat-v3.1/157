import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-6, max_iter=None):
    """
    使用共轭梯度法求解线性方程组 Ax = b
    
    参数:
    A: 对称正定矩阵 (n x n)
    b: 右侧向量 (n,)
    x0: 初始猜测解 (默认为零向量)
    tol: 收敛容差
    max_iter: 最大迭代次数 (默认为n)
    
    返回:
    x: 近似解
    converged: 是否收敛
    iterations: 实际迭代次数
    residuals: 残差历史记录
    """
    n = len(b)
    
    if max_iter is None:
        max_iter = n
    
    if x0 is None:
        x = np.zeros_like(b)
    else:
        x = x0.copy()
    
    r = b - A @ x  # 初始残差
    p = r.copy()   # 初始搜索方向
    rs_old = r @ r
    
    residuals = [np.linalg.norm(r)]
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rs_old / (p @ Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        rs_new = r @ r
        
        residuals.append(np.linalg.norm(r))
        
        if np.sqrt(rs_new) < tol:
            return x, True, i + 1, np.array(residuals)
        
        p = r + (rs_new / rs_old) * p
        rs_old = rs_new
    
    return x, False, max_iter, np.array(residuals)

def preconditioned_conjugate_gradient(A, b, M, x0=None, tol=1e-6, max_iter=None):
    """
    使用预处理共轭梯度法求解线性方程组 Ax = b
    
    参数:
    A: 对称正定矩阵 (n x n)
    b: 右侧向量 (n,)
    M: 预处理矩阵 (近似A的逆)
    x0: 初始猜测解 (默认为零向量)
    tol: 收敛容差
    max_iter: 最大迭代次数 (默认为n)
    
    返回:
    x: 近似解
    converged: 是否收敛
    iterations: 实际迭代次数
    residuals: 残差历史记录
    """
    n = len(b)
    
    if max_iter is None:
        max_iter = n
    
    if x0 is None:
        x = np.zeros_like(b)
    else:
        x = x0.copy()
    
    r = b - A @ x
    z = M @ r  # 预处理残差
    p = z.copy()
    rz_old = r @ z
    
    residuals = [np.linalg.norm(r)]
    
    for i in range(max_iter):
        Ap = A @ p
        alpha = rz_old / (p @ Ap)
        x = x + alpha * p
        r = r - alpha * Ap
        z = M @ r
        rz_new = r @ z
        
        residuals.append(np.linalg.norm(r))
        
        if np.sqrt(rz_new) < tol:
            return x, True, i + 1, np.array(residuals)
        
        p = z + (rz_new / rz_old) * p
        rz_old = rz_new
    
    return x, False, max_iter, np.array(residuals)

# 示例用法
if __name__ == "__main__":
    # 创建一个对称正定矩阵
    n = 100
    A = np.random.randn(n, n)
    A = A.T @ A + np.eye(n)  # 确保对称正定
    
    # 创建精确解和右侧向量
    x_exact = np.ones(n)
    b = A @ x_exact
    
    # 使用共轭梯度法求解
    x_cg, converged, iterations, residuals = conjugate_gradient(A, b)
    
    print(f"共轭梯度法:")
    print(f"收敛: {converged}")
    print(f"迭代次数: {iterations}")
    print(f"最终残差: {residuals[-1]:.2e}")
    print(f"相对误差: {np.linalg.norm(x_cg - x_exact)/np.linalg.norm(x_exact):.2e}")
    
    # 使用预处理共轭梯度法（对角预处理）
    M = np.diag(1 / np.diag(A))  # 对角预处理矩阵
    x_pcg, converged, iterations, residuals = preconditioned_conjugate_gradient(A, b, M)
    
    print(f"\n预处理共轭梯度法:")
    print(f"收敛: {converged}")
    print(f"迭代次数: {iterations}")
    print(f"最终残差: {residuals[-1]:.2e}")
    print(f"相对误差: {np.linalg.norm(x_pcg - x_exact)/np.linalg.norm(x_exact):.2e}")