# Пути к файлам
shap_file = "Vuori_Final_Approval_2024_09_24.json"
system_prompt_file = "system.prompt"

# Вызвать функцию для получения ответа
response = generate_analysis(
    json_path=shap_file, prompt_path=system_prompt_file, model_config=model_parameters
)

# Вывести ответ
print(response.content)