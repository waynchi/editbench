script_dir = os.path.dirname(os.path.abspath(__file__))

# Skonstruuj ścieżkę względną do chromedrivera
chromedriver_path = os.path.join(script_dir, "chromedriver-win64", "chromedriver.exe")

# The original code incorrectly used options.binary_location for the chromedriver path,
# causing a "session not created" error. The correct approach is to use the
# driver_executable_path parameter in the uc.Chrome constructor.
print("wde")
with uc.Chrome(use_subprocess=True, driver_executable_path=chromedriver_path) as driver:
    print("wde")
    driver.get("https://lmarena.ai/")
    print("wde")
    # utwórz instancję ChromeOptions dla undetected_chromedriver
    # zainicjalizuj niewykrywalny sterownik Chrome z określonymi opcjami
