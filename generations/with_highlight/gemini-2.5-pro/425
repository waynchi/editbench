import numpy as np
from typing import Dict
from simulator.model.bidder import _Bidder
from simulator.simulation.modules import History
from simulator.model.traffic import Traffic


class Mystique(_Bidder):
    """
    Mystique bidding strategy implementation.

    This bidder uses a control-based approach to pace spending throughout a
    campaign, adjusting bids based on spending error and gradient.
    """
    default_params = {
        'traffic_path': '../data/traffic_share.csv',
        'pf0': 300,
        'C_max': 50,
        'C_min': 5,
        'E_max': 10,
        'E_gmc': 10
    }

    def __init__(self, params: dict = None):
        """
        Initializes the Mystique bidder.

        Args:
            params (dict, optional): Custom parameters to override defaults.
        """
        super().__init__()

        self.day_initial_balance = 0
        self.count = 0

        params = params or {}

        self.traffic = Traffic(
            path=params.get("traffic_path", self.default_params['traffic_path'])
        )
        # self.pf0 = params.get('pf0', self.default_params['pf0'])
        self.C_max = params.get('C_max', self.default_params['C_max'])
        self.C_min = params.get('C_min', self.default_params['C_min'])
        self.E_max = params.get('E_max', self.default_params['E_max'])
        self.E_gmc = params.get('E_gmc', self.default_params['E_gmc'])

        self.balance_previous = np.array([])
        self.bid_previous = np.array([])
        self.timestamp_previous = np.array([])

    def place_bid(self, bidding_input_params: Dict[str, any],
                  history: History) -> float:
        """
        Calculates and places a bid for an ad impression.

        Args:
            bidding_input_params (Dict[str, any]): Parameters for the current bid.
            history (History): Historical data of the campaign (not used).

        Returns:
            float: The calculated bid price.
        """
        self.count += 1
        start = bidding_input_params['campaign_start_time']
        end = bidding_input_params['campaign_end_time']
        initial_balance = bidding_input_params['initial_balance']
        balance = bidding_input_params['balance']
        curr_time = bidding_input_params['curr_time']

        # This implementation tracks its own history instead of using the
        # `history` object provided by the simulator.
        # balance_previous = history.get_balance()
        # bid_previous = history.get_bids()
        # timestamp_previous = history.get_timestamps()

        # On the first bid, use a default value and initialize history.
        if len(self.bid_previous) == 0:
            bid = 300.0  # Default starting bid from original 'pf0'
            self.balance_previous = np.pad(
                self.balance_previous,
                pad_width=[0, 1],
                constant_values=balance
            )
            self.timestamp_previous = np.pad(
                self.timestamp_previous,
                pad_width=[0, 1],
                constant_values=curr_time
            )
            self.bid_previous = np.pad(
                self.bid_previous,
                pad_width=[0, 1],
                constant_values=bid
            )
            return bid

        # --- Main bidding logic for subsequent bids ---
        # NOTE: The logic for updating history arrays is duplicated in the
        # original code. It is consolidated at the end of this method.
        # A variable 'bid' will be calculated and used in the final update.

        # Calculate time-related metrics
        day = (curr_time - start) // (3600 * 24)
        hour = (curr_time - start) // 3600 % 24
        # Use max(1, ...) to avoid division by zero on campaigns < 1 day
        desired_days = max(1, (end - start) // (3600 * 24))
        day_quote = initial_balance / desired_days

        # Calculate target spending based on historical traffic patterns
        region_id = bidding_input_params['region_id']

        hours_in_day = np.arange(start, start + 3600 * 24, 3600)
        traffic_campaign = self.traffic.get_traffic_share(
            region_id, start, start + 3600 * 24
        )
        traffic_list = np.array([
            self.traffic.get_traffic_share(region_id, h, h + 3600)
            for h in hours_in_day
        ])
        if traffic_campaign != 0:
            traffic_list = traffic_list / traffic_campaign
        else:
            traffic_list = np.zeros_like(traffic_list)
        target_spend = day_quote * np.cumsum(traffic_list)

        # Find the balance at the start of the current day ('initial_day_balance')
        hour_previous = [(t - start) // 3600 % 24 for t in self.timestamp_previous]
        if day == 0:
            initial_day_balance = initial_balance
        else:
            # Look for the last day change in recent history
            initial_day_balance = None
            # Iterate backwards from second-to-last entry to avoid index errors
            for i in range(len(hour_previous) - 2,
                           max(-1, len(hour_previous) - 13), -1):
                if hour_previous[i] > hour_previous[i + 1]:
                    # A day change is detected when hour number resets (e.g., 23 -> 0)
                    initial_day_balance = self.balance_previous[i + 1]
                    break
            # If no day change found (e.g., sparse bidding), use the last known balance
            if initial_day_balance is None:
                initial_day_balance = self.balance_previous[-1]

        # ---- Bid Calculation ----
        # Check if spending is too fast (already over daily budget)
        if initial_day_balance - balance >= day_quote:
            # Reduce bid periodically to slow down
            if self.count % 3 != 1:
                bid = self.bid_previous[-1]
            else:
                bid = 0.95 * self.bid_previous[-1]
        else:
            # Calculate spend error (proportional term)
            spend_error = (initial_day_balance - balance - target_spend[int(hour)])

            # Calculate spend gradient error (derivative term)
            if int(hour) > 0:
                desired_gradient = (target_spend[int(hour)] -
                                    target_spend[int(hour) - 1]) / 3600
                time_delta = curr_time - self.timestamp_previous[-1]
                if time_delta > 0:
                    real_gradient = (self.balance_previous[-1] - balance) / time_delta
                else:
                    real_gradient = 0  # No time has passed, no gradient
                gradient_spend_error = real_gradient - desired_gradient
            else:
                gradient_spend_error = 0

            # Calculate tau and weights for the controller
            if gradient_spend_error == 0:
                tau = 1_000_000  # A large number to avoid division by zero
            else:
                tau = -spend_error / gradient_spend_error

            if tau < 0:
                ws = 0.5
                wg = 0.5
            else:
                ws = min(0.9, 0.2 * tau)
                wg = 1 - ws

            # Calculate controller output for error correction
            spend_error_c = min(self.C_max,
                                self.C_max * abs(spend_error) / self.E_max)
            gradient_spend_error_i = min(1, abs(gradient_spend_error))
            gradient_spend_error_c = max(
                self.C_min,
                self.C_max * gradient_spend_error_i / self.E_gmc
            )

            # Apply controller adjustment to bid periodically
            if self.count % 3 != 1:
                bid = self.bid_previous[-1]
            else:
                bid = (self.bid_previous[-1] -
                       ws * spend_error_c * np.sign(spend_error) -
                       wg * gradient_spend_error_c * np.sign(gradient_spend_error))

        # --- Update history and return bid ---
        self.balance_previous = np.pad(
            self.balance_previous,
            pad_width=[0, 1],
            constant_values=balance
        )
        self.timestamp_previous = np.pad(
            self.timestamp_previous,
            pad_width=[0, 1],
            constant_values=curr_time
        )
        self.bid_previous = np.pad(
            self.bid_previous,
            pad_width=[0, 1],
            constant_values=bid
        )

        return bid