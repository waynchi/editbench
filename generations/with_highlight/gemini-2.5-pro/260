import numpy as np

def conjugate_gradient(A, b, x0=None, tol=1e-5, max_iter=1000):
    """
    Решает систему линейных уравнений Ax = b методом сопряжённых градиентов.

    Этот метод подходит для решения систем, где A является симметричной
    и положительно-определённой матрицей.

    Аргументы:
    A (np.ndarray): Квадратная, симметричная, положительно-определённая матрица (n x n).
    b (np.ndarray): Вектор правой части (размер n).
    x0 (np.ndarray, optional): Начальное приближение для x. Если None, используется нулевой вектор.
    tol (float, optional): Допустимая погрешность для нормы невязки, критерий остановки.
    max_iter (int, optional): Максимальное количество итераций.

    Возвращает:
    np.ndarray: Вектор решения x.
    """
    n = len(b)

    # Инициализация начального приближения
    if x0 is None:
        x = np.zeros(n)
    else:
        x = x0.copy()

    # Начальная невязка r = b - A*x
    r = b - A @ x
    
    # Если начальное приближение уже достаточно точное
    if np.linalg.norm(r) < tol:
        return x
        
    # Первое направление спуска p совпадает с невязкой
    p = r.copy()
    
    # Квадрат нормы начальной невязки
    rs_old = np.dot(r, r)

    for i in range(max_iter):
        # Вычисление произведения матрицы на вектор направления
        Ap = A @ p

        # Вычисление оптимального шага alpha
        alpha = rs_old / np.dot(p, Ap)

        # Обновление приближения решения
        x += alpha * p
        
        # Обновление невязки
        r -= alpha * Ap

        # Квадрат нормы новой невязки
        rs_new = np.dot(r, r)

        # Проверка на сходимость
        # Если норма невязки меньше заданной точности, останавливаемся
        if np.sqrt(rs_new) < tol:
            # print(f"Метод сошёлся за {i+1} итераций.")
            break

        # Обновление направления спуска p
        # p = r + (rs_new / rs_old) * p_k
        p = r + (rs_new / rs_old) * p
        
        # Обновление квадрата нормы невязки для следующей итерации
        rs_old = rs_new
    else: # Выполняется, если цикл завершился без break
        print(f"Метод не сошёлся за {max_iter} итераций.")

    return x

# --- Пример использования ---
if __name__ == '__main__':
    # Создаём тестовую симметричную положительно-определённую матрицу A
    A = np.array([[4, 1, 0], 
                  [1, 3, 1], 
                  [0, 1, 5]])

    # Создаём вектор b
    b = np.array([1, 2, 3])

    # Начальное приближение (можно не указывать, тогда будет np.zeros)
    x0 = np.array([0.0, 0.0, 0.0])

    print("Матрица A:\n", A)
    print("\nВектор b:", b)

    # Решаем систему Ax=b
    solution = conjugate_gradient(A, b, x0=x0, tol=1e-9)

    print("\nРешение, найденное методом сопряжённых градиентов:\n", solution)

    # Сравним с точным решением из numpy
    exact_solution = np.linalg.solve(A, b)
    print("\nТочное решение (np.linalg.solve):\n", exact_solution)

    # Проверим невязку нашего решения
    residual_norm = np.linalg.norm(b - A @ solution)
    print(f"\nНорма невязки ||b - A*x||: {residual_norm:.2e}")
