# Wykonywanie klasteryzacji (po etapie 5 i przed etapem 6)
if 'features_transformed' in locals() and features_transformed is not None:
    # Przykład definicji klasteryzacji. 
    # Dostosuj nazwy kolumn do swojego DataFrame 'features_transformed'.
    numerical_cols = features_transformed.select_dtypes(include=np.number).columns.tolist()

    if len(numerical_cols) >= 2:
        # Zdefiniuj, które zestawy kolumn chcesz klastrować i jak nazwać wyniki.
        cluster_definitions = {
            # Przykład 1: Klasteryzacja na podstawie wszystkich cech numerycznych
            'cluster_all_numeric': numerical_cols,
            # Przykład 2: Klasteryzacja na podstawie tylko dwóch pierwszych cech
            'cluster_first_two': numerical_cols[:2]
        }
        
        n_clusters = 3  # Liczba klastrów (dobierz optymalną wartość)
        features_with_clusters = cluster_data(features_transformed, cluster_definitions, n_clusters=n_clusters)
        
        # Wizualizacja wyników dla każdego przeprowadzonego klastrowania
        if features_with_clusters is not None:
            print("\n--- Wizualizacja wyników klasteryzacji ---")
            for cluster_col_name, clustered_cols in cluster_definitions.items():
                if cluster_col_name in features_with_clusters.columns:
                    # Wizualizacja jest możliwa tylko dla co najmniej 2 wymiarów.
                    # Użyjemy pierwszych dwóch kolumn z danego zestawu do wykresu.
                    if len(clustered_cols) >= 2:
                        plt.figure(figsize=(8, 6))
                        scatter = plt.scatter(
                            features_with_clusters[clustered_cols[0]], 
                            features_with_clusters[clustered_cols[1]], 
                            c=features_with_clusters[cluster_col_name], 
                            cmap='viridis'
                        )
                        plt.xlabel(clustered_cols[0])
                        plt.ylabel(clustered_cols[1])
                        plt.title(f'Wyniki klasteryzacji dla: {cluster_col_name}')
                        plt.colorbar(scatter, label='Numer klastra')
                        plt.show()
                    else:
                        print(f"Nie można zwizualizować klastrów dla '{cluster_col_name}', ponieważ użyto mniej niż 2 cechy.")
    else:
        print("Nie znaleziono wystarczającej liczby cech numerycznych do przeprowadzenia klasteryzacji.")
else:
    print("Najpierw wykonaj Krok 5 (Transformacja danych), aby utworzyć DataFrame 'features_transformed'.")