import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

def cluster_data(features_transformed, cluster_definitions, n_clusters=2, clustering_method='kmeans'):
    """
    Wykonuje klasteryzację na wskazanych, niezależnych zestawach kolumn.

    Args:
        features_transformed (pandas.DataFrame): Przekształcony DataFrame z parametrami.
        cluster_definitions (dict): Słownik definiujący zadania klasteryzacji.
                                    Klucze to nazwy dla nowych kolumn z etykietami klastrów.
                                    Wartości to listy/krotki nazw kolumn do użycia w klasteryzacji.
                                    Przykład: {'klaster_A': ['cecha1', 'cecha2'], 'klaster_B': ['cecha3']}
        n_clusters (int): Liczba klastrów do utworzenia. Stosowana do wszystkich zadań klasteryzacji.
        clustering_method (str): Metoda klasteryzacji do użycia ('kmeans').

    Returns:
        pandas.DataFrame: DataFrame z dodanymi kolumnami etykiet klastrów lub None w przypadku błędu.
    """
    if features_transformed is None:
        print("Najpierw wykonaj transformację danych (krok 5).")
        return None

    df_with_clusters = features_transformed.copy()
    print(f"Rozpoczęcie klasteryzacji dla {len(cluster_definitions)} zdefiniowanych zestawów...")

    for cluster_feature_name, columns_to_cluster in cluster_definitions.items():
        print(f"\n--- Przetwarzanie klasteryzacji '{cluster_feature_name}' dla kolumn: {list(columns_to_cluster)} ---")

        # Sprawdzenie, czy wszystkie podane kolumny istnieją w DataFrame
        missing_cols = [col for col in columns_to_cluster if col not in df_with_clusters.columns]
        if missing_cols:
            print(f"Błąd: Brakujące kolumny w DataFrame: {missing_cols}. Pomijanie tego zestawu klasteryzacji.")
            continue

        # Wybór podzbioru danych dla bieżącego zadania klasteryzacji
        features_for_clustering = df_with_clusters[list(columns_to_cluster)]
        
        if features_for_clustering.empty:
            print("Brak danych do klasteryzacji po wybraniu kolumn. Pomijanie.")
            continue

        if clustering_method == 'kmeans':
            model = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
            try:
                cluster_labels = model.fit_predict(features_for_clustering)
            except Exception as e:
                print(f"Błąd podczas dopasowywania modelu KMeans dla '{cluster_feature_name}': {e}")
                continue

            # Ocena jakości klasteryzacji (np. za pomocą współczynnika sylwetki)
            # Sprawdzenie, czy utworzono więcej niż jeden klaster
            if len(np.unique(cluster_labels)) > 1:
                try:
                    silhouette_avg = silhouette_score(features_for_clustering, cluster_labels)
                    print(f"Współczynnik sylwetki dla {n_clusters} klastrów: {silhouette_avg:.4f}")
                except Exception as e:
                    print(f"Nie można obliczyć współczynnika sylwetki: {e}")
            else:
                print("Nie można obliczyć współczynnika sylwetki, ponieważ wszystkie punkty znalazły się w jednym klastrze.")
        
        else:
            print(f"Nieobsługiwana metoda klasteryzacji: '{clustering_method}'. Pomijanie tego zestawu.")
            continue
        
        # Dodanie etykiet klastrów jako nowej kolumny do DataFrame
        df_with_clusters[cluster_feature_name] = cluster_labels
        print(f"Klasteryzacja zakończona. Etykiety dodane do kolumny '{cluster_feature_name}'.")

    return df_with_clusters

