import math

def is_sum_of_four_squares(n):
    """
    Finds one representation of n as a sum of four squares (a^2+b^2+c^2+d^2 = n).
    The squares can be zero. Returns a tuple (a, b, c, d) or False if n is negative.
    This implementation is more efficient than the original's O(n^2) approach.
    """
    if n < 0:
        return False

    # Per Lagrange's four-square theorem, any natural number can be represented
    # as the sum of four integer squares. This function will always find a solution for n >= 0.
    # We use a more efficient search O(n^1.5) by reducing the problem.
    # d^2 = n - a^2 - b^2 - c^2
    limit_a = int(math.sqrt(n))
    for a in range(limit_a + 1):
        a2 = a * a
        limit_b = int(math.sqrt(n - a2))
        for b in range(a, limit_b + 1):
            b2 = b * b
            limit_c = int(math.sqrt(n - a2 - b2))
            for c in range(b, limit_c + 1):
                c2 = c * c
                remainder = n - a2 - b2 - c2
                # We only need to check if the remainder is a perfect square.
                if remainder >= 0:
                    d = int(math.sqrt(remainder))
                    if d * d == remainder:
                        # Found a decomposition. By construction: a <= b <= c <= d.
                        return a, b, c, d
    return None # This is theoretically unreachable for n >= 0

def find_four_squares_sums(limit):
    """
    Finds numbers up to a limit that can be expressed as the sum of four squares
    without any of the squares being zero.
    This implementation efficiently generates the sums directly instead of checking each number.
    """
    results_set = set()

    # We generate sums n = a^2+b^2+c^2+d^2 with a,b,c,d >= 1 and n <= limit.
    # To avoid permutations and redundant calculations, we enforce an order: a >= b >= c >= d >= 1.
    
    if limit < 4: # The smallest sum of four non-zero squares is 1*1+1*1+1*1+1*1 = 4
        return []

    max_a = int(math.sqrt(limit))
    for a in range(1, max_a + 1):
        a2 = a * a
        # Optimization: if the smallest possible sum with 'a' exceeds the limit, stop.
        if a2 + 3 > limit: # Smallest sum is a^2 + 1^2 + 1^2 + 1^2
            break

        for b in range(1, a + 1):
            b2 = b * b
            # Optimization: if the smallest possible sum with 'a' and 'b' exceeds the limit, stop this inner loop.
            if a2 + b2 + 2 > limit: # Smallest sum is a^2 + b^2 + 1^2 + 1^2
                break
            
            for c in range(1, b + 1):
                c2 = c * c
                # Optimization
                if a2 + b2 + c2 + 1 > limit: # Smallest sum is a^2 + b^2 + c^2 + 1^2
                    break

                for d in range(1, c + 1):
                    d2 = d * d
                    current_sum = a2 + b2 + c2 + d2

                    if current_sum > limit:
                        break # Since d increases, all further sums in this loop will also exceed the limit.
                    
                    results_set.add(current_sum)
    
    return sorted(list(results_set))

# Example usage:
limit = int(input("Digite o limite superior: "))
sums_found = find_four_squares_sums(limit)
print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
for num in sums_found:
    result = is_sum_of_four_squares(num)
    a, b, c, d = result
    print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")