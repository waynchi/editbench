import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self):
        """
        Initializes the network layers.
        The constructor is now self-contained and dynamically calculates the
        size for the linear layer, making the model runnable without needing
        to pass external arguments. It assumes a sample input size (e.g., 32x32)
        for this calculation.
        """
        super().__init__()

        # Feature extraction part of the network (convolutional layers)
        self.features = nn.Sequential(
            nn.Conv2d(in_channels=3, out_channels=32, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2),
            nn.Conv2d(in_channels=32, out_channels=64, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )

        # To fix the original code, we must determine the input size
        # for the first linear layer. We can do this automatically by performing
        # a dummy forward pass with a sample input tensor.
        # Let's assume a common input image size of 32x32 pixels.
        with torch.no_grad():
            dummy_input = torch.zeros(1, 3, 32, 32)
            dummy_output = self.features(dummy_input)
            flattened_size = dummy_output.view(1, -1).shape[1]
            # For a 32x32 input, flattened_size will be 64*6*6 = 2304

        # Classifier part of the network (fully connected layers)
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(flattened_size, 512),
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        """Defines the forward pass of the network."""
        x = self.features(x)
        x = self.classifier(x)
        return x
