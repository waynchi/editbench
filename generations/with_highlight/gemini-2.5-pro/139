_four_squares_cache = {}

def is_sum_of_four_squares(n):
    """
    Returns the representation of n as a sum of four non-zero squares from a pre-computed cache.
    The cache is populated by find_four_squares_sums.
    """
    return _four_squares_cache.get(n)

def find_four_squares_sums(limit):
    """找到所有可以表示为四个非零平方和的数字。"""
    global _four_squares_cache
    _four_squares_cache.clear()  # Clear cache for the new run

    if limit < 4:
        return []

    # Step 1: Efficiently compute all sums of two non-zero squares up to limit
    # and store them in a dictionary for quick lookup. {sum: (a, b)}
    sums_of_two = {}
    max_val = int(limit**0.5)
    for i in range(1, max_val + 1):
        for j in range(i, max_val + 1):
            s = i*i + j*j
            if s > limit:
                break
            if s not in sums_of_two:
                sums_of_two[s] = (i, j)

    # Step 2: Combine pairs of "sums of two squares" to find sums of four.
    # This generates all target numbers and their decompositions in one pass.
    two_sums_keys = sorted(sums_of_two.keys())
    for i in range(len(two_sums_keys)):
        s1 = two_sums_keys[i]
        for j in range(i, len(two_sums_keys)): # Iterate from i to ensure s1 <= s2
            s2 = two_sums_keys[j]
            n = s1 + s2
            if n > limit:
                break  # Since the list is sorted, no further sums will be in the limit
            if n not in _four_squares_cache:
                a, b = sums_of_two[s1]
                c, d = sums_of_two[s2]
                # Store the decomposition in the cache for is_sum_of_four_squares to use
                _four_squares_cache[n] = tuple(sorted((a, b, c, d)))
    
    # Return a sorted list of the numbers found, as expected by the calling code.
    return sorted(_four_squares_cache.keys())

# 示例用法：
limit = int(input("Digite o limite superior: "))
sums_found = find_four_squares_sums(limit)
print("Números que podem ser expressos como a soma de quatro quadrados não nulos:")
for num in sums_found:
    result = is_sum_of_four_squares(num)
    a, b, c, d = result
    print(f"{num} = {a}^2 + {b}^2 + {c}^2 + {d}^2")