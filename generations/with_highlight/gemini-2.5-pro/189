import torch
import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self):
        super().__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(in_channels=3, out_channels=32, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(in_channels=32, out_channels=64, kernel_size=3),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )

        self.flatten = nn.Flatten()
        
        # The original code required the user to manually calculate and pass `flattened_size`,
        # which is not robust. This is fixed by making the model assume a fixed input size
        # (e.g., 32x32) and calculating the size internally.
        # For a 32x32 input image:
        # After conv1 + pool: ((32-3+1)/2) = 15x15. Shape: (N, 32, 15, 15)
        # After conv2 + pool: floor(((15-3+1)/2)) = 6x6. Shape: (N, 64, 6, 6)
        # Flattened size = 64 * 6 * 6 = 2304.
        self.fc1 = nn.Sequential(
            nn.Linear(64 * 6 * 6, 512),  # Use the calculated size
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x