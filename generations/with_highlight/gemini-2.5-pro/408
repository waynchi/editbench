import { useReducer, useEffect, useCallback, useMemo } from 'react';

// Define initial state and reducer outside the hook for better performance and readability.
const initialDateRange = {
  startDate: (() => {
    const date = new Date();
    date.setFullYear(date.getFullYear() - 1);
    return date;
  })(),
  endDate: new Date(),
};

const initialState = {
  customerData: { summary: null, customers: [] },
  websiteCheckInProgress: false,
  stripeApiKey: null, // Use null to indicate not loaded yet. An empty string is a valid (but empty) key.
  dateRange: initialDateRange,
  isLoading: {
    settings: false,
    customers: false,
  },
  error: null,
};

function dashboardReducer(state, action) {
  switch (action.type) {
    case 'FETCH_SETTINGS_START':
      return { ...state, isLoading: { ...state.isLoading, settings: true }, error: null };
    case 'FETCH_SETTINGS_SUCCESS':
      return { ...state, isLoading: { ...state.isLoading, settings: false }, stripeApiKey: action.payload };
    case 'FETCH_SETTINGS_ERROR':
      return { ...state, isLoading: { ...state.isLoading, settings: false }, error: action.payload };

    case 'FETCH_DATA_START':
      return { ...state, isLoading: { ...state.isLoading, customers: true }, error: null };
    case 'FETCH_DATA_SUCCESS':
      return {
        ...state,
        isLoading: { ...state.isLoading, customers: false },
        customerData: {
          summary: action.payload,
          customers: action.payload.customers,
        },
      };
    case 'FETCH_DATA_ERROR':
      return { ...state, isLoading: { ...state.isLoading, customers: false }, error: action.payload };

    case 'CHECK_WEBSITES_START':
      return { ...state, websiteCheckInProgress: true, error: null };
    case 'CHECK_WEBSITES_SUCCESS': {
      const updatedCustomers = action.payload;
      const newSummary = {
        ...state.customerData.summary,
        customers: updatedCustomers,
        active: updatedCustomers.filter((c) => c.status === 'active').length,
        churned: updatedCustomers.filter((c) => c.status === 'churned').length,
      };
      return {
        ...state,
        websiteCheckInProgress: false,
        customerData: { summary: newSummary, customers: updatedCustomers },
      };
    }
    case 'CHECK_WEBSITES_ERROR':
      return { ...state, websiteCheckInProgress: false, error: action.payload };

    case 'SET_DATE_RANGE':
      if (action.payload.startDate > action.payload.endDate) {
        return { ...state, error: 'Start date cannot be after end date' };
      }
      return { ...state, dateRange: action.payload, error: null };

    case 'CLEAR_ERROR':
      return { ...state, error: null };

    default:
      throw new Error(`Unhandled action type: ${action.type}`);
  }
}

function useDashboardData(user) {
  const [state, dispatch] = useReducer(dashboardReducer, initialState);

  // Memoize derived data to avoid re-calculating on every render.
  // This calculation is now more efficient (O(C+M) vs O(C*M)).
  const healthData = useMemo(() => {
    if (!state.customerData?.customers?.length) return [];
    
    const customerGroups = new Map();
    // Group customers by 'year-month' for efficient lookup.
    for (const customer of state.customerData.customers) {
      const customerDate = new Date(customer.created);
      const key = `${customerDate.getFullYear()}-${customerDate.getMonth()}`;
      if (!customerGroups.has(key)) {
        customerGroups.set(key, []);
      }
      customerGroups.get(key).push(customer);
    }

    const monthsData = [];
    const currentDate = new Date(state.dateRange.startDate);
    currentDate.setDate(1); // Align to the start of the month for iteration.

    while (currentDate <= state.dateRange.endDate) {
      const year = currentDate.getFullYear();
      const monthIndex = currentDate.getMonth();
      const key = `${year}-${monthIndex}`;
      const monthCustomers = customerGroups.get(key) || [];
      
      monthsData.push({
        monthYear: `${currentDate.toLocaleString("default", { month: "short" })} ${year}`,
        healthy: monthCustomers.filter((c) => c.status === "active").length,
        warning: monthCustomers.filter((c) => c.status === "churned").length,
        critical: monthCustomers.filter((c) => c.status === "delinquent").length,
      });

      currentDate.setMonth(currentDate.getMonth() + 1);
    }
    return monthsData;
  }, [state.customerData.customers, state.dateRange]);

  // Memoized async actions. Dispatch is stable and doesn't need to be in deps.
  const loadSettings = useCallback(async () => {
    if (!user?.id) return;
    dispatch({ type: 'FETCH_SETTINGS_START' });
    try {
      const response = await fetch("/api/db/churnary_user_settings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query: "SELECT stripe_api_key FROM `user_settings` WHERE `user_id` = ? LIMIT 1",
          values: [user.id],
        }),
      });

      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      const settings = await response.json();
      dispatch({ type: 'FETCH_SETTINGS_SUCCESS', payload: settings[0]?.stripe_api_key || "" });
    } catch (error) {
      dispatch({ type: 'FETCH_SETTINGS_ERROR', payload: "Failed to load user settings" });
    }
  }, [user?.id]);

  const loadData = useCallback(async () => {
    // This function now only runs when user and a valid stripe key are present.
    if (!user?.id || !state.stripeApiKey) return;
    
    dispatch({ type: 'FETCH_DATA_START' });
    try {
      const response = await fetch("/api/stripe-customer-summary", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: user.id }),
      });

      if (!response.ok) throw new Error("Failed to fetch customer summary");
      const summary = await response.json();
      if (summary.error) throw new Error(summary.error);

      dispatch({ type: 'FETCH_DATA_SUCCESS', payload: summary });
    } catch (error) {
      dispatch({ type: 'FETCH_DATA_ERROR', payload: error.message });
    }
  }, [user?.id, state.stripeApiKey]);

  // Effects to trigger data loading.
  useEffect(() => {
    loadSettings();
  }, [loadSettings]);

  useEffect(() => {
    // Load data only after settings (API key) are loaded.
    loadData();
  }, [loadData]); // loadData's dependency array includes user.id and stripeApiKey

  // Memoize actions object to provide a stable reference to consumers.
  const actions = useMemo(() => ({
    checkWebsites: async () => {
      if (!state.customerData.customers?.length) return;

      dispatch({ type: 'CHECK_WEBSITES_START' });
      try {
        const updatedCustomers = await Promise.all(
          state.customerData.customers.map(async (customer) => {
            const response = await fetch("/api/website-churn-detector", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ websiteUrl: customer.website }),
            });
            const health = await response.json();
            return { ...customer, health, status: health.status === "active" ? "active" : "churned" };
          })
        );
        dispatch({ type: 'CHECK_WEBSITES_SUCCESS', payload: updatedCustomers });
      } catch (err) {
        dispatch({ type: 'CHECK_WEBSITES_ERROR', payload: "Failed to check websites. Please try again." });
      }
    },
    setDateRange: (range) => dispatch({ type: 'SET_DATE_RANGE', payload: range }),
    clearError: () => dispatch({ type: 'CLEAR_ERROR' }),
  }), [state.customerData.customers]);
  
  // Re-create the original `data` object structure for backward compatibility.
  const data = useMemo(() => ({
    customerData: {
      summary: state.customerData.summary,
      customers: state.customerData.customers,
      loading: state.isLoading.customers,
    },
    healthData: healthData,
    websiteStatus: {
      checking: state.websiteCheckInProgress,
    },
    stripeApiKey: state.stripeApiKey,
    dateRange: state.dateRange,
    error: state.error,
  }), [state, healthData]);

  // The original isLoading flag was a combination of two specific loading states.
  const isLoading = state.isLoading.customers || state.websiteCheckInProgress;

  return { 
    data, 
    actions,
    isLoading,
  };
}

export default useDashboardData;