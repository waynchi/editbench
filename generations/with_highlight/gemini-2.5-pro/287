def medcouple(data):
    data = np.sort(data)
    n = len(data)
    median = np.median(data)

    # Разделить данные на левую и правую части относительно медианы
    left = data[data <= median]
    right = data[data >= median]

    # Векторизованное ядро функции h(xi, xj)
    def h(xi, xj):
        numerator = (xj - median) - (median - xi)
        denominator = xj - xi
        # Использовать np.where для обработки массивов и избежания деления на ноль
        return np.where(denominator != 0, numerator / denominator, 0)

    # Векторизованное специальное ядро для случаев с повторяющимися медианами
    def special_h(i, j, k):
        # Логика if/elif/else эквивалентна функции np.sign
        return np.sign(i + j - 1 - k)

    # Сгенерировать все возможные h(xi, xj)
    k = len(data[data == median])  # Количество повторяющихся медианных значений

    # Используйте трансляцию numpy для повышения эффективности
    xi, xj = np.meshgrid(left, right, indexing='ij')

    if k > 1:
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        i, j = np.meshgrid(left_indices, right_indices, indexing='ij')
        # np.where вызывает функции-аргументы со всем массивом,
        # поэтому эти функции должны быть векторизованы, чтобы избежать ошибки ValueError.
        h_matrix = np.where((xi == median) & (xj == median), special_h(i, j, k), h(xi, xj))
    else:
        h_matrix = h(xi, xj)

    # Развернуть матрицу и вычислить медиану значений h
    return np.median(h_matrix.flatten())

def adjusted_boxplot_bounds(data):
    """Вычисляет границы скорректированного boxplot с учетом skewness-adjusted fences."""
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """Нормализация с использованием скорректированного ящичного графика."""
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

