import random
import logging
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.common.exceptions import NoSuchElementException, WebDriverException
import time

class SearchModule:
    def __init__(self, driver, config):
        self.driver = driver
        self.config = config
        self.search_engine = config.get('Search', 'search_engine')
        self.queries = [q.strip() for q in config.get('Search', 'queries').split(',')]
        self.random_query = config.getboolean('Search', 'random_query')

    def perform_search(self):
        query = random.choice(self.queries) if self.random_query else self.queries[0]
        logging.info(f"Performing search with query: {query}")

        try:
            if self.search_engine.lower() == 'google':
                self.driver.get("https://www.google.com")
                search_box = self.driver.find_element(By.NAME, "q")
            elif self.search_engine.lower() == 'yandex':
                self.driver.get("https://ya.ru")
                search_box = self.driver.find_element(By.CSS_SELECTOR, 'input[placeholder="Найдётся всё"]')
            elif self.search_engine.lower() == 'bing':
                self.driver.get("https://www.bing.com")
                search_box = self.driver.find_element(By.NAME, "q")
            else:
                logging.error("Unsupported search engine.")
                return

            search_box.send_keys(query + Keys.RETURN)
            time.sleep(random.uniform(2, 4))  # Oczekiwanie na załadowanie wyników

        except NoSuchElementException:
            logging.error(f"Search box not found on {self.search_engine}. The page layout may have changed.")
        except WebDriverException as e:
            logging.error(f"A WebDriver error occurred during the search on {self.search_engine}: {e}")
        except Exception as e:
            logging.error(f"An unexpected error occurred during the search: {e}")

    def navigate_random_link(self):
        logging.info("Navigating to a random search result link.")
        try:
            links = []
            if self.search_engine.lower() == 'google':
                links = self.driver.find_elements(By.CSS_SELECTOR, 'div.yuRUbf > a')
            elif self.search_engine.lower() == 'yandex':
                links = self.driver.find_elements(By.CSS_SELECTOR, 'a.link')
            elif self.search_engine.lower() == 'bing':
                links = self.driver.find_elements(By.CSS_SELECTOR, 'li.b_algo h2 a')
            else:
                logging.error("Unsupported search engine.")
                return

            if not links:
                logging.warning("No links found on the search results page.")
                return

            random_link = random.choice(links)
            href = random_link.get_attribute('href')

            if not href:
                logging.warning("Found a link element without an href attribute. Skipping navigation.")
                return

            logging.info(f"Navigating to: {href}")
            self.driver.get(href)
            time.sleep(random.uniform(3, 6))  # Oczekiwanie na załadowanie strony

        except WebDriverException as e:
            # Check if 'href' was assigned before the error occurred for better logging
            href_val = locals().get('href', 'an unknown link')
            logging.error(f"Failed to navigate to {href_val}: {e}")
        except IndexError:
            # This is a fallback, the 'if not links' check should prevent this.
            logging.warning("Attempted to select a link from an empty list of results.")
        except Exception as e:
            logging.error(f"An unexpected error occurred while navigating to a link: {e}")