# Write get_task_list to get a list of *.xml file names from the folder settings['taskPath'].
# In the first line of each file, an optional string is recorded: <!-- comment -->
# Present the response in the format of a list of objects {fileName, comment, file_date_str}
@eel.expose
def get_task_list(settings):
    from datetime import datetime
    path = settings.get('taskPath')
    if not path or not os.path.isdir(path):
        print(f"Error: Task path '{path}' is not a valid directory.")
        return []

    task_list = []
    try:
        # Get a list of all .xml files in the directory
        files = [f for f in os.listdir(path) if f.endswith('.xml') and os.path.isfile(os.path.join(path, f))]

        for file_name in files:
            full_path = os.path.join(path, file_name)
            comment = ""
            
            try:
                # Read the first line to find an optional comment
                with open(full_path, 'r', encoding='utf-8') as f:
                    first_line = f.readline().strip()
                    match = re.match(r'<!--\s*(.*?)\s*-->', first_line)
                    if match:
                        comment = match.group(1)
            except Exception as e:
                print(f"Warning: Could not read or parse comment from {file_name}: {e}")

            # Get file modification date
            try:
                mod_time = os.path.getmtime(full_path)
                file_date_str = datetime.fromtimestamp(mod_time).strftime('%Y-%m-%d %H:%M:%S')
            except OSError as e:
                print(f"Warning: Could not get modification date for {file_name}: {e}")
                file_date_str = "N/A"

            task_list.append({
                'fileName': file_name,
                'comment': comment,
                'file_date_str': file_date_str
            })
        
        # Sort the list by date, newest first
        task_list.sort(key=lambda x: x.get('file_date_str', '0'), reverse=True)
        
        return task_list

    except Exception as e:
        print(f"Error getting task list from '{path}': {e}")
        return []


