import os
# import hashlib
# import base64

project_name = "CheckerKMV"


def createLicense(secretKey: str) -> None:
    # Ścieżka do folderu projektu w %appdata%
    # Note: os.environ["APPDATA"] usually points to the Roaming folder, not Local.
    # For the Local folder, os.environ["LOCALAPPDATA"] would be used.
    appdata_path = os.path.join(os.environ["APPDATA"], project_name)

    if not os.path.exists(appdata_path):
        os.makedirs(appdata_path)

    # The file is opened in binary write mode ("wb"), which requires bytes.
    # The input `secretKey` is a string, so it must be encoded to bytes before writing.
    with open(os.path.join(appdata_path, "license.dat"), "wb") as f:
        f.write(secretKey.encode('utf-8'))
