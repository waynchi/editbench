# New function added as per user instruction to build a hierarchical dictionary
def build_discussion_hierarchy(comment_object: Comment) -> dict:
    """
    Recursively builds a hierarchical dictionary for a given post or comment.

    :param comment_object: A beem.comment.Comment object to process.
    :return: A dictionary representing the comment and its nested replies.
    """
    # Create a node for the current comment/post
    node = {
        'author': comment_object['author'],
        'permlink': comment_object['permlink'],
        'body': comment_object['body'],
        'created': str(comment_object['created']),
        'replies': []  # A list to hold the children (replies)
    }

    # Fetch all replies for the current comment
    replies = comment_object.get_replies()

    # Recursively call this function for each reply to build the tree structure
    for reply in replies:
        # Optional: You can filter replies here, for example, by a ban list.
        if is_banned(reply['author']):
            continue
        node['replies'].append(build_discussion_hierarchy(reply))

    return node


