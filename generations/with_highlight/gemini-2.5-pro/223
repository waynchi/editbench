import numpy as np
from typing import Dict
from simulator.model.bidder import _Bidder
from simulator.simulation.modules import History
from simulator.model.traffic import Traffic


class Mystique(_Bidder):
    """
    Mystique bidding agent implementation.

    This bidder uses a PID-like controller to adjust bids based on spending
    pace and traffic patterns.
    """
    default_params = {
        'traffic_path': '../data/traffic_share.csv',
        'pf0': 300,
        'C_max': 50,
        'C_min': 5,
        'E_max': 10,
        'E_gmc': 10
    }

    def __init__(self, params: dict = None):
        """Initializes the Mystique bidder."""
        super().__init__()

        self.day_initial_balance = 0
        self.count = 0

        params = params or {}

        # Initialize parameters
        traffic_path = params.get("traffic_path",
                                  self.default_params['traffic_path'])
        self.traffic = Traffic(path=traffic_path)
        # self.pf0 = params.get('pf0', self.default_params['pf0'])
        self.C_max = params.get('C_max', self.default_params['C_max'])
        self.C_min = params.get('C_min', self.default_params['C_min'])
        self.E_max = params.get('E_max', self.default_params['E_max'])
        self.E_gmc = params.get('E_gmc', self.default_params['E_gmc'])

        # Initialize history arrays
        self.balance_previous = np.array([])
        self.bid_previous = np.array([])
        self.timestamp_previous = np.array([])

    def _update_history(self, balance: float, curr_time: int, bid: float):
        """Appends the latest bid results to the internal history arrays."""
        self.balance_previous = np.pad(
            self.balance_previous,
            pad_width=[0, 1],
            constant_values=balance,
        )
        self.timestamp_previous = np.pad(
            self.timestamp_previous,
            pad_width=[0, 1],
            constant_values=curr_time,
        )
        self.bid_previous = np.pad(
            self.bid_previous,
            pad_width=[0, 1],
            constant_values=bid,
        )

    def place_bid(self, bidding_input_params: Dict[str, any],
                  history: History) -> float:
        """
        Places a bid based on campaign progress and traffic patterns.

        Args:
            bidding_input_params: A dictionary of parameters for the bid.
            history: The campaign history (not used by this implementation which
                     maintains its own history).

        Returns:
            The calculated bid value.
        """
        self.count += 1
        start = bidding_input_params['campaign_start_time']
        end = bidding_input_params['campaign_end_time']
        initial_balance = bidding_input_params['initial_balance']
        balance = bidding_input_params['balance']
        curr_time = bidding_input_params['curr_time']

        # NOTE: This implementation uses its own history arrays instead of the
        # `history` object.
        # balance_previous = history.get_balance()
        # bid_previous = history.get_bids()
        # timestamp_previous = history.get_timestamps()

        if len(self.bid_previous) == 0:
            # For the first bid, use a default value and initialize history.
            bid = 300.0  # self.pf0
            self._update_history(balance, curr_time, bid)
            return bid

        # Calculate campaign time progress
        # desired_hours = (end - start) // 3600  # unused
        day = (curr_time - start) // 3600 // 24
        hour = (curr_time - start) // 3600 % 24
        campaign_duration_days = (end - start) // 3600 // 24

        if campaign_duration_days == 0:
            # Avoid division by zero if campaign is less than a day
            campaign_duration_days = 1
        day_quote = initial_balance / campaign_duration_days

        # Get traffic forecast for setting spending targets
        region_id = bidding_input_params['region_id']
        # logical_category = bidding_input_params['logical_category']  # unused
        first_day_end = start + 3600 * 24
        traffic_campaign = self.traffic.get_traffic_share(
            region_id, start, first_day_end)
        hours_in_day = np.arange(start, first_day_end, 3600)

        traffic_list = np.array([
            self.traffic.get_traffic_share(region_id, h, h + 3600)
            for h in hours_in_day
        ])

        if traffic_campaign != 0:
            traffic_list = traffic_list / traffic_campaign
        else:
            traffic_list = np.zeros_like(traffic_list)

        target_spend = day_quote * np.cumsum(traffic_list)

        # Find the balance at the beginning of the current day
        hour_previous = [(t - start) // 3600 % 24
                         for t in self.timestamp_previous]
        initial_day_balance = None
        if day == 0:
            initial_day_balance = initial_balance
        else:
            # If the prev hour was later in the day, we've just crossed midnight
            if hour_previous[-1] > hour:
                initial_day_balance = self.balance_previous[-1]
            else:
                # Look back to find the balance at the start of the day
                # (when the hour number decreased, e.g., from 23 to 0)
                # Search up to 12 previous records to find the day change.
                search_start = len(hour_previous) - 1
                search_end = max(0, len(hour_previous) - 12)
                for i in range(search_start, search_end, -1):
                    if hour_previous[i] < hour_previous[i - 1]:
                        initial_day_balance = self.balance_previous[i]
                        break

        # Fallback if start-of-day balance wasn't found in recent history
        if initial_day_balance is None:
            initial_day_balance = self.balance_previous[-1]

        # If today's spend has already exceeded the daily budget, reduce bid
        if initial_day_balance - balance >= day_quote:
            if self.count % 3 != 1:
                bid = self.bid_previous[-1]
            else:
                bid = 0.95 * self.bid_previous[-1]
            self._update_history(balance, curr_time, bid)
            return bid

        # PID-like control logic
        # Calculate proportional error (spend_error)
        spend_error = (initial_day_balance - balance -
                       target_spend[int(hour)])

        # Calculate derivative error (gradient_spend_error)
        time_delta = curr_time - self.timestamp_previous[-1]
        if int(hour) > 0 and time_delta > 0:
            desired_gradient = (target_spend[int(hour)] -
                                target_spend[int(hour) - 1]) / 3600
            real_gradient = (self.balance_previous[-1] - balance) / time_delta
            gradient_spend_error = real_gradient - desired_gradient
        else:
            gradient_spend_error = 0

        # Calculate tau and weights (ws, wg) for proportional/derivative terms
        if gradient_spend_error == 0:
            tau = 1_000_000  # A large number to represent infinity
        else:
            tau = -spend_error / gradient_spend_error

        if tau < 0:
            ws = 0.5
            wg = 0.5
        else:
            ws = min(0.9, 0.2 * tau)
            wg = 1 - ws

        # Scale the error components
        spend_error_c = min(self.C_max, self.C_max * abs(spend_error) /
                            self.E_max)
        gradient_spend_error_i = min(1, abs(gradient_spend_error))
        gradient_spend_error_c = max(
            self.C_min,
            (self.C_max * gradient_spend_error_i / self.E_gmc)
        )

        # Update bid based on errors (only every 3rd call to avoid jitter)
        if self.count % 3 != 1:
            bid = self.bid_previous[-1]
        else:
            bid = (self.bid_previous[-1] -
                   ws * spend_error_c * np.sign(spend_error) -
                   wg * gradient_spend_error_c * np.sign(gradient_spend_error))

        self._update_history(balance, curr_time, bid)
        return bid