import random
import torch
from torchvision import transforms
from datasets import load_dataset
from PIL import Image
import numpy as np

class AlignmentDatasetCreator:
    def __init__(self, sample_size=1000):
        self.sample_size = sample_size
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                              std=[0.229, 0.224, 0.225])
        ])
    def create_unrelated_pairs(self, image_text_pairs):
        """Crea pares de imagen-texto no relacionados al mezclar las descripciones de texto"""
        images, texts = zip(*image_text_pairs)
        original_texts = list(texts)
        shuffled_texts = list(texts)
        # Asegurarse de que ningún texto se empareje con su imagen original después de mezclar
        while any(orig == shuf for orig, shuf in zip(original_texts, shuffled_texts)):
            random.shuffle(shuffled_texts)
        return list(zip(images, shuffled_texts))

    def create_textual_pairs(self, dataset_name='quora'):
        """Crea pares de texto semánticamente similares utilizando conjuntos de datos de paráfrasis"""
        # Se usa streaming para buscar eficientemente hasta encontrar la cantidad deseada de pares.
        dataset = load_dataset(dataset_name, split='train', streaming=True)
        textual_pairs = []
        for item in dataset:
            if len(textual_pairs) >= self.sample_size:
                break
            if item.get('is_duplicate') == 1:
                pair = (item['question1'], item['question2'])
                textual_pairs.append(pair)
        return textual_pairs

    def create_visual_pairs(self, image_text_pairs):
        """Crea pares de imágenes aumentadas manteniendo el significado semántico"""
        augmentation_transforms = transforms.Compose([
            transforms.RandomHorizontalFlip(p=1.0),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.RandomRotation(15)
        ])
        
        visual_pairs = []
        for image, _ in image_text_pairs:
            if isinstance(image, Image.Image):
                augmented = augmentation_transforms(image)
                visual_pairs.append((image, augmented))
        return visual_pairs

    def load_mscoco_dataset(self):
        """Carga y preprocesa el conjunto de datos MSCOCO con filtrado mejorado"""
        # Se cambia a un conjunto de datos más estable ('nlpconnect/mscoco_captions') 
        # y se elimina el streaming para solucionar el FileNotFoundError.
        # Se carga una porción mayor del conjunto de datos para asegurar que se obtenga
        # el número de muestras deseado después del filtrado.
        # El factor de 2 es heurístico; puede necesitar ajuste si el filtrado es muy agresivo.
        initial_load_size = self.sample_size * 2
        try:
            dataset = load_dataset(
                "nlpconnect/mscoco_captions",
                split=f'train[:{initial_load_size}]'
            )
        except Exception as e:
            print(f"Failed to load dataset. Error: {e}")
            print("Please ensure you have an internet connection and the `datasets` library is up to date.")
            return []

        image_text_pairs = []
        for item in dataset:
            if len(image_text_pairs) >= self.sample_size:
                break
            
            caption = item.get("caption")
            image = item.get("image")

            if image is None or caption is None:
                continue

            # Filtrar las leyendas demasiado cortas
            if len(caption.split()) >= 5:
                # Asegurar que la imagen esté en formato RGB para la coherencia de las transformaciones
                if image.mode != 'RGB':
                    image = image.convert('RGB')
                image_text_pairs.append((image, caption))
                
        return image_text_pairs

def main():
    # Inicializar creador de conjunto de datos
    creator = AlignmentDatasetCreator(sample_size=100)
    
    # Cargar y crear conjuntos de datos
    print("Loading MSCOCO dataset...")
    image_text_pairs = creator.load_mscoco_dataset()
    if not image_text_pairs:
        print("Could not load image-text pairs. Exiting.")
        return
    
    print("Creating unrelated pairs...")
    unrelated_pairs = creator.create_unrelated_pairs(image_text_pairs)
    
    print("Creating textual pairs...")
    textual_pairs = creator.create_textual_pairs()
    
    print("Creating visual pairs...")
    visual_pairs = creator.create_visual_pairs(image_text_pairs)
    
    # Imprimir muestra de cada conjunto de datos
    print("\nDataset Samples:")
    if image_text_pairs:
        print(f"Image-Text Pair: ({type(image_text_pairs[0][0])}, '{image_text_pairs[0][1]}')")
    if unrelated_pairs:
        print(f"Unrelated Pair: ({type(unrelated_pairs[0][0])}, '{unrelated_pairs[0][1]}')")
    if textual_pairs:
        print(f"Textual Pair: {textual_pairs[0]}")
    if visual_pairs:
        print(f"Visual Pair: ({type(visual_pairs[0][0])}, {type(visual_pairs[0][1])})")


if __name__ == "__main__":
    main()