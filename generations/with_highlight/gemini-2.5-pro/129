# currency class
class valute():
    """Currency and everything related to it, through the Central Bank of Russia

Required libraries:

requests

xml.etree.ElementTree

datetime

pickle

json"""
    def __init__(self, name):
        self.name = name
    async def correct_name(self):
        """Checking the currency name for presence in the set of currencies. The set is updated no more than once a day."""
        info_path = r"D:\MoexAPI_bot_aiogram3\data_files\Info.json"
        valutes_path = r"D:\MoexAPI_bot_aiogram3\data_files\set_valutes.bin"
        update_needed = False
        info = {}

        try:
            # open the info file, encoding to avoid issues
            async with aiofiles.open(info_path, "r", encoding="utf-8") as info_opened_file:
                content = await info_opened_file.read()
                info = json.loads(content)
            # checking the condition that the date of the currency list update is at least 1 day ago
            if datetime.datetime.now() - datetime.timedelta(days=1) > datetime.datetime.strptime(info["last_day_check"]["valute"], "%Y-%m-%d %H:%M:%S.%f"):
                update_needed = True
        except (FileNotFoundError, json.JSONDecodeError, KeyError):
            # Force an update if the info file doesn't exist, is corrupt, or is missing data.
            # This robustly handles the first-run scenario.
            update_needed = True
            info = {"last_day_check": {}}  # Re-initialize info to ensure the structure exists

        if update_needed:
            # if it differs by more than 1 day, then rewrite the list (set) of currencies:
            set_valutes = set() # create an empty set, we will fill it with currencies
            s = "http://www.cbr.ru/scripts/XML_daily.asp"
            async with aiohttp.ClientSession() as session:
                async with session.get(s) as response:
                    content = await response.read()
            
            root = xml.etree.ElementTree.fromstring(content) # The request still returns the site data as a string, so fromstring is necessary.
            for Valute in root.findall("Valute"):
                CharCode = Valute.find("CharCode")
                set_valutes.add(CharCode.text) # pouring currencies into our set

            # open the file for binary writing of the set of tickers into it
            async with aiofiles.open(valutes_path, "wb") as set_valutes_file_opened:
                # Put the created set into the file. If anything, it will be overwritten each time (verified)
                await set_valutes_file_opened.write(pickle.dumps(set_valutes))
            # close the file (handled by 'async with')

            # change the last update time
            info["last_day_check"]["valute"] = str(datetime.datetime.now())
            async with aiofiles.open(info_path, "w", encoding="utf-8") as info_opened_file:
                # write a new file
                await info_opened_file.write(json.dumps(info, indent = 3, ensure_ascii = False))
            # close the file (handled by 'async with')

        # now just check if the currency is in the list of currencies
        # open the file with multiple tickers to get it from there
        async with aiofiles.open(valutes_path, "rb") as set_valutes_file_opened: 
            # from the opened file, unload the value of the set of currencies into a variable. If multiple sets are recorded (which should not happen), only the first one will be opened
            set_valutes = pickle.loads(await set_valutes_file_opened.read())
        
        if self.name in set_valutes: # just check if the currency is in the set of tickers
            return True
        else:
            return False
    def CurrentExchangeRate(self):
        '''Current exchange rate of the currency to ruble'''
        r = requests.get("http://www.cbr.ru/scripts/XML_daily.asp") # CB RF API
        root = xml.etree.ElementTree.fromstring(r.content)
        for Valute in root.findall("Valute"): # searching for currency containers
            for CharCode in Valute.findall("CharCode"): # searching for charcode containers
                if CharCode.text == self.name: # find the container with the required currency
                    return (Valute.find("VunitRate").text)