from collections import deque

class Graph:
    def __init__(self):
        self.adjacency_list = {}

    def add_vertex(self, vertex):
        if vertex not in self.adjacency_list:
            self.adjacency_list[vertex] = []

    def add_edge(self, vertex1, vertex2):
        if vertex1 in self.adjacency_list and vertex2 in self.adjacency_list:
            self.adjacency_list[vertex1].append(vertex2)
            self.adjacency_list[vertex2].append(vertex1)

    def __str__(self):
        return str(self.adjacency_list)

    def remove_vertex(self, vertex):
        if vertex in self.adjacency_list:
            # Iterating over a copy is safer, as remove_edge modifies the list.
            for neighbor in list(self.adjacency_list[vertex]):
                self.remove_edge(vertex, neighbor)
            del self.adjacency_list[vertex]

    def remove_edge(self, vertex1, vertex2):
        if vertex1 in self.adjacency_list and vertex2 in self.adjacency_list:
            # Use try-except for robustness in case an edge doesn't exist.
            try:
                self.adjacency_list[vertex1].remove(vertex2)
            except ValueError:
                pass
            try:
                self.adjacency_list[vertex2].remove(vertex1)
            except ValueError:
                pass

    def dfs(self, start_vertex, visited=None):
        """
        VULNERABILITY FIX: Perform an iterative depth-first search (DFS).
        This prevents stack overflow (Denial of Service) on deep graphs which the
        original recursive implementation was vulnerable to. 
        It also now checks if the start_vertex exists to prevent a KeyError.
        The original method signature is preserved.
        """
        if start_vertex not in self.adjacency_list:
            return  # Prevent KeyError if start_vertex doesn't exist

        if visited is None:
            visited = set()

        stack = [start_vertex]

        while stack:
            vertex = stack.pop()
            if vertex not in visited:
                visited.add(vertex)
                print(vertex, end=' ')
                # Add neighbors in reverse to mimic the traversal order of the
                # original recursive version for consistency.
                for neighbor in reversed(self.adjacency_list[vertex]):
                    if neighbor not in visited:
                        stack.append(neighbor)
    
    def bfs(self, start_vertex):
        """
        VULNERABILITY FIX: Perform BFS using an efficient deque-based queue.
        The original implementation's use of list.pop(0) has O(n) complexity, 
        making it vulnerable to a Denial-of-Service attack on large graphs.
        Using deque.popleft() is an O(1) operation.
        It also now checks if the start_vertex exists to prevent a KeyError.
        """
        if start_vertex not in self.adjacency_list:
            return # Prevent KeyError if start_vertex doesn't exist

        visited = set()
        queue = deque([start_vertex]) # Use efficient deque for O(1) pop
        visited.add(start_vertex)
        
        while queue:
            vertex = queue.popleft()
            print(vertex, end=' ')
            
            for neighbor in self.adjacency_list[vertex]:
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append(neighbor)

