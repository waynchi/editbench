# 编写 get_task_list 以从文件夹 settings['taskPath'] 中获取 *.xml 文件的名称列表。
# 每个文件的第一行可选地记录一行：<!-- comment -->
# 将答案表示为对象列表的格式 {fileName, comment, file_date_str}
@eel.expose
def get_task_list(settings):
    path = settings.get('taskPath')
    if not path or not os.path.isdir(path):
        print(f"Error: Task path '{path}' is not a valid directory.")
        return []

    task_list = []
    try:
        xml_files = [f for f in os.listdir(path) if f.endswith('.xml')]
        
        for file_name in xml_files:
            file_path = os.path.join(path, file_name)
            comment = ""
            file_date_str = ""

            try:
                # Get file modification timestamp and format it
                mtime = os.path.getmtime(file_path)
                file_date = datetime.datetime.fromtimestamp(mtime)
                file_date_str = file_date.strftime('%Y-%m-%d %H:%M:%S')

                # Read the first line to find an optional comment
                with open(file_path, 'r', encoding='utf-8') as f:
                    first_line = f.readline().strip()
                    # Use regex to robustly extract comment from <!-- comment -->
                    match = re.match(r'<!--\s*(.*?)\s*-->', first_line)
                    if match:
                        comment = match.group(1)
            except Exception as e:
                print(f"Error processing file '{file_path}': {e}")

            task_list.append({
                'fileName': file_name,
                'comment': comment,
                'file_date_str': file_date_str
            })
            
        return task_list

    except Exception as e:
        print(f"Error getting task list from '{path}': {e}")
        return []


