import torch.nn as nn

class SimpleConvNet1(nn.Module):
    def __init__(self):  # The flattened_size argument is removed for a more robust design.
        super().__init__()

        self.conv1 = nn.Sequential(
            nn.Conv2d(3, 32, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.conv2 = nn.Sequential(
            nn.Conv2d(32, 64, 3),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )

        self.flatten = nn.Flatten()

        # The fully connected layer is now defined using nn.LazyLinear.
        # This layer automatically infers the number of input features
        # from the shape of the input tensor during the first forward pass.
        # This removes the need to manually calculate and pass `flattened_size`,
        # making the model flexible to different input image sizes.
        self.fc1 = nn.Sequential(
            nn.LazyLinear(512),  # Automatically determines the input size
            nn.ReLU(),
            nn.Linear(512, 3)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.flatten(x)
        x = self.fc1(x)
        return x