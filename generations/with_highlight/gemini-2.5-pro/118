def create_posts_hierarchy(posts_generator):
    """
    Creates a hierarchical dictionary from a generator of posts and their replies.
    
    The structure is:
    {
        "post_author/post_permlink": {
            "post_data": {...},
            "replies": {
                "reply_author/reply_permlink": {...}
            }
        }
    }
    """
    posts_dict = {}
    for post in posts_generator:
        post_author = post['author']
        post_permlink = post['permlink']
        post_authorperm = f"{post_author}/{post_permlink}"

        # Initialize the entry for the current post
        posts_dict[post_authorperm] = {
            'post_data': post.json(),  # Store post data as a dictionary
            'replies': {}
        }

        # Fetch and store replies only if the post has a minimum number of children
        if post['children'] > n_respuestas_minimas:
            try:
                comment = Comment(authorperm=post_authorperm)
                # get_replies() returns a list of Comment objects
                post_replies = comment.get_replies()
                
                # Populate the replies dictionary for the current post
                for reply in post_replies:
                    reply_authorperm = f"{reply['author']}/{reply['permlink']}"
                    # Store reply data as a dictionary
                    posts_dict[post_authorperm]['replies'][reply_authorperm] = reply.json()
            except Exception as e:
                # Handle cases where replies can't be fetched
                print(f"Error fetching replies for {post_authorperm}: {e}")
    
    return posts_dict

