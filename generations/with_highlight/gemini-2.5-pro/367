import numpy as np


def linear_regression_gradient_descent(
    X: np.ndarray, y: np.ndarray, alpha: float, iterations: int
) -> np.ndarray:
    # Twój kod tutaj, upewnij się, że zaokrąglasz
    m, n = X.shape
    theta = np.zeros((n, 1))

    for _ in range(iterations):
        # The shape of y is (m,), which causes incorrect broadcasting in the expression (X @ theta - y).
        # We reshape y to (m, 1) to ensure correct element-wise subtraction.
        gradient = (1/m) * X.T @ (X @ theta - y.reshape(-1, 1))
        theta -= alpha * gradient

    # Round the final result as requested by the comment.
    return np.round(theta, 4)


print(
    linear_regression_gradient_descent(
        np.array([[1, 1], [1, 2], [1, 3]]), np.array([1, 2, 3]), 0.01, 1000
    )
)