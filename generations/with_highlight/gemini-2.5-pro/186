import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew

# 定义中位数耦合函数(data):
# 需要加速并重写函数 medcouple
def medcouple(data):
    """
    计算中位数耦合(medcouple)，一个稳健的偏度度量。
    此实现经过矢量化以提高效率。
    """
    data = np.sort(data)
    n = len(data)
    median = np.median(data)

    # 将数据分为中位数的左侧和右侧
    # 注意：当中位数重复时，它们会同时出现在left和right中
    left = data[data <= median]
    right = data[data >= median]

    # Vectorized kernel function h(xi, xj)
    def h(xi, xj):
        numerator = (xj - median) - (median - xi)
        denominator = xj - xi
        # 使用 np.divide 安全地处理除零情况。当分母为0时，结果为0。
        return np.divide(numerator, denominator, out=np.zeros_like(numerator, dtype=float), where=(denominator != 0))

    # Vectorized special kernel function for repeated medians
    def special_h(i, j, k):
        # np.sign 根据比较提供 -1, 0, 1 输出，
        # 将原始的 if/elif/else 逻辑矢量化。
        return np.sign((i + j - 1) - k)

    k = len(data[data == median])  # 重复中位数的计数

    # 使用numpy广播以提高效率
    xi, xj = np.meshgrid(left, right, indexing='ij')

    if k > 1:
        # 如果中位数重复，则需要特殊处理
        left_indices = np.arange(len(left))
        right_indices = np.arange(len(right))
        i, j = np.meshgrid(left_indices, right_indices, indexing='ij')
        
        # h 和 special_h现在是矢量化的，所以 np.where 可以正常工作
        h_matrix = np.where(
            (xi == median) & (xj == median),
            special_h(i, j, k),
            h(xi, xj)
        )
    else:
        # 如果中位数不重复，则直接计算所有 h(xi, xj)
        h_matrix = h(xi, xj)

    # 将矩阵展平并计算h值的中位数
    return np.median(h_matrix.flatten())

def adjusted_boxplot_bounds(data):
    """计算调整后的箱线图边界，考虑偏度调整的围栏。"""
    q1 = np.percentile(data, 25)
    q3 = np.percentile(data, 75)
    iqr = q3 - q1
    _medcouple = medcouple(data)

    if _medcouple > 0:
        lower_fence = q1 - 1.5 * np.exp(-4 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(3 * _medcouple) * iqr
    else:
        lower_fence = q1 - 1.5 * np.exp(-3 * _medcouple) * iqr
        upper_fence = q3 + 1.5 * np.exp(4 * _medcouple) * iqr

    return lower_fence, upper_fence

def normalize_column(data):
    """使用调整后的箱线图进行归一化。"""
    lower_fence, upper_fence = adjusted_boxplot_bounds(data)
    print(lower_fence)
    return (data - lower_fence) / (upper_fence - lower_fence)

